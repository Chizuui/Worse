// Orchestra live view (design frame "Orchestra · live", FigCraft): every running session (plus the open one) as an
// Orchestrator node, each with one node per active subagent it delegated to (ChatUi.fleet, §9.8) joined by curved edges, a legend chip, zoom
// control and minimap on a pannable canvas, and a detail panel for the picked subagent (Message / Stop).
// Not shown until the hub exposes them: claimed paths, token counts, progress %, the full live log and the queue.
import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, IconButton } from "../components/controls.slint";
import { ChatUi, SubagentRow, FleetGroup } from "../chat/globals.slint";
import { AgentTint } from "../panels/common.slint";
import { AgentLogo, AgentMark } from "../components/agent_logo.slint";
import { SettingsUi } from "../settings/globals.slint";

export global OrchLiveUi {
    in-out property <bool> open;
}

// Status helpers (SubagentRow.status: 0 running, 1 needs approval, 2 done, 3 failed, 4 cancelled, 5 interrupted).
global LiveStatus {
    public pure function label(s: int) -> string {
        if s == 0 { return @tr("Running"); }
        if s == 1 { return @tr("Needs approval"); }
        if s == 2 { return @tr("Done"); }
        if s == 3 { return @tr("Failed"); }
        if s == 4 { return @tr("Cancelled"); }
        return @tr("Interrupted");
    }
    public pure function tint(s: int) -> color {
        if s == 0 { return Theme.success; }
        if s == 1 { return Theme.warning; }
        if s == 2 { return Theme.info; }
        if s == 3 { return Theme.destructive; }
        return Theme.muted;
    }
    public pure function initial(agent: string) -> string {
        if agent == "claude-code" || agent == "claude" { return "C"; }
        if agent == "codex" { return "C"; }
        if agent.to-lowercase() == "deepseek" || agent.to-lowercase() == "deepseek-api" { return "D"; }
        if agent == "agy" || agent == "antigravity" { return "A"; }
        if agent == "gemini" { return "G"; }
        if agent == "harness" { return "H"; }
        return "•";
    }
}

component StatusPill inherits Rectangle {
    in property <int> status;
    height: 18px;
    width: st.preferred-width + 16px;
    border-radius: 9px;
    background: LiveStatus.tint(root.status).with-alpha(0.14);
    st := Text {
        text: LiveStatus.label(root.status);
        font-size: 10px;
        font-weight: Theme.weight-semibold;
        color: LiveStatus.tint(root.status);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Avatar (design: 28px circle, agent tint 18% fill + 1px tint ring, initial 12 semibold).
component Avatar inherits Rectangle {
    in property <string> agent;
    in property <length> size: 28px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: AgentLogo.key(root.agent) != "" ? transparent : AgentTint.of(root.agent).with-alpha(0.18);
    border-width: AgentLogo.key(root.agent) != "" ? 0px : 1px;
    border-color: AgentTint.of(root.agent).with-alpha(0.55);
    if AgentLogo.key(root.agent) != "": AgentMark {
        name: root.agent;
        size: root.size;
    }
    if AgentLogo.key(root.agent) == "": Text {
        text: LiveStatus.initial(root.agent);
        font-size: root.size * 0.42;
        font-weight: Theme.weight-semibold;
        color: AgentTint.of(root.agent);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Progress track (design: 4px, #24272D track, agent tint fill). Running = indeterminate sweep, done = full.
component Progress inherits Rectangle {
    in property <int> status;
    in property <color> tint;
    height: 4px;
    border-radius: 2px;
    background: Theme.border;
    clip: true;
    property <float> phase: Theme.reduce-motion ? 0.3 : Math.mod(animation-tick() / 1ms, 1800) / 1800;
    if root.status == 0 || root.status == 1: Rectangle {
        width: parent.width * 0.35;
        x: (parent.width * 1.35) * root.phase - parent.width * 0.35;
        height: parent.height;
        border-radius: 2px;
        background: root.status == 1 ? Theme.warning : root.tint;
    }
    if root.status >= 2: Rectangle {
        x: 0;
        width: parent.width;
        height: parent.height;
        border-radius: 2px;
        background: root.status == 2 ? root.tint : LiveStatus.tint(root.status).with-alpha(0.6);
    }
}

// Header / panel button (design: 30px, radius 8; "secondary" #1C1F24 + #2A2D33, "accent" brand gradient,
// "danger" red outline).
component LiveButton inherits Rectangle {
    in property <string> text;
    in property <string> variant: "secondary";
    in property <bool> enabled: true;
    callback clicked();
    height: 30px;
    min-width: bt.preferred-width + 26px;
    border-radius: 8px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.variant == "accent" ? Theme.brand-gradient : root.variant == "danger" ? Theme.destructive.with-alpha(ta.has-hover ? 0.18 : 0.1) : (ta.has-hover && root.enabled ? Theme.surface-hover : Theme.raised);
    border-width: root.variant == "accent" ? 0px : 1px;
    border-color: root.variant == "danger" ? Theme.destructive.with-alpha(0.5) : Theme.border-hover;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    bt := Text {
        text: root.text;
        font-size: 12px;
        font-weight: Theme.weight-medium;
        color: root.variant == "accent" ? Theme.on-accent : root.variant == "danger" ? Theme.destructive : Theme.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Caps inherits Text {
    font-size: 10px;
    font-weight: Theme.weight-semibold;
    letter-spacing: 0.8px;
    color: Theme.caps-label;
}

// Subagent node (design: 286 wide, #121317, 1px #24272D, r10; selected = accent ring).
component SubNode inherits Rectangle {
    in property <SubagentRow> item;
    in property <bool> selected;
    callback picked();
    width: 340px;
    height: 116px;
    border-radius: 10px;
    background: root.selected ? Theme.card-selected : Theme.card;
    border-width: root.selected ? 1.5px : 1px;
    border-color: root.selected ? Theme.accent-fg.with-alpha(0.7) : (nta.has-hover ? Theme.border-hover : Theme.border);
    drop-shadow-blur: root.selected ? 18px : 0px;
    drop-shadow-color: Theme.accent-fg.with-alpha(0.18);
    accessible-role: button;
    accessible-label: root.item.agent-name + ": " + root.item.title;
    accessible-action-default => {
        root.picked();
    }
    nta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Avatar {
                agent: root.item.agent;
                size: 22px;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 1px;
                Text {
                    text: root.item.agent-name;
                    font-size: 12px;
                    font-weight: Theme.weight-semibold;
                    color: Theme.foreground;
                    overflow: elide;
                }
                Text {
                    text: root.item.agent + " · " + ChatUi.elapsed(root.item.started-s, root.item.finished-s);
                    font-size: 10px;
                    color: Theme.foreground-subtlest;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: start;
                StatusPill {
                    status: root.item.status;
                }
            }
        }
        Text {
            text: root.item.title;
            font-size: 12px;
            color: Theme.foreground-subtle;
            overflow: elide;
        }
        Progress {
            status: root.item.status;
            tint: AgentTint.of(root.item.agent);
        }
        // Latest activity (design: path chips row; the hub reports one activity line instead).
        HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 18px;
                width: min(316px, at.preferred-width + 12px);
                border-radius: 4px;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border-hover;
                at := Text {
                    x: 6px;
                    width: parent.width - 12px;
                    text: root.item.activity != "" ? root.item.activity : (root.item.status == 0 ? @tr("thinking…") : (root.item.preview != "" ? root.item.preview : LiveStatus.label(root.item.status)));
                    font-size: 10px;
                    color: Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

component SessionGroup inherits Rectangle {
    in property <FleetGroup> g;
    in property <string> model-name;
    in property <int> sel: -1;
    callback picked(int);
    callback open-session();
    property <int> n: root.g.subagents.length;
    property <length> node-h: 116px;
    property <length> gap: 28px;
    property <length> col-h: root.n * root.node-h + max(0, root.n - 1) * root.gap;
    property <length> top: (root.height - root.col-h) / 2;
    property <length> orch-y: (root.height - 196px) / 2;
    property <length> sub-x: 460px;
    height: root.g.height * 1px;
    for r[i] in root.g.subagents: Path {
        property <float> sx: 320;
        property <float> sy: (root.orch-y + (root.n > 1 ? 40px + i * 116px / (root.n - 1) : 98px)) / 1px;
        property <float> ex: root.sub-x / 1px;
        property <float> ey: (root.top + i * (root.node-h + root.gap) + 58px) / 1px;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: "M " + self.sx + " " + self.sy + " C " + (self.sx + 80) + " " + self.sy + " " + (self.ex - 90) + " " + self.ey + " " + (self.ex - 6) + " " + self.ey;
        stroke: i == root.sel ? Theme.accent-fg.with-alpha(0.9) : Theme.accent-fg.with-alpha(0.45);
        stroke-width: i == root.sel ? 1.6px : 1.2px;
        accessible-role: none;
    }
    for r[i] in root.g.subagents: Path {
        x: root.sub-x - 8px;
        y: root.top + i * (root.node-h + root.gap) + 58px - 4px;
        width: 8px;
        height: 8px;
        viewbox-width: 8;
        viewbox-height: 8;
        commands: "M 0 0 L 8 4 L 0 8 Z";
        fill: i == root.sel ? Theme.accent-fg : Theme.accent-fg.with-alpha(0.7);
        accessible-role: none;
    }
    for r[i] in root.g.subagents: Rectangle {
        x: 320px - 3px;
        y: root.orch-y + (root.n > 1 ? 40px + i * 116px / (root.n - 1) : 98px) - 3px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent-fg.with-alpha(0.85);
    }
    Rectangle {
        x: 0;
        y: root.orch-y;
        width: 320px;
        height: 196px;
        border-radius: 10px;
        background: oa.has-hover ? Theme.card-selected : Theme.card;
        border-width: root.g.open ? 1.5px : 1px;
        border-color: root.g.open ? Theme.accent-fg.with-alpha(0.6) : Theme.border-hover;
        accessible-role: button;
        accessible-label: root.g.title;
        accessible-description: root.g.prompt;
        accessible-action-default => {
            root.open-session();
        }
        oa := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.open-session();
            }
        }
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Avatar {
                    agent: root.g.agent;
                    size: 26px;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 1px;
                    Text {
                        text: root.g.title != "" ? root.g.title : @tr("Untitled session");
                        font-size: 12px;
                        font-weight: Theme.weight-semibold;
                        color: Theme.foreground;
                        overflow: elide;
                    }
                    Text {
                        text: (root.g.open ? @tr("Open") + " · " : "") + @tr("Orchestrator") + " · " + root.g.agent-name + (root.model-name != "" ? " · " + root.model-name : "");
                        font-size: 10px;
                        color: root.g.open ? Theme.accent-fg : Theme.foreground-subtlest;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: start;
                    StatusPill {
                        status: root.g.running || root.g.active > 0 ? 0 : 2;
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                border-radius: 6px;
                background: Theme.well;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    Caps {
                        text: root.g.running ? @tr("PROCESSING") : @tr("LAST PROMPT");
                        color: root.g.running ? Theme.success : Theme.caps-label;
                    }
                    prompt-flick := Flickable {
                        vertical-stretch: 1;
                        min-height: 0;
                        interactive: false;
                        content-width: self.width;
                        content-height: max(self.height, prompt-text.preferred-height);
                        prompt-text := Text {
                            width: prompt-flick.width;
                            text: root.g.prompt != "" ? root.g.prompt : @tr("No prompt yet");
                            font-size: 11px;
                            color: root.g.prompt != "" ? Theme.foreground-subtle : Theme.foreground-subtlest;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            HorizontalLayout {
                Text {
                    text: @tr("{0} of {1} subagents finished", root.g.total - root.g.active, root.g.total);
                    font-size: 10px;
                    color: Theme.foreground-subtlest;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: @tr("{0} active", root.g.active);
                    font-size: 10px;
                    color: Theme.foreground-subtlest;
                }
            }
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.border;
                Rectangle {
                    x: 0;
                    width: root.g.total == 0 ? 0px : parent.width * (root.g.total - root.g.active) / root.g.total;
                    height: parent.height;
                    border-radius: 2px;
                    background: Theme.accent-fg;
                }
            }
        }
    }
    for r[i] in root.g.subagents: SubNode {
        x: root.sub-x;
        y: root.top + i * (root.node-h + root.gap);
        item: r;
        selected: i == root.sel;
        picked => {
            root.picked(i);
        }
    }
    if root.n == 0 && root.g.open: Rectangle {
        x: root.sub-x;
        y: root.orch-y + 48px;
        width: 340px;
        height: 100px;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.well;
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            alignment: center;
            Text {
                text: root.g.total == 0 ? @tr("No subagents yet") : @tr("No active subagents");
                font-size: 12px;
                font-weight: Theme.weight-medium;
                color: Theme.foreground-subtle;
            }
            Text {
                text: root.g.total == 0
                    ? @tr("When the orchestrator delegates part of a task, each subagent appears here live.")
                    : @tr("All {0} subagents finished. Their results are in the chat; new delegations appear here live.", root.g.total);
                font-size: 11px;
                color: Theme.foreground-subtlest;
                wrap: word-wrap;
            }
        }
    }
}

export component OrchestraLive inherits Rectangle {
    in property <string> session-title;
    in property <string> agent-id;
    in property <string> agent-name;
    in property <string> model-name;
    in property <bool> session-running;
    callback close();
    callback delegate();
    callback open-settings();

    property <int> max-conc: max(1, SettingsUi.get-int("orchestra.maxConcurrent", SettingsUi.rev));
    property <int> sel-g: 0;
    property <int> sel-s: 0;
    property <bool> detail: true;
    property <bool> has-sel: root.detail && root.sel-g >= 0 && root.sel-g < ChatUi.fleet.length && root.sel-s >= 0 && root.sel-s < ChatUi.fleet[max(0, root.sel-g)].subagents.length;
    property <SubagentRow> cur: ChatUi.fleet[max(0, root.sel-g)].subagents[max(0, root.sel-s)];
    // Canvas view state.
    property <float> zoom: 1.0;
    property <length> pan-x: 0px;
    property <length> pan-y: 0px;
    property <length> press-x;
    property <length> press-y;
    property <length> start-x;
    property <length> start-y;

    background: Theme.canvas;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: @tr("Orchestra");
    TouchArea { }

    // Elapsed clock while anything runs.
    Timer {
        interval: 1s;
        running: ChatUi.fleet-running > 0;
        triggered => {
            ChatUi.subagent-action("tick", "");
        }
    }

    VerticalLayout {
        // Header (design: 56px, "Orchestra" 15 semibold | running pill; Auto-layout + Delegate task right).
        Rectangle {
            height: 56px;
            border-width: 0px;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 16px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.chevron-left;
                        label: @tr("Back to chat");
                        clicked => {
                            root.close();
                        }
                    }
                }
                Text {
                    text: @tr("Orchestra");
                    font-family: Theme.display-font;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.foreground;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 1px;
                        height: 16px;
                        background: Theme.border-hover;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 20px;
                        width: rp.preferred-width + 26px;
                        border-radius: 10px;
                        background: Theme.success.with-alpha(0.12);
                        Rectangle {
                            x: 9px;
                            width: 5px;
                            height: 5px;
                            border-radius: 2.5px;
                            background: Theme.success;
                        }
                        rp := Text {
                            x: 19px;
                            text: @tr("{0} / {1} running", ChatUi.fleet-running, root.max-conc);
                            font-size: 11px;
                            font-weight: Theme.weight-medium;
                            color: Theme.success;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: ChatUi.fleet-sessions == 0 ? @tr("No session running") : @tr("{0} sessions active", ChatUi.fleet-sessions);
                    font-size: 12px;
                    color: Theme.foreground-subtlest;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.settings;
                        label: @tr("Orchestra settings");
                        clicked => {
                            root.open-settings();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    LiveButton {
                        text: @tr("Auto-layout");
                        clicked => {
                            root.zoom = 1.0;
                            root.pan-x = 0px;
                            root.pan-y = 0px;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    LiveButton {
                        text: @tr("+  Delegate task");
                        variant: "accent";
                        clicked => {
                            root.delegate();
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.raised;
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            // ---- Canvas ----
            canvas := Rectangle {
                horizontal-stretch: 1;
                clip: true;
                // Pan by dragging the background; wheel zooms.
                pan := TouchArea {
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                            root.press-x = self.mouse-x;
                            root.press-y = self.mouse-y;
                            root.start-x = root.pan-x;
                            root.start-y = root.pan-y;
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.pan-x = root.start-x + self.mouse-x - root.press-x;
                            root.pan-y = root.start-y + self.mouse-y - root.press-y;
                        }
                    }
                    scroll-event(e) => {
                        root.zoom = clamp(root.zoom + (e.delta-y > 0 ? 0.1 : -0.1), 0.5, 1.6);
                        accept
                    }
                }
                world := Rectangle {
                    property <length> top: max(70px, (self.height - ChatUi.fleet-height * 1px) / 2);
                    x: root.pan-x;
                    y: root.pan-y;
                    width: canvas.width;
                    height: max(canvas.height, ChatUi.fleet-height * 1px + 140px);
                    transform-scale: root.zoom;
                    for g[gi] in ChatUi.fleet: SessionGroup {
                        x: 38px;
                        y: world.top + g.y * 1px;
                        width: world.width - 38px;
                        g: g;
                        model-name: g.open ? root.model-name : "";
                        sel: root.detail && gi == root.sel-g ? root.sel-s : -1;
                        picked(i) => {
                            root.sel-g = gi;
                            root.sel-s = i;
                            root.detail = true;
                        }
                        open-session => {
                            ChatUi.subagent-action("open", g.id);
                        }
                    }
                    if ChatUi.fleet.length == 0: Text {
                        x: 38px;
                        y: world.top;
                        text: @tr("No session is running. Open or start a session to see it here.");
                        font-size: 12px;
                        color: Theme.foreground-subtlest;
                    }
                }
                // Legend chip (design: top-left, #121317, 1px #24272D, r8).
                Rectangle {
                    x: 16px;
                    y: 14px;
                    height: 30px;
                    width: lg.preferred-width + 24px;
                    border-radius: 8px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.border;
                    lg := HorizontalLayout {
                        x: 12px;
                        width: self.preferred-width;
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 5px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 5px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: Theme.success;
                                }
                            }
                            Text {
                                text: @tr("{0} running", ChatUi.fleet-running - ChatUi.fleet-waiting);
                                font-size: 11px;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: 5px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 5px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: Theme.warning;
                                }
                            }
                            Text {
                                text: @tr("{0} waiting", ChatUi.fleet-waiting);
                                font-size: 11px;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                        }
                        HorizontalLayout {
                            spacing: 5px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 5px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: Theme.foreground-subtlest;
                                }
                            }
                            Text {
                                text: @tr("max {0} concurrent", root.max-conc);
                                font-size: 11px;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // Zoom (design: bottom-left "− 100% +").
                Rectangle {
                    x: 16px;
                    y: parent.height - self.height - 16px;
                    height: 26px;
                    width: 82px;
                    border-radius: 8px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        Rectangle {
                            width: 22px;
                            Text {
                                text: "−";
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                color: zo.has-hover ? Theme.foreground : Theme.muted;
                            }
                            zo := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.zoom = max(0.5, root.zoom - 0.1);
                                }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: round(root.zoom * 100) + "%";
                            font-size: 10px;
                            color: Theme.foreground-subtle;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 22px;
                            Text {
                                text: "+";
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                color: zi.has-hover ? Theme.foreground : Theme.muted;
                            }
                            zi := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.zoom = min(1.6, root.zoom + 0.1);
                                }
                            }
                        }
                    }
                }
                // Minimap (design: bottom-right 140x80, nodes as blocks).
                Rectangle {
                    x: parent.width - self.width - 16px;
                    y: parent.height - self.height - 16px;
                    width: 140px;
                    height: 80px;
                    border-radius: 8px;
                    background: Theme.card;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    property <float> k: 0.1;
                    for g[gi] in ChatUi.fleet: Rectangle {
                        property <float> k: 64 / max(1, ChatUi.fleet-height);
                        x: 10px;
                        y: 8px + g.y * self.k * 1px;
                        width: 120px;
                        height: max(3px, g.height * self.k * 1px);
                        Rectangle {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            width: 24px;
                            height: max(3px, min(parent.height, 196 * parent.k * 1px));
                            border-radius: 2px;
                            background: g.open ? Theme.accent-fg.with-alpha(0.4) : #2A2D3A;
                        }
                        for r[i] in g.subagents: Rectangle {
                            property <length> step: parent.height / max(1, g.active);
                            x: 48px;
                            y: i * self.step;
                            width: 32px;
                            height: max(2px, self.step - 2px);
                            border-radius: 2px;
                            background: gi == root.sel-g && i == root.sel-s && root.detail ? Theme.accent-fg.with-alpha(0.55) : #2F3446;
                        }
                    }
                }
            }
            // ---- Detail panel (design: 270 wide, left border) ----
            if root.has-sel: Rectangle {
                width: 290px;
                background: Theme.well;
                Rectangle {
                    x: 0;
                    width: 1px;
                    background: Theme.raised;
                }
                VerticalLayout {
                    padding: 14px;
                    padding-left: 15px;
                    spacing: 12px;
                    HorizontalLayout {
                        Caps {
                            text: @tr("SUBAGENT");
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        IconButton {
                            icon: Icons.x;
                            label: @tr("Close details");
                            size: 22px;
                            icon-size: 12px;
                            clicked => {
                                root.detail = false;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Avatar {
                            agent: root.cur.agent;
                            size: 30px;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: root.cur.agent-name;
                                font-size: 13px;
                                font-weight: Theme.weight-semibold;
                                color: Theme.foreground;
                                overflow: elide;
                            }
                            Text {
                                text: root.cur.id;
                                font-size: 10px;
                                color: Theme.foreground-subtlest;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            StatusPill {
                                status: root.cur.status;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;
                            Caps {
                                text: @tr("AGENT");
                            }
                            Text {
                                text: root.cur.agent-name;
                                font-size: 12px;
                                color: Theme.foreground-subtle;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            spacing: 3px;
                            Caps {
                                text: @tr("ELAPSED");
                                horizontal-alignment: right;
                            }
                            Text {
                                text: ChatUi.elapsed(root.cur.started-s, root.cur.finished-s);
                                font-size: 12px;
                                color: Theme.foreground-subtle;
                                horizontal-alignment: right;
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        Caps {
                            text: @tr("TASK");
                        }
                        Text {
                            text: root.cur.title;
                            font-size: 12px;
                            color: Theme.foreground;
                            wrap: word-wrap;
                        }
                    }
                    // Live log (design: mono box). The hub streams one activity line; the latest answer follows.
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.card;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            Caps {
                                text: @tr("LIVE ACTIVITY");
                            }
                            if root.cur.activity != "": Text {
                                text: root.cur.activity;
                                font-family: Theme.mono-font;
                                font-size: 11px;
                                color: Theme.foreground-subtle;
                                wrap: word-wrap;
                            }
                            if root.cur.preview != "": Text {
                                text: root.cur.preview;
                                font-family: Theme.mono-font;
                                font-size: 11px;
                                color: root.cur.status == 2 ? Theme.success : (root.cur.status == 3 ? Theme.destructive : Theme.muted);
                                wrap: word-wrap;
                                overflow: elide;
                                max-height: 150px;
                            }
                            if root.cur.activity == "" && root.cur.preview == "": Text {
                                text: root.cur.status == 0 ? @tr("thinking…") : LiveStatus.label(root.cur.status);
                                font-family: Theme.mono-font;
                                font-size: 11px;
                                color: Theme.foreground-subtlest;
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        LiveButton {
                            horizontal-stretch: 1;
                            text: @tr("Message");
                            clicked => {
                                ChatUi.subagent-action("open", root.cur.id);
                                root.close();
                            }
                        }
                        LiveButton {
                            horizontal-stretch: 1;
                            text: @tr("Stop");
                            variant: "danger";
                            enabled: root.cur.status <= 1;
                            clicked => {
                                ChatUi.subagent-action("stop", root.cur.id);
                            }
                        }
                    }
                }
            }
        }
    }
}
