import { Theme } from "tokens.slint";

export component MidnightBackdrop inherits Rectangle {
    property <length> light: max(root.width, root.height) * 1.5;
    background: Theme.dark ? #0b0c0e : @linear-gradient(180deg, #f4f6fa 0%, #e9edf3 100%);
    clip: true;
    Rectangle {
        width: root.light;
        height: root.light;
        x: (root.width - self.width) / 2;
        y: -root.height * 0.25 - self.height / 2;
        background: Theme.dark ? transparent : @radial-gradient(circle, #ffffffcc 0%, #ffffff59 35%, #ffffff00 70%);
    }
    @children
}
