// Agent-config pages (design frames S7–S13). MCP servers, Skills, Commands, Hooks and Subagents share one data
// pattern — target switch -> list -> detail card (form <-> raw) -> diff confirm -> atomic write — but each concept
// has its own list layout (tables, skill grid, per-event hook cards). Instructions and Memory edit one document
// per target. Unsupported concepts show a greyed notice instead of disappearing.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icons, IconButton, Segmented, MenuShell, MenuItem } from "../components/controls.slint";
import { ConfigUi, DocUi, ResRow, FormField, SettingsUi, RecallUi, RecallRow, GraphUi, GraphNode } from "globals.slint";
import { PageHeader, Group, SettingRow, Switch, TextField, TextArea, Select, SearchField, UnsupportedNotice, StatusLine } from "parts.slint";
import { Labels } from "labels.slint";

// Agent identity dot colour (design "Agent switcher": a 6px agent-colour dot before the label).
global AgentDot {
    pure public function color-of(id: string) -> color {
        if id == "claude-code" { return Theme.agent-claude; }
        if id == "codex" { return Theme.agent-codex; }
        if id == "harness" { return Theme.agent-deepseek; }
        if id == "agy" { return Theme.agent-agy; }
        if id == "gemini" { return Theme.agent-gemini; }
        return Theme.icon-subtlest;
    }
}

// Page copy (design S7–S13, verbatim).
global ConfigCopy {
    pure public function title(concept: string) -> string {
        if concept == "mcp" { return "MCP servers"; }
        if concept == "skill" { return "Skills"; }
        if concept == "command" { return "Commands"; }
        if concept == "hook" { return "Hooks"; }
        if concept == "subagent" { return "Subagents"; }
        return Labels.concept-title(concept);
    }
    pure public function subtitle(concept: string) -> string {
        if concept == "mcp" { return "Model Context Protocol servers exposed to agents in this session."; }
        if concept == "skill" { return "Skills are loaded on demand and count against context usage. Toggle to expose a skill to this agent."; }
        if concept == "command" { return "Slash commands available in the composer. Type / to invoke."; }
        if concept == "hook" { return "Shell commands that run on agent lifecycle events. Matchers are regex against the tool name."; }
        if concept == "subagent" { return "Reusable subagent definitions. The orchestrator delegates to these when a task can run in parallel."; }
        return Labels.concept-intro(concept);
    }
    pure public function new-label(concept: string) -> string {
        if concept == "mcp" { return "+ Add server"; }
        if concept == "skill" { return "+ New skill"; }
        if concept == "command" { return "+ New command"; }
        if concept == "hook" { return "+ Add hook"; }
        if concept == "subagent" { return "+ New subagent"; }
        return "+ New";
    }
    pure public function detail-kind(concept: string) -> string {
        if concept == "mcp" { return "MCP server"; }
        if concept == "skill" { return "Skill"; }
        if concept == "command" { return "Command"; }
        if concept == "hook" { return "Hook"; }
        if concept == "subagent" { return "Subagent definition"; }
        return "";
    }
    pure public function scope-name(scope: string) -> string {
        if scope == "workspace" { return "project"; }
        if scope == "local" { return "local"; }
        return "global";
    }
    pure public function scope-tint(scope: string) -> color {
        return scope == "user" ? Theme.info : Theme.accent-fg;
    }
}

// ---- design primitives ---------------------------------------------------------------------------------------

// Pill (design: pad [3,8] 11px, or [3,6] 10px when small; tint text on tint at ~12%; radius 999).
component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent-fg;
    in property <bool> small: false;
    height: root.small ? 16px : 18px;
    preferred-width: t.preferred-width + (root.small ? 12px : 16px);
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: root.tint.with-alpha(0.12);
    t := Text {
        text: root.text;
        font-size: root.small ? 10px : 11px;
        color: root.tint;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// Button (design: height 28, pad [0,12], radius 8, 12px; primary = #EDEEF0 on #0B0C0E,
// secondary = raised fill + #2A2D33 border). `compact` = 26 tall, pad 11, radius 7 (editor bar).
component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    in property <string> label: root.text;
    callback clicked;
    height: root.compact ? 26px : 28px;
    preferred-width: t.preferred-width + (root.compact ? 22px : 24px);
    horizontal-stretch: 0;
    border-radius: root.compact ? 7px : 8px;
    background: root.primary ? (ta.has-hover && root.enabled ? Theme.primary-hover : Theme.primary) : (ta.has-hover && root.enabled ? Theme.border-hover : Theme.surface-hover);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border-hover;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: Theme.dur-hover; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    t := Text {
        text: root.text;
        font-size: 12px;
        color: root.primary ? Theme.foreground-inverse : Theme.foreground;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Dot inherits Rectangle {
    in property <color> tint;
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: root.tint;
}

component Hairline inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// Card shell (design: fill #111215, 1px #24272D, radius 12).
component DCard inherits Rectangle {
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 12px;
    clip: true;
}

// Card header (design: 44 tall, pad [0,16], title 13 #EDEEF0 over subtitle 11 #6B717C, gap 2; right slot).
component CardHead inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <color> title-color: Theme.foreground;
    height: 44px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: 13px;
                color: root.title-color;
                overflow: elide;
            }
            if root.sub != "": Text {
                text: root.sub;
                font-size: 11px;
                color: Theme.icon-subtlest;
                overflow: elide;
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            horizontal-stretch: 0;
            @children
        }
    }
}

// Table column header text (design: caps 10 #5D636D).
component Th inherits Text {
    font-size: 10px;
    color: Theme.caps-label;
    letter-spacing: 0.4px;
    vertical-alignment: center;
    overflow: elide;
}

component Muted inherits Text {
    font-size: 11px;
    color: Theme.foreground-subtlest;
    vertical-alignment: center;
    overflow: elide;
}

// ---- agent switcher ------------------------------------------------------------------------------------------

// One agent segment (design: 28 tall, radius 6, pad [0,12,0,10], gap 7; active = raised + #2A2D33 border,
// agent-colour dot, #EDEEF0 label; inactive = grey dot, #8A909A label; 12px).
component AgentChip inherits Rectangle {
    in property <string> agent-id;
    in property <string> text;
    in property <bool> active;
    in property <color> dot: AgentDot.color-of(root.agent-id);
    callback picked;
    height: 28px;
    preferred-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: root.active ? Theme.surface-hover : (ta.has-hover ? Theme.hover : Theme.hover.with-alpha(0));
    border-width: root.active ? 1px : 0px;
    border-color: Theme.border-hover;
    animate background { duration: Theme.dur-hover; }
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checked: root.active;
    accessible-action-default => {
        root.picked();
    }
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 7px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Dot {
                tint: root.active ? root.dot : Theme.icon-subtlest;
            }
        }
        Text {
            text: root.text;
            font-size: 12px;
            color: root.active ? Theme.foreground : Theme.foreground-subtlest;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }
}

// Segmented container (design: 34 tall, pad 3, gap 2, fill #16181C, 1px #24272D, radius 8).
component ChipBar inherits Rectangle {
    height: 34px;
    preferred-width: chips.preferred-width;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    chips := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        @children
    }
}

// Target switch: agent tabs (+ optional User/Workspace scope at the right).
export component TargetBar inherits HorizontalLayout {
    in property <string> agent;
    in property <string> scope;
    in property <bool> with-harness: false;
    in property <bool> with-scope: true;
    callback select-agent(string);
    callback select-scope(string);
    spacing: 8px;
    ChipBar {
        AgentChip {
            agent-id: "claude-code";
            text: "Claude Code";
            active: root.agent == "claude-code";
            picked => {
                root.select-agent("claude-code");
            }
        }
        AgentChip {
            agent-id: "codex";
            text: "Codex";
            active: root.agent == "codex";
            picked => {
                root.select-agent("codex");
            }
        }
        AgentChip {
            agent-id: "agy";
            text: "agy";
            active: root.agent == "agy";
            picked => {
                root.select-agent("agy");
            }
        }
        if root.with-harness: AgentChip {
            agent-id: "harness";
            text: "Harness";
            active: root.agent == "harness";
            picked => {
                root.select-agent("harness");
            }
        }
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    if root.with-scope: VerticalLayout {
        alignment: center;
        Segmented {
            options: [{ id: "user", label: @tr("User") }, { id: "workspace", label: @tr("Workspace") }];
            current: root.scope;
            select(id) => {
                root.select-scope(id);
            }
        }
    }
}

// ---- detail card (editor) ------------------------------------------------------------------------------------

component ImportButton inherits Rectangle {
    width: btn.preferred-width;
    height: 28px;
    btn := Btn {
        x: 0;
        y: 0;
        text: "Import from Claude Code";
        clicked => {
            menu.show();
        }
    }
    menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 220px;
        MenuShell {
            MenuItem {
                text: "From Claude Code";
                show-check: false;
                clicked => {
                    ConfigUi.import("claude-code");
                    menu.close();
                }
            }
            MenuItem {
                text: "From Codex";
                show-check: false;
                clicked => {
                    ConfigUi.import("codex");
                    menu.close();
                }
            }
            MenuItem {
                text: "From agy";
                show-check: false;
                clicked => {
                    ConfigUi.import("agy");
                    menu.close();
                }
            }
            MenuItem {
                text: "All";
                show-check: false;
                clicked => {
                    ConfigUi.import("all");
                    menu.close();
                }
            }
        }
    }
}

component FieldEditor inherits VerticalLayout {
    in property <FormField> field;
    spacing: 6px;
    if root.field.kind != "switch": Text {
        text: Labels.field-label(root.field.key);
        font-size: 11px;
        color: Theme.icon-subtlest;
    }
    if root.field.kind == "text" || root.field.kind == "mono": TextField {
        text: root.field.value;
        label: Labels.field-label(root.field.key);
        placeholder: Labels.field-hint(root.field.key);
        mono: root.field.kind == "mono";
        enabled: root.field.enabled;
        edited(v) => {
            ConfigUi.set-field(root.field.key, v);
        }
    }
    if root.field.kind == "multiline": TextArea {
        height: 120px;
        text: root.field.value;
        label: Labels.field-label(root.field.key);
        mono: root.field.key != "description";
        edited(v) => {
            ConfigUi.set-field(root.field.key, v);
        }
    }
    if root.field.kind == "select": Select {
        label: Labels.field-label(root.field.key);
        options: root.field.options;
        current: root.field.value;
        current-label: root.field.value;
        enabled: root.field.enabled;
        select(id) => {
            ConfigUi.set-field(root.field.key, id);
        }
    }
    if root.field.kind == "switch": HorizontalLayout {
        spacing: 10px;
        Text {
            text: Labels.field-label(root.field.key);
            font-size: 13px;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Switch {
            label: Labels.field-label(root.field.key);
            checked: root.field.value == "true";
            toggled(on) => {
                ConfigUi.set-field(root.field.key, on ? "true" : "false");
            }
        }
    }
    if Labels.field-hint(root.field.key) != "" && root.field.kind == "multiline": Text {
        text: Labels.field-hint(root.field.key);
        font-size: 11px;
        color: Theme.icon-subtlest;
    }
}

// Detail card of the selected / new entry (design "Card · deepseek-core", "Card · ida-pro-mcp", "Card · /review"):
// header (name + kind · file), body = form or raw code box, actions Save / Discard / Delete.
component DetailCard inherits DCard {
    VerticalLayout {
        CardHead {
            title: ConfigUi.is-new ? Labels.new-label(ConfigUi.concept) : (ConfigUi.concept == "command" ? "/" + ConfigUi.edit-name : ConfigUi.edit-name);
            sub: ConfigCopy.detail-kind(ConfigUi.concept) + (ConfigUi.raw-path != "" ? " · " + ConfigUi.raw-path : "");
            VerticalLayout {
                alignment: center;
                Segmented {
                    options: [{ id: "form", label: @tr("Form") }, { id: "raw", label: @tr("Raw") }];
                    current: ConfigUi.raw-mode ? "raw" : "form";
                    select(id) => {
                        ConfigUi.raw-mode = id == "raw";
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.x;
                    label: @tr("Close editor");
                    size: 26px;
                    icon-size: Theme.icon-xs;
                    clicked => {
                        ConfigUi.close-editor();
                    }
                }
            }
        }
        Hairline { }
        VerticalLayout {
            padding-top: 14px;
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 16px;
            spacing: 10px;
            if !ConfigUi.raw-mode: VerticalLayout {
                spacing: 12px;
                for f in ConfigUi.form: FieldEditor {
                    field: f;
                }
            }
            if ConfigUi.raw-mode: TextArea {
                height: 200px;
                label: @tr("Raw configuration");
                text <=> ConfigUi.raw;
            }
            if ConfigUi.error != "": StatusLine {
                text: ConfigUi.error;
                error: true;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Btn {
                    text: "Save";
                    primary: true;
                    clicked => {
                        ConfigUi.save();
                    }
                }
                Btn {
                    text: "Discard";
                    clicked => {
                        ConfigUi.close-editor();
                    }
                }
                if !ConfigUi.is-new: Btn {
                    text: ConfigUi.concept == "mcp" ? "Remove" : "Delete";
                    clicked => {
                        ConfigUi.remove(ConfigUi.edit-name);
                    }
                }
                if !ConfigUi.is-new && ConfigUi.agent != "harness" && (ConfigUi.concept == "mcp" || ConfigUi.concept == "skill"): Btn {
                    text: "Copy to Harness";
                    clicked => {
                        ConfigUi.copy-to-harness(ConfigUi.edit-name);
                    }
                }
            }
        }
    }
}

// ---- lists ---------------------------------------------------------------------------------------------------

// Row background (design: even rows #16181C, odd transparent; hover / selected = raised).
component RowBg inherits Rectangle {
    in property <int> index;
    in property <bool> selected;
    in property <bool> clickable: true;
    callback clicked;
    background: root.selected || (ta.has-hover && root.clickable) ? Theme.surface-hover : (mod(root.index, 2) == 0 ? Theme.surface : Theme.surface.with-alpha(0));
    animate background { duration: Theme.dur-hover; }
    ta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// Caps sub-heading inside a table (built-in vs configured MCP servers).
component GroupRow inherits HorizontalLayout {
    in property <string> text;
    padding-left: 16px;
    padding-right: 16px;
    height: 30px;
    Th {
        text: root.text.to-uppercase();
    }
}

component EmptyBody inherits VerticalLayout {
    padding: 32px;
    spacing: 4px;
    alignment: center;
    Text {
        text: ConfigUi.loading ? @tr("Loading…") : ConfigUi.query != "" ? @tr("No matches") : @tr("Nothing configured yet");
        font-size: 13px;
        color: Theme.foreground-subtle;
        horizontal-alignment: center;
    }
    Text {
        text: ConfigUi.query != "" ? @tr("Try another search.") : Labels.new-label(ConfigUi.concept);
        font-size: 11px;
        color: Theme.icon-subtlest;
        horizontal-alignment: center;
    }
}

// MCP: SERVER 190 · TYPE 90 · STATUS 130 · TOOLS 80 · COMMAND / URL 296 · ON 60 (design S10).
component McpTable inherits DCard {
    VerticalLayout {
        CardHead {
            title: "Servers";
            sub: "stdio and http transports";
        }
        Hairline { }
        VerticalLayout {
            padding-top: 4px;
            HorizontalLayout {
                height: 30px;
                padding-left: 16px;
                padding-right: 16px;
                Th { width: 190px; text: "SERVER"; }
                Th { width: 90px; text: "TYPE"; }
                Th { width: 130px; text: "STATUS"; }
                Th { width: 80px; text: "TOOLS"; }
                Th { horizontal-stretch: 1; text: "COMMAND / URL"; }
                Th { width: 60px; text: "ON"; horizontal-alignment: right; }
            }
            Hairline { }
        }
        VerticalLayout {
            padding-bottom: 8px;
            if ConfigUi.rows.length == 0: EmptyBody { }
            for r[i] in ConfigUi.rows: VerticalLayout {
                if r.group != "" && (i == 0 || ConfigUi.rows[i - 1].group != r.group): GroupRow {
                    text: r.group;
                }
                RowBg {
                    index: i;
                    height: 46px;
                    selected: ConfigUi.editing && !ConfigUi.is-new && ConfigUi.edit-name == r.name;
                    clickable: !r.builtin;
                    clicked => {
                        ConfigUi.edit(r.name);
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            width: 190px;
                            text: r.name;
                            font-size: 12px;
                            color: r.enabled ? Theme.foreground : Theme.foreground-subtlest;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Muted {
                            width: 90px;
                            text: r.detail;
                        }
                        HorizontalLayout {
                            width: 130px;
                            spacing: 6px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Dot {
                                    tint: r.builtin ? Theme.accent-fg : r.enabled ? Theme.success : Theme.icon-subtlest;
                                }
                            }
                            Text {
                                text: r.builtin ? "Built-in" : r.enabled ? "Enabled" : "Disabled";
                                font-size: 11px;
                                color: r.builtin ? Theme.accent-fg : r.enabled ? Theme.success : Theme.icon-subtlest;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            width: 80px;
                            text: "—";
                            font-size: 11px;
                            color: Theme.icon-subtlest;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: r.summary;
                            font-size: 11px;
                            color: Theme.icon-subtlest;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            width: 60px;
                            alignment: end;
                            if r.toggleable && !r.builtin: VerticalLayout {
                                alignment: center;
                                Switch {
                                    label: @tr("Enable {0}", r.name);
                                    checked: r.enabled;
                                    enabled: ConfigUi.can-disable;
                                    toggled(on) => {
                                        ConfigUi.toggle(r.name, on);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Subagents: NAME 200 · MODEL 150 · TOOLS 190 · CONCURRENCY 130 · ENABLED 90 (design S9).
component SubagentTable inherits DCard {
    VerticalLayout {
        CardHead {
            title: "Definitions";
            sub: "Available to the orchestrator";
        }
        Hairline { }
        VerticalLayout {
            padding-top: 4px;
            HorizontalLayout {
                height: 30px;
                padding-left: 16px;
                padding-right: 16px;
                Th { width: 200px; text: "NAME"; }
                Th { width: 150px; text: "MODEL"; }
                Th { width: 190px; text: "TOOLS"; }
                Th { width: 130px; text: "CONCURRENCY"; }
                Th { horizontal-stretch: 1; text: "ENABLED"; horizontal-alignment: right; }
            }
            Hairline { }
        }
        VerticalLayout {
            padding-bottom: 8px;
            if ConfigUi.rows.length == 0: EmptyBody { }
            for r[i] in ConfigUi.rows: RowBg {
                index: i;
                height: 56px;
                selected: ConfigUi.editing && !ConfigUi.is-new && ConfigUi.edit-name == r.name;
                clicked => {
                    ConfigUi.edit(r.name);
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    VerticalLayout {
                        width: 200px;
                        alignment: center;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 7px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Dot {
                                    tint: AgentDot.color-of(ConfigUi.agent);
                                }
                            }
                            Text {
                                text: r.name;
                                font-size: 12px;
                                color: Theme.foreground;
                                overflow: elide;
                            }
                        }
                        Text {
                            width: 186px;
                            text: r.summary;
                            font-size: 11px;
                            color: Theme.icon-subtlest;
                            overflow: elide;
                        }
                    }
                    Text {
                        width: 150px;
                        text: r.detail != "" ? r.detail : "inherit";
                        font-size: 12px;
                        color: Theme.foreground-subtle;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        width: 190px;
                        padding-right: 14px;
                        Muted {
                            text: r.extra != "" ? r.extra : "all tools";
                        }
                    }
                    Muted {
                        width: 130px;
                        text: "—";
                    }
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        if r.toggleable: VerticalLayout {
                            alignment: center;
                            Switch {
                                label: @tr("Enable {0}", r.name);
                                checked: r.enabled;
                                enabled: ConfigUi.can-disable;
                                toggled(on) => {
                                    ConfigUi.toggle(r.name, on);
                                }
                            }
                        }
                        if !r.toggleable: Muted {
                            text: "always";
                        }
                    }
                }
            }
        }
    }
}

// Commands: COMMAND 170 · DESCRIPTION 400 · SOURCE 120 · ARGS 110 (design S12).
component CommandTable inherits DCard {
    VerticalLayout {
        CardHead {
            title: "Slash commands";
            sub: "Built-in commands cannot be edited";
        }
        Hairline { }
        VerticalLayout {
            padding-top: 4px;
            HorizontalLayout {
                height: 30px;
                padding-left: 16px;
                padding-right: 16px;
                Th { width: 170px; text: "COMMAND"; }
                Th { width: 400px; text: "DESCRIPTION"; }
                Th { width: 120px; text: "SOURCE"; }
                Th { horizontal-stretch: 1; text: "ARGS"; horizontal-alignment: right; }
            }
            Hairline { }
        }
        VerticalLayout {
            padding-bottom: 8px;
            if ConfigUi.rows.length == 0: EmptyBody { }
            for r[i] in ConfigUi.rows: RowBg {
                index: i;
                height: 46px;
                selected: ConfigUi.editing && !ConfigUi.is-new && ConfigUi.edit-name == r.name;
                clickable: !r.builtin;
                clicked => {
                    ConfigUi.edit(r.name);
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text {
                        width: 170px;
                        text: "/" + r.name;
                        font-size: 12px;
                        color: Theme.accent-fg;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        width: 400px;
                        padding-right: 16px;
                        Text {
                            text: r.summary;
                            font-size: 12px;
                            color: Theme.foreground-subtle;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        width: 120px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Pill {
                                small: true;
                                text: r.builtin ? "built-in" : ConfigCopy.scope-name(r.scope);
                                tint: r.builtin ? Theme.foreground-subtlest : ConfigCopy.scope-tint(r.scope);
                            }
                        }
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: r.detail != "" ? r.detail : "—";
                        font-size: 11px;
                        color: Theme.icon-subtlest;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

// Skills: 3-column card grid (design S11: cards 285 wide, gap 12, pad [12,14], radius 10).
component SkillCard inherits Rectangle {
    in property <ResRow> item;
    in property <bool> selected;
    background: ta.has-hover || root.selected ? Theme.surface : Theme.card;
    border-width: 1px;
    border-color: root.selected ? Theme.border-hover : Theme.border;
    border-radius: 10px;
    animate background { duration: Theme.dur-hover; }
    ta := TouchArea {
        enabled: !root.item.builtin;
        mouse-cursor: pointer;
        clicked => {
            ConfigUi.edit(root.item.name);
        }
    }
    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        HorizontalLayout {
            height: 18px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 7px;
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    Dot {
                        tint: root.item.enabled ? Theme.accent-fg : Theme.foreground-subtlest;
                    }
                }
                Text {
                    text: root.item.name;
                    font-size: 12px;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            if root.item.toggleable: Switch {
                label: @tr("Enable {0}", root.item.name);
                checked: root.item.enabled;
                enabled: ConfigUi.can-disable;
                toggled(on) => {
                    ConfigUi.toggle(root.item.name, on);
                }
            }
        }
        Text {
            text: root.item.summary != "" ? root.item.summary : "No description";
            font-size: 11px;
            color: Theme.foreground-subtlest;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 6px;
            height: 16px;
            Pill {
                small: true;
                text: root.item.builtin ? "built-in" : ConfigCopy.scope-name(root.item.scope);
                tint: ConfigCopy.scope-tint(root.item.scope);
            }
            Text {
                text: root.item.path;
                font-size: 10px;
                color: Theme.icon-subtlest;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}

component SkillGrid inherits Rectangle {
    property <length> cell-w: (self.width - 24px) / 3;
    property <length> cell-h: 89px;
    property <int> row-count: ceil(ConfigUi.rows.length / 3);
    height: ConfigUi.rows.length == 0 ? 120px : root.row-count * root.cell-h + (root.row-count - 1) * 12px;
    if ConfigUi.rows.length == 0: DCard {
        width: root.width;
        height: 120px;
        EmptyBody { }
    }
    for r[i] in ConfigUi.rows: SkillCard {
        x: mod(i, 3) * (root.cell-w + 12px);
        y: floor(i / 3) * (root.cell-h + 12px);
        width: root.cell-w;
        height: root.cell-h;
        item: r;
        selected: ConfigUi.editing && !ConfigUi.is-new && ConfigUi.edit-name == r.name;
    }
}

// Hooks: one card per event (design S13: head = event + "N hooks" + active pill; rows = matcher pill,
// command chip, ✕).
component HookRow inherits Rectangle {
    in property <ResRow> item;
    height: 40px;
    background: ta.has-hover || (ConfigUi.editing && !ConfigUi.is-new && ConfigUi.edit-name == root.item.name) ? Theme.surface-hover.with-alpha(0.6) : Theme.surface.with-alpha(0);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            ConfigUi.edit(root.item.name);
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        HorizontalLayout {
            width: 140px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Pill {
                    text: root.item.detail != "" ? root.item.detail : ".*";
                    tint: Theme.info;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Rectangle {
                height: 23px;
                border-radius: 6px;
                background: Theme.surface;
                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: root.item.extra;
                    font-size: 11px;
                    font-family: Theme.mono-font;
                    color: Theme.foreground-subtle;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        Rectangle {
            width: 16px;
            xt := Text {
                text: "✕"; font-family: "Segoe UI Symbol";
                font-size: 11px;
                color: xa.has-hover ? Theme.destructive : Theme.icon-subtlest;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            xa := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    ConfigUi.remove(root.item.name);
                }
            }
        }
    }
}

component HookCards inherits VerticalLayout {
    spacing: 20px;
    if ConfigUi.groups.length == 0: DCard {
        EmptyBody { }
    }
    for g in ConfigUi.groups: DCard {
        VerticalLayout {
            CardHead {
                title: g.name;
                sub: g.count == 1 ? "1 hook" : g.count + " hooks";
                VerticalLayout {
                    alignment: center;
                    Pill {
                        text: "active";
                        tint: Theme.success;
                    }
                }
            }
            Hairline { }
            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 8px;
                for r in ConfigUi.rows: VerticalLayout {
                    if r.group == g.name: HookRow {
                        item: r;
                    }
                }
            }
        }
    }
}

// ---- config page ---------------------------------------------------------------------------------------------

export component ConfigPage inherits VerticalLayout {
    in property <bool> stacked;
    property <string> concept: ConfigUi.concept;
    spacing: 20px;
    PageHeader {
        title: ConfigCopy.title(root.concept);
        description: ConfigCopy.subtitle(root.concept);
    }
    TargetBar {
        agent: ConfigUi.agent;
        scope: ConfigUi.scope;
        with-harness: root.concept == "mcp" || root.concept == "skill";
        with-scope: ConfigUi.agent != "harness";
        select-agent(id) => {
            ConfigUi.select-agent(id);
        }
        select-scope(id) => {
            ConfigUi.select-scope(id);
        }
    }
    if !ConfigUi.supported || !ConfigUi.scope-supported: UnsupportedNotice {
        title: !ConfigUi.supported ? @tr("{0} does not support {1}", Labels.agent-name(ConfigUi.agent), Labels.concept-title(ConfigUi.concept)) : @tr("{0} has no workspace {1}", Labels.agent-name(ConfigUi.agent), Labels.concept-title(ConfigUi.concept));
        reason: ConfigUi.reason;
    }
    if ConfigUi.supported && ConfigUi.scope-supported: VerticalLayout {
        spacing: 20px;
        // Toolbar (design: 34 tall; count + pills on the left, actions right; Skills: search + New).
        HorizontalLayout {
            height: 34px;
            spacing: 8px;
            if root.concept == "skill": SearchField {
                height: 34px;
                placeholder: "Search " + ConfigUi.rows.length + " skills…";
                text <=> ConfigUi.query;
                edited(q) => {
                    ConfigUi.search(q);
                }
            }
            if root.concept != "skill": HorizontalLayout {
                spacing: 8px;
                alignment: start;
                horizontal-stretch: 1;
                Text {
                    text: root.concept == "mcp" ? ConfigUi.rows.length + " servers" : root.concept == "subagent" ? ConfigUi.rows.length + " definitions" : root.concept == "command" ? ConfigUi.rows.length + " commands" : ConfigUi.groups.length + " events";
                    font-size: 12px;
                    color: Theme.foreground-subtlest;
                    vertical-alignment: center;
                }
                if root.concept == "hook": Text {
                    text: "·";
                    font-size: 12px;
                    color: Theme.icon-subtlest;
                    vertical-alignment: center;
                }
                if root.concept == "hook": Text {
                    text: ConfigUi.rows.length + " hooks";
                    font-size: 12px;
                    color: Theme.foreground-subtlest;
                    vertical-alignment: center;
                }
                if root.concept == "subagent": VerticalLayout {
                    alignment: center;
                    Pill {
                        text: "max " + SettingsUi.get-int("orchestra.maxConcurrent", SettingsUi.rev) + " concurrent";
                        tint: Theme.warning;
                    }
                }
                if root.concept == "mcp" || root.concept == "command": VerticalLayout {
                    alignment: center;
                    Pill {
                        text: ConfigUi.agent == "harness" ? "built-in + configured" : ConfigCopy.scope-name(ConfigUi.scope) + " scope";
                        tint: Theme.info;
                    }
                }
            }
            if ConfigUi.agent == "harness" && root.concept == "mcp": VerticalLayout {
                alignment: center;
                ImportButton { }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    text: ConfigCopy.new-label(root.concept);
                    label: Labels.new-label(root.concept);
                    primary: true;
                    clicked => {
                        ConfigUi.create();
                    }
                }
            }
        }
        // A new entry opens its card right under the toolbar so it is visible on long lists.
        if ConfigUi.editing && ConfigUi.is-new: DetailCard { }
        if root.concept == "mcp": McpTable { }
        if root.concept == "subagent": SubagentTable { }
        if root.concept == "command": CommandTable { }
        if root.concept == "skill": SkillGrid { }
        if root.concept == "hook": HookCards { }
        if ConfigUi.editing && !ConfigUi.is-new: DetailCard { }
    }
}

// ---- instructions / memory -----------------------------------------------------------------------------------

// Line-numbered code editor (design S7 "Editor body": gutter 44 with numbers 12 #6B717C right-aligned at 34,
// code 12 #C9CCD2, pad [14,0,16,0]).
component CodeEditor inherits Rectangle {
    in-out property <string> text;
    in property <int> lines: 1;
    in property <string> label;
    callback edited(string);
    property <length> line-h: probe.preferred-height;
    clip: true;
    probe := Text {
        visible: false;
        text: "0";
        font-size: 12px;
        font-family: Theme.mono-font;
    }
    sv := ScrollView {
        width: parent.width;
        height: parent.height;
        content-height: max(self.visible-height, ed.preferred-height + 30px);
        content-width: max(self.visible-width, ed.preferred-width + 60px);
        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => {
                ed.focus();
            }
        }
        for i in root.lines: Text {
            x: 0;
            y: 14px + i * root.line-h;
            width: 34px;
            height: root.line-h;
            text: i + 1;
            font-size: 12px;
            font-family: Theme.mono-font;
            color: Theme.icon-subtlest;
            horizontal-alignment: right;
            accessible-role: none;
        }
        ed := TextInput {
            x: 44px;
            y: 14px;
            width: max(sv.visible-width - 58px, self.preferred-width);
            text <=> root.text;
            single-line: false;
            wrap: no-wrap;
            color: Theme.foreground-subtle;
            font-size: 12px;
            font-family: Theme.mono-font;
            selection-background-color: Theme.text-selection;
            accessible-label: root.label;
            edited => {
                root.edited(self.text);
            }
        }
    }
}

// Scope tab (design S7 "Scope tabs": 13px text, active #EDEEF0, inactive #8A909A, 30 tall).
component ScopeTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback picked;
    height: 30px;
    preferred-width: t.preferred-width;
    horizontal-stretch: 0;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => {
        root.picked();
    }
    t := Text {
        text: root.text;
        font-size: 13px;
        color: root.active || ta.has-hover ? Theme.foreground : Theme.foreground-subtlest;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }
}

component InstructionsBody inherits VerticalLayout {
    spacing: 20px;
    // Scope tabs + underline.
    HorizontalLayout {
        spacing: 18px;
        alignment: start;
        ScopeTab {
            text: DocUi.scope == "user" && DocUi.file-name != "" ? "Global · " + DocUi.file-name : "Global";
            active: DocUi.scope == "user";
            picked => {
                DocUi.select-scope("user");
            }
        }
        ScopeTab {
            text: DocUi.scope == "workspace" && DocUi.file-name != "" ? "Project · " + DocUi.file-name : "Project";
            active: DocUi.scope == "workspace";
            picked => {
                DocUi.select-scope("workspace");
            }
        }
    }
    Hairline { }
    if !DocUi.supported: UnsupportedNotice {
        title: @tr("{0} has no instructions file for this scope", Labels.agent-name(DocUi.agent));
        reason: DocUi.error;
    }
    if DocUi.supported: DCard {
        VerticalLayout {
            // Editor bar: file + unsaved chip | Discard + Write changes.
            HorizontalLayout {
                height: 42px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    horizontal-stretch: 1;
                    Text {
                        text: DocUi.file-name != "" ? DocUi.file-name : DocUi.path;
                        font-size: 12px;
                        color: Theme.foreground-subtle;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if !DocUi.exists: VerticalLayout {
                        alignment: center;
                        Pill {
                            text: "new file";
                            tint: Theme.info;
                        }
                    }
                    if DocUi.dirty: VerticalLayout {
                        alignment: center;
                        Pill {
                            text: (DocUi.added + DocUi.removed) + " unsaved";
                            tint: Theme.warning;
                        }
                    }
                    Text {
                        text: DocUi.path;
                        font-size: 11px;
                        color: Theme.icon-subtlest;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                Btn {
                    compact: true;
                    text: "Discard";
                    enabled: DocUi.dirty;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        DocUi.revert();
                    }
                }
                Btn {
                    compact: true;
                    primary: true;
                    text: "Write changes";
                    y: (parent.height - self.height) / 2;
                    label: @tr("Save instructions");
                    enabled: DocUi.dirty && DocUi.bytes <= DocUi.limit;
                    clicked => {
                        DocUi.save();
                    }
                }
            }
            Hairline { }
            CodeEditor {
                height: 240px;
                label: @tr("Instructions content");
                lines: DocUi.line-count;
                text <=> DocUi.text;
                edited(v) => {
                    DocUi.edited(v);
                }
            }
        }
    }
    if DocUi.supported && DocUi.dirty: DCard {
        VerticalLayout {
            HorizontalLayout {
                height: 40px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    horizontal-stretch: 1;
                    Text {
                        text: "Changes";
                        font-size: 12px;
                        color: Theme.foreground-subtle;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "+" + DocUi.added + " −" + DocUi.removed;
                        font-size: 11px;
                        color: Theme.foreground-subtlest;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "against saved version";
                    font-size: 11px;
                    color: Theme.icon-subtlest;
                    vertical-alignment: center;
                }
            }
            Hairline { }
            VerticalLayout {
                padding-top: 6px;
                padding-bottom: 8px;
                spacing: 1px;
                for d in DocUi.changes: Rectangle {
                    height: 22px;
                    background: (d.kind == 1 ? Theme.success : Theme.destructive).with-alpha(0.12);
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        Text {
                            width: 8px;
                            text: d.kind == 1 ? "+" : "-";
                            font-size: 12px;
                            font-family: Theme.mono-font;
                            color: d.kind == 1 ? Theme.success : Theme.destructive;
                            vertical-alignment: center;
                        }
                        Text {
                            text: d.text;
                            font-size: 12px;
                            font-family: Theme.mono-font;
                            color: d.kind == 1 ? Theme.success : Theme.destructive;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
    if DocUi.supported && (DocUi.error != "" || DocUi.saved != ""): StatusLine {
        text: DocUi.error != "" ? DocUi.error : DocUi.saved;
        error: DocUi.error != "";
    }
    if DocUi.supported && DocUi.bytes > DocUi.limit: StatusLine {
        text: @tr("{0} / {1} KB — over the size budget", round(DocUi.bytes / 102.4) / 10, DocUi.limit / 1024);
        error: true;
    }
    Text {
        text: "Instructions are injected at the top of the system prompt for every session in this project.";
        font-size: 11px;
        color: Theme.icon-subtlest;
        wrap: word-wrap;
    }
}

// Memory entry row (design S8 "mem n": pad [10,12], gap 5, radius 8; selected = raised fill, title #EDEEF0).
component MemoryRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    callback picked;
    height: 54px;
    border-radius: 8px;
    background: root.selected ? Theme.surface-hover : (ta.has-hover ? Theme.hover : Theme.hover.with-alpha(0));
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }
    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 5px;
        HorizontalLayout {
            spacing: 8px;
            height: 16px;
            Text {
                text: root.title;
                font-size: 12px;
                color: root.selected ? Theme.foreground : Theme.foreground-subtle;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Pill {
                small: true;
                text: DocUi.scope == "workspace" ? "Project" : "Global";
                tint: DocUi.scope == "workspace" ? Theme.accent-fg : Theme.info;
            }
        }
        Text {
            text: root.detail;
            font-size: 11px;
            color: Theme.foreground-subtlest;
            overflow: elide;
        }
    }
}

component MemoryBody inherits VerticalLayout {
    in property <bool> memory-enabled;
    callback set-memory-enabled(bool);
    spacing: 20px;
    // Toolbar: search + New memory.
    HorizontalLayout {
        height: 34px;
        spacing: 8px;
        SearchField {
            height: 34px;
            placeholder: "Search memory…";
            text <=> DocUi.query;
            edited(q) => {
                DocUi.search(q);
            }
        }
        VerticalLayout {
            alignment: center;
            Btn {
                text: "+ New memory";
                primary: true;
                clicked => {
                    DocUi.new-entry();
                }
            }
        }
    }
    if !DocUi.supported: UnsupportedNotice {
        title: @tr("Memory is not available for this scope");
        reason: DocUi.error;
    }
    if DocUi.supported: HorizontalLayout {
        spacing: 16px;
        // Entries list.
        DCard {
            width: 336px;
            height: 390px;
            VerticalLayout {
                CardHead {
                    title: "Entries";
                    sub: DocUi.entry-count == 1 ? "1 memory" : DocUi.entry-count + " memories";
                }
                Hairline { }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-top: 6px;
                        padding-bottom: 8px;
                        spacing: 1px;
                        alignment: start;
                        for e in DocUi.entries: MemoryRow {
                            title: e.title;
                            detail: e.detail;
                            selected: e.index == DocUi.selected;
                            picked => {
                                root.selected-title = e.title;
                                DocUi.select-entry(e.index);
                            }
                        }
                        if DocUi.entries.length == 0: Text {
                            height: 54px;
                            text: DocUi.query != "" ? @tr("No matches") : @tr("No memories yet");
                            font-size: 12px;
                            color: Theme.icon-subtlest;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        // Selected entry.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
        DCard {
            horizontal-stretch: 1;
            VerticalLayout {
                CardHead {
                    title: DocUi.selected >= 0 && DocUi.entry-text != "" ? (DocUi.entries.length > 0 ? root.selected-title : "Memory") : "No entry selected";
                    sub: (DocUi.scope == "workspace" ? "Project" : "Global") + " · " + (DocUi.exists ? (DocUi.dirty ? "unsaved changes" : "saved") : "new file");
                    VerticalLayout {
                        alignment: center;
                        Pill {
                            text: DocUi.scope == "workspace" ? "Project" : "Global";
                            tint: DocUi.scope == "workspace" ? Theme.accent-fg : Theme.info;
                        }
                    }
                }
                Hairline { }
                VerticalLayout {
                    padding-top: 14px;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 16px;
                    spacing: 12px;
                    TextArea {
                        height: 94px;
                        label: @tr("Memory content");
                        mono: false;
                        read-only: DocUi.selected < 0;
                        text <=> DocUi.entry-text;
                        edited(v) => {
                            DocUi.entry-edited(v);
                        }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 10px;
                            Muted { width: 70px; text: "Scope"; color: Theme.icon-subtlest; }
                            Muted { text: DocUi.scope == "workspace" ? "Project" : "Global"; color: Theme.foreground-subtle; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Muted { width: 70px; text: "Source"; color: Theme.icon-subtlest; }
                            Muted { text: DocUi.path; color: Theme.foreground-subtle; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Muted { width: 70px; text: "Size"; color: Theme.icon-subtlest; }
                            Muted {
                                text: (round(DocUi.bytes / 102.4) / 10) + " / " + (DocUi.limit / 1024) + " KB";
                                color: DocUi.bytes > DocUi.limit ? Theme.destructive : Theme.foreground-subtle;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if DocUi.error != "" || DocUi.saved != "": StatusLine {
                        text: DocUi.error != "" ? DocUi.error : DocUi.saved;
                        error: DocUi.error != "";
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Btn {
                            text: "Save";
                            label: @tr("Save memory");
                            primary: true;
                            enabled: DocUi.dirty && DocUi.bytes <= DocUi.limit;
                            clicked => {
                                DocUi.save();
                            }
                        }
                        Btn {
                            text: "Discard";
                            enabled: DocUi.dirty;
                            clicked => {
                                DocUi.revert();
                                DocUi.select-entry(DocUi.selected);
                            }
                        }
                        Btn {
                            text: "Delete";
                            enabled: DocUi.selected >= 0;
                            clicked => {
                                DocUi.delete-entry();
                            }
                        }
                    }
                }
            }
        }
        }
    }
    // Not in the design: the existing "Use memory" switch stays, below the designed content.
    Group {
        SettingRow {
            first: true;
            title: @tr("Use memory");
            description: @tr("Give agents the Harness memory MCP server in new sessions.");
            Switch {
                label: @tr("Use memory");
                checked: root.memory-enabled;
                toggled(on) => {
                    root.set-memory-enabled(on);
                }
            }
        }
    }
    // Title of the picked section (set when a row is picked; entries can be filtered so index ≠ position).
    property <string> selected-title: "Memory";
}

// One row of the local memory: kind, text, where it comes from; pin and forget on the right.
component RecallItem inherits Rectangle {
    in property <RecallRow> entry;
    callback pin(bool);
    callback forget;
    property <color> tint: root.entry.kind == "episode" ? Theme.info : root.entry.kind == "preference" ? Theme.accent-fg : root.entry.kind == "decision" ? Theme.warning : Theme.icon-subtle;
    border-radius: 8px;
    background: ta.has-hover ? Theme.hover : Theme.hover.with-alpha(0);
    ta := TouchArea { }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            width: 74px;
            Pill {
                text: root.entry.kind == "episode" ? "session" : root.entry.kind;
                tint: root.tint;
                small: true;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            Text {
                text: root.entry.text;
                font-size: 12px;
                color: Theme.foreground;
                wrap: word-wrap;
            }
            Text {
                text: root.entry.meta;
                font-size: 10.5px;
                color: Theme.icon-subtlest;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: start;
            HorizontalLayout {
                spacing: 6px;
                if root.entry.kind != "episode": Btn {
                    text: root.entry.pinned ? "Pinned" : "Pin";
                    label: root.entry.pinned ? "Unpin memory" : "Pin memory";
                    compact: true;
                    primary: root.entry.pinned;
                    clicked => {
                        root.pin(!root.entry.pinned);
                    }
                }
                Btn {
                    text: "Forget";
                    label: "Forget memory";
                    compact: true;
                    clicked => {
                        root.forget();
                    }
                }
            }
        }
    }
}

// Settings › Memory › Recall: Harness's own local memory, shared by every agent and session.
component RecallBody inherits VerticalLayout {
    spacing: 16px;
    Group {
        SettingRow {
            first: true;
            title: "Recall in new sessions";
            description: "A new session starts with your pinned memories, the memories related to the request and the latest sessions of the project, whichever agent runs it.";
            Switch {
                label: "Recall in new sessions";
                checked: RecallUi.auto-recall;
                toggled(on) => {
                    RecallUi.set-auto-recall(on);
                }
            }
        }
        SettingRow {
            title: "Remember each session";
            description: "When a turn finishes, keep a short digest of the session: what was asked, how it ended, which files changed. Cut from the conversation, no model involved.";
            Switch {
                label: "Remember each session";
                checked: RecallUi.auto-capture;
                toggled(on) => {
                    RecallUi.set-auto-capture(on);
                }
            }
        }
    }
    // Add by hand.
    DCard {
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            Text {
                text: "Remember something";
                font-size: 12.5px;
                font-weight: Theme.weight-semibold;
                color: Theme.foreground;
            }
            TextField {
                height: 34px;
                text <=> RecallUi.draft;
                placeholder: "One fact, preference or decision, in a sentence or two";
                label: "New memory";
                accepted(text) => {
                    RecallUi.add();
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Segmented {
                    options: [
                        { id: "fact", label: "Fact" },
                        { id: "preference", label: "Preference" },
                        { id: "decision", label: "Decision" },
                        { id: "howto", label: "How-to" },
                    ];
                    current: RecallUi.draft-kind;
                    chip-pad: 12px;
                    select(id) => {
                        RecallUi.draft-kind = id;
                    }
                }
                Segmented {
                    options: [{ id: "project", label: "This project" }, { id: "global", label: "Everywhere" }];
                    current: RecallUi.draft-global ? "global" : "project";
                    chip-pad: 12px;
                    select(id) => {
                        RecallUi.draft-global = id == "global";
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        text: "Remember";
                        primary: true;
                        enabled: RecallUi.draft != "";
                        clicked => {
                            RecallUi.add();
                        }
                    }
                }
            }
            if RecallUi.note != "": Text {
                text: RecallUi.note;
                font-size: 11px;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
    }
    HorizontalLayout {
        height: 34px;
        spacing: 8px;
        SearchField {
            height: 34px;
            placeholder: "Search the local memory…";
            text <=> RecallUi.query;
            edited(q) => {
                RecallUi.refresh();
            }
        }
        VerticalLayout {
            alignment: center;
            Segmented {
                options: [{ id: "all", label: "All" }, { id: "memories", label: "Memories" }, { id: "sessions", label: "Sessions" }];
                current: RecallUi.filter;
                chip-pad: 12px;
                select(id) => {
                    RecallUi.filter = id;
                    RecallUi.refresh();
                }
            }
        }
    }
    DCard {
        VerticalLayout {
            CardHead {
                title: "Local memory";
                sub: RecallUi.rows.length == RecallUi.total ? RecallUi.total + " stored" : RecallUi.rows.length + " of " + RecallUi.total + " shown";
            }
            Hairline { }
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                for item in RecallUi.rows: RecallItem {
                    entry: item;
                    pin(on) => {
                        RecallUi.pin(item.id, on);
                    }
                    forget => {
                        RecallUi.forget(item.id);
                    }
                }
                if RecallUi.rows.length == 0: Text {
                    height: 54px;
                    text: RecallUi.query != "" ? "No matches" : "Nothing remembered yet. Agents save memories with the memory_add tool, and every finished session leaves a digest.";
                    font-size: 12px;
                    color: Theme.icon-subtlest;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// The picture of the project graph: nodes coloured by community, sized by their links. Drag to move, Ctrl +
// wheel or the buttons to zoom, click a node to light up its links.
component GraphCanvas inherits Rectangle {
    property <float> zoom: 1;
    property <length> pan-x;
    property <length> pan-y;
    property <length> grab-x;
    property <length> grab-y;
    pure function tone(i: int) -> color {
        if i < 0 { return #8a909a; }
        if mod(i, 8) == 0 { return #c8f04a; }
        if mod(i, 8) == 1 { return #6aa8ff; }
        if mod(i, 8) == 2 { return #ff9d5c; }
        if mod(i, 8) == 3 { return #b58cff; }
        if mod(i, 8) == 4 { return #4fd1c5; }
        if mod(i, 8) == 5 { return #ff7a90; }
        if mod(i, 8) == 6 { return #f2c94c; }
        return #9fb3c8;
    }
    function set-zoom(next: float) {
        root.zoom = clamp(next, 0.6, 4);
    }
    height: 440px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.dark ? #0a0b0d : #f7f6f2;
    clip: true;
    // Behind the nodes: drag pans, the wheel zooms, a click on empty space clears the selection.
    TouchArea {
        mouse-cursor: self.pressed ? grabbing : grab;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.grab-x = root.pan-x - self.mouse-x;
                root.grab-y = root.pan-y - self.mouse-y;
            }
        }
        moved => {
            if self.pressed {
                root.pan-x = root.grab-x + self.mouse-x;
                root.pan-y = root.grab-y + self.mouse-y;
            }
        }
        clicked => {
            GraphUi.view-select(-1);
        }
        scroll-event(event) => {
            // Ctrl + wheel zooms; the plain wheel is left to the page, so the canvas does not trap scrolling.
            if event.modifiers.control {
                root.set-zoom(root.zoom * (event.delta-y > 0 ? 1.15 : 0.87));
                return accept;
            }
            reject
        }
    }
    stage := Rectangle {
        x: (parent.width - self.width) / 2 + root.pan-x;
        y: (parent.height - self.height) / 2 + root.pan-y;
        width: parent.width * root.zoom;
        height: parent.height * root.zoom;
        // A Path keeps its aspect ratio inside its element; the nodes use the same fit, so they sit on the
        // ends of the links at any size. The box is 1000 × 532 (`graph_view.rs`).
        property <float> fit: min(self.width / 1000px, self.height / 532px);
        property <length> left: (self.width - 1000px * self.fit) / 2;
        property <length> top: (self.height - 532px * self.fit) / 2;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 1000;
            viewbox-height: 532;
            commands: GraphUi.view-links;
            stroke: Theme.dark ? #ffffff24 : #1a1b1d24;
            stroke-width: 1px;
            fill: transparent;
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 1000;
            viewbox-height: 532;
            commands: GraphUi.view-focus;
            stroke: Theme.accent-fg;
            stroke-width: 1.6px;
            fill: transparent;
        }
        for n[i] in GraphUi.view-nodes: dot := Rectangle {
            property <length> r: clamp(3px + sqrt(n.degree) * 1.2px, 4px, 15px);
            property <bool> lit: GraphUi.view-selected == i || nta.has-hover;
            x: stage.left + n.x * 1000px * stage.fit - self.r;
            y: stage.top + n.y * 532px * stage.fit - self.r;
            width: self.r * 2;
            height: self.r * 2;
            border-radius: self.r;
            background: root.tone(n.tone);
            border-width: self.lit ? 2px : 0px;
            border-color: Theme.foreground;
            opacity: GraphUi.view-selected < 0 || self.lit || n.named ? 1 : 0.55;
            accessible-role: button;
            accessible-label: "graph node " + n.label;
            accessible-action-default => {
                GraphUi.view-select(i);
            }
            nta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    GraphUi.view-select(i);
                }
            }
            if n.named || dot.lit: Text {
                x: dot.width + 4px;
                y: (dot.height - self.height) / 2;
                text: n.label;
                font-size: dot.lit ? 11.5px : 10.5px;
                font-weight: dot.lit ? 600 : 400;
                color: dot.lit ? Theme.foreground : Theme.foreground-subtle;
                accessible-role: none;
            }
        }
    }
    // Zoom buttons.
    HorizontalLayout {
        x: 10px;
        y: parent.height - 38px;
        width: 108px;
        height: 28px;
        spacing: 6px;
        Btn {
            text: "−";
            label: "Zoom out";
            compact: true;
            clicked => {
                root.set-zoom(root.zoom * 0.8);
            }
        }
        Btn {
            text: "+";
            label: "Zoom in";
            compact: true;
            clicked => {
                root.set-zoom(root.zoom * 1.25);
            }
        }
        Btn {
            text: "Fit";
            label: "Fit the graph";
            compact: true;
            clicked => {
                root.zoom = 1;
                root.pan-x = 0px;
                root.pan-y = 0px;
            }
        }
    }
    Text {
        x: parent.width - self.width - 12px;
        y: parent.height - 24px;
        text: GraphUi.view-note;
        font-size: 10.5px;
        color: Theme.icon-subtlest;
    }
}

// Settings › Memory › Graph: build and share the project's Graphify knowledge graph.
component GraphBody inherits VerticalLayout {
    spacing: 16px;
    Group {
        SettingRow {
            first: true;
            title: "Give agents the project graph";
            description: "When the project has a Graphify graph, a new session is told about it and, with graphify-mcp installed, gets its tools (query_graph, get_neighbors, shortest_path…), whichever agent runs it.";
            Switch {
                label: "Give agents the project graph";
                checked: GraphUi.give-agents;
                toggled(on) => {
                    GraphUi.set-give-agents(on);
                }
            }
        }
    }
    DCard {
        VerticalLayout {
            CardHead {
                title: "Graphify";
                sub: GraphUi.installed ? GraphUi.cli-path : "not installed";
            }
            Hairline { }
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                if !GraphUi.installed: VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Graphify turns a project into a knowledge graph an agent can query instead of grepping. It is a separate tool (Python, Apache-2.0): install it once, then build the graph here.";
                        font-size: 12px;
                        color: Theme.foreground-subtle;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 32px;
                        border-radius: 8px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        Text {
                            x: 12px;
                            width: parent.width - 24px;
                            text: GraphUi.install-command;
                            font-family: Theme.mono-font;
                            font-size: 11.5px;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                if GraphUi.installed: Text {
                    text: GraphUi.has-graph ? GraphUi.summary : "No graph for this project yet. Building reads the code with tree-sitter on this computer: no model, no API key.";
                    font-size: 12px;
                    color: GraphUi.has-graph ? Theme.foreground : Theme.foreground-subtle;
                    wrap: word-wrap;
                }
                if GraphUi.installed && !GraphUi.mcp: Text {
                    text: "graphify-mcp was not found, so agents are only pointed at the graph's files and the graphify command. For the query tools: " + GraphUi.install-command;
                    font-size: 11px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                Text {
                    text: GraphUi.project;
                    font-family: Theme.mono-font;
                    font-size: 10.5px;
                    color: Theme.icon-subtlest;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    if !GraphUi.installed && GraphUi.installer != "": Btn {
                        text: GraphUi.busy ? "Installing…" : "Install with " + GraphUi.installer;
                        primary: true;
                        enabled: !GraphUi.busy;
                        clicked => {
                            GraphUi.install();
                        }
                    }
                    if GraphUi.installed: Btn {
                        text: GraphUi.busy ? "Working…" : GraphUi.has-graph ? "Update graph" : "Build graph";
                        primary: true;
                        enabled: !GraphUi.busy;
                        clicked => {
                            GraphUi.build();
                        }
                    }
                    if GraphUi.has-html: Btn {
                        text: "Open graph";
                        clicked => {
                            GraphUi.open-html();
                        }
                    }
                    if GraphUi.has-report: Btn {
                        text: "Open report";
                        clicked => {
                            GraphUi.open-report();
                        }
                    }
                    Btn {
                        text: "Check again";
                        enabled: !GraphUi.busy;
                        clicked => {
                            GraphUi.refresh();
                        }
                    }
                }
                if GraphUi.note != "": Text {
                    text: GraphUi.note;
                    font-size: 11px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                if GraphUi.log != "": Rectangle {
                    border-radius: 8px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 10px;
                        Text {
                            text: GraphUi.log;
                            font-family: Theme.mono-font;
                            font-size: 10.5px;
                            color: Theme.foreground-subtle;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
    if GraphUi.view-nodes.length > 0: VerticalLayout {
        spacing: 8px;
        GraphCanvas { }
        Text {
            text: GraphUi.view-detail != "" ? GraphUi.view-detail : "Click a node to see what it connects to. Drag to move, Ctrl + wheel or the buttons to zoom. Colours are the graph's communities.";
            font-size: 11.5px;
            color: GraphUi.view-detail != "" ? Theme.foreground : Theme.muted;
            wrap: word-wrap;
        }
    }
}

// Instructions (CLAUDE.md / AGENTS.md / GEMINI.md) and Memory (MEMORY.md): one document per target.
export component DocPage inherits VerticalLayout {
    in property <bool> stacked;
    in property <bool> memory-enabled;
    callback set-memory-enabled(bool);
    // Memory page: a tab that is not a MEMORY.md document: "recall" (Harness's own local memory) or "graph"
    // (the project's Graphify graph); "" = the document of the picked scope.
    property <string> extra: "";
    spacing: 20px;
    PageHeader {
        title: DocUi.kind == "memory" ? "Memory" : "Instructions";
        description: DocUi.kind == "memory" ? "Durable facts Harness remembers across sessions. Scoped to a project or shared globally." : "Project instructions steers every session in this workspace. Global instructions apply to all projects.";
    }
    // Instructions: agent switcher. Memory is Harness-wide, so its switcher picks the scope instead.
    if DocUi.kind == "instructions": TargetBar {
        agent: DocUi.agent;
        scope: DocUi.scope;
        with-scope: false;
        select-agent(id) => {
            DocUi.select-agent(id);
        }
    }
    if DocUi.kind == "memory": HorizontalLayout {
        alignment: start;
        ChipBar {
            AgentChip {
                agent-id: "harness";
                dot: Theme.info;
                text: "Global";
                active: root.extra == "" && DocUi.scope == "user";
                picked => {
                    root.extra = "";
                    DocUi.select-scope("user");
                }
            }
            AgentChip {
                agent-id: "harness";
                dot: Theme.accent-fg;
                text: "Project";
                active: root.extra == "" && DocUi.scope == "workspace";
                picked => {
                    root.extra = "";
                    DocUi.select-scope("workspace");
                }
            }
            AgentChip {
                agent-id: "harness";
                dot: Theme.warning;
                text: "Recall";
                active: root.extra == "recall";
                picked => {
                    root.extra = "recall";
                    RecallUi.refresh();
                }
            }
            AgentChip {
                agent-id: "harness";
                dot: Theme.agent-agy;
                text: "Graph";
                active: root.extra == "graph";
                picked => {
                    root.extra = "graph";
                    GraphUi.refresh();
                }
            }
        }
    }
    if DocUi.kind == "instructions": InstructionsBody { }
    if DocUi.kind == "memory" && root.extra == "recall": RecallBody { }
    if DocUi.kind == "memory" && root.extra == "graph": GraphBody { }
    if DocUi.kind == "memory" && root.extra == "": MemoryBody {
        memory-enabled: root.memory-enabled;
        set-memory-enabled(on) => {
            root.set-memory-enabled(on);
        }
    }
}
