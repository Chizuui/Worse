// Agents page (design frames "02 · Settings — Agents" and "03 · Settings — Agents · API Providers"):
// page header + rule, sub-tabs Agents / API Providers. Agents: one card per agent CLI (status pill, enable toggle,
// MODE segmented + MODEL select, accounts chips for agy / Claude). API Providers: configured custom providers and the
// fallback order. Every control stays wired to AgentsUi / the shell's fallback callbacks.
import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, Button, IconButton, Divider, Dialog, Spinner } from "../components/controls.slint";
import { AgentsUi, AgentCard, ProviderPreset } from "globals.slint";
import { Select, TextField, TextArea, Switch } from "parts.slint";
import { SetupUi } from "../setup.slint";
import { AgentLogo, AgentMark } from "../components/agent_logo.slint";

export struct FallbackRow {
    id: string,
    name: string,
    // 0 available, 1 not installed, 2 limit reached, 3 adapter missing (§9.10)
    state: int,
}

// ---- design palette (literal where tokens.slint has no exact match) ----
global AgentsLook {
    out property <color> rule: #1E2025;
    out property <color> seg-bg: #0E1013;
    out property <color> seg-on-text: Theme.accent-fg;
    out property <color> drag: #4A4F58;
    pure public function color-of(id: string) -> color {
        if id == "claude-code" { return Theme.agent-claude; }
        if id == "codex" { return Theme.agent-codex; }
        if id == "harness" { return Theme.agent-deepseek; }
        if id == "agy" { return Theme.agent-agy; }
        if id == "gemini" { return Theme.agent-gemini; }
        return Theme.accent-fg;
    }
    // Initial colour on the tile (design: dark ink on the light Codex / Gemini tiles).
    pure public function ink-of(id: string) -> color {
        if id == "codex" { return #08130D; }
        if id == "gemini" { return #06131A; }
        return #FFFFFF;
    }
    pure public function initial-of(id: string) -> string {
        if id == "claude-code" { return "C"; }
        if id == "codex" { return "X"; }
        if id == "harness" { return "D"; }
        if id == "agy" { return "A"; }
        if id == "gemini" { return "G"; }
        return "?";
    }
    pure public function vendor-of(id: string) -> string {
        if id == "claude-code" { return "Anthropic"; }
        if id == "codex" { return "OpenAI"; }
        if id == "harness" { return "DeepSeek"; }
        if id == "agy" { return "agy"; }
        if id == "gemini" { return "Google"; }
        return "";
    }
    // Provider tile (design frame 03): known vendors get their colour, anything else the custom purple.
    pure public function provider-color(label: string) -> color {
        if label.to-lowercase() == "anthropic" { return Theme.agent-claude; }
        if label.to-lowercase() == "openai" { return #E6E8EB; }
        if label.to-lowercase() == "deepseek" { return Theme.agent-deepseek; }
        if label.to-lowercase() == "openrouter" { return #9AA3B2; }
        return Theme.agent-agy;
    }
    pure public function provider-initial(label: string) -> string {
        if label.to-lowercase() == "anthropic" { return "A"; }
        if label.to-lowercase() == "openai" { return "O"; }
        if label.to-lowercase() == "deepseek" { return "D"; }
        if label.to-lowercase() == "openrouter" { return "R"; }
        if label.to-lowercase() == "9router" { return "9"; }
        return "◆";
    }
}

// Status pill (design: tone text on tone @ 12% fill, radius 999).
component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.icon-subtlest;
    in property <length> size: 10.5px;
    in property <length> pad-v: 3px;
    in property <length> pad-h: 7px;
    in property <color> fill: root.tone.with-alpha(0.12);
    border-radius: 999px;
    background: root.fill;
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    HorizontalLayout {
        padding-top: root.pad-v;
        padding-bottom: root.pad-v;
        padding-left: root.pad-h;
        padding-right: root.pad-h;
        Text {
            text: root.text;
            color: root.tone;
            font-size: root.size;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }
}

component Caps inherits Text {
    font-size: 9.5px;
    font-weight: Theme.weight-semibold;
    letter-spacing: 0.8px;
    color: Theme.caps-label;
    vertical-alignment: center;
}

// Segmented control (design: #0E1013, 1px #24272D, radius 8, pad 2 gap 2; segments 22 tall radius 6,
// active = accent tint + #B9C2FF text).
component SegBox inherits Rectangle {
    height: 26px;
    horizontal-stretch: 0;
    background: AgentsLook.seg-bg;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 8px;
    accessible-role: tab-list;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        @children
    }
}

component Seg inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <length> min-w: 63px;
    callback clicked;
    height: 22px;
    min-width: root.min-w;
    border-radius: 6px;
    background: root.active ? Theme.accent-fg.with-alpha(0.2) : (ta.has-hover ? Theme.hover : Theme.hover.with-alpha(0));
    animate background { duration: Theme.dur-hover; }
    accessible-role: AccessibleRole.tab;
    accessible-label: root.text;
    accessible-item-selected: root.active;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: root.active ? Theme.weight-semibold : Theme.weight-normal;
            color: root.active ? AgentsLook.seg-on-text : Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Raised button (design: #1C1F24, 1px #2A2D33; "Re-detect agents" 28 tall r7, section actions 25 tall r8).
component DButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <length> h: 28px;
    in property <length> pad: 11px;
    in property <length> size: 12px;
    in property <bool> primary: false;
    in property <bool> outline: false;
    in property <bool> enabled: true;
    callback clicked;
    height: root.h;
    horizontal-stretch: 0;
    border-radius: root.h >= 28px ? 7px : 8px;
    background: root.primary ? Theme.primary : root.outline ? (ta.has-hover ? Theme.hover : Theme.hover.with-alpha(0)) : (ta.has-hover && root.enabled ? Theme.border-hover : Theme.raised);
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border-hover;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: Theme.dur-hover; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: root.glyph != "" ? (root.h >= 28px ? 7px : 5px) : 0px;
        alignment: center;
        if root.glyph != "": Text {
            text: root.glyph;
            font-family: "Segoe UI Symbol";
            font-size: 11px;
            color: root.outline ? Theme.muted : Theme.foreground-subtle;
            vertical-alignment: center;
            accessible-role: none;
        }
        Text {
            text: root.text;
            font-size: root.size;
            font-weight: root.outline ? Theme.weight-normal : Theme.weight-medium;
            color: root.primary ? Theme.primary-foreground : root.outline ? Theme.muted : Theme.foreground;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Clickable faint glyph ("⋯", "✕", "▲", "▼").
component Glyph inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <length> size: 12px;
    in property <color> tint: Theme.icon-subtlest;
    in property <bool> active: false;
    callback clicked;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: ta.has-hover || root.active ? Theme.hover : Theme.hover.with-alpha(0);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }
    Text {
        text: root.text;
        font-family: "Segoe UI Symbol";
        font-size: root.size;
        color: ta.has-hover || root.active ? Theme.foreground-subtle : root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Tile inherits Rectangle {
    in property <string> logo;
    in property <bool> dim;
    in property <string> initial;
    in property <color> tone;
    in property <color> ink: #FFFFFF;
    in property <length> size: 30px;
    in property <length> font: 12.6px;
    width: root.size;
    height: root.size;
    border-radius: 8px;
    background: root.logo != "" ? transparent : root.tone;
    accessible-role: none;
    if root.logo != "": AgentMark {
        name: root.logo;
        size: root.size;
        opacity: root.dim ? 0.4 : 1;
    }
    if root.logo == "": Text {
        text: root.initial;
        font-size: root.font;
        font-weight: Theme.weight-semibold;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Account chip (design: 24 tall, pad [4,8], #111215, 1px #24272D, radius 7, 6px status dot, 11px label).
component AccountChip inherits Rectangle {
    in property <string> text;
    in property <color> dot;
    in property <bool> active;
    in property <string> hint;
    callback clicked;
    height: 24px;
    horizontal-stretch: 0;
    border-radius: 7px;
    background: ta.has-hover ? Theme.raised : Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: root.hint != "" ? root.hint : root.text;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.dot;
            }
        }
        Text {
            text: root.text;
            font-size: 11px;
            color: Theme.foreground-subtle;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.active: VerticalLayout {
            alignment: center;
            Pill {
                text: "active";
                tone: Theme.agent-agy;
                size: 9px;
                pad-v: 1px;
                pad-h: 5px;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Hint inherits Text {
    font-size: 11px;
    color: Theme.icon-subtlest;
    wrap: word-wrap;
}

component DefaultSelect inherits Select {
    in property <AgentCard> card;
    in property <string> kind;
    height: 26px;
    label: root.kind == "model" ? @tr("{0} default model", root.card.name) : @tr("{0} default effort", root.card.name);
    options: root.kind == "model" ? root.card.models : root.card.efforts;
    current: root.kind == "model" ? root.card.model : root.card.effort;
    current-label: root.kind == "model" ? root.card.model-label : root.card.effort-label;
    placeholder: @tr("Agent default");
    reset-label: @tr("Agent default");
    empty-text: @tr("{0} reports its options after it starts. Make sure it is installed and signed in.", root.card.name);
    select(id) => {
        AgentsUi.set-default(root.card.id, root.kind == "model" ? "defaultModel" : "defaultEffort", id);
    }
}

// One agent (design "Card/<agent>": #16181C, 1px #24272D, radius 12, pad [12,14], gap 10).
component AgentCardView inherits Rectangle {
    in property <AgentCard> card;
    property <bool> open: AgentsUi.open-agent == root.card.id;
    property <bool> adding: false;
    property <bool> is-agy: root.card.id == "agy";
    property <bool> is-claude: root.card.id == "claude-code";
    property <bool> show-accounts: (root.is-agy && AgentsUi.agy-available) || (root.is-claude && AgentsUi.accounts.length > 0);
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        // row1: tile, name + meta, status pill / more / toggle.
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Tile {
                    logo: AgentLogo.key(root.card.id) != "" ? AgentLogo.key(root.card.id) : AgentLogo.key(root.card.name);
                    initial: AgentsLook.initial-of(root.card.id);
                    tone: AgentsLook.color-of(root.card.id);
                    ink: AgentsLook.ink-of(root.card.id);
                    opacity: root.card.installed ? 1 : 0.85;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.card.name;
                    font-size: 13.5px;
                    font-weight: Theme.weight-semibold;
                    color: root.card.installed ? Theme.foreground : Theme.foreground-subtle;
                    overflow: elide;
                }
                Text {
                    property <string> model: root.card.model-label != "" ? root.card.model-label : root.card.model;
                    text: !root.card.installed ? (self.model != "" ? self.model + " · " : "") + (root.card.adapter-missing ? "ACP adapter missing" : "not found on PATH") : (self.model != "" ? self.model + " · " : "") + (root.card.version != "" ? "v" + root.card.version : "installed");
                    font-size: 11px;
                    color: Theme.icon-subtlest;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                horizontal-stretch: 0;
                if !root.card.installed && root.card.adapter-missing: VerticalLayout {
                    alignment: center;
                    DButton {
                        text: SetupUi.busy == root.card.id ? "Installing…" : "Install adapter";
                        h: 24px;
                        pad: 9px;
                        size: 11px;
                        enabled: SetupUi.busy == "";
                        clicked => {
                            SetupUi.install(root.card.id);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Pill {
                        text: !root.card.installed ? (root.card.adapter-missing ? "Adapter missing" : @tr("Not installed")) : root.card.auth == 0 ? @tr("Signed in") : root.card.auth == 1 ? @tr("Not signed in") : @tr("Installed");
                        tone: !root.card.installed ? (root.card.adapter-missing ? Theme.warning : Theme.icon-subtlest) : root.card.auth == 0 ? Theme.success : root.card.auth == 1 ? Theme.warning : Theme.icon-subtlest;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Glyph {
                        text: "⋯";
                        label: root.open ? @tr("Hide {0} settings", root.card.name) : @tr("Show {0} settings", root.card.name);
                        active: root.open;
                        clicked => {
                            AgentsUi.open-agent = root.open ? "" : root.card.id;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        label: @tr("Enable {0}", root.card.name);
                        checked: root.card.enabled;
                        toggled(on) => {
                            AgentsUi.set-enabled(root.card.id, on);
                        }
                    }
                }
            }
        }
        // row2: MODE segmented … MODEL select (indented 40 under the tile).
        HorizontalLayout {
            padding-left: 40px;
            spacing: 10px;
            height: 26px;
            Caps {
                text: "MODE";
            }
            SegBox {
                Seg {
                    text: @tr("Default");
                    min-w: 69px;
                    active: root.card.mode == "";
                    clicked => {
                        AgentsUi.set-default(root.card.id, "defaultMode", "");
                    }
                }
                for m in root.card.modes: Seg {
                    text: m.label;
                    min-w: 69px;
                    active: root.card.mode == m.id;
                    clicked => {
                        AgentsUi.set-default(root.card.id, "defaultMode", m.id);
                    }
                }
            }
            if root.card.modes.length == 0: Text {
                text: root.card.installed ? @tr("Modes appear after the agent starts once") : "";
                font-size: 11px;
                color: Theme.icon-subtlest;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Caps {
                text: "MODEL";
            }
            DefaultSelect {
                card: root.card;
                kind: "model";
                width: 168px;
                horizontal-stretch: 0;
            }
        }
        // ACCOUNTS (design: agy card; Claude shows its extra subscriptions the same way).
        if root.show-accounts: HorizontalLayout {
            padding-left: 40px;
            spacing: 8px;
            height: 24px;
            alignment: start;
            Caps {
                text: "ACCOUNTS";
            }
            if root.is-agy: HorizontalLayout {
                spacing: 8px;
                for acc in AgentsUi.agy-accounts: AccountChip {
                    text: acc.name;
                    dot: acc.exhausted ? Theme.warning : acc.signed-in ? Theme.success : Theme.icon-subtlest;
                    active: acc.active;
                    hint: acc.signed-in && !acc.active ? "Use " + acc.name : acc.name;
                    clicked => {
                        if acc.signed-in && !acc.active {
                            AgentsUi.agy-use(acc.id);
                        } else if !acc.signed-in {
                            AgentsUi.agy-sign-in(acc.id);
                        }
                    }
                }
            }
            if root.is-claude: HorizontalLayout {
                spacing: 8px;
                for acc in AgentsUi.accounts: AccountChip {
                    text: acc.label;
                    dot: acc.auth == 0 ? Theme.success : acc.auth == 1 ? Theme.warning : Theme.icon-subtlest;
                    hint: @tr("Sign in to {0}", acc.label);
                    clicked => {
                        if acc.auth != 0 {
                            AgentsUi.login-account(acc.id);
                        }
                    }
                }
            }
            if !root.adding: DButton {
                text: @tr("Add account");
                glyph: "+";
                outline: true;
                h: 24px;
                pad: 9px;
                size: 11px;
                clicked => {
                    root.adding = true;
                }
            }
            if root.adding && root.is-agy: TextField {
                width: 200px;
                height: 24px;
                horizontal-stretch: 0;
                text <=> AgentsUi.agy-label;
                placeholder: "Account name, e.g. Work";
                label: "New Antigravity account name";
                accepted(text) => {
                    AgentsUi.agy-add(text);
                    root.adding = false;
                }
            }
            if root.adding && root.is-claude: TextField {
                width: 200px;
                height: 24px;
                horizontal-stretch: 0;
                text <=> AgentsUi.account-label;
                placeholder: @tr("Account name, e.g. Work");
                label: @tr("New account name");
                accepted(text) => {
                    AgentsUi.add-account(text);
                    root.adding = false;
                }
            }
            if root.adding: Glyph {
                text: "✕";
                size: 10px;
                label: @tr("Cancel");
                clicked => {
                    root.adding = false;
                }
            }
        }
        // "⋯" details: sign-in hint, effort, launch command + connection test.
        if root.open: VerticalLayout {
            padding-left: 40px;
            spacing: 10px;
            if root.card.auth == 1 && root.card.installed: Hint {
                text: @tr("Sign in from a terminal with the agent's own login command. Harness never reads or stores agent credentials.");
            }
            HorizontalLayout {
                spacing: 10px;
                height: 26px;
                Caps {
                    text: "EFFORT";
                }
                DefaultSelect {
                    card: root.card;
                    kind: "effort";
                    width: 168px;
                    horizontal-stretch: 0;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                border-radius: 8px;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: root.card.program != "" ? root.card.program : @tr("Found on PATH");
                            font-family: root.card.program != "" ? Theme.mono-font : "";
                            font-size: 11.5px;
                            color: Theme.foreground-subtle;
                            overflow: elide;
                        }
                        Text {
                            text: (root.card.args != "" ? root.card.args : @tr("No extra arguments")) + (root.card.env != "" ? "  ·  " + root.card.env : "");
                            font-family: root.card.args != "" ? Theme.mono-font : "";
                            font-size: 11px;
                            color: Theme.icon-subtlest;
                            overflow: elide;
                        }
                    }
                    if root.card.test-state == 1: VerticalLayout {
                        alignment: center;
                        Spinner {
                            size: 14px;
                            tint: Theme.foreground-subtle;
                        }
                    }
                    if root.card.test-state == 1 || root.card.test-state == 2: Text {
                        text: root.card.test-state == 1 ? @tr("Testing…") : @tr("{0}ms latency", root.card.test-latency);
                        font-size: 11px;
                        color: root.card.test-state == 2 ? Theme.success : Theme.muted;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        DButton {
                            text: @tr("Test connection");
                            h: 26px;
                            pad: 10px;
                            size: 11.5px;
                            enabled: root.card.installed && root.card.test-state != 1;
                            clicked => {
                                AgentsUi.test(root.card.id);
                            }
                        }
                    }
                }
            }
            if root.card.test-state == 3: Text {
                text: root.card.test-error != "" ? root.card.test-error : @tr("Connection test failed.");
                font-size: 11px;
                color: Theme.destructive-surface-foreground;
                wrap: word-wrap;
            }
        }
    }
}

// Section head (design: 12.5 title + count pill, raised action on the right).
component SectionHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> pill;
    in property <string> action;
    callback act();
    height: 25px;
    spacing: 7px;
    Text {
        text: root.title;
        font-size: 12.5px;
        font-weight: Theme.weight-semibold;
        color: Theme.foreground;
        vertical-alignment: center;
    }
    if root.pill != "": VerticalLayout {
        alignment: center;
        Pill {
            text: root.pill;
            size: 9.5px;
            pad-v: 2px;
            pad-h: 6px;
        }
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    if root.action != "": DButton {
        text: root.action;
        glyph: "+";
        h: 25px;
        pad: 9px;
        size: 11.5px;
        clicked => {
            root.act();
        }
    }
}

// Card with a header (title + optional note) for the account managers kept below the designed content.
component SectionCard inherits Rectangle {
    in property <string> title;
    in property <string> note;
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    VerticalLayout {
        HorizontalLayout {
            height: 46px;
            padding-left: 16px;
            padding-right: 16px;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: Theme.weight-semibold;
                color: Theme.foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.note;
                font-size: 11px;
                color: Theme.icon-subtlest;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Divider { }
        @children
    }
}

component ManageRow inherits HorizontalLayout {
    in property <string> name;
    in property <string> sub;
    in property <color> dot;
    in property <string> state;
    padding-left: 16px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        horizontal-stretch: 1;
        Text {
            text: root.name;
            font-size: 13px;
            color: Theme.foreground;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: root.sub;
                font-family: Theme.mono-font;
                font-size: 11px;
                color: Theme.icon-subtlest;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.dot;
                }
            }
            Text {
                text: root.state;
                font-size: 11px;
                color: Theme.muted;
                vertical-alignment: center;
            }
        }
    }
    @children
}

component LabeledField inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: 6px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text {
            text: root.title;
            font-size: 11px;
            font-weight: Theme.weight-medium;
            color: Theme.foreground-subtle;
            vertical-alignment: center;
        }
        if root.hint != "": Text {
            text: root.hint;
            font-size: 10px;
            color: Theme.icon-subtlest;
            vertical-alignment: center;
        }
    }
    @children
}

// One provider in the "Add provider" grid.
component PresetTile inherits Rectangle {
    in property <string> name;
    in property <string> tag;
    in property <string> letter;
    callback clicked;
    border-radius: 9px;
    background: ta.has-hover ? Theme.border-hover : Theme.raised;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.border-hover : AgentsLook.rule;
    animate background { duration: Theme.dur-hover; }
    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => {
        root.clicked();
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 8px;
        spacing: 8px;
        AgentMark {
            y: (parent.height - self.height) / 2;
            name: root.name;
            letter: root.letter;
            size: 20px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.name;
                font-size: 11.5px;
                font-weight: Theme.weight-medium;
                color: Theme.foreground;
                overflow: elide;
            }
            Text {
                text: root.tag;
                font-size: 9.5px;
                color: Theme.icon-subtlest;
                overflow: elide;
            }
        }
    }
}

// Small text action ("Get a key ↗", "Edit", "Change").
component LinkText inherits Text {
    callback clicked;
    font-size: 11px;
    color: lta.has-hover ? Theme.foreground : Theme.primary;
    vertical-alignment: center;
    accessible-role: button;
    accessible-action-default => {
        root.clicked();
    }
    lta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// "Add provider" modal: pick a provider (endpoint and a default model filled in), then paste the key.
export component ProviderDialog inherits Dialog {
    property <string> picked: AgentsUi.provider-preset;
    property <ProviderPreset> preset: AgentsUi.provider-current;
    // The Command Code CLI preset: a name and one key per line, no endpoint or model.
    property <bool> command-code: AgentsUi.provider-kind == "command-code";
    // Several keys (one per line) instead of the single masked key field.
    property <bool> many-keys: root.command-code;
    property <int> cols: 3;
    property <length> gap: 6px;
    property <length> tile-h: 40px;
    title: root.picked == "" ? @tr("Add provider") : root.preset.name;
    close-label: @tr("Close");
    dialog-width: 580px;
    close => {
        AgentsUi.provider-open = false;
        AgentsUi.provider-kind = "";
        AgentsUi.provider-preset = "";
    }
    // ---------- step 1: pick a provider ----------
    if root.picked == "": VerticalLayout {
        spacing: 12px;
        Text {
            text: "Pick a provider: the endpoint and a model are filled in, so only the API key is needed.";
            font-size: 11.5px;
            color: Theme.muted;
            wrap: word-wrap;
        }
        grid := Rectangle {
            property <int> rows: (AgentsUi.presets.length + root.cols - 1) / root.cols;
            property <length> tile-w: (self.width - (root.cols - 1) * root.gap) / root.cols;
            height: self.rows * root.tile-h + (self.rows - 1) * root.gap;
            for p[i] in AgentsUi.presets: PresetTile {
                x: mod(i, root.cols) * (grid.tile-w + root.gap);
                y: floor(i / root.cols) * (root.tile-h + root.gap);
                width: grid.tile-w;
                height: root.tile-h;
                name: p.name;
                tag: p.tag;
                letter: p.letter;
                clicked => {
                    root.many-keys = p.id == "command-code-cli";
                    AgentsUi.pick-preset(p.id);
                }
            }
        }
    }
    // ---------- step 2: key (and model) ----------
    if root.picked != "": VerticalLayout {
        spacing: 14px;
        HorizontalLayout {
            spacing: 10px;
            AgentMark {
                y: (parent.height - self.height) / 2;
                name: root.preset.name;
                letter: root.preset.letter;
                size: 22px;
            }
            Text {
                text: root.preset.note != "" ? root.preset.note : root.preset.tag;
                font-size: 11px;
                color: Theme.foreground-subtle;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            LinkText {
                text: "Change";
                clicked => {
                    AgentsUi.provider-preset = "";
                    AgentsUi.provider-kind = "";
                }
            }
        }
        LabeledField {
            title: "Name";
            hint: root.many-keys ? "several keys are numbered: " + AgentsUi.provider-label + " 1, " + AgentsUi.provider-label + " 2, …" : "";
            TextField {
                height: 34px;
                text <=> AgentsUi.provider-label;
                placeholder: "My provider";
                label: "Provider name";
            }
        }
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.many-keys ? "API keys" : "API key";
                    font-size: 11px;
                    font-weight: Theme.weight-medium;
                    color: Theme.foreground-subtle;
                    vertical-alignment: center;
                }
                Text {
                    text: root.preset.keyless ? "optional for a local server" : root.many-keys ? "one per line; new sessions take them in turn (round robin)" : "stored in Harness's data folder, never shown again";
                    font-size: 10px;
                    color: Theme.icon-subtlest;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if !root.command-code: LinkText {
                    text: root.many-keys ? "One key" : "Several keys";
                    clicked => {
                        root.many-keys = !root.many-keys;
                    }
                }
                if root.preset.key-url != "": LinkText {
                    text: "Get a key ↗";
                    clicked => {
                        AgentsUi.open-key-page(root.preset.key-url);
                    }
                }
            }
            if root.many-keys: TextArea {
                min-height: 72px;
                max-height: 72px;
                text <=> AgentsUi.provider-key;
                label: "API keys";
            }
            if !root.many-keys: TextField {
                height: 34px;
                text <=> AgentsUi.provider-key;
                placeholder: root.preset.keyless ? "not needed" : "Paste the key";
                label: "API key";
                password: true;
                accepted(text) => {
                    if AgentsUi.provider-model == "" {
                        AgentsUi.fetch-models();
                    }
                }
            }
        }
        if !root.command-code && !AgentsUi.provider-edit-url: HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Endpoint";
                font-size: 11px;
                color: Theme.foreground-subtle;
                vertical-alignment: center;
            }
            Text {
                text: AgentsUi.provider-url;
                font-family: Theme.mono-font;
                font-size: 10.5px;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            LinkText {
                text: "Edit";
                clicked => {
                    AgentsUi.provider-edit-url = true;
                }
            }
        }
        if !root.command-code && AgentsUi.provider-edit-url: LabeledField {
            title: "Endpoint (base URL)";
            hint: "the part before /chat/completions";
            TextField {
                height: 34px;
                text <=> AgentsUi.provider-url;
                placeholder: "https://example.com/v1";
                label: "Base URL";
            }
        }
        if !root.command-code: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Model";
                    font-size: 11px;
                    font-weight: Theme.weight-medium;
                    color: Theme.foreground-subtle;
                    vertical-alignment: center;
                }
                Text {
                    text: AgentsUi.provider-models-note != "" ? AgentsUi.provider-models-note : root.picked == "hermes" ? "the gateway's model name (hermes-agent unless a profile renames it)" : "must support tool (function) calling";
                    font-size: 10px;
                    color: Theme.icon-subtlest;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if AgentsUi.provider-models-loading: Spinner {
                    width: 12px;
                    height: 12px;
                    y: (parent.height - self.height) / 2;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                TextField {
                    height: 34px;
                    text <=> AgentsUi.provider-model;
                    placeholder: "model id, or list the endpoint's models";
                    label: "Model ID";
                    edited(text) => {
                        AgentsUi.filter-models(text);
                    }
                    accepted(text) => {
                        AgentsUi.add-provider();
                    }
                }
                DButton {
                    text: "List models";
                    h: 34px;
                    pad: 12px;
                    enabled: !AgentsUi.provider-models-loading && AgentsUi.provider-url != "";
                    clicked => {
                        AgentsUi.fetch-models();
                    }
                }
            }
            if AgentsUi.provider-models.length > 0: Rectangle {
                height: min(132px, AgentsUi.provider-models.length * 24px + 8px);
                border-radius: 8px;
                border-width: 1px;
                border-color: AgentsLook.rule;
                background: Theme.surface;
                clip: true;
                Flickable {
                    content-height: models-col.preferred-height;
                    models-col := VerticalLayout {
                        padding: 4px;
                        for m in AgentsUi.provider-models: Rectangle {
                            height: 24px;
                            border-radius: 6px;
                            background: m == AgentsUi.provider-model ? Theme.primary.with-alpha(0.18) : mta.has-hover ? Theme.hover : transparent;
                            mta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    AgentsUi.provider-model = m;
                                }
                            }
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                text: m;
                                font-family: Theme.mono-font;
                                font-size: 11px;
                                color: Theme.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
        if AgentsUi.provider-error != "": Text {
            text: AgentsUi.provider-error;
            font-size: 11px;
            color: Theme.destructive-surface-foreground;
            wrap: word-wrap;
        }
        Rectangle {
            height: 1px;
            background: AgentsLook.rule;
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Takes effect after Harness restarts.";
                font-size: 11px;
                color: Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            DButton {
                text: "Cancel";
                h: 30px;
                pad: 12px;
                clicked => {
                    AgentsUi.provider-open = false;
                    AgentsUi.provider-kind = "";
                    AgentsUi.provider-preset = "";
                }
            }
            DButton {
                text: root.command-code || root.many-keys ? "Save keys" : "Save provider";
                h: 30px;
                pad: 12px;
                primary: true;
                enabled: AgentsUi.provider-label != "" && (root.command-code ? AgentsUi.provider-key != "" : AgentsUi.provider-url != "" && AgentsUi.provider-model != "" && (root.preset.keyless || root.picked == "custom" || AgentsUi.provider-key != ""));
                clicked => {
                    AgentsUi.add-provider();
                }
            }
        }
    }
}

export component AgentsPage inherits VerticalLayout {
    in property <bool> stacked;
    in property <[FallbackRow]> fallback;
    callback move-fallback(int, int);
    // 0 Agents, 1 API Providers (design sub-tabs).
    property <int> tab: 0;
    // Agents filter: 0 All, 1 Enabled, 2 Installed.
    property <int> filter: 0;
    // Provider whose "⋯" menu is open ("" = none).
    property <string> provider-menu: "";
    property <[AgentCard]> cards: AgentsUi.cards;
    pure function en(i: int) -> int {
        return root.cards[i].enabled ? 1 : 0;
    }
    pure function missing(i: int) -> int {
        return i < root.cards.length && !root.cards[i].installed ? 1 : 0;
    }
    property <int> n-enabled: en(0) + en(1) + en(2) + en(3) + en(4) + en(5) + en(6) + en(7);
    property <int> n-missing: missing(0) + missing(1) + missing(2) + missing(3) + missing(4) + missing(5) + missing(6) + missing(7);
    spacing: 0px;
    // Header (design: pad [22,28,16,28], title 22 + subtitle 12.5, gap 5) and the full-width rule.
    VerticalLayout {
        padding-top: 22px;
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 16px;
        spacing: 5px;
        Text {
            text: root.tab == 0 ? @tr("Agents") : "API Providers";
            font-family: Theme.display-font;
            font-size: 22px;
            font-weight: 700;
            color: Theme.foreground;
            accessible-role: AccessibleRole.text;
        }
        Text {
            text: root.tab == 0 ? @tr("Choose which agents Harness can run, the permission mode they start in, and which model each one uses by default. Applies to new sessions.") : "Bring your own OpenAI-compatible endpoints. Harness fails over down this list when a provider is rate limited or out of quota.";
            font-size: 12.5px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    Rectangle {
        height: 1px;
        background: AgentsLook.rule;
    }
    VerticalLayout {
        padding-top: root.tab == 0 ? 16px : 14px;
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 20px;
        spacing: root.tab == 0 ? 10px : 12px;
        // Sub-tabs (design: 30 tall, pad [0,11], radius 8; active = raised + #2A2D33 stroke).
        HorizontalLayout {
            height: 34px;
            spacing: 4px;
            alignment: start;
            for t[i] in [@tr("Agents"), "API Providers"]: Rectangle {
                height: 30px;
                border-radius: 8px;
                background: root.tab == i ? Theme.raised : (tta.has-hover ? Theme.hover : Theme.hover.with-alpha(0));
                border-width: root.tab == i ? 1px : 0px;
                border-color: Theme.border-hover;
                accessible-role: AccessibleRole.tab;
                accessible-label: t;
                accessible-item-selected: root.tab == i;
                accessible-action-default => {
                    root.tab = i;
                }
                HorizontalLayout {
                    padding-left: 11px;
                    padding-right: 11px;
                    Text {
                        text: t;
                        font-size: 12px;
                        font-weight: root.tab == i ? Theme.weight-semibold : Theme.weight-normal;
                        color: root.tab == i ? Theme.foreground : Theme.muted;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                tta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.tab = i;
                    }
                }
            }
        }
        // ---------------- Agents ----------------
        if root.tab == 0: VerticalLayout {
            spacing: 10px;
            // Toolbar: "5 AGENTS" + count pills … All / Enabled / Installed.
            HorizontalLayout {
                height: 26px;
                spacing: 10px;
                Caps {
                    text: root.cards.length + " AGENTS";
                }
                VerticalLayout {
                    alignment: center;
                    Pill {
                        text: root.n-enabled + " enabled";
                        tone: Theme.success;
                        size: 10px;
                        pad-h: 8px;
                    }
                }
                if root.n-missing > 0: VerticalLayout {
                    alignment: center;
                    Pill {
                        text: root.n-missing + " not installed";
                        size: 10px;
                        pad-h: 8px;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                SegBox {
                    Seg {
                        text: "All";
                        active: root.filter == 0;
                        clicked => {
                            root.filter = 0;
                        }
                    }
                    Seg {
                        text: "Enabled";
                        active: root.filter == 1;
                        clicked => {
                            root.filter = 1;
                        }
                    }
                    Seg {
                        text: "Installed";
                        active: root.filter == 2;
                        clicked => {
                            root.filter = 2;
                        }
                    }
                }
            }
            // Agent list (gap 12).
            VerticalLayout {
                padding-top: 0px;
                spacing: 0px;
                for c in root.cards: VerticalLayout {
                    if root.filter == 0 || (root.filter == 1 && c.enabled) || (root.filter == 2 && c.installed): VerticalLayout {
                        padding-bottom: 12px;
                        AgentCardView {
                            card: c;
                        }
                    }
                }
            }
            // Account managers (not in the design frame; kept so sign-in / remove / order stay reachable).
            if AgentsUi.accounts.length > 0 || AgentsUi.account-error != "": SectionCard {
                title: @tr("Claude accounts");
                note: "Extra subscriptions take over when one reaches its limit";
                for acc[i] in AgentsUi.accounts: VerticalLayout {
                    if i > 0: Divider { }
                    ManageRow {
                        name: acc.label;
                        sub: acc.id;
                        dot: acc.auth == 0 ? Theme.success : acc.auth == 1 ? Theme.warning : Theme.icon-subtlest;
                        state: (acc.auth == 0 ? @tr("Signed in") : acc.auth == 1 ? @tr("Not signed in") : @tr("Sign-in unknown")) + (acc.loaded ? "" : " · restart to activate");
                        VerticalLayout {
                            alignment: center;
                            DButton {
                                text: @tr("Sign in");
                                h: 26px;
                                pad: 10px;
                                size: 11.5px;
                                clicked => {
                                    AgentsUi.login-account(acc.id);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Glyph {
                                text: "✕";
                                size: 10px;
                                label: @tr("Remove {0}", acc.label);
                                clicked => {
                                    AgentsUi.remove-account(acc.id);
                                }
                            }
                        }
                    }
                }
                Divider { }
                HorizontalLayout {
                    padding: 12px;
                    padding-left: 16px;
                    spacing: 8px;
                    Hint {
                        text: AgentsUi.account-error != "" ? AgentsUi.account-error : @tr("After adding: click Sign in, run /login in the console, then restart Harness.");
                        color: AgentsUi.account-error != "" ? Theme.destructive-surface-foreground : Theme.icon-subtlest;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Glyph {
                        text: "↻";
                        label: @tr("Refresh accounts");
                        clicked => {
                            AgentsUi.refresh-accounts();
                        }
                    }
                }
            }
            if AgentsUi.agy-available: SectionCard {
                title: @tr("Antigravity accounts");
                note: "Logins live in Windows Credential Manager";
                for acc[i] in AgentsUi.agy-accounts: VerticalLayout {
                    if i > 0: Divider { }
                    ManageRow {
                        name: acc.name;
                        sub: acc.id;
                        dot: acc.exhausted ? Theme.warning : acc.signed-in ? Theme.success : Theme.icon-subtlest;
                        state: (AgentsUi.agy-pending == acc.id ? "Waiting for sign-in" : acc.exhausted ? "Limit reached" : acc.signed-in ? "Signed in" : "Not signed in") + (acc.active ? " · active" : "");
                        if i > 0: VerticalLayout {
                            alignment: center;
                            Glyph {
                                text: "▲";
                                size: 9px;
                                label: "Move " + acc.name + " up";
                                clicked => {
                                    AgentsUi.agy-move-up(acc.id);
                                }
                            }
                        }
                        if acc.signed-in && !acc.active: VerticalLayout {
                            alignment: center;
                            DButton {
                                text: "Use";
                                h: 26px;
                                pad: 10px;
                                size: 11.5px;
                                clicked => {
                                    AgentsUi.agy-use(acc.id);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            DButton {
                                text: AgentsUi.agy-pending == acc.id ? "Done" : "Sign in";
                                h: 26px;
                                pad: 10px;
                                size: 11.5px;
                                clicked => {
                                    if AgentsUi.agy-pending == acc.id {
                                        AgentsUi.agy-done();
                                    } else {
                                        AgentsUi.agy-sign-in(acc.id);
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Glyph {
                                text: "✕";
                                size: 10px;
                                label: "Remove " + acc.name;
                                clicked => {
                                    AgentsUi.agy-remove(acc.id);
                                }
                            }
                        }
                    }
                }
                if AgentsUi.agy-accounts.length > 0: Divider { }
                HorizontalLayout {
                    padding: 12px;
                    padding-left: 16px;
                    spacing: 8px;
                    Hint {
                        text: AgentsUi.agy-error != "" ? AgentsUi.agy-error : "Sign in signs agy out and opens a console running agy: log in there, then click Done. Running agy sessions restart on every switch.";
                        color: AgentsUi.agy-error != "" ? Theme.destructive-surface-foreground : Theme.icon-subtlest;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if AgentsUi.agy-accounts.length == 0 && AgentsUi.agy-live-signed-in: VerticalLayout {
                        alignment: center;
                        DButton {
                            text: "Import current login";
                            h: 26px;
                            pad: 10px;
                            size: 11.5px;
                            clicked => {
                                AgentsUi.agy-import();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Glyph {
                            text: "↻";
                            label: "Refresh Antigravity accounts";
                            clicked => {
                                AgentsUi.agy-refresh();
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 40px;
            }
            // Footer (design: 1px #24272D rule, 46 tall row: hint left, "Re-detect agents" right).
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                height: 46px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 7px;
                    horizontal-stretch: 1;
                    Text {
                        text: "◷";
                        font-family: "Segoe UI Symbol";
                        font-size: 11px;
                        color: Theme.icon-subtlest;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    Text {
                        text: "Detected when Settings opened · mode and model apply to new sessions";
                        font-size: 11px;
                        color: Theme.icon-subtlest;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    DButton {
                        text: @tr("Set up agents…");
                        outline: true;
                        clicked => {
                            SetupUi.open-setup();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    DButton {
                        text: "Re-detect agents";
                        glyph: "↻";
                        clicked => {
                            AgentsUi.refresh();
                        }
                    }
                }
            }
        }
        // ---------------- API Providers ----------------
        if root.tab == 1: VerticalLayout {
            spacing: 12px;
            SectionHead {
                title: "Configured providers";
                pill: AgentsUi.providers.length;
                action: "Add provider";
                act => {
                    AgentsUi.provider-open = true;
                }
            }
            VerticalLayout {
                spacing: 6px;
                for p in AgentsUi.providers: Rectangle {
                    height: 50px;
                    background: Theme.surface;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 11px;
                        VerticalLayout {
                            alignment: center;
                            Tile {
                                size: 26px;
                                font: 10.9px;
                                logo: p.kind == "command-code" ? "commandcode" : AgentLogo.key(p.label);
                                initial: AgentsLook.provider-initial(p.label);
                                tone: AgentsLook.provider-color(p.label);
                                ink: p.label.to-lowercase() == "openai" ? Theme.canvas : #FFFFFF;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: p.label;
                                    font-size: 12.5px;
                                    font-weight: Theme.weight-semibold;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: !p.has-key ? @tr("No API key") : !p.loaded ? @tr("Restart to activate") : "Custom";
                                        tone: !p.has-key ? Theme.warning : !p.loaded ? Theme.icon-subtlest : Theme.agent-agy;
                                        size: 9px;
                                        pad-v: 1px;
                                        pad-h: 6px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: p.kind == "command-code" ? "Command Code key" : "OpenAI-compatible";
                                        size: 9px;
                                        pad-v: 1px;
                                        pad-h: 6px;
                                    }
                                }
                            }
                            Text {
                                text: p.kind == "command-code" ? "Takes turns with the other Command Code keys (round robin)" : p.model;
                                font-size: 10.5px;
                                color: Theme.icon-subtlest;
                                overflow: elide;
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            Text {
                                text: p.kind == "command-code" ? "command-code acp" : p.endpoint;
                                font-size: 10px;
                                color: Theme.icon-subtlest;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text {
                                text: !p.has-key ? "needs key" : !p.loaded ? "pending restart" : "OK";
                                font-size: 10px;
                                color: !p.has-key ? Theme.warning : Theme.muted;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: p.has-key ? "key ••••" : "no key";
                            font-size: 10px;
                            color: Theme.icon-subtlest;
                            vertical-alignment: center;
                        }
                        if root.provider-menu == p.id: VerticalLayout {
                            alignment: center;
                            DButton {
                                text: @tr("Remove");
                                h: 24px;
                                pad: 9px;
                                size: 11px;
                                clicked => {
                                    root.provider-menu = "";
                                    AgentsUi.remove-provider(p.id);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Glyph {
                                text: "⋯";
                                label: @tr("More for {0}", p.label);
                                active: root.provider-menu == p.id;
                                clicked => {
                                    root.provider-menu = root.provider-menu == p.id ? "" : p.id;
                                }
                            }
                        }
                    }
                }
                if AgentsUi.providers.length == 0: Rectangle {
                    height: 50px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;
                    Text {
                        text: "No custom providers yet. Any OpenAI-compatible API works; the model must support tool calling.";
                        font-size: 11px;
                        color: Theme.icon-subtlest;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            SectionHead {
                title: "Fallback order";
                pill: "▲ ▼ to reorder";
                action: "Add to fallback";
                act => {
                    root.tab = 0;
                    root.filter = 0;
                }
            }
            Rectangle {
                background: Theme.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                VerticalLayout {
                    padding: 1px;
                    for a[i] in root.fallback: VerticalLayout {
                        if i > 0: Rectangle {
                            height: 1px;
                            background: AgentsLook.rule;
                        }
                        Rectangle {
                            height: 40px;
                            background: rta.has-hover ? Theme.hover : Theme.hover.with-alpha(0);
                            rta := TouchArea { }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                Text {
                                    text: "⋮⋮";
                                    font-size: 11px;
                                    color: a.state == 0 ? Theme.icon-subtlest : AgentsLook.drag;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                                Text {
                                    text: i + 1;
                                    min-width: 7px;
                                    font-size: 10.5px;
                                    color: a.state == 0 ? Theme.muted : Theme.icon-subtlest;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Tile {
                                        size: 22px;
                                        font: 9.24px;
                                        logo: AgentLogo.key(a.id);
                                        dim: a.state != 0;
                                        initial: AgentsLook.initial-of(a.id);
                                        tone: a.state == 0 ? AgentsLook.color-of(a.id) : Theme.border-hover;
                                        ink: a.state == 0 ? AgentsLook.ink-of(a.id) : #FFFFFF;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: a.name;
                                        font-size: 12px;
                                        color: a.state == 0 ? Theme.foreground : Theme.icon-subtlest;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: AgentsLook.vendor-of(a.id);
                                        font-size: 10px;
                                        color: Theme.icon-subtlest;
                                        overflow: elide;
                                    }
                                }
                                if rta.has-hover && i > 0: VerticalLayout {
                                    alignment: center;
                                    Glyph {
                                        text: "▲";
                                        size: 9px;
                                        label: @tr("Move {0} up", a.name);
                                        clicked => {
                                            root.move-fallback(i, -1);
                                        }
                                    }
                                }
                                if rta.has-hover && i < root.fallback.length - 1: VerticalLayout {
                                    alignment: center;
                                    Glyph {
                                        text: "▼";
                                        size: 9px;
                                        label: @tr("Move {0} down", a.name);
                                        clicked => {
                                            root.move-fallback(i, 1);
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        text: a.state == 0 ? @tr("Ready") : a.state == 1 ? @tr("Not installed") : a.state == 3 ? "Adapter missing" : @tr("Limit reached");
                                        tone: a.state == 0 ? Theme.success : a.state == 1 ? Theme.icon-subtlest : Theme.warning;
                                        size: 9px;
                                        pad-v: 1px;
                                        pad-h: 6px;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Glyph {
                                        text: "✕";
                                        size: 10px;
                                        label: @tr("Disable {0}", a.name);
                                        clicked => {
                                            AgentsUi.set-enabled(a.id, false);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.fallback.length > 0: Rectangle {
                        height: 1px;
                        background: AgentsLook.rule;
                    }
                    Rectangle {
                        height: 34px;
                        background: ata.has-hover ? Theme.hover : Theme.hover.with-alpha(0);
                        accessible-role: button;
                        accessible-label: "Add to fallback";
                        accessible-action-default => {
                            root.tab = 0;
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: "+";
                                font-size: 11px;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.fallback.length == 0 ? @tr("No agent is enabled. Add to fallback") : "Add to fallback";
                                font-size: 11.5px;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                        }
                        ata := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.tab = 0;
                            }
                        }
                    }
                }
            }
            Text {
                text: "Fallback is automatic: each session uses the agent you pick, and when it hits a usage limit Harness switches to the next ready agent in this order and continues the turn. Enabled agents join the fallback order; turn one off in Agents to take it out. New or removed providers take effect after Harness restarts.";
                font-size: 11px;
                color: Theme.icon-subtlest;
                wrap: word-wrap;
            }
        }
    }
}
