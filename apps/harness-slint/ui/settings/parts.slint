// Settings building blocks (round 9.1, spec phase-9-parity.md §6.1): Slint counterparts of ZCode's
// `SettingsPageParts.tsx` (SettingsRow, SettingsGroupCard, SettingsBadge) and the form controls the settings pages
// need. Every visual value comes from `Theme`; spacing follows ZCode (row px-4 py-3, control column 192px).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, Button, IconButton, Divider, Card, MenuShell, MenuItem, Dialog, SegmentOption } from "../components/controls.slint";

export { SegmentOption }

// Page title + optional intro (design: 22 semibold title, 13 muted subtitle, 6px gap — frame S1/S6).
export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 6px;
    Text {
        text: root.title;
        font-size: 22px;
        font-weight: Theme.weight-semibold;
        color: Theme.foreground;
        accessible-role: AccessibleRole.text;
        accessible-label: root.title;
    }
    if root.description != "": Text {
        text: root.description;
        font-size: Theme.ui-caption;
        color: Theme.muted;
        wrap: word-wrap;
    }
}

// Card header strip on its own (cards that build their own body): 46px min, pad [0,16], title 13 + note 11.
// Extra children (e.g. a SetButton) are appended at the right.
export component CardHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> note;
    in property <string> description;
    min-height: 46px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: root.description != "" ? 12px : 0px;
    padding-bottom: root.description != "" ? 12px : 0px;
    spacing: 12px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 3px;
        Text {
            text: root.title;
            font-size: Theme.ui-caption;
            font-weight: Theme.weight-semibold;
            color: Theme.foreground;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: Theme.ui-sm;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    if root.note != "": Text {
        text: root.note;
        font-size: Theme.ui-font-size - 3px;
        color: Theme.icon-subtlest;
        vertical-alignment: center;
        horizontal-alignment: right;
        accessible-role: none;
    }
    @children
}

// Group = the design's card (fill #111215, 1px #24272D border, radius 12). Header (design "header · X"): 46px tall,
// 16px side padding, title 13 left + `note` 11 #6B717C right (spaceBetween), then a 1px #24272D rule. `description`
// (optional, legacy) is drawn under the title as a 12px muted line. Rows (SettingRow) draw their own dividers.
export component Group inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> note;
    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;
    VerticalLayout {
        padding: 1px;
        if root.title != "": CardHeader {
            title: root.title;
            note: root.note;
            description: root.description;
        }
        if root.title != "": Rectangle {
            height: 1px;
            background: Theme.border;
        }
        @children
    }
}

// 1px #24272D rule between card rows / sections.
export component RowDivider inherits Rectangle {
    height: 1px;
    background: Theme.border;
    accessible-role: none;
}

// Settings row (design frames S1–S16): label 13 medium + description 12 muted on the left, control right-aligned in
// a fixed column, 14/16 padding and a 1px #24272D divider above every row but the first. `first` hides that hairline.
// Below 560px of content width (`stacked`) the control moves under the text.
export component SettingRow inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <bool> first: false;
    in property <bool> wide: false;
    in property <bool> stacked: false;
    in property <bool> enabled: true;
    // Text inputs (terminal font, proxy): the control sits under the description at up to 480px, so the value is
    // readable instead of elided in the 192/280px control column.
    in property <bool> below: false;
    // Vertical padding of a side-by-side row (design: 14 → 62px rows; Appearance S2 uses 10 → 54px rows).
    in property <length> pad-y: 14px;
    property <bool> under: root.stacked || root.below;
    if !root.first: Divider { }
    // 修复（窄布局）：原先用一个 GridLayout 按 stacked 切换控件的 row/col，但这两个属性改变后网格不会重新排布，
    // 窄窗口下控件仍在右侧并被裁掉。改为显式定位：宽布局控件在右侧固定列，stacked 时控件放到文字下方。
    body := Rectangle {
        property <length> ctrl-w: root.below ? min(480px, self.width) : root.stacked ? min(ctrl.preferred-width, self.width) : (root.wide ? 280px : 192px);
        property <length> text-w: max(0px, root.under ? self.width - 32px : self.width - 44px - self.ctrl-w);
        height: root.under ? txt.preferred-height + ctrl.preferred-height + 40px : max(txt.preferred-height, ctrl.preferred-height) + 2 * root.pad-y;
        txt := VerticalLayout {
            x: 16px;
            y: root.under ? 14px : (parent.height - self.preferred-height) / 2;
            width: body.text-w;
            height: self.preferred-height;
            spacing: 3px;
            Text {
                text: root.title;
                font-size: Theme.ui-caption;
                font-weight: Theme.weight-medium;
                color: root.enabled ? Theme.foreground : Theme.foreground-subtlest;
                wrap: word-wrap;
            }
            if root.description != "": Text {
                text: root.description;
                font-size: Theme.ui-sm;
                color: root.enabled ? Theme.muted : Theme.foreground-subtlest;
                wrap: word-wrap;
            }
        }
        ctrl := HorizontalLayout {
            x: root.under ? 16px : parent.width - 16px - body.ctrl-w;
            y: root.under ? txt.preferred-height + 20px : (parent.height - self.preferred-height) / 2;
            width: body.ctrl-w;
            height: self.preferred-height;
            alignment: root.below ? LayoutAlignment.stretch : root.stacked ? LayoutAlignment.start : LayoutAlignment.end;
            VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
}

// Switch (design: 32x18 radius 9; on = accent + white 14px knob right, off = #2A2D33 + muted knob left).
// Role checkbox for screen readers + gates.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 32px;
    height: 18px;
    border-radius: 9px;
    background: root.checked ? Theme.accent-fg : Theme.border-hover;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.toggled(!root.checked);
        }
    }
    animate background { duration: Theme.dur-hover; }
    Rectangle {
        width: 14px;
        height: 14px;
        y: 2px;
        x: root.checked ? root.width - self.width - 2px : 2px;
        border-radius: 7px;
        background: root.checked ? #ffffff : Theme.foreground-subtlest;
        animate x, background { duration: Theme.dur-hover; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

// Single-line input (design: height 36, fill #16181C, 1px #24272D border, radius 8, focus = accent line,
// placeholder #6B717C). `edited` fires on every change, `accepted` on Enter.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> mono: false;
    in property <bool> password: false;
    callback edited(string);
    callback accepted(string);
    height: 36px;
    min-width: 80px;
    forward-focus: input;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    background: Theme.input;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent-line : (ta.has-hover ? Theme.border-hover : Theme.border);
    opacity: root.enabled ? 1 : 0.6;
    animate border-color { duration: Theme.dur-hover; }
    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }
    if root.text == "" && root.placeholder != "": Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.icon-subtlest;
        font-size: Theme.ui-base;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        color: Theme.foreground;
        font-size: Theme.ui-base;
        font-family: root.mono ? Theme.mono-font : "";
        vertical-alignment: center;
        single-line: true;
        input-type: root.password ? InputType.password : InputType.text;
        accessible-label: root.label;
        accessible-placeholder-text: root.placeholder;
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted(self.text);
        }
    }
}

// Search input with a leading magnifier (design S6 toolbar: 36px, surface, radius 8, placeholder faint).
export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited(string);
    height: 36px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-md;
    background: Theme.input;
    border-width: 1px;
    border-color: si.has-focus ? Theme.accent-line : Theme.border;
    animate border-color { duration: Theme.dur-hover; }
    Icon {
        x: 11px;
        height: parent.height;
        source: Icons.search;
        size: 15px;
        tint: si.has-focus ? Theme.icon-subtle : Theme.icon-subtlest;
    }
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            si.focus();
        }
    }
    if root.text == "": Text {
        x: 34px;
        width: parent.width - 44px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.icon-subtlest;
        font-size: Theme.ui-base;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    si := TextInput {
        x: 34px;
        width: parent.width - 44px;
        height: parent.height;
        text <=> root.text;
        color: Theme.foreground;
        font-size: Theme.ui-base;
        vertical-alignment: center;
        single-line: true;
        accessible-label: root.placeholder;
        edited => {
            root.edited(self.text);
        }
    }
}

// Multi-line editor (instructions, memory, raw JSON/TOML/markdown). Scrolls; mono when `mono`.
export component TextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> label;
    in property <bool> mono: true;
    in property <bool> read-only: false;
    callback edited(string);
    min-height: 160px;
    border-radius: Theme.radius-md;
    background: Theme.input;
    border-width: 1px;
    border-color: ed.has-focus ? Theme.accent-line : Theme.border;
    clip: true;
    animate border-color { duration: Theme.dur-hover; }
    sv := ScrollView {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        content-height: max(self.visible-height, ed.preferred-height + 24px);
        content-width: self.visible-width;
        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => {
                ed.focus();
            }
        }
        ed := TextInput {
            x: 12px;
            y: 12px;
            width: sv.visible-width - 24px;
            text <=> root.text;
            single-line: false;
            wrap: word-wrap;
            read-only: root.read-only;
            color: Theme.foreground;
            font-size: root.mono ? Theme.code-size + 1px : Theme.ui-base;
            font-family: root.mono ? Theme.mono-font : "";
            accessible-label: root.label;
            edited => {
                root.edited(self.text);
            }
        }
    }
}

// Number stepper (− value +), clamped by the caller's range. Role spinbox: Increment / Decrement actions.
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> suffix;
    in property <string> label;
    // Optional text shown instead of value+suffix (e.g. "100%").
    in property <string> display;
    callback changed-value(int);
    // Design "stepper": 98x30, cells 28 / 40 / 28, "–" "+" 13 #8A909A, value 13 #EDEEF0. Grows for long values.
    height: 30px;
    width: max(98px, vt.preferred-width + 64px);
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.input;
    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => {
        root.changed-value(min(root.maximum, root.value + root.step));
    }
    accessible-action-decrement => {
        root.changed-value(max(root.minimum, root.value - root.step));
    }
    accessible-action-set-value(v) => {
        root.changed-value(max(root.minimum, min(root.maximum, v.to-float())));
    }
    Rectangle {
        x: 1px;
        y: 1px;
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: dta.has-hover && root.value > root.minimum ? Theme.hover : transparent;
        accessible-role: button;
        accessible-label: @tr("Decrease");
        accessible-action-default => {
            root.changed-value(max(root.minimum, root.value - root.step));
        }
        Text {
            text: "–"; font-family: "Segoe UI Symbol";
            font-size: Theme.ui-caption;
            color: root.value > root.minimum ? Theme.muted : Theme.icon-subtlest;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        dta := TouchArea {
            enabled: root.value > root.minimum;
            mouse-cursor: pointer;
            clicked => {
                root.changed-value(max(root.minimum, root.value - root.step));
            }
        }
    }
    vt := Text {
        x: 29px;
        width: root.width - 58px;
        height: root.height;
        text: root.display != "" ? root.display : root.value + root.suffix;
        color: Theme.foreground;
        font-size: Theme.ui-caption;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    Rectangle {
        x: root.width - 29px;
        y: 1px;
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: ita.has-hover && root.value < root.maximum ? Theme.hover : transparent;
        accessible-role: button;
        accessible-label: @tr("Increase");
        accessible-action-default => {
            root.changed-value(min(root.maximum, root.value + root.step));
        }
        Text {
            text: "+";
            font-size: Theme.ui-caption;
            color: root.value < root.maximum ? Theme.muted : Theme.icon-subtlest;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        ita := TouchArea {
            enabled: root.value < root.maximum;
            mouse-cursor: pointer;
            clicked => {
                root.changed-value(min(root.maximum, root.value + root.step));
            }
        }
    }
}

export struct SelectOption {
    id: string,
    label: string,
}

// Select (ZCode Select: input-style trigger + menu). The menu is a PopupWindow; Increment / Decrement on the
// trigger also cycle the options (keyboard and automation).
export component Select inherits Rectangle {
    in property <[SelectOption]> options;
    in property <string> current;
    in property <string> label;
    in property <string> placeholder;
    in property <bool> enabled: true;
    // Visible text of the current option (Slint functions cannot loop over `options`, so the caller passes it).
    in property <string> current-label;
    // When non-empty the menu starts with a reset row ("Agent default") that selects "".
    in property <string> reset-label;
    // Muted hint shown in the menu when `options` is empty.
    in property <string> empty-text;
    // Design "select · X": optional 8px coloured dot before the text (agent colour).
    in property <bool> has-dot: false;
    in property <color> dot: Theme.accent-fg;
    // true = natural width (design: the trigger hugs its text) instead of filling the row's control column.
    in property <bool> fit: false;
    callback select(string);
    height: 30px;
    min-width: root.fit ? trig.preferred-width : 108px;
    preferred-width: trig.preferred-width;
    max-width: root.fit ? trig.preferred-width : 100000px;
    horizontal-stretch: root.fit ? 0 : 1;
    border-radius: Theme.radius-md;
    background: Theme.input;
    border-width: 1px;
    border-color: ta.has-hover && root.enabled ? Theme.border-hover : Theme.border;
    opacity: root.enabled ? 1 : 0.6;
    animate border-color { duration: Theme.dur-hover; }
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: lbl.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            popup.show();
        }
    }
    accessible-action-expand => {
        if root.enabled {
            popup.show();
        }
    }
    // Design trigger: pad [6,10], gap 8, [dot] text 12 #EDEEF0, caret "▾" 11 #8A909A.
    trig := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.has-dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.dot;
            }
        }
        lbl := Text {
            horizontal-stretch: 1;
            text: root.current-label != "" ? root.current-label : root.placeholder;
            color: root.current-label == "" ? Theme.icon-subtlest : Theme.foreground;
            font-size: Theme.ui-sm;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        Text {
            text: "▾"; font-family: "Segoe UI Symbol";
            font-size: Theme.ui-font-size - 3px;
            color: ta.has-hover && root.enabled ? Theme.foreground-subtle : Theme.muted;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 180px);
        MenuShell {
            if root.reset-label != "": MenuItem {
                text: root.reset-label;
                checked: root.current == "";
                clicked => {
                    root.select("");
                    popup.close();
                }
            }
            if root.reset-label != "" && root.options.length > 0: Divider { }
            for o in root.options: MenuItem {
                text: o.label;
                label: o.label;
                checked: o.id == root.current;
                clicked => {
                    root.select(o.id);
                    popup.close();
                }
            }
            if root.options.length == 0 && root.empty-text != "": HorizontalLayout {
                padding: 8px;
                Text {
                    text: root.empty-text;
                    font-size: Theme.ui-sm;
                    color: Theme.foreground-subtle;
                    wrap: word-wrap;
                }
            }
        }
    }
}


// Key cap (design S6: raised #1C1F24 bg, #2A2D33 border, radius 6, 11 semibold text, 3/7 padding).
export component Kbd inherits Rectangle {
    in property <string> text;
    in property <bool> muted: false;
    height: 21px;
    min-width: 21px;
    preferred-width: kt.preferred-width + 14px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-hover;
    background: Theme.raised;
    // The key cap is read as one text (screen readers, gate): "Ctrl+Alt+K".
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    kt := Text {
        text: root.text;
        font-size: Theme.ui-xs;
        font-weight: Theme.weight-semibold;
        color: root.muted ? Theme.muted : Theme.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Badge → pill (design: colour text on colour+1F bg, radius full, 11 semibold).
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.muted;
    height: 20px;
    preferred-width: bt.preferred-width + 16px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-full;
    background: root.tint.with-alpha(0.12);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    bt := Text {
        text: root.text;
        font-size: Theme.ui-xs;
        font-weight: Theme.weight-semibold;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Greyed "not supported by this CLI" card (spec §6.2: shown instead of hiding the page).
export component UnsupportedNotice inherits Rectangle {
    in property <string> title;
    in property <string> reason;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card;
    accessible-role: AccessibleRole.text;
    accessible-label: root.title;
    accessible-description: root.reason;
    HorizontalLayout {
        padding: 16px;
        spacing: 10px;
        Icon {
            source: Icons.info;
            size: 16px;
            tint: Theme.icon-subtle;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text {
                text: root.title;
                font-size: Theme.ui-base;
                font-weight: Theme.weight-medium;
                color: Theme.foreground-subtle;
                wrap: word-wrap;
                accessible-role: none;
            }
            if root.reason != "": Text {
                text: root.reason;
                font-size: Theme.ui-sm;
                color: Theme.muted;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
    }
}

// Inline status line under a form (saved / error).
export component StatusLine inherits HorizontalLayout {
    in property <string> text;
    in property <bool> error: false;
    spacing: 6px;
    if root.text != "": Icon {
        source: root.error ? Icons.circle-alert : Icons.circle-check;
        size: Theme.icon-sm;
        tint: root.error ? Theme.destructive : Theme.success;
    }
    if root.text != "": Text {
        text: root.text;
        font-size: Theme.ui-sm;
        color: root.error ? Theme.destructive : Theme.foreground-subtle;
        wrap: word-wrap;
        horizontal-stretch: 1;
        accessible-role: AccessibleRole.text;
        accessible-label: root.text;
    }
}

// Confirmation dialog (destructive actions, reset all, data dir move).
export component ConfirmDialog inherits Dialog {
    in property <string> message;
    in property <string> confirm-text;
    in property <bool> destructive: true;
    callback confirm();
    dialog-width: 420px;
    Text {
        text: root.message;
        color: Theme.foreground-subtle;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button {
            text: @tr("Cancel");
            variant: "outline";
            size: "lg";
            clicked => {
                root.close();
            }
        }
        Button {
            text: root.confirm-text;
            variant: root.destructive ? "destructive" : "primary";
            size: "lg";
            clicked => {
                root.confirm();
            }
        }
    }
}

// ---- Design-exact building blocks (redesign 2026-11, frames S1-S16) ----------------------------------------------

// Toggle = design name for Switch (32x18 r9, on #7C8CFF + white 14px knob right, off #2A2D33 + #8A909A knob left).
export component Toggle inherits Switch { }

// Pill (design "pill · X": pad [3,8], 11px text in `tint`, fill tint+1F, radius 999). Default tint = accent #7C8CFF.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent-fg;
    height: 19px;
    preferred-width: pt.preferred-width + 16px;
    min-width: self.preferred-width;
    max-width: self.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-full;
    background: root.tint.with-alpha(0.12);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    pt := Text {
        text: root.text;
        font-size: Theme.ui-font-size - 3px;
        font-weight: Theme.weight-medium;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Settings button (design "btn · X": pad [6..7,12], 12px label, radius 8, 29px tall, natural width).
// variant: "secondary" (default; #1C1F24 + #2A2D33 border), "primary" (#EDEEF0, dark text), "accent" (brand
// gradient, white text), "destructive" (#F2555A text + border, 1F fill), "ghost".
export component SetButton inherits Rectangle {
    in property <string> text;
    in property <string> label: self.text;
    in property <string> variant: "secondary";
    in property <bool> enabled: true;
    callback clicked;
    property <bool> hot: ta.has-hover && root.enabled;
    property <color> fg: root.variant == "primary" ? Theme.primary-foreground : root.variant == "accent" ? #ffffff : root.variant == "destructive" ? Theme.destructive : root.variant == "ghost" ? Theme.foreground-subtle : Theme.foreground;
    height: 29px;
    preferred-width: bt.preferred-width + 24px;
    min-width: self.preferred-width;
    max-width: self.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    border-width: root.variant == "secondary" || root.variant == "destructive" ? 1px : 0px;
    border-color: root.variant == "destructive" ? Theme.destructive.with-alpha(root.hot ? 0.8 : 0.5) : (root.hot ? #34383f : Theme.border-hover);
    background: root.variant == "primary" ? (root.hot ? Theme.primary-hover : Theme.primary) : root.variant == "accent" ? Theme.brand-gradient : root.variant == "destructive" ? Theme.destructive.with-alpha(root.hot ? 0.18 : 0.12) : root.variant == "ghost" ? (root.hot ? Theme.hover : transparent) : (root.hot ? #23262c : Theme.raised);
    opacity: root.enabled ? 1 : 0.45;
    transform-scale: ta.pressed && root.enabled ? 0.97 : 1;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    animate background, border-color { duration: Theme.dur-hover; }
    animate transform-scale { duration: Theme.dur-press; }
    bt := Text {
        text: root.text;
        font-size: Theme.ui-sm;
        font-weight: Theme.weight-medium;
        color: root.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Segmented control at design size (pad 3 gap 2, segments pad [4,10] 12px, active fill #1C1F24 text #EDEEF0,
// inactive text #8A909A). Same API as controls.slint `Segmented` (options / current / select).
export component SegmentedControl inherits Rectangle {
    in property <[SegmentOption]> options;
    in property <string> current;
    in property <string> label;
    callback select(string);
    height: 31px;
    preferred-width: sg.preferred-width;
    min-width: self.preferred-width;
    max-width: self.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.label;
    sg := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for o in root.options: Rectangle {
            width: st.preferred-width + 20px;
            border-radius: Theme.radius-sm;
            background: o.id == root.current ? Theme.raised : (sta.has-hover ? Theme.hover : transparent);
            animate background { duration: Theme.dur-hover; }
            accessible-role: button;
            accessible-label: o.label;
            accessible-checked: o.id == root.current;
            accessible-action-default => {
                root.select(o.id);
            }
            st := Text {
                text: o.label;
                font-size: Theme.ui-sm;
                color: o.id == root.current ? Theme.foreground : Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.select(o.id);
                }
            }
        }
    }
}

// Coloured dot (design ELLIPSE "dot" 8x8, e.g. agent colour).
export component Dot inherits Rectangle {
    in property <color> tint: Theme.accent-fg;
    in property <length> size: 8px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.tint;
    accessible-role: none;
}

// Caps label (design 10px #5D636D, letter-spacing 8%).
export component CapsLabel inherits Text {
    font-size: Theme.ui-xs;
    font-weight: Theme.weight-semibold;
    color: Theme.caps-label;
    letter-spacing: 0.8px;
    vertical-alignment: center;
}
