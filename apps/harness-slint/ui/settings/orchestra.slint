import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, Button, IconButton, Divider, Card, SectionLabel, MenuShell, MenuItem } from "../components/controls.slint";
import { TextArea, Switch, SelectOption, Select, TextField } from "parts.slint";
import { SettingsUi, DecisionUi } from "globals.slint";

export struct OrchNode {
    id: string,
    name: string,
    initial: string,
    role: int,
    x: float,
    y: float,
    muted: bool,
}

export struct OrchEdge {
    commands: string,
    role: int,
}

export struct OrchLink {
    edge: int,
    name: string,
}

export struct OrchAgent {
    id: string,
    name: string,
}

// One route of the team graph (design S3 "Card · Connections"): from → to, role of the target.
export struct OrchConn {
    edge: int,
    from-id: string,
    from-agent: string,
    from-name: string,
    to-id: string,
    to-agent: string,
    to-name: string,
    role: int,
}

export global OrchestraUi {
    in property <[OrchNode]> nodes;
    in property <[OrchEdge]> edges;
    in property <[OrchLink]> links;
    in property <[OrchAgent]> addable;
    in property <string> error;
    in property <string> selected;
    in property <string> selected-name;
    in property <int> selected-role;
    in-out property <string> instructions;
    in property <float> bx;
    in property <float> by;
    in property <float> bw;
    in property <float> bh;
    callback select(string);
    callback add-node(string, float, float);
    callback move-node(int, float, float);
    callback drop-node();
    callback set-role(int, int);
    callback connect-at(int, float, float);
    callback remove-edge(int);
    callback clear-links(int);
    callback remove-node(int);
    callback clear();
    callback edit-instructions(string);
    // Every known agent (default-subagent select), all routes, and the pairs that can still be connected.
    in property <[OrchAgent]> agents;
    in property <[OrchConn]> connections;
    in property <[OrchConn]> candidates;
    callback connect(string, string);
    pure callback agent-name(string) -> string;
    pure callback agent-color(string) -> color;
    pure callback line-count(string) -> int;
    pure public function route-label(role: int) -> string {
        if role == 0 { return "orchestrate"; }
        if role == 2 { return "review"; }
        if role == 3 { return "research"; }
        return "delegate";
    }
    pure public function role-color(role: int) -> color {
        if role == 0 { return Theme.accent-fg; }
        if role == 2 { return Theme.success; }
        if role == 3 { return Theme.violet; }
        return Theme.info;
    }
    pure public function role-label(role: int) -> string {
        if role == 0 { return "Orchestrator"; }
        if role == 2 { return "QC / Reviewer"; }
        if role == 3 { return "Planner / Researcher"; }
        return "Subagent";
    }
}

component Canvas inherits Rectangle {
    property <float> node-w: 176;
    property <float> node-h: 52;
    in-out property <float> zoom: 1;
    in property <bool> snap: false;
    pure function snapped(v: float) -> float {
        return root.snap ? round(v / 16) * 16 : v;
    }
    public function zoom-to(next: float) {
        root.set-zoom(next, root.width / 2, root.height / 2);
    }
    property <length> pan-x: 40px;
    property <length> pan-y: 40px;
    property <length> pan-sx;
    property <length> pan-sy;
    property <int> link-from: -1;
    property <float> link-x;
    property <float> link-y;
    property <int> menu-index: -1;
    property <int> menu-role;
    property <length> menu-x;
    property <length> menu-y;
    function set-zoom(next: float, ax: length, ay: length) {
        let z = clamp(next, 0.4, 2.0);
        root.pan-x = ax - (ax - root.pan-x) * z / root.zoom;
        root.pan-y = ay - (ay - root.pan-y) * z / root.zoom;
        root.zoom = z;
    }
    public function fit() {
        if OrchestraUi.nodes.length == 0 {
            root.zoom = 1;
            root.pan-x = 40px;
            root.pan-y = 40px;
            return;
        }
        let z = clamp(min((root.width / 1px - 80) / max(OrchestraUi.bw, 1), (root.height / 1px - 80) / max(OrchestraUi.bh, 1)), 0.4, 1.5);
        root.zoom = z;
        root.pan-x = (root.width - OrchestraUi.bw * z * 1px) / 2 - OrchestraUi.bx * z * 1px;
        root.pan-y = (root.height - OrchestraUi.bh * z * 1px) / 2 - OrchestraUi.by * z * 1px;
    }
    public function center-x() -> float {
        return (root.width / 2 - root.pan-x) / 1px / root.zoom - root.node-w / 2;
    }
    public function center-y() -> float {
        return (root.height / 2 - root.pan-y) / 1px / root.zoom - root.node-h / 2;
    }
    background: Theme.background-win-alt;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    pan := TouchArea {
        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.pan-sx = root.pan-x;
                root.pan-sy = root.pan-y;
                OrchestraUi.select("");
            }
        }
        moved => {
            if self.pressed {
                root.pan-x = root.pan-sx + (self.mouse-x - self.pressed-x);
                root.pan-y = root.pan-sy + (self.mouse-y - self.pressed-y);
            }
        }
        scroll-event(event) => {
            root.set-zoom(event.delta-y > 0 ? root.zoom * 1.1 : (event.delta-y < 0 ? root.zoom / 1.1 : root.zoom), self.mouse-x, self.mouse-y);
            accept
        }
    }
    for e in OrchestraUi.edges: Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-x: -root.pan-x / 1px / root.zoom;
        viewbox-y: -root.pan-y / 1px / root.zoom;
        viewbox-width: root.width / 1px / root.zoom;
        viewbox-height: root.height / 1px / root.zoom;
        commands: e.commands;
        stroke: OrchestraUi.role-color(e.role);
        stroke-width: 1.5px;
        accessible-role: none;
    }
    if root.link-from >= 0 && root.link-from < OrchestraUi.nodes.length: Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-x: -root.pan-x / 1px / root.zoom;
        viewbox-y: -root.pan-y / 1px / root.zoom;
        viewbox-width: root.width / 1px / root.zoom;
        viewbox-height: root.height / 1px / root.zoom;
        commands: "M \{OrchestraUi.nodes[root.link-from].x + root.node-w / 2} \{OrchestraUi.nodes[root.link-from].y + root.node-h} L \{root.link-x} \{root.link-y}";
        stroke: Theme.foreground-subtle;
        stroke-width: 1.5px;
        accessible-role: none;
    }
    for n[i] in OrchestraUi.nodes: Rectangle {
        x: root.pan-x + n.x * root.zoom * 1px;
        y: root.pan-y + n.y * root.zoom * 1px;
        width: root.node-w * root.zoom * 1px;
        height: root.node-h * root.zoom * 1px;
        border-radius: 10px * root.zoom;
        border-width: OrchestraUi.selected == n.id ? 2px : 1.5px;
        border-color: OrchestraUi.role-color(n.role);
        background: Theme.popover;
        drop-shadow-blur: OrchestraUi.selected == n.id ? 12px : 0px;
        drop-shadow-color: OrchestraUi.role-color(n.role).with-alpha(0.35);
        opacity: n.muted ? 0.55 : 1;
        accessible-role: button;
        accessible-label: n.name + ", " + OrchestraUi.role-label(n.role);
        node-ta := TouchArea {
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    OrchestraUi.select(n.id);
                }
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    OrchestraUi.drop-node();
                }
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                    OrchestraUi.select(n.id);
                    root.menu-index = i;
                    root.menu-role = n.role;
                    root.menu-x = root.pan-x + n.x * root.zoom * 1px + self.mouse-x;
                    root.menu-y = root.pan-y + n.y * root.zoom * 1px + self.mouse-y;
                    menu.show();
                }
            }
            moved => {
                if self.pressed {
                    OrchestraUi.move-node(i, root.snapped(n.x + (self.mouse-x - self.pressed-x) / 1px / root.zoom), root.snapped(n.y + (self.mouse-y - self.pressed-y) / 1px / root.zoom));
                }
            }
        }
        HorizontalLayout {
            padding-left: 10px * root.zoom;
            padding-right: 12px * root.zoom;
            spacing: 8px * root.zoom;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 28px * root.zoom;
                    height: 28px * root.zoom;
                    border-radius: 7px * root.zoom;
                    background: OrchestraUi.role-color(n.role).with-alpha(0.18);
                    Text {
                        text: n.initial;
                        font-size: 13px * root.zoom;
                        font-weight: Theme.weight-semibold;
                        color: OrchestraUi.role-color(n.role);
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: n.name;
                    font-size: 13px * root.zoom;
                    font-weight: Theme.weight-semibold;
                    color: Theme.foreground;
                    overflow: elide;
                }
                Text {
                    text: OrchestraUi.role-label(n.role);
                    font-size: 11px * root.zoom;
                    color: OrchestraUi.role-color(n.role);
                    overflow: elide;
                }
            }
        }
        Rectangle {
            x: 0;
            y: parent.height - 10px * root.zoom;
            width: parent.width;
            height: 16px * root.zoom;
            background: transparent;
            accessible-role: none;
            handle-ta := TouchArea {
                mouse-cursor: MouseCursor.crosshair;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.link-from = i;
                        root.link-x = n.x + root.node-w / 2;
                        root.link-y = n.y + root.node-h;
                    }
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.link-from == i {
                        OrchestraUi.connect-at(i, root.link-x, root.link-y);
                        root.link-from = -1;
                    }
                }
                moved => {
                    if self.pressed {
                        root.link-x = n.x + root.node-w / 2 + (self.mouse-x - self.pressed-x) / 1px / root.zoom;
                        root.link-y = n.y + root.node-h + (self.mouse-y - self.pressed-y) / 1px / root.zoom;
                    }
                }
            }
        }
    }
    if OrchestraUi.nodes.length == 0: Text {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        text: "Add agents with \"Add agent\", then drag from the bottom edge of a box to another box to connect them.";
        font-size: Theme.ui-sm;
        color: Theme.foreground-subtle;
    }
    Rectangle {
        x: 16px;
        y: root.height - self.height - 16px;
        width: 36px;
        height: zoom-col.preferred-height;
        background: Theme.popover;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        zoom-col := VerticalLayout {
            padding: 2px;
            IconButton {
                icon: Icons.plus;
                label: "Zoom in";
                clicked => {
                    root.set-zoom(root.zoom * 1.2, root.width / 2, root.height / 2);
                }
            }
            Divider { }
            IconButton {
                icon: Icons.minus;
                label: "Zoom out";
                clicked => {
                    root.set-zoom(root.zoom / 1.2, root.width / 2, root.height / 2);
                }
            }
            Divider { }
            IconButton {
                icon: Icons.scan;
                label: "Fit to view";
                clicked => {
                    root.fit();
                }
            }
        }
    }
    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 220px;
        MenuShell {
            MenuItem {
                text: "Orchestrator";
                checked: root.menu-role == 0;
                clicked => {
                    OrchestraUi.set-role(root.menu-index, 0);
                    menu.close();
                }
            }
            MenuItem {
                text: "Subagent";
                checked: root.menu-role == 1;
                clicked => {
                    OrchestraUi.set-role(root.menu-index, 1);
                    menu.close();
                }
            }
            MenuItem {
                text: "QC / Reviewer";
                checked: root.menu-role == 2;
                clicked => {
                    OrchestraUi.set-role(root.menu-index, 2);
                    menu.close();
                }
            }
            MenuItem {
                text: "Planner / Researcher";
                checked: root.menu-role == 3;
                clicked => {
                    OrchestraUi.set-role(root.menu-index, 3);
                    menu.close();
                }
            }
            Divider { }
            MenuItem {
                text: "Remove connections";
                show-check: false;
                clicked => {
                    OrchestraUi.clear-links(root.menu-index);
                    menu.close();
                }
            }
            MenuItem {
                text: "Remove from Orchestra";
                show-check: false;
                clicked => {
                    OrchestraUi.remove-node(root.menu-index);
                    menu.close();
                }
            }
        }
    }
}

component AddAgentButton inherits Rectangle {
    callback pick(string);
    width: btn.preferred-width;
    height: btn.preferred-height;
    btn := Button {
        x: 0;
        y: 0;
        text: "Add agent";
        icon: Icons.plus;
        has-icon: true;
        trailing-chevron: true;
        enabled: OrchestraUi.addable.length > 0;
        clicked => {
            menu.show();
        }
    }
    menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 240px;
        MenuShell {
            for a in OrchestraUi.addable: MenuItem {
                text: a.name;
                show-check: false;
                clicked => {
                    root.pick(a.id);
                    menu.close();
                }
            }
        }
    }
}


// ---- Design S3 building blocks (private; numbers from spec/S3_Orchestra.txt) ----

component ODiv inherits Rectangle {
    height: 1px;
    background: Theme.card-border;
}

// Card: #111215, 1px #24272D, r12; header 46 tall pad [15,16], 13 title + 11 right note.
component OCard inherits Rectangle {
    in property <string> title;
    in property <string> note;
    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;
    VerticalLayout {
        padding: 1px;
        HorizontalLayout {
            height: 46px;
            padding-left: 16px;
            padding-right: 16px;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: Theme.weight-semibold;
                color: Theme.foreground;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: root.note;
                font-size: 11px;
                color: Theme.icon-subtlest;
                vertical-alignment: center;
            }
        }
        ODiv { }
        @children
    }
}

// Row: pad [12,16], label 13 + description 12 (gap 3) left, trailing controls (gap 8) right.
component ORow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 3px;
        Text {
            text: root.label;
            font-size: 13px;
            color: Theme.foreground;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 12px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        @children
    }
}

// Stepper 98x30: cells 28 / 40 / 28, r8, #16181C on #24272D.
component OStepper inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <bool> can-dec: true;
    in property <bool> can-inc: true;
    callback dec();
    callback inc();
    width: 98px;
    height: 30px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.input;
    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-action-increment => { root.inc(); }
    accessible-action-decrement => { root.dec(); }
    HorizontalLayout {
        padding: 1px;
        Rectangle {
            width: 28px;
            border-radius: 7px;
            background: dta.has-hover && root.can-dec ? Theme.surface-hover : transparent;
            Text {
                text: "–"; font-family: "Segoe UI Symbol";
                font-size: 13px;
                color: root.can-dec ? Theme.muted : Theme.icon-subtlest;
            }
            dta := TouchArea {
                enabled: root.can-dec;
                mouse-cursor: pointer;
                clicked => { root.dec(); }
            }
        }
        Text {
            width: 40px;
            text: root.text;
            font-size: 13px;
            color: Theme.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
        Rectangle {
            width: 28px;
            border-radius: 7px;
            background: ita.has-hover && root.can-inc ? Theme.surface-hover : transparent;
            Text {
                text: "+";
                font-size: 13px;
                color: root.can-inc ? Theme.muted : Theme.icon-subtlest;
            }
            ita := TouchArea {
                enabled: root.can-inc;
                mouse-cursor: pointer;
                clicked => { root.inc(); }
            }
        }
    }
}

// Secondary button: pad [6,12], #1C1F24 on #2A2D33, r8, 12px text.
component OButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 29px;
    width: bl.preferred-width + 24px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.popover-border;
    background: bta.has-hover && root.enabled ? Theme.border : Theme.surface-hover;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    bl := Text {
        text: root.text;
        font-size: 12px;
        font-weight: Theme.weight-semibold;
        color: Theme.foreground;
        accessible-role: none;
    }
    bta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Pill: pad [2,8], accent text 11 on accent 12%.
component OPill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent-fg;
    height: 17px;
    width: pl.preferred-width + 16px;
    border-radius: 999px;
    background: root.tint.with-alpha(0.12);
    pl := Text {
        text: root.text;
        font-size: 11px;
        font-weight: Theme.weight-semibold;
        color: root.tint;
    }
}

component ODot inherits Rectangle {
    in property <color> tint;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.tint;
}

// Segmented: pad 3 gap 2, #16181C on #24272D r8; segment pad [4,10] r6 12px, active #1C1F24 + #EDEEF0.
component OSegmented inherits Rectangle {
    in property <[SelectOption]> options;
    in property <string> current;
    in property <string> label;
    callback select(string);
    height: 31px;
    width: row.preferred-width + 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.input;
    accessible-role: tab-list;
    accessible-label: root.label;
    row := HorizontalLayout {
        x: 3px;
        y: 3px;
        height: 25px;
        spacing: 2px;
        for o in root.options: Rectangle {
            width: st.preferred-width + 20px;
            border-radius: 6px;
            background: o.id == root.current ? Theme.surface-hover : (sta.has-hover ? Theme.surface-hover.with-alpha(0.5) : transparent);
            accessible-role: tab;
            accessible-label: o.label;
            accessible-item-selected: o.id == root.current;
            accessible-action-default => { root.select(o.id); }
            st := Text {
                text: o.label;
                font-size: 12px;
                color: o.id == root.current ? Theme.foreground : Theme.muted;
                accessible-role: none;
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.select(o.id); }
            }
        }
    }
}

// Agent select: pad [6,10] gap 8, agent dot + 12px name + ▾.
component OAgentSelect inherits Rectangle {
    in property <string> current;
    callback select(string);
    height: 29px;
    width: sr.preferred-width;
    border-radius: 8px;
    border-width: 1px;
    border-color: sta.has-hover ? Theme.popover-border : Theme.card-border;
    background: Theme.input;
    accessible-role: combobox;
    accessible-label: @tr("Default subagent");
    accessible-value: OrchestraUi.agent-name(root.current);
    accessible-action-default => { popup.show(); }
    sr := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            ODot { tint: root.current == "" ? Theme.icon-subtlest : OrchestraUi.agent-color(root.current); }
        }
        Text {
            text: root.current == "" ? @tr("Auto (first connected)") : OrchestraUi.agent-name(root.current);
            font-size: 12px;
            color: Theme.foreground;
            vertical-alignment: center;
        }
        Text {
            text: "▾"; font-family: "Segoe UI Symbol";
            font-size: 11px;
            color: Theme.muted;
            vertical-alignment: center;
        }
    }
    sta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: root.width - 240px;
        y: root.height + 4px;
        width: 240px;
        MenuShell {
            MenuItem {
                text: @tr("Auto (first connected)");
                checked: root.current == "";
                clicked => {
                    root.select("");
                    popup.close();
                }
            }
            Divider { }
            for a in OrchestraUi.agents: MenuItem {
                text: a.name;
                checked: a.id == root.current;
                clicked => {
                    root.select(a.id);
                    popup.close();
                }
            }
        }
    }
}

// "+ Add connection": menu of the pairs that are not connected yet.
component AddConnectionButton inherits Rectangle {
    width: ob.width;
    height: ob.height;
    ob := OButton {
        text: @tr("+ Add connection");
        enabled: OrchestraUi.candidates.length > 0;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 280px;
        MenuShell {
            for c in OrchestraUi.candidates: MenuItem {
                text: c.from-name + "  →  " + c.to-name;
                show-check: false;
                clicked => {
                    OrchestraUi.connect(c.from-id, c.to-id);
                    menu.close();
                }
            }
        }
    }
}

// Textarea (design: pad 12, #16181C on #24272D r8, 12px #C9CCD2). Saves 600 ms after the last keystroke.
component InstructionsBox inherits Rectangle {
    in property <string> text;
    property <string> pending;
    height: max(79px, ed.preferred-height + 24px);
    border-radius: 8px;
    border-width: 1px;
    border-color: ed.has-focus ? Theme.accent-line : Theme.card-border;
    background: Theme.input;
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { ed.focus(); }
    }
    if ed.text == "": Text {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        text: "Claim paths before editing.\nReport frame ids or files changed when you finish.\nNever run cargo clean. Ask before pushing to main.";
        font-size: 12px;
        color: Theme.icon-subtlest;
        wrap: word-wrap;
        accessible-role: none;
    }
    ed := TextInput {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        text: root.text;
        single-line: false;
        wrap: word-wrap;
        font-size: 12px;
        color: Theme.foreground-subtle;
        accessible-label: @tr("Subagent instructions");
        edited => {
            root.pending = self.text;
            save.running = false;
            save.running = true;
        }
    }
    save := Timer {
        interval: 600ms;
        running: false;
        triggered => {
            self.running = false;
            SettingsUi.set-string("orchestra.instructions", root.pending);
        }
    }
}

// Card "Canvas": Zoom (stepper + Fit to screen) and Snap to grid.
component CanvasPrefs inherits OCard {
    in property <float> zoom;
    callback zoom-to(float);
    callback fit();
    title: @tr("Canvas");
    note: @tr("Orchestra view");
    ORow {
        label: @tr("Zoom");
        VerticalLayout {
            alignment: center;
            OStepper {
                label: @tr("Zoom");
                text: round(root.zoom * 100) + "%";
                can-dec: root.zoom > 0.41;
                can-inc: root.zoom < 1.99;
                dec => { root.zoom-to(max(0.4, (round(root.zoom * 10) - 1) / 10)); }
                inc => { root.zoom-to(min(2.0, (round(root.zoom * 10) + 1) / 10)); }
            }
        }
        VerticalLayout {
            alignment: center;
            OButton {
                text: @tr("Fit to screen");
                clicked => { root.fit(); }
            }
        }
    }
    ODiv { }
    ORow {
        label: @tr("Snap to grid");
        VerticalLayout {
            alignment: center;
            Switch {
                label: @tr("Snap to grid");
                checked: SettingsUi.get-bool("orchestra.snapToGrid", SettingsUi.rev);
                toggled(on) => { SettingsUi.set-bool("orchestra.snapToGrid", on); }
            }
        }
    }
    Rectangle {
        vertical-stretch: 1;
    }
}
export component OrchestraPage inherits VerticalLayout {
    in property <bool> stacked;
    property <string> mode: SettingsUi.get-string("orchestra.defaultMode", SettingsUi.rev);
    property <string> instr: SettingsUi.get-string("orchestra.instructions", SettingsUi.rev);
    property <int> max-conc: SettingsUi.get-int("orchestra.maxConcurrent", SettingsUi.rev);
    max-width: 880px;
    alignment: start;
    spacing: 20px;
    // Title block: 22 #EDEEF0, gap 6, 13 #8A909A.
    VerticalLayout {
        spacing: 6px;
        Text {
            text: @tr("Orchestra");
            font-family: Theme.display-font;
            font-size: 22px;
            font-weight: 700;
            color: Theme.foreground;
        }
        Text {
            text: @tr("How Harness delegates work to subagents.");
            font-size: 13px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    init => {
        DecisionUi.refresh();
    }
    OCard {
        title: "Decision model";
        note: "Routes work to agents";
        ORow {
            label: "Decision model";
            description: "A small, cheap model that decides for Harness: when a task is delegated without naming an agent, it picks the agent of the team (and one of that agent's models) that suits the task. One of your API providers, for example OpenRouter or Command Code API with a small model.";
            VerticalLayout {
                alignment: center;
                Select {
                    width: 240px;
                    label: "Decision model";
                    options: DecisionUi.providers;
                    current: DecisionUi.provider;
                    current-label: DecisionUi.provider-label;
                    reset-label: "Off";
                    placeholder: "Off";
                    empty-text: "Add an API provider first (Agents › API Providers)";
                    select(id) => {
                        DecisionUi.set-provider(id);
                    }
                }
            }
        }
        ODiv { }
        ORow {
            label: "Model";
            description: "The model to ask. Empty uses the provider's own model. Pick a fast one: every decision is one short request.";
            VerticalLayout {
                alignment: center;
                TextField {
                    width: 240px;
                    height: 32px;
                    text <=> DecisionUi.model;
                    placeholder: "the provider's model";
                    label: "Decision model id";
                    enabled: DecisionUi.provider != "";
                    edited(text) => {
                        DecisionUi.set-model(text);
                    }
                }
            }
        }
        ODiv { }
        ORow {
            label: "Pick the subagent";
            description: "For a delegate call without an agent. Off, or when the model does not answer in time, the first available subagent is used as before.";
            VerticalLayout {
                alignment: center;
                Switch {
                    label: "Pick the subagent";
                    checked: DecisionUi.delegation;
                    enabled: DecisionUi.provider != "";
                    toggled(on) => {
                        DecisionUi.set-delegation(on);
                    }
                }
            }
        }
        if DecisionUi.note != "": Text {
            text: DecisionUi.note;
            font-size: 11px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    OCard {
        title: @tr("Concurrency");
        note: @tr("Applies to new delegations");
        ORow {
            label: @tr("Max concurrent subagents");
            description: @tr("Extra delegations wait in the queue.");
            VerticalLayout {
                alignment: center;
                OStepper {
                    label: @tr("Max concurrent subagents");
                    text: root.max-conc;
                    can-dec: root.max-conc > 1;
                    can-inc: root.max-conc < 8;
                    dec => { SettingsUi.set-int("orchestra.maxConcurrent", max(1, root.max-conc - 1)); }
                    inc => { SettingsUi.set-int("orchestra.maxConcurrent", min(8, root.max-conc + 1)); }
                }
            }
            Text {
                text: @tr("up to 8");
                font-size: 11px;
                color: Theme.icon-subtlest;
                vertical-alignment: center;
            }
        }
        ODiv { }
        ORow {
            label: @tr("Default subagent");
            description: @tr("Used when a task does not name an agent.");
            VerticalLayout {
                alignment: center;
                OAgentSelect {
                    current: SettingsUi.get-string("orchestra.defaultAgent", SettingsUi.rev);
                    select(id) => { SettingsUi.set-string("orchestra.defaultAgent", id); }
                }
            }
        }
        ODiv { }
        ORow {
            label: @tr("Default mode");
            description: @tr("Permission mode subagents start in.");
            VerticalLayout {
                alignment: center;
                OSegmented {
                    label: @tr("Default mode");
                    options: [
                        { id: "ask", label: @tr("Ask") },
                        { id: "acceptEdits", label: @tr("Accept edits") },
                        { id: "machine", label: @tr("Machine") },
                    ];
                    current: root.mode;
                    select(id) => { SettingsUi.set-string("orchestra.defaultMode", id); }
                }
            }
        }
        ODiv { }
        ORow {
            label: @tr("Auto-claim paths");
            description: @tr("Subagents claim files before editing so they never collide.");
            VerticalLayout {
                alignment: center;
                Switch {
                    label: @tr("Auto-claim paths");
                    checked: SettingsUi.get-bool("orchestra.autoClaim", SettingsUi.rev);
                    toggled(on) => { SettingsUi.set-bool("orchestra.autoClaim", on); }
                }
            }
        }
    }
    // Pair: two 432 cards, gap 16 (stacked when narrow).
    if !root.stacked: HorizontalLayout {
        spacing: 16px;
        instr-card := OCard {
            horizontal-stretch: 1;
            title: @tr("Subagent instructions");
            note: @tr("Appended to every delegated task");
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 8px;
                InstructionsBox {
                    text: root.instr;
                }
                Text {
                    text: @tr("{0} lines · Markdown", OrchestraUi.line-count(root.instr));
                    font-size: 11px;
                    color: Theme.icon-subtlest;
                }
            }
        }
        CanvasPrefs {
            horizontal-stretch: 1;
            zoom: canvas.zoom;
            zoom-to(z) => { canvas.zoom-to(z); SettingsUi.set-int("orchestra.canvasZoom", round(canvas.zoom * 100)); }
            fit => { canvas.fit(); SettingsUi.set-int("orchestra.canvasZoom", round(canvas.zoom * 100)); }
        }
    }
    if root.stacked: OCard {
        title: @tr("Subagent instructions");
        note: @tr("Appended to every delegated task");
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 8px;
            InstructionsBox {
                text: root.instr;
            }
            Text {
                text: @tr("{0} lines · Markdown", OrchestraUi.line-count(root.instr));
                font-size: 11px;
                color: Theme.icon-subtlest;
            }
        }
    }
    if root.stacked: CanvasPrefs {
        zoom: canvas.zoom;
        zoom-to(z) => { canvas.zoom-to(z); SettingsUi.set-int("orchestra.canvasZoom", round(canvas.zoom * 100)); }
        fit => { canvas.fit(); SettingsUi.set-int("orchestra.canvasZoom", round(canvas.zoom * 100)); }
    }
    OCard {
        title: @tr("Connections");
        note: OrchestraUi.connections.length == 1 ? @tr("1 route") : @tr("{0} routes", OrchestraUi.connections.length);
        for c[i] in OrchestraUi.connections: VerticalLayout {
            if i > 0: ODiv { }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 11px;
                padding-bottom: 11px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    ODot { tint: OrchestraUi.agent-color(c.from-agent); }
                }
                Text {
                    text: c.from-name;
                    font-size: 13px;
                    color: Theme.foreground;
                    vertical-alignment: center;
                }
                Text {
                    text: "→"; font-family: "Segoe UI Symbol";
                    font-size: 13px;
                    color: Theme.icon-subtlest;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    ODot { tint: OrchestraUi.agent-color(c.to-agent); }
                }
                Text {
                    text: c.to-name;
                    font-size: 13px;
                    color: Theme.foreground;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    OPill { text: OrchestraUi.route-label(c.role); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 16px;
                    accessible-role: button;
                    accessible-label: @tr("Remove connection {0} to {1}", c.from-name, c.to-name);
                    accessible-action-default => { OrchestraUi.remove-edge(c.edge); }
                    Text {
                        text: "✕"; font-family: "Segoe UI Symbol";
                        font-size: 12px;
                        color: xta.has-hover ? Theme.foreground : Theme.icon-subtlest;
                        accessible-role: none;
                    }
                    xta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { OrchestraUi.remove-edge(c.edge); }
                    }
                }
            }
        }
        if OrchestraUi.connections.length == 0: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 11px;
            padding-bottom: 11px;
            Text {
                text: @tr("No connections yet. Add agents in the canvas editor below, then connect them.");
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
        ODiv { }
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 12px;
            alignment: start;
            AddConnectionButton { }
        }
    }
    // Existing team editor (kept below the designed cards).
    OCard {
        title: @tr("Canvas editor");
        note: @tr("{0} agents", OrchestraUi.nodes.length);
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            padding-bottom: 16px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                AddAgentButton {
                    pick(id) => {
                        OrchestraUi.add-node(id, canvas.center-x(), canvas.center-y());
                    }
                }
                Button {
                    text: @tr("Clear");
                    size: "lg";
                    enabled: OrchestraUi.nodes.length > 0;
                    clicked => {
                        OrchestraUi.clear();
                    }
                }
            }
            if OrchestraUi.error != "": Text {
                text: OrchestraUi.error;
                font-size: 12px;
                color: Theme.destructive-surface-foreground;
                wrap: word-wrap;
            }
            canvas := Canvas {
                height: 460px;
                zoom: SettingsUi.get-int("orchestra.canvasZoom", 0) / 100;
                snap: SettingsUi.get-bool("orchestra.snapToGrid", SettingsUi.rev);
            }
            if OrchestraUi.selected != "": VerticalLayout {
                spacing: 10px;
                Text {
                    text: OrchestraUi.selected-name + " · " + OrchestraUi.role-label(OrchestraUi.selected-role);
                    font-size: 13px;
                    font-weight: Theme.weight-semibold;
                    color: Theme.foreground;
                }
                Text {
                    text: @tr("Instructions are added to every new task this agent gets.");
                    font-size: 12px;
                    color: Theme.muted;
                }
                TextArea {
                    text <=> OrchestraUi.instructions;
                    label: @tr("Instructions");
                    mono: false;
                    min-height: 110px;
                    edited(text) => {
                        OrchestraUi.edit-instructions(text);
                    }
                }
                for l in OrchestraUi.links: HorizontalLayout {
                    spacing: 8px;
                    height: 30px;
                    Icon {
                        source: Icons.network;
                        size: Theme.icon-sm;
                        tint: Theme.icon-subtle;
                    }
                    Text {
                        text: l.name;
                        font-size: 12px;
                        color: Theme.foreground-subtle;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: Icons.x;
                        label: @tr("Remove connection to {0}", l.name);
                        size: Theme.control-sm;
                        icon-size: Theme.icon-xs;
                        clicked => {
                            OrchestraUi.remove-edge(l.edge);
                        }
                    }
                }
            }
        }
    }
}
