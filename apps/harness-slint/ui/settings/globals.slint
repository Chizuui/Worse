// Settings state shared between the Slint pages and `src/settings` (spec phase-9-parity.md §6.3/§6.4).
// Rust is the only writer of the models; pages call callbacks. Values of app settings are read through pure
// callbacks keyed by the settings.json path ("general.showReasoning"); `rev` is passed so bindings re-evaluate when
// Rust bumps it after a snapshot changes.
import { SelectOption } from "parts.slint";

export struct NavEntry {
    id: string,
    group: int,
}

export struct DiffLine {
    // 0 context, 1 added, 2 removed, 3 hunk / file header
    kind: int,
    text: string,
}

export struct ResRow {
    name: string,
    scope: string,
    enabled: bool,
    toggleable: bool,
    summary: string,
    path: string,
    // Hooks: event name used as a group heading (empty for other concepts).
    group: string,
    builtin: bool,
    // Table columns of the agent-config pages (design S9-S13). MCP: transport; Subagents: model;
    // Commands: argument hint; Hooks: matcher.
    detail: string,
    // Subagents: tools; Hooks: command.
    extra: string,
}

// Hooks page: one card per event.
export struct ResGroup {
    name: string,
    count: int,
}

// Memory page: one entry = one markdown section (heading + body) of MEMORY.md.
export struct DocEntry {
    title: string,
    detail: string,
    // Section index in the document (entries can be filtered by the search).
    index: int,
}

export struct FormField {
    key: string,
    value: string,
    // "text" | "multiline" | "select" | "switch" | "mono"
    kind: string,
    options: [SelectOption],
    enabled: bool,
}

export struct ShortcutRow {
    id: string,
    // "global" | "composer"
    scope: string,
    bindings: [string],
    custom: bool,
}

export struct AgentCard {
    id: string,
    name: string,
    installed: bool,
    // CLI installed, ACP adapter missing (§9.10).
    adapter-missing: bool,
    version: string,
    // 0 present, 1 absent, 2 unknown
    auth: int,
    enabled: bool,
    mode: string,
    model: string,
    effort: string,
    modes: [SelectOption],
    models: [SelectOption],
    efforts: [SelectOption],
    mode-label: string,
    model-label: string,
    effort-label: string,
    program: string,
    args: string,
    env: string,
    // Connection test (hub test_agent): 0 not run, 1 running, 2 passed, 3 failed.
    test-state: int,
    test-latency: int,
    test-error: string,
}

export struct ProjectRow {
    id: string,
    name: string,
    path: string,
    // Last two path segments (design S14 sub line: "ZCode/Worse").
    short: string,
    sessions: int,
    last-used: string,
    unused: bool,
    selected: bool,
    // Workspace of the current window (design S14 "open" pill).
    current: bool,
}

export struct ArchiveRow {
    id: string,
    title: string,
    project: string,
    updated: string,
    // Display name of the session's agent (design S15 AGENT column).
    agent: string,
}

export global SettingsUi {
    in-out property <string> page: "general";
    in property <[NavEntry]> nav;
    // Narrow (< 720px) shows either the nav list or one page.
    in-out property <bool> narrow-nav: true;
    in property <int> rev;
    in property <string> data-dir;
    in property <string> pending-data-dir;
    in property <string> status;
    in property <bool> status-error;
    pure callback get-bool(string, int) -> bool;
    pure callback get-int(string, int) -> int;
    pure callback get-string(string, int) -> string;
    callback set-bool(string, bool);
    callback set-int(string, int);
    callback set-string(string, string);
    callback open-page(string);
    callback relocate-data-dir(string);
    callback cancel-relocation();
    // Settings S1 "Reset all settings to defaults" (app preferences only).
    callback reset-settings();
}

// Diff confirmation before every agent-config / document write (spec §1.3, §6.2).
export global DiffUi {
    in property <bool> open;
    in property <string> title;
    in property <string> path;
    in property <[DiffLine]> lines;
    in property <bool> no-op;
    in property <string> error;
    callback confirm();
    callback cancel();
}

// MCP / Skills / Commands / Hooks / Subagents (one pattern, spec §6.2).
export global ConfigUi {
    in property <string> concept;
    in property <string> agent: "claude-code";
    in property <string> scope: "user";
    in property <[ResRow]> rows;
    in property <[ResGroup]> groups;
    in property <bool> loading;
    in property <bool> supported: true;
    in property <bool> scope-supported: true;
    in property <bool> can-disable: true;
    in property <string> reason;
    in-out property <string> query;
    // Editor
    in property <bool> editing;
    in property <bool> is-new;
    in-out property <bool> raw-mode;
    in property <string> edit-name;
    in property <[FormField]> form;
    in-out property <string> raw;
    in property <string> raw-path;
    in property <string> error;
    callback select-agent(string);
    callback select-scope(string);
    callback search(string);
    callback refresh();
    callback edit(string);
    callback create();
    callback toggle(string, bool);
    callback remove(string);
    callback copy-to-harness(string);
    callback import(string);
    callback set-field(string, string);
    callback save();
    callback close-editor();
    callback open-folder(string);
}

// Instructions (CLAUDE.md / AGENTS.md / GEMINI.md) and Memory (MEMORY.md).
export global DocUi {
    in property <string> kind: "instructions";
    in property <string> agent: "claude-code";
    in property <string> scope: "user";
    in property <string> path;
    in property <bool> exists;
    in property <bool> supported: true;
    in-out property <string> text;
    in property <bool> dirty;
    in property <int> bytes;
    in property <int> limit: 102400;
    in-out property <string> query;
    in property <[string]> matches;
    in property <string> error;
    in property <string> saved;
    // Design S7/S8: file name, line count, unsaved diff against the saved text, memory entries.
    in property <string> file-name;
    in property <int> line-count: 1;
    in property <[DiffLine]> changes;
    in property <int> added;
    in property <int> removed;
    in property <[DocEntry]> entries;
    in property <int> entry-count;
    in-out property <int> selected: -1;
    in-out property <string> entry-text;
    callback select-entry(int);
    callback entry-edited(string);
    callback new-entry();
    callback delete-entry();
    callback select-agent(string);
    callback select-scope(string);
    callback edited(string);
    callback save();
    callback revert();
    callback refresh();
    callback search(string);
}

export global ShortcutsUi {
    in property <[ShortcutRow]> rows;
    in-out property <string> query;
    in property <string> key-query;
    in property <bool> key-search;
    in property <string> recording;
    in property <string> recorded;
    in property <string> error;
    // Command that owns the recorded binding (steal confirmation), empty when none.
    in property <string> conflict;
    callback search(string);
    callback start-key-search();
    callback clear-key-search();
    callback start-record(string);
    callback cancel-record();
    // text, control, alt, shift, meta -> true when consumed
    callback key(string, bool, bool, bool, bool) -> bool;
    callback steal();
    callback clear(string);
    callback reset-all();
    // Global dispatch: returns the command id bound to the key, or "".
    pure callback match(string, bool, bool, bool, bool) -> string;
    // Display text of a binding string ("CmdOrCtrl+Shift+l" -> "Ctrl+Shift+L").
    pure callback display(string) -> string;
    // Same, split into one keycap per key (design S6: "Ctrl" "Shift" "O").
    pure callback display-keys(string) -> [string];
}

// Extra Claude account (phase-9-parity.md §9.6).
export struct AccountRow {
    id: string,
    label: string,
    // 0 signed in, 1 not signed in, 2 unknown
    auth: int,
    // false until Harness restarts
    loaded: bool,
}

// Antigravity (agy) login slot; the login itself stays in Windows Credential Manager.
export struct AgyAccountRow {
    id: string,
    name: string,
    signed-in: bool,
    active: bool,
    exhausted: bool,
}

// Custom OpenAI-compatible provider (phase-9-parity.md §9.7). The key never reaches the UI.
export struct ProviderRow {
    id: string,
    label: string,
    model: string,
    endpoint: string,
    has-key: bool,
    // false until Harness restarts
    loaded: bool,
    // "" = OpenAI-compatible endpoint, "command-code" = one API key of the Command Code CLI
    kind: string,
}

// A ready-made API provider: picking it fills the endpoint and a default model, so only a key is needed.
export struct ProviderPreset {
    id: string,
    name: string,
    // short line under the name ("OpenAI-compatible", "local, no key")
    tag: string,
    url: string,
    model: string,
    // shown once picked: where the key comes from, limits
    note: string,
    // page that creates keys ("" = none)
    key-url: string,
    // a local server that needs no key
    keyless: bool,
    // monogram for providers without a logo
    letter: string,
}

export global AgentsUi {
    in property <[ProviderPreset]> presets;
    // id of the picked preset; "" = none picked yet, "custom" = any OpenAI-compatible endpoint
    in-out property <string> provider-preset;
    // the picked preset (set with provider-preset)
    in property <ProviderPreset> provider-current;
    // the endpoint field is shown (custom, or "edit" pressed on a preset)
    in-out property <bool> provider-edit-url;
    // models the endpoint listed (GET /models), filtered by the model field
    in property <[string]> provider-models;
    // "" idle, otherwise a status line for the model list ("Loading…", "41 models", an error)
    in property <string> provider-models-note;
    in property <bool> provider-models-loading;
    callback pick-preset(string);
    callback fetch-models();
    callback filter-models(string);
    callback open-key-page(string);
    in property <[AgentCard]> cards;
    in property <[ProviderRow]> providers;
    in-out property <string> provider-label;
    in-out property <string> provider-url;
    in-out property <string> provider-model;
    in-out property <string> provider-key;
    // "" = OpenAI-compatible endpoint; "command-code" = API keys of the Command Code CLI (provider-key then
    // holds one key per line, and the endpoint and model are not used).
    in-out property <string> provider-kind;
    in property <string> provider-error;
    in-out property <bool> provider-open;
    callback add-provider();
    callback remove-provider(string);
    in property <[AccountRow]> accounts;
    in-out property <string> account-label;
    in property <string> account-error;
    callback add-account(string);
    callback remove-account(string);
    callback login-account(string);
    callback refresh-accounts();
    in property <[AgyAccountRow]> agy-accounts;
    in property <bool> agy-available;
    in property <bool> agy-live-signed-in;
    in property <string> agy-pending;
    in-out property <string> agy-label;
    in property <string> agy-error;
    callback agy-add(string);
    callback agy-remove(string);
    callback agy-sign-in(string);
    callback agy-use(string);
    callback agy-import();
    callback agy-done();
    callback agy-refresh();
    callback agy-move-up(string);
    callback set-enabled(string, bool);
    callback set-default(string, string, string);
    callback test(string);
    callback refresh();
    in-out property <string> open-agent;
}

export global ProjectsUi {
    in property <[ProjectRow]> rows;
    in-out property <string> query;
    in-out property <bool> unused-only;
    in property <int> unused-count;
    // Sum of the sessions of every project (design S14 toolbar pill).
    in property <int> total-sessions;
    in property <int> selected;
    in property <bool> available;
    // Projects removed by the last remove (0 hides the undo bar).
    in property <int> undo-count;
    callback search(string);
    callback set-unused-only(bool);
    callback select(string, bool);
    // Row remove button (design S14): selects only this project before the confirm dialog.
    callback select-only(string);
    callback remove-selected(bool);
    callback undo-remove();
}

export global ArchiveUi {
    in property <[ArchiveRow]> rows;
    in-out property <string> query;
    in property <bool> available;
    in property <bool> has-more;
    callback search(string);
    callback unarchive(string);
    callback delete(string);
    callback more();
}

// One entry of Harness's local memory (Settings › Memory › Recall): a saved memory or the digest of a session.
export struct RecallRow {
    id: string,
    // "fact" | "preference" | "decision" | "howto" | "episode"
    kind: string,
    text: string,
    // "3d ago · Claude Code · worse"
    meta: string,
    pinned: bool,
}

// The local memory shared by every agent and session (`harness_agent_hub::recall`).
export global RecallUi {
    in property <[RecallRow]> rows;
    // live entries in the store, before the search and the filter
    in property <int> total;
    in property <string> note;
    in-out property <string> query;
    // "all" | "memories" | "sessions"
    in-out property <string> filter: "all";
    in property <bool> auto-recall: true;
    in property <bool> auto-capture: true;
    in-out property <string> draft;
    in-out property <string> draft-kind: "fact";
    in-out property <bool> draft-global;
    callback refresh();
    callback add();
    callback forget(string);
    callback pin(string, bool);
    callback set-auto-recall(bool);
    callback set-auto-capture(bool);
}

// One node of the graph picture.
export struct GraphNode {
    // position in the unit square
    x: float,
    y: float,
    label: string,
    // community index, for the colour
    tone: int,
    degree: int,
    // always shows its name (the most connected nodes)
    named: bool,
}

// Settings › Memory › Graph: the project's Graphify knowledge graph (`harness_agent_hub::graphify`).
export global GraphUi {
    // ---- the picture: the most connected nodes of the graph ----
    in property <[GraphNode]> view-nodes;
    // SVG path of the links, in a 1000 × 532 box
    in property <string> view-links;
    // the links of the selected node
    in property <string> view-focus;
    in property <int> view-selected: -1;
    // "client.py · src/client.py · 23 links · connects to …"
    in property <string> view-detail;
    // "The 160 most connected of 4,210 nodes"
    in property <string> view-note;
    callback view-select(int);

    // the `graphify` command was found
    in property <bool> installed;
    // the `graphify-mcp` command was found (agents then get the graph's tools)
    in property <bool> mcp;
    in property <string> cli-path;
    in property <string> install-command;
    // "uv" | "pipx" | "" (nothing here can install it: the command is only shown)
    in property <string> installer;
    in property <string> project;
    in property <bool> has-graph;
    // "1,204 nodes · 3,310 links · 18 communities · updated 2h ago"
    in property <string> summary;
    in property <bool> has-html;
    in property <bool> has-report;
    // a build or an install is running
    in property <bool> busy;
    // last lines of the running or finished command
    in property <string> log;
    in property <string> note;
    in property <bool> give-agents: true;
    callback refresh();
    callback build();
    callback install();
    callback open-html();
    callback open-report();
    callback set-give-agents(bool);
}

// Settings › Orchestra › Decision model (`harness_agent_hub::decision`): the API provider that picks the agent
// and model of a delegation that names none.
export global DecisionUi {
    // API providers that can answer: id + "Label · model"
    in property <[SelectOption]> providers;
    // "" = off
    in property <string> provider;
    in property <string> provider-label;
    in-out property <string> model;
    in property <bool> delegation: true;
    in property <string> note;
    callback refresh();
    callback set-provider(string);
    callback set-model(string);
    callback set-delegation(bool);
}
