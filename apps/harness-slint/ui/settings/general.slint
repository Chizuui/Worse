// General + Appearance pages — design frames "S1 · General" and "S2 · Appearance" (FigCraft), 1:1.
// Designed cards come first in design order; settings the design does not show (terminal, network, conversation,
// archive, storage, window & code) follow under "ADVANCED" so no feature is lost.
import { Theme } from "../theme/tokens.slint";
import { Look } from "../theme/look.slint";
import { ThinkGlyph, GlyphAnim, AsciiArt } from "../components/ascii.slint";
import { Button } from "../components/controls.slint";
import { SettingsUi } from "globals.slint";
import { PageHeader, Group, SettingRow, Switch, TextField, Stepper, RangeSlider, Select, SetButton, Pill, SegmentedControl, CapsLabel, Dot } from "parts.slint";

// Boolean row bound to one settings.json path.
component BoolRow inherits SettingRow {
    in property <string> key;
    Switch {
        label: root.title;
        checked: SettingsUi.get-bool(root.key, SettingsUi.rev);
        toggled(on) => {
            SettingsUi.set-bool(root.key, on);
        }
    }
}

// Text row with an explicit Save (terminal font, proxy, CA certificate).
component TextRow inherits SettingRow {
    in property <string> key;
    in property <string> placeholder;
    in property <bool> mono: false;
    property <string> stored: SettingsUi.get-string(root.key, SettingsUi.rev);
    below: true;
    HorizontalLayout {
        spacing: 8px;
        field := TextField {
            text: root.stored;
            label: root.title;
            placeholder: root.placeholder;
            mono: root.mono;
            accepted(value) => {
                SettingsUi.set-string(root.key, value);
            }
        }
        SetButton {
            text: @tr("Save");
            label: @tr("Save {0}", root.title);
            enabled: field.text != root.stored;
            clicked => {
                SettingsUi.set-string(root.key, field.text);
            }
        }
    }
}

component SectionCaps inherits HorizontalLayout {
    in property <string> text;
    padding-top: 6px;
    CapsLabel {
        text: root.text;
    }
}

export component GeneralPage inherits VerticalLayout {
    in property <bool> stacked;
    in property <bool> update-ready: false;
    callback restart-for-update();
    callback request-reset-settings();
    property <bool> moving: false;
    property <bool> confirm-move: false;
    property <string> version: SettingsUi.get-string("app.version", SettingsUi.rev);
    spacing: 18px;
    PageHeader {
        title: @tr("General");
        description: @tr("Language, send key, startup, live updates and notifications.");
    }
    // Card · Basics
    Group {
        title: @tr("Basics");
        note: @tr("Applies immediately");
        SettingRow {
            first: true;
            stacked: root.stacked;
            title: @tr("Language");
            description: @tr("Interface language for Harness itself.");
            Select {
                fit: true;
                property <string> value: SettingsUi.get-string("general.language", SettingsUi.rev);
                label: @tr("Language");
                options: [
                    { id: "system", label: @tr("System default") },
                    { id: "en-US", label: "English" },
                    { id: "zh-CN", label: "简体中文" },
                ];
                current: self.value;
                current-label: self.value == "en-US" ? "English" : self.value == "zh-CN" ? "简体中文" : @tr("System default");
                select(id) => {
                    SettingsUi.set-string("general.language", id);
                }
            }
        }
        SettingRow {
            stacked: root.stacked;
            title: @tr("Send message");
            description: @tr("Which key sends from the composer.");
            SegmentedControl {
                label: @tr("Send message");
                options: [{ id: "enter", label: "Enter" }, { id: "modEnter", label: "Ctrl+Enter" }];
                current: SettingsUi.get-string("general.composerSend", SettingsUi.rev);
                select(id) => {
                    SettingsUi.set-string("general.composerSend", id);
                }
            }
        }
        BoolRow {
            stacked: root.stacked;
            key: "general.launchAtStartup";
            title: @tr("Launch at startup");
            description: @tr("Open Harness when you sign in.");
        }
        SettingRow {
            stacked: root.stacked;
            title: @tr("Live update channel");
            description: @tr("Nightly gets new builds a week early.");
            SegmentedControl {
                label: @tr("Live update channel");
                options: [{ id: "stable", label: @tr("Stable") }, { id: "nightly", label: @tr("Nightly") }];
                current: SettingsUi.get-bool("updates.previewChannel", SettingsUi.rev) ? "nightly" : "stable";
                select(id) => {
                    SettingsUi.set-bool("updates.previewChannel", id == "nightly");
                }
            }
        }
        SettingRow {
            stacked: root.stacked;
            title: root.update-ready ? @tr("New build ready · v{0}", root.version) : @tr("Up to date · v{0}", root.version);
            description: root.update-ready ? @tr("Downloaded in the background. Restart to apply.") : @tr("New builds download in the background.");
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                if root.update-ready: VerticalLayout {
                    alignment: center;
                    Pill {
                        text: @tr("update");
                        tint: Theme.info;
                    }
                }
                if root.update-ready: SetButton {
                    text: @tr("Restart");
                    label: @tr("Restart to apply the new build");
                    variant: "accent";
                    clicked => {
                        root.restart-for-update();
                    }
                }
                if !root.update-ready: Pill {
                    text: @tr("latest");
                    tint: Theme.muted;
                }
            }
        }
    }
    // Card · Notifications
    Group {
        title: @tr("Notifications");
        note: @tr("Desktop");
        BoolRow {
            first: true;
            stacked: root.stacked;
            key: "notifications.taskDone";
            title: @tr("Subagent finished");
            description: @tr("When a delegated task completes.");
        }
        BoolRow {
            stacked: root.stacked;
            key: "notifications.buildDone";
            title: @tr("Build finished");
            description: @tr("When cargo build or CI finishes.");
        }
        BoolRow {
            stacked: root.stacked;
            key: "notifications.prReview";
            title: @tr("PR review requested");
            description: @tr("When a pull request asks for you.");
        }
        BoolRow {
            stacked: root.stacked;
            key: "notifications.sound";
            title: @tr("Play sound");
            description: @tr("Play a short chime with notifications.");
        }
    }
    // Card · Danger zone (no header: a single 66px row, pad 16).
    Group {
        SettingRow {
            first: true;
            stacked: root.stacked;
            pad-y: 16px;
            title: @tr("Reset all settings to defaults");
            description: @tr("Projects, sessions and API keys are kept.");
            SetButton {
                text: @tr("Reset all settings");
                variant: "destructive";
                clicked => {
                    root.request-reset-settings();
                }
            }
        }
    }

    // ---- Beyond the design: existing settings, kept below ----
    SectionCaps {
        text: @tr("ADVANCED");
    }
    Group {
        title: @tr("Conversation");
        note: @tr("Chat view");
        SettingRow {
            first: true;
            stacked: root.stacked;
            title: @tr("Messages sent while running");
            description: @tr("Queue waits for the current turn; Steer sends to the running agent.");
            SegmentedControl {
                label: @tr("Messages sent while running");
                options: [{ id: "queue", label: @tr("Queue") }, { id: "steer", label: @tr("Steer") }];
                current: SettingsUi.get-string("general.followUp", SettingsUi.rev);
                select(id) => {
                    SettingsUi.set-string("general.followUp", id);
                }
            }
        }
        BoolRow {
            stacked: root.stacked;
            key: "general.showReasoning";
            title: @tr("Show reasoning");
            description: @tr("Show the agent's thinking blocks in the conversation.");
        }
        BoolRow {
            stacked: root.stacked;
            key: "general.showTodos";
            title: @tr("Show to-do lists");
            description: @tr("Show the agent's plan as a checklist.");
        }
        BoolRow {
            stacked: root.stacked;
            key: "general.groupExploration";
            title: @tr("Group exploration steps");
            description: @tr("Collapse consecutive reads and searches into one row.");
        }
        BoolRow {
            stacked: root.stacked;
            key: "general.groupTerminal";
            title: @tr("Group terminal commands");
            description: @tr("Collapse consecutive commands into one row.");
        }
        BoolRow {
            stacked: root.stacked;
            key: "general.groupFileChanges";
            title: @tr("Group file changes");
            description: @tr("Collapse consecutive edits into one row.");
        }
    }
    Group {
        title: @tr("Terminal");
        note: @tr("Integrated terminals");
        BoolRow {
            first: true;
            stacked: root.stacked;
            key: "general.terminal.inheritSystemProfile";
            title: @tr("Use the system shell profile");
            description: @tr("Load your login shell profile (PATH, aliases) in integrated terminals.");
        }
        TextRow {
            stacked: root.stacked;
            key: "general.terminal.fontFamily";
            title: @tr("Terminal font");
            description: @tr("Font family for integrated terminals. Empty uses the default monospace font.");
            placeholder: Theme.mono-font;
        }
        SettingRow {
            stacked: root.stacked;
            title: @tr("Terminal font size");
            description: @tr("Text size in integrated terminals.");
            Stepper {
                label: @tr("Terminal font size");
                value: SettingsUi.get-int("general.terminal.fontSize", SettingsUi.rev);
                minimum: 9;
                maximum: 24;
                suffix: "px";
                changed-value(v) => {
                    SettingsUi.set-int("general.terminal.fontSize", v);
                }
            }
        }
        TextRow {
            stacked: root.stacked;
            key: "general.terminal.shell";
            title: @tr("Integrated shell");
            description: @tr("Program used for new terminals. Empty uses the system default.");
            placeholder: @tr("System default");
            mono: true;
        }
    }
    Group {
        title: @tr("Network");
        note: @tr("New agents only");
        TextRow {
            first: true;
            stacked: root.stacked;
            key: "general.proxy.httpProxy";
            title: @tr("HTTP proxy");
            description: @tr("Passed to agent CLIs started by Harness.");
            placeholder: "http://127.0.0.1:7890";
            mono: true;
        }
        TextRow {
            stacked: root.stacked;
            key: "general.proxy.noProxy";
            title: @tr("No proxy");
            placeholder: "localhost,127.0.0.1";
            mono: true;
        }
        TextRow {
            stacked: root.stacked;
            key: "general.proxy.caCertPath";
            title: @tr("CA certificate");
            description: @tr("Path to an extra PEM certificate trusted by agent CLIs.");
            placeholder: @tr("Path to a .pem file");
            mono: true;
        }
    }
    Group {
        title: @tr("System");
        note: @tr("Window and power");
        BoolRow {
            first: true;
            stacked: root.stacked;
            key: "general.hardwareAcceleration";
            title: @tr("Hardware acceleration");
            description: @tr("Use the GPU renderer. Restart Harness to apply.");
        }
        BoolRow {
            stacked: root.stacked;
            key: "notifications.closeToTray";
            title: @tr("Keep running in the tray when closed");
            description: @tr("Closing the window hides Harness instead of quitting.");
        }
        BoolRow {
            stacked: root.stacked;
            key: "notifications.keepAwake";
            title: @tr("Keep the computer awake while agents run");
            description: @tr("Prevents sleep while any session is working.");
        }
        BoolRow {
            stacked: root.stacked;
            key: "general.autoArchive";
            title: @tr("Archive inactive sessions automatically");
            description: @tr("Moves idle sessions to the archive.");
        }
        SettingRow {
            stacked: root.stacked;
            enabled: SettingsUi.get-bool("general.autoArchive", SettingsUi.rev);
            title: @tr("Archive after");
            description: @tr("Days without activity.");
            Stepper {
                label: @tr("Archive after");
                value: SettingsUi.get-int("general.autoArchiveDays", SettingsUi.rev);
                minimum: 1;
                maximum: 365;
                suffix: @tr(" days");
                changed-value(v) => {
                    SettingsUi.set-int("general.autoArchiveDays", v);
                }
            }
        }
    }
    Group {
        title: @tr("Storage");
        note: @tr("Data directory");
        SettingRow {
            first: true;
            stacked: root.stacked;
            wide: true;
            title: @tr("Data directory");
            description: SettingsUi.pending-data-dir != "" ? @tr("Moves to {0} on the next start.", SettingsUi.pending-data-dir) : SettingsUi.data-dir;
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                if SettingsUi.pending-data-dir != "": SetButton {
                    text: @tr("Cancel move");
                    clicked => {
                        SettingsUi.cancel-relocation();
                    }
                }
                if SettingsUi.pending-data-dir == "": SetButton {
                    text: @tr("Change…");
                    label: @tr("Change data directory");
                    clicked => {
                        root.moving = !root.moving;
                    }
                }
            }
        }
        if root.moving: VerticalLayout {
            padding: 16px;
            padding-top: 0px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                target := TextField {
                    label: @tr("New data directory");
                    placeholder: @tr("Absolute path of an empty or new folder");
                    mono: true;
                }
                SetButton {
                    text: @tr("Move");
                    variant: "accent";
                    enabled: target.text != "";
                    clicked => {
                        root.confirm-move = true;
                    }
                }
            }
            Text {
                text: @tr("Harness copies its data to the new folder on the next start, verifies it, then switches. The old folder is kept until the copy is verified.");
                font-size: Theme.ui-sm;
                color: Theme.muted;
                wrap: word-wrap;
            }
            if root.confirm-move: HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Text {
                    text: @tr("Move the data directory to {0}?", target.text);
                    color: Theme.foreground;
                    font-size: Theme.ui-sm;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                SetButton {
                    text: @tr("Cancel");
                    clicked => {
                        root.confirm-move = false;
                    }
                }
                SetButton {
                    text: @tr("Move on restart");
                    variant: "accent";
                    clicked => {
                        SettingsUi.relocate-data-dir(target.text);
                        root.confirm-move = false;
                        root.moving = false;
                    }
                }
            }
        }
    }
}

// Mini window mock line (design "l1/l2/l3").
component MockLine inherits Rectangle {
    in property <color> tint;
    height: 6px;
    border-radius: 3px;
    background: root.tint;
}

// Theme option tile (design S2 "opt · X": 272x157, fill #16181C, radius 10, pad 10, gap 8; selected = #7C8CFF border;
// preview 110 tall radius 6; label 12, #EDEEF0 when selected else #8A909A).
component ThemeOption inherits Rectangle {
    in property <string> title;
    in property <bool> selected;
    // 0 = split (System), 1 = dark, 2 = light.
    in property <int> kind;
    callback picked;
    horizontal-stretch: 1;
    min-width: 150px;
    height: 157px;
    border-radius: 10px;
    background: Theme.surface;
    border-width: 1px;
    border-color: root.selected ? Theme.accent-fg : (ta.has-hover ? Theme.border-hover : Theme.border);
    animate border-color { duration: Theme.dur-hover; }
    accessible-role: radio-button;
    accessible-label: root.title;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.picked();
    }
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Rectangle {
            height: 110px;
            border-radius: 6px;
            clip: true;
            background: root.kind == 2 ? #f3f2ee : #08090a;
            if root.kind != 0: HorizontalLayout {
                Rectangle {
                    width: 34px;
                    background: root.kind == 2 ? #e7e5df : #131416;
                }
                VerticalLayout {
                    padding-top: 18px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: start;
                    HorizontalLayout { alignment: start; MockLine { width: 150px; tint: root.kind == 2 ? #d5d3cc : #2c2d31; } }
                    HorizontalLayout { alignment: start; MockLine { width: 110px; tint: root.kind == 2 ? #d5d3cc : #2c2d31; } }
                    HorizontalLayout { alignment: start; MockLine { width: 70px; tint: root.kind == 2 ? #d5d3cc : #2c2d31; } }
                }
            }
            if root.kind == 0: HorizontalLayout {
                Rectangle {
                    background: #08090a;
                    HorizontalLayout {
                        Rectangle { width: 16px; background: #131416; }
                        VerticalLayout {
                            padding-top: 14px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: start;
                            HorizontalLayout { alignment: start; MockLine { width: 78px; height: 5px; tint: #2c2d31; } }
                            HorizontalLayout { alignment: start; MockLine { width: 58px; height: 5px; tint: #2c2d31; } }
                            HorizontalLayout { alignment: start; MockLine { width: 36px; height: 5px; tint: #2c2d31; } }
                        }
                    }
                }
                Rectangle {
                    background: #f3f2ee;
                    HorizontalLayout {
                        Rectangle { width: 16px; background: #e7e5df; }
                        VerticalLayout {
                            padding-top: 14px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: start;
                            HorizontalLayout { alignment: start; MockLine { width: 78px; height: 5px; tint: #d5d3cc; } }
                            HorizontalLayout { alignment: start; MockLine { width: 58px; height: 5px; tint: #d5d3cc; } }
                            HorizontalLayout { alignment: start; MockLine { width: 36px; height: 5px; tint: #d5d3cc; } }
                        }
                    }
                }
            }
        }
        Text {
            text: root.title;
            font-size: Theme.ui-sm;
            color: root.selected ? Theme.foreground : Theme.muted;
            accessible-role: none;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }
}

// Accent swatch (design 22x22 r11; selected = 1px #EDEEF0 ring).
component Swatch inherits Rectangle {
    in property <color> tint;
    in property <string> hex;
    in property <bool> selected;
    callback picked;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: root.tint;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.foreground;
    accessible-role: radio-button;
    accessible-label: root.hex;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.picked();
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }
}

// One "thinking" animation, playing, as a pickable tile.
component ThinkTile inherits Rectangle {
    in property <string> title;
    // Index into AsciiArt.think; -1 = shuffle (the tile walks through all of them).
    in property <int> index;
    in property <bool> selected;
    callback picked;
    property <int> walk;
    horizontal-stretch: 1;
    min-width: 64px;
    height: 66px;
    border-radius: 10px;
    background: tta.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: root.selected ? Theme.accent-fg : (tta.has-hover ? Theme.border-hover : Theme.border);
    animate border-color, background { duration: Theme.dur-hover; }
    accessible-role: radio-button;
    accessible-label: root.title;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.picked();
    }
    Timer {
        interval: 1.6s;
        running: root.index < 0 && !Theme.reduce-motion;
        triggered => {
            root.walk = mod(root.walk + 1, AsciiArt.think.length);
        }
    }
    Rectangle {
        y: 8px;
        height: 30px;
        ThinkGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            index: root.index < 0 ? root.walk : root.index;
            clocked: false;
            ink: root.selected ? Theme.foreground : Theme.foreground-subtle;
        }
    }
    Text {
        y: parent.height - self.height - 9px;
        width: parent.width;
        text: root.title;
        font-size: Theme.ui-xs + 1px;
        color: root.selected ? Theme.foreground : Theme.foreground-subtle;
        horizontal-alignment: center;
        overflow: elide;
    }
    tta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }
}

// One unicode backdrop field, moving, as a pickable tile.
component FieldTile inherits Rectangle {
    in property <string> title;
    in property <string> id;
    in property <bool> selected;
    callback picked;
    horizontal-stretch: 1;
    min-width: 64px;
    height: 80px;
    border-radius: 10px;
    background: fta.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: 1px;
    border-color: root.selected ? Theme.accent-fg : (fta.has-hover ? Theme.border-hover : Theme.border);
    animate border-color, background { duration: Theme.dur-hover; }
    accessible-role: radio-button;
    accessible-label: root.title;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.picked();
    }
    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: 42px;
        border-radius: 6px;
        background: Theme.canvas;
        clip: true;
        if root.id != "none": GlyphAnim {
            x: 5px;
            y: -3px;
            frames: root.id == "rain" ? AsciiArt.rain-left[0] : root.id == "stars" ? AsciiArt.stars-left[0] : root.id == "circuit" ? AsciiArt.circuit-left[0] : AsciiArt.field-left[0];
            interval: root.id == "rain" ? 130ms : root.id == "circuit" ? 195ms : root.id == "stars" ? 325ms : 455ms;
            font-size: 8px;
            letter-spacing: 5px;
            color: Theme.foreground.with-alpha(root.selected ? 0.6 : 0.4);
        }
    }
    Text {
        y: parent.height - self.height - 9px;
        width: parent.width;
        text: root.title;
        font-size: Theme.ui-xs + 1px;
        color: root.selected ? Theme.foreground : Theme.foreground-subtle;
        horizontal-alignment: center;
        overflow: elide;
    }
    fta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.picked();
        }
    }
}

export component AppearancePage inherits VerticalLayout {
    in property <bool> stacked;
    property <string> accent: SettingsUi.get-string("appearance.accentColor", SettingsUi.rev);
    spacing: 20px;
    PageHeader {
        title: @tr("Appearance");
        description: @tr("Theme, accent colour, text size and motion. Changes preview live.");
    }
    // Card · Theme
    Group {
        title: @tr("Theme");
        note: @tr("Applies immediately");
        HorizontalLayout {
            padding: 16px;
            spacing: 12px;
            ThemeOption {
                title: @tr("System");
                kind: 0;
                selected: Theme.pref != 1 && Theme.pref != 2;
                picked => {
                    SettingsUi.set-int("appearance.theme", 0);
                }
            }
            ThemeOption {
                title: @tr("Dark");
                kind: 1;
                selected: Theme.pref == 2;
                picked => {
                    SettingsUi.set-int("appearance.theme", 2);
                }
            }
            ThemeOption {
                title: @tr("Light");
                kind: 2;
                selected: Theme.pref == 1;
                picked => {
                    SettingsUi.set-int("appearance.theme", 1);
                }
            }
        }
    }
    // Card · Colour & type
    Group {
        title: @tr("Colour & type");
        note: @tr("Per window");
        SettingRow {
            first: true;
            stacked: root.stacked;
            wide: true;
            title: @tr("Accent colour");
            description: @tr("Used for focus rings, active nav and the brand gradient.");
            HorizontalLayout {
                spacing: 10px;
                alignment: end;
                for s in [
                    { c: #c8f04a, h: "#C8F04A" },
                    { c: #5fd8cb, h: "#5FD8CB" },
                    { c: #7cc4ff, h: "#7CC4FF" },
                    { c: #f5b14c, h: "#F5B14C" },
                    { c: #ff9a52, h: "#FF9A52" },
                    { c: #f2708a, h: "#F2708A" },
                    { c: #f4f4f5, h: "#F4F4F5" },
                ]: Swatch {
                    tint: s.c;
                    hex: s.h;
                    selected: root.accent == s.h || ((root.accent == "" || root.accent == "#7C8CFF") && s.h == "#C8F04A");
                    picked => {
                        SettingsUi.set-string("appearance.accentColor", s.h);
                    }
                }
            }
        }
        SettingRow {
            stacked: root.stacked;
            pad-y: 10px;
            title: @tr("Interface font");
            description: @tr("Typeface for chat, sidebar and settings.");
            Select {
                fit: true;
                property <string> value: SettingsUi.get-string("appearance.uiFont", SettingsUi.rev);
                label: @tr("Interface font");
                options: [
                    { id: "jakarta", label: "Plus Jakarta Sans" },
                    { id: "inter", label: "Inter" },
                    { id: "system", label: @tr("System default") },
                ];
                current: self.value;
                current-label: self.value == "inter" ? "Inter" : self.value == "system" ? @tr("System default") : "Plus Jakarta Sans";
                select(id) => {
                    SettingsUi.set-string("appearance.uiFont", id);
                }
            }
        }
        SettingRow {
            stacked: root.stacked;
            pad-y: 10px;
            title: @tr("Font size");
            description: @tr("Base size for chat, sidebar and settings.");
            SegmentedControl {
                label: @tr("Font size");
                options: [{ id: "12", label: "12" }, { id: "13", label: "13" }, { id: "14", label: "14" }, { id: "15", label: "15" }];
                current: SettingsUi.get-int("appearance.uiFontSize", SettingsUi.rev);
                select(id) => {
                    SettingsUi.set-int("appearance.uiFontSize", id.to-float());
                }
            }
        }
        SettingRow {
            stacked: root.stacked;
            pad-y: 10px;
            title: @tr("Density");
            description: @tr("Comfortable adds padding to rows and messages.");
            SegmentedControl {
                label: @tr("Density");
                options: [{ id: "compact", label: @tr("Compact") }, { id: "comfortable", label: @tr("Comfortable") }];
                current: SettingsUi.get-string("appearance.density", SettingsUi.rev);
                select(id) => {
                    SettingsUi.set-string("appearance.density", id);
                }
            }
        }
        BoolRow {
            stacked: root.stacked;
            pad-y: 10px;
            key: "appearance.reduceMotion";
            title: @tr("Reduce motion");
            description: @tr("Disable transitions and animated typing.");
        }
        BoolRow {
            stacked: root.stacked;
            pad-y: 10px;
            key: "appearance.showTokenUsage";
            title: @tr("Show token usage in sidebar");
            description: @tr("A small ring next to each session shows context use.");
        }
    }
    // Card · While the agent works
    Group {
        title: @tr("While the agent works");
        note: @tr("Unicode animation beside the status line");
        think-box := VerticalLayout {
            padding: 16px;
            spacing: 8px;
            property <string> pick: SettingsUi.get-string("appearance.thinkingStyle", SettingsUi.rev);
            HorizontalLayout {
                spacing: 8px;
                for t in [
                    { id: "scan", title: @tr("Scan"), index: 0 },
                    { id: "bars", title: @tr("Bars"), index: 1 },
                    { id: "pulse", title: @tr("Pulse"), index: 2 },
                    { id: "quads", title: @tr("Quads"), index: 3 },
                    { id: "charge", title: @tr("Charge"), index: 4 },
                ]: ThinkTile {
                    title: t.title;
                    index: t.index;
                    selected: think-box.pick == t.id || (think-box.pick == "" && t.id == "scan");
                    picked => {
                        SettingsUi.set-string("appearance.thinkingStyle", t.id);
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                for t in [
                    { id: "moon", title: @tr("Moon"), index: 5 },
                    { id: "cipher", title: @tr("Cipher"), index: 6 },
                    { id: "chevrons", title: @tr("Chevrons"), index: 7 },
                    { id: "bunny", title: @tr("Bunny"), index: 8 },
                    { id: "shuffle", title: @tr("Shuffle"), index: -1 },
                ]: ThinkTile {
                    title: t.title;
                    index: t.index;
                    selected: think-box.pick == t.id;
                    picked => {
                        SettingsUi.set-string("appearance.thinkingStyle", t.id);
                    }
                }
            }
        }
        SettingRow {
            stacked: root.stacked;
            pad-y: 10px;
            title: @tr("Status words");
            description: @tr("Plain says \"Thinking…\"; Playful rotates through a few bunny-flavoured lines.");
            SegmentedControl {
                label: @tr("Status words");
                options: [{ id: "plain", label: @tr("Plain") }, { id: "playful", label: @tr("Playful") }];
                current: SettingsUi.get-string("appearance.statusWords", SettingsUi.rev);
                select(id) => {
                    SettingsUi.set-string("appearance.statusWords", id);
                }
            }
        }
    }
    // Card · Background
    Group {
        title: @tr("Background");
        note: @tr("Unicode field, wallpaper, blur and dim");
        field-box := VerticalLayout {
            padding: 16px;
            spacing: 8px;
            property <string> pick: SettingsUi.get-string("appearance.backdropField", SettingsUi.rev);
            HorizontalLayout {
                spacing: 8px;
                for t in [
                    { id: "dither", title: @tr("Dither") },
                    { id: "rain", title: @tr("Rain") },
                    { id: "stars", title: @tr("Stars") },
                    { id: "circuit", title: @tr("Circuit") },
                    { id: "none", title: @tr("None") },
                ]: FieldTile {
                    title: t.title;
                    id: t.id;
                    selected: field-box.pick == t.id || (field-box.pick == "" && t.id == "dither");
                    picked => {
                        SettingsUi.set-string("appearance.backdropField", t.id);
                    }
                }
            }
        }
        SettingRow {
            stacked: root.stacked;
            wide: true;
            pad-y: 10px;
            title: @tr("Motion");
            description: @tr("When the field moves. Always keeps it moving during chats and uses more CPU.");
            SegmentedControl {
                label: @tr("Motion");
                options: [{ id: "home", label: @tr("Home only") }, { id: "always", label: @tr("Always") }, { id: "off", label: @tr("Off") }];
                current: SettingsUi.get-string("appearance.backdropMotion", SettingsUi.rev);
                select(id) => {
                    SettingsUi.set-string("appearance.backdropMotion", id);
                }
            }
        }
        SettingRow {
            stacked: root.stacked;
            wide: true;
            pad-y: 10px;
            title: @tr("Wallpaper");
            description: Look.wallpaper-note == "loading" ? @tr("Loading…") : Look.wallpaper-note != "" ? @tr("Could not load: {}", Look.wallpaper-note) : Look.wallpaper-name != "" ? Look.wallpaper-name : @tr("A picture or an animated GIF / WebP behind the whole window.");
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                if Look.wallpaper-name != "": SetButton {
                    text: @tr("Remove");
                    variant: "ghost";
                    clicked => {
                        Look.clear-wallpaper();
                    }
                }
                SetButton {
                    text: @tr("Choose image…");
                    clicked => {
                        Look.pick-wallpaper();
                    }
                }
            }
        }
        SettingRow {
            stacked: root.stacked;
            wide: true;
            pad-y: 10px;
            title: @tr("Blur");
            description: @tr("Softens the wallpaper. Glass panels always show a frosted copy of it.");
            RangeSlider {
                label: @tr("Blur");
                value: SettingsUi.get-int("appearance.wallpaperBlur", SettingsUi.rev);
                maximum: 40;
                suffix: "px";
                changed-value(v) => {
                    SettingsUi.set-int("appearance.wallpaperBlur", v);
                }
            }
        }
        SettingRow {
            stacked: root.stacked;
            wide: true;
            pad-y: 10px;
            title: @tr("Dim");
            description: @tr("How much of the theme colour covers the wallpaper: darker in dark mode, lighter in light mode.");
            RangeSlider {
                label: @tr("Dim");
                value: SettingsUi.get-int("appearance.wallpaperDim", SettingsUi.rev);
                maximum: 95;
                suffix: "%";
                moved(v) => {
                    Look.dim = v / 100;
                }
                changed-value(v) => {
                    SettingsUi.set-int("appearance.wallpaperDim", v);
                }
            }
        }
    }
    // Card · Preview
    Group {
        title: @tr("Preview");
        note: @tr("Sample chat bubble");
        HorizontalLayout {
            padding: 16px;
            alignment: start;
            Rectangle {
                background: Theme.surface;
                border-radius: 10px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: start;
                        Pill {
                            text: "Claude Code";
                            tint: Theme.accent-fg;
                        }
                    }
                    Text {
                        text: "cargo build -p harness-slint finished in 41s";
                        font-size: Theme.ui-caption;
                        color: Theme.foreground-subtle;
                    }
                }
            }
        }
    }

    // ---- Beyond the design: existing settings, kept below ----
    SectionCaps {
        text: @tr("ADVANCED");
    }
    Group {
        title: @tr("Window & code");
        note: @tr("Native frame needs a restart");
        SettingRow {
            first: true;
            stacked: root.stacked;
            title: @tr("Zoom");
            description: @tr("Scales the whole window. Ctrl+= / Ctrl+- also change zoom.");
            Stepper {
                label: @tr("Zoom");
                value: SettingsUi.get-int("appearance.zoomPercent", SettingsUi.rev);
                minimum: 80;
                maximum: 150;
                step: 10;
                suffix: "%";
                changed-value(v) => {
                    SettingsUi.set-int("appearance.zoomPercent", v);
                }
            }
        }
        BoolRow {
            stacked: root.stacked;
            key: "appearance.nativeFrame";
            title: @tr("Use Windows title bar");
            description: @tr("Native frame, snapping and resize borders. Takes effect after restarting Harness.");
        }
        SettingRow {
            stacked: root.stacked;
            title: @tr("Code font size");
            description: @tr("Code blocks, diffs and the file viewer.");
            Stepper {
                label: @tr("Code font size");
                value: SettingsUi.get-int("appearance.codeFontSize", SettingsUi.rev);
                minimum: 10;
                maximum: 20;
                suffix: "px";
                changed-value(v) => {
                    SettingsUi.set-int("appearance.codeFontSize", v);
                }
            }
        }
        BoolRow {
            stacked: root.stacked;
            key: "appearance.wrapLines";
            title: @tr("Wrap long lines");
            description: @tr("Wrap code in chat code blocks and the file viewer instead of scrolling.");
        }
        BoolRow {
            stacked: root.stacked;
            key: "appearance.lineNumbers";
            title: @tr("Line numbers");
            description: @tr("Show line numbers in the file viewer and diffs.");
        }
    }
}
