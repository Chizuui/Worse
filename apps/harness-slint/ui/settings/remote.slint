// Remote page (design frame S5 "Remote"): Tunnel card (status, public URL + Copy / Restart, enable + pairing rows),
// Pair a device (QR + code), Paired devices. The tunnel helper fields and raw output stay in an extra card below.
import { Theme } from "../theme/tokens.slint";
import { Divider } from "../components/controls.slint";
import { SettingRow, Switch, TextField } from "parts.slint";
import { SettingsUi } from "globals.slint";

export struct RemoteDevice {
    id: string,
    name: string,
    created: string,
    last-seen: string,
}

export global RemoteUi {
    in property <int> server-state;
    in property <string> server-text;
    in property <string> local-url;
    in property <bool> has-url;
    in property <string> public-url;
    in property <int> tunnel-state;
    in property <string> tunnel-text;
    in property <string> tunnel-hint;
    in property <[string]> tunnel-log;
    in property <string> pair-url;
    in property <string> pair-code;
    in property <string> pair-expiry;
    in property <bool> has-qr;
    in property <image> qr;
    in property <[RemoteDevice]> devices;
    in property <string> note;
    in-out property <bool> log-open;
    callback set-enabled(bool);
    callback start-tunnel();
    callback stop-tunnel();
    callback pair-new();
    callback revoke(string);
    callback refresh();
    callback copy(string);
    callback open-url(string);
}

global RemoteLook {
    out property <color> danger: Theme.destructive;
    out property <color> offline: #3A3E45;
}

// Card (design S5: #111215, 1px #24272D, radius 12; header 40 tall pad [14,16,10,16], 13 title + 11 caps note).
component RCard inherits Rectangle {
    in property <string> title;
    in property <string> note;
    background: Theme.card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    VerticalLayout {
        HorizontalLayout {
            padding-top: 14px;
            padding-bottom: 10px;
            padding-left: 16px;
            padding-right: 16px;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: Theme.weight-semibold;
                color: Theme.foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.note;
                font-size: 11px;
                color: Theme.caps-label;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        @children
    }
}

component Sep inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// Raised button (design: pad [7,12], #1C1F24, 1px #2A2D33, radius 8, 12px text); `danger` = red tint.
component RButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    height: root.danger ? 29px : 31px;
    horizontal-stretch: 0;
    border-radius: 8px;
    background: root.danger ? RemoteLook.danger.with-alpha(ta.has-hover ? 0.2 : 0.12) : (ta.has-hover && root.enabled ? Theme.border-hover : Theme.raised);
    border-width: 1px;
    border-color: root.danger ? RemoteLook.danger.with-alpha(0.45) : Theme.border-hover;
    opacity: root.enabled ? 1 : 0.5;
    animate background { duration: Theme.dur-hover; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: Theme.weight-medium;
            color: root.danger ? RemoteLook.danger : Theme.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ToggleRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    padding-top: 14px;
    padding-bottom: 14px;
    padding-left: 16px;
    padding-right: 16px;
    spacing: 16px;
    VerticalLayout {
        spacing: 3px;
        horizontal-stretch: 1;
        alignment: center;
        Text {
            text: root.title;
            font-size: 13px;
            color: Theme.foreground;
        }
        Text {
            text: root.description;
            font-size: 12px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: center;
        @children
    }
}

component FieldRow inherits SettingRow {
    in property <string> key;
    in property <string> placeholder;
    in property <bool> numeric: false;
    property <string> stored: SettingsUi.get-string(root.key, SettingsUi.rev);
    below: true;
    HorizontalLayout {
        spacing: 8px;
        field := TextField {
            text: root.stored;
            label: root.title;
            placeholder: root.placeholder;
            mono: true;
            accepted(value) => {
                root.save(value);
            }
        }
        VerticalLayout {
            alignment: center;
            RButton {
                text: @tr("Save");
                enabled: field.text != root.stored && (!root.numeric || field.text.is-float());
                clicked => {
                    root.save(field.text);
                }
            }
        }
    }
    function save(value: string) {
        if root.numeric {
            if value.is-float() {
                SettingsUi.set-int(root.key, value.to-float());
            }
        } else {
            SettingsUi.set-string(root.key, value);
        }
    }
}

export component RemotePage inherits VerticalLayout {
    in property <bool> stacked;
    property <bool> running: RemoteUi.server-state == 1 || RemoteUi.server-state == 2;
    property <bool> tunnel-running: RemoteUi.tunnel-state == 1 || RemoteUi.tunnel-state == 2;
    property <string> bin: SettingsUi.get-string("remote.tunnelBin", SettingsUi.rev);
    property <string> url: RemoteUi.has-url ? RemoteUi.public-url : RemoteUi.local-url;
    property <color> tunnel-tone: RemoteUi.tunnel-state == 2 ? Theme.success : RemoteUi.tunnel-state == 1 ? Theme.warning : RemoteUi.tunnel-state == 3 ? RemoteLook.danger : Theme.icon-subtlest;
    spacing: 16px;
    // Title block (design: h1 22 + 13px subtitle, gap 6).
    VerticalLayout {
        spacing: 6px;
        Text {
            text: @tr("Remote");
            font-family: Theme.display-font;
            font-size: 22px;
            font-weight: 700;
            color: Theme.foreground;
        }
        Text {
            text: "Reach Harness from your phone through a Cloudflare tunnel.";
            font-size: 13px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    if RemoteUi.note != "": Text {
        text: RemoteUi.note;
        font-size: 12px;
        color: Theme.destructive-surface-foreground;
        wrap: word-wrap;
    }
    // ---- Tunnel ----
    RCard {
        title: "Tunnel";
        note: root.bin != "" ? root.bin : "cloudflared";
        HorizontalLayout {
            padding-top: 14px;
            padding-bottom: 14px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    border-radius: 999px;
                    background: root.tunnel-tone.with-alpha(0.12);
                    horizontal-stretch: 0;
                    HorizontalLayout {
                        padding-top: 3px;
                        padding-bottom: 3px;
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: "● " + (RemoteUi.tunnel-state == 2 ? "Connected" : RemoteUi.tunnel-state == 1 ? @tr("Starting") : RemoteUi.tunnel-state == 3 ? @tr("Error") : @tr("Off"));
                            font-size: 11px;
                            font-weight: Theme.weight-medium;
                            color: root.tunnel-tone;
                        }
                    }
                }
            }
            Text {
                text: RemoteUi.tunnel-text != "" ? RemoteUi.tunnel-text : RemoteUi.tunnel-hint;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: RemoteUi.server-text;
                font-size: 11px;
                color: Theme.icon-subtlest;
                vertical-alignment: center;
                overflow: elide;
                max-width: 320px;
            }
        }
        Sep { }
        HorizontalLayout {
            padding-top: 14px;
            padding-bottom: 14px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            Rectangle {
                height: 34px;
                horizontal-stretch: 1;
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: root.url != "" ? root.url : (root.running ? "Start the tunnel to get a public URL" : "Remote access is off");
                        font-size: 12px;
                        color: root.url != "" ? Theme.foreground-subtle : Theme.icon-subtlest;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                TouchArea {
                    enabled: RemoteUi.has-url;
                    mouse-cursor: RemoteUi.has-url ? MouseCursor.pointer : MouseCursor.default;
                    clicked => {
                        RemoteUi.open-url(RemoteUi.public-url);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                RButton {
                    text: "Copy";
                    enabled: root.url != "";
                    clicked => {
                        RemoteUi.copy(root.url);
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                RButton {
                    text: root.tunnel-running ? "Restart tunnel" : @tr("Start tunnel");
                    enabled: RemoteUi.server-state == 2;
                    clicked => {
                        if root.tunnel-running {
                            RemoteUi.stop-tunnel();
                        }
                        RemoteUi.start-tunnel();
                    }
                }
            }
        }
        Sep { }
        ToggleRow {
            title: "Enable remote access";
            description: "Start the tunnel automatically when Harness launches.";
            Switch {
                label: "Enable remote access";
                checked: root.running;
                toggled(on) => {
                    RemoteUi.set-enabled(on);
                }
            }
        }
        Sep { }
        // Pairing is always required by the server; the toggle shows that state and cannot be turned off.
        ToggleRow {
            title: "Require pairing code";
            description: "New devices must enter a 6-digit code before they can connect.";
            Switch {
                label: "Require pairing code (always on)";
                checked: true;
                enabled: false;
            }
        }
    }
    // ---- Pair a device ----
    RCard {
        title: @tr("Pair a device");
        note: "ANDROID · PHONE BROWSER";
        HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 16px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 20px;
            Rectangle {
                width: 182px;
                height: 182px;
                background: Theme.surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                if RemoteUi.has-qr && RemoteUi.pair-code != "": Rectangle {
                    x: 11px;
                    y: 11px;
                    width: 160px;
                    height: 160px;
                    background: #FFFFFF;
                    border-radius: 8px;
                    accessible-role: AccessibleRole.image;
                    accessible-label: @tr("Pairing QR code");
                    Image {
                        width: parent.width - 12px;
                        height: parent.height - 12px;
                        source: RemoteUi.qr;
                        image-rendering: pixelated;
                        image-fit: contain;
                    }
                }
                if !(RemoteUi.has-qr && RemoteUi.pair-code != ""): Text {
                    x: 16px;
                    width: parent.width - 32px;
                    height: parent.height;
                    text: RemoteUi.has-url ? "Generate a code to show the QR" : "The QR appears once the tunnel is up";
                    font-size: 11px;
                    color: Theme.icon-subtlest;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                spacing: 10px;
                horizontal-stretch: 1;
                alignment: start;
                Text {
                    text: "Scan with the Harness Android app";
                    font-size: 15px;
                    font-weight: Theme.weight-semibold;
                    color: Theme.foreground;
                }
                Text {
                    text: "Open Harness on your phone, tap “Pair device” and point the camera at the code. The device gets its own session list and can send messages to any agent that is running here.";
                    font-size: 12px;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                if RemoteUi.pair-code != "": HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        height: 41px;
                        background: Theme.raised;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.border-hover;
                        horizontal-stretch: 0;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text {
                                text: RemoteUi.pair-code;
                                font-size: 22px;
                                font-weight: Theme.weight-semibold;
                                letter-spacing: 2px;
                                color: Theme.foreground;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: RemoteUi.pair-expiry;
                        font-size: 11px;
                        color: Theme.icon-subtlest;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    RButton {
                        text: RemoteUi.pair-code != "" ? "Regenerate" : @tr("Pair new device");
                        enabled: RemoteUi.server-state == 2;
                        clicked => {
                            RemoteUi.pair-new();
                        }
                    }
                    if RemoteUi.pair-url != "": RButton {
                        text: @tr("Copy pair link");
                        clicked => {
                            RemoteUi.copy(RemoteUi.pair-url);
                        }
                    }
                    Text {
                        text: RemoteUi.server-state == 2 ? "Only devices on the same tunnel can use it." : "Turn on remote access to pair a device.";
                        font-size: 11px;
                        color: Theme.icon-subtlest;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    // ---- Paired devices ----
    RCard {
        title: @tr("Paired devices");
        note: RemoteUi.devices.length + (RemoteUi.devices.length == 1 ? " DEVICE" : " DEVICES");
        for d[i] in RemoteUi.devices: VerticalLayout {
            if i > 0: Sep { }
            HorizontalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: RemoteLook.offline;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 8px;
                        background: Theme.accent-fg.with-alpha(0.12);
                        Text {
                            text: "▯"; font-family: "Segoe UI Symbol";
                            font-size: 11px;
                            color: Theme.accent-fg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    Text {
                        text: d.name;
                        font-size: 13px;
                        color: Theme.foreground;
                        overflow: elide;
                    }
                    Text {
                        text: @tr("Paired {0} · last seen {1}", d.created, d.last-seen);
                        font-size: 11px;
                        color: Theme.icon-subtlest;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    RButton {
                        text: "Revoke";
                        danger: true;
                        clicked => {
                            RemoteUi.revoke(d.id);
                        }
                    }
                }
            }
        }
        if RemoteUi.devices.length == 0: HorizontalLayout {
            padding-top: 12px;
            padding-bottom: 16px;
            padding-left: 16px;
            padding-right: 16px;
            Text {
                text: RemoteUi.server-state == 2 ? @tr("No paired devices") : @tr("Start the server to see paired devices");
                font-size: 12px;
                color: Theme.icon-subtlest;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            RButton {
                text: "Refresh";
                clicked => {
                    RemoteUi.refresh();
                }
            }
        }
    }
    // ---- Tunnel helper (not in the design frame; keeps the server/tunnel configuration reachable) ----
    RCard {
        title: "Tunnel helper";
        note: "ADVANCED";
        Sep { }
        FieldRow {
            first: true;
            stacked: root.stacked;
            key: "remote.port";
            numeric: true;
            title: @tr("Port");
            description: @tr("Loopback port of the local server. Applies the next time the server starts.");
            placeholder: "7878";
        }
        FieldRow {
            stacked: root.stacked;
            key: "remote.tunnelBin";
            title: @tr("Tunnel binary");
            description: @tr("Started as: <binary> http <port> --name <subdomain>.");
            placeholder: "cftunnel (on PATH) or C:\\tools\\cftunnel.exe";
        }
        FieldRow {
            stacked: root.stacked;
            key: "remote.subdomain";
            title: @tr("Subdomain");
            description: @tr("Name of the tunnel. Leave empty for a quick tunnel with a random host.");
            placeholder: "harness";
        }
        FieldRow {
            stacked: root.stacked;
            key: "remote.tunnelDomain";
            title: @tr("Tunnel domain");
            description: @tr("Used as https://<subdomain>.<domain> when the helper prints no URL.");
            placeholder: "example.com";
        }
        Sep { }
        HorizontalLayout {
            padding-top: 14px;
            padding-bottom: 14px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            VerticalLayout {
                spacing: 3px;
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: @tr("Raw tunnel output");
                    font-size: 13px;
                    color: Theme.foreground;
                }
                Text {
                    text: RemoteUi.tunnel-log.length == 0 ? @tr("No output yet.") : @tr("Last {0} lines.", RemoteUi.tunnel-log.length);
                    font-size: 12px;
                    color: Theme.muted;
                }
            }
            if root.tunnel-running: VerticalLayout {
                alignment: center;
                RButton {
                    text: @tr("Stop tunnel");
                    clicked => {
                        RemoteUi.stop-tunnel();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                RButton {
                    text: RemoteUi.log-open ? @tr("Hide") : @tr("Show");
                    clicked => {
                        RemoteUi.log-open = !RemoteUi.log-open;
                    }
                }
            }
        }
        if RemoteUi.log-open: VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 16px;
            Rectangle {
                background: Theme.canvas;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                accessible-role: AccessibleRole.text;
                accessible-label: @tr("Raw tunnel output");
                VerticalLayout {
                    padding: 12px;
                    spacing: 2px;
                    for line in RemoteUi.tunnel-log: Text {
                        text: line;
                        font-family: Theme.mono-font;
                        font-size: Theme.code-size;
                        color: Theme.foreground-subtle;
                        wrap: word-wrap;
                    }
                    if RemoteUi.tunnel-log.length == 0: Text {
                        text: @tr("No output yet.");
                        font-size: 11px;
                        color: Theme.icon-subtlest;
                    }
                }
            }
        }
    }
}
