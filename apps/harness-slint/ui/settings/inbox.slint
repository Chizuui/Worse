import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, Button, IconButton, Divider, Card, Tag, Dialog } from "../components/controls.slint";
import { PageHeader, Group, SettingRow, Switch, TextField, Select, SelectOption, StatusLine } from "parts.slint";

export struct InboxSourceRow {
    id: string,
    repo: string,
    folder: string,
    detail: string,
    enabled: bool,
    failing: bool,
    has-router: bool,
}

export struct InboxTicketRow {
    id: string,
    title: string,
    meta: string,
    status: string,
    tone: string,
    pr: string,
    error: string,
    has-session: bool,
    can-post: bool,
    can-stop: bool,
    can-discard: bool,
    shadow: bool,
}

export struct InboxTriggerRow {
    title: string,
    verdict: string,
    accepted: bool,
    time: string,
}

// Design S4 inbox row: unread dot, agent chip, title + meta, status pill.
export struct InboxNotice {
    id: string,
    chip: string,
    tint: color,
    title: string,
    meta: string,
    pill: string,
    pill-tint: color,
    trailing: string,
    unread: bool,
    can-open: bool,
}

export global InboxUi {
    in property <[InboxNotice]> notices;
    in property <string> filter: "all";
    in property <int> count-all;
    in property <int> count-unread;
    in property <int> count-subagents;
    in property <int> count-builds;
    in property <bool> enabled;
    in property <bool> gh-ready;
    in property <string> gh-text;
    in property <int> gh-state;
    in property <bool> gh-installing;
    in property <[InboxSourceRow]> sources;
    in property <[InboxTicketRow]> tickets;
    in property <[InboxTriggerRow]> triggers;
    in property <string> error;
    in property <string> busy;
    in property <[SelectOption]> agents;
    in-out property <bool> form-open;
    in-out property <string> form-id;
    in-out property <string> form-repo;
    in-out property <string> form-folder;
    in-out property <string> form-users;
    in-out property <string> form-handle;
    in-out property <string> form-agent;
    in-out property <string> form-agent-label;
    in-out property <int> form-minutes: 2;
    in-out property <bool> form-draft;
    in-out property <bool> form-enabled: true;
    in-out property <bool> form-route;
    in-out property <string> form-shadow;
    in-out property <string> form-error;
    callback set-enabled(bool);
    callback action(string, string);
    callback save-form();
}

component Caption inherits Text {
    font-size: Theme.ui-xs;
    color: Theme.icon-subtlest;
    overflow: elide;
}

// Card header (design S4: 13 semibold + 11 faint hint, 15/16 padding).
component CardHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> hint;
    height: 46px;
    padding-left: 16px;
    padding-right: 16px;
    alignment: space-between;
    Text {
        text: root.title;
        font-size: Theme.ui-caption;
        font-weight: Theme.weight-semibold;
        color: Theme.foreground;
        vertical-alignment: center;
    }
    if root.hint != "": Text {
        text: root.hint;
        font-size: Theme.ui-xs;
        color: Theme.icon-subtlest;
        vertical-alignment: center;
    }
}

// Agent colour tile (design S4 "chip": 28px, radius 8, agent colour at 12%, initial in the colour).
component AgentChip inherits Rectangle {
    in property <string> initial;
    in property <color> tint: Theme.accent-fg;
    width: 28px;
    height: 28px;
    border-radius: Theme.radius-md;
    background: root.tint.with-alpha(0.12);
    Text {
        text: root.initial;
        font-size: Theme.ui-xs;
        font-weight: Theme.weight-semibold;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}

component SourceRow inherits Rectangle {
    in property <InboxSourceRow> item;
    background: hta.has-hover ? Theme.surface-hover : transparent;
    animate background { duration: Theme.dur-hover; }
    hta := TouchArea { }
    HorizontalLayout {
        min-height: 58px;
        padding-left: 16px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            AgentChip {
                initial: "◎";
                tint: root.item.failing ? Theme.destructive : Theme.accent-fg;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.item.repo;
                font-size: Theme.ui-caption;
                font-weight: Theme.weight-semibold;
                color: Theme.foreground;
                overflow: elide;
            }
            Caption {
                text: root.item.folder;
                font-family: Theme.mono-font;
            }
            Caption {
                text: root.item.detail;
                color: root.item.failing ? Theme.destructive : Theme.icon-subtlest;
            }
        }
        VerticalLayout {
            alignment: center;
            Switch {
                label: @tr("Watch {0}", root.item.repo);
                checked: root.item.enabled;
                toggled(on) => {
                    InboxUi.action(on ? "enable" : "disable", root.item.id);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: InboxUi.busy == root.item.id ? @tr("Checking…") : @tr("Check now");
                size: "sm";
                enabled: InboxUi.enabled && root.item.enabled && InboxUi.busy == "";
                clicked => {
                    InboxUi.action("poll", root.item.id);
                }
            }
        }
        if root.item.has-router: VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.network;
                label: @tr("Open router");
                size: Theme.control-sm;
                icon-size: Theme.icon-xs;
                clicked => {
                    InboxUi.action("open-router", root.item.id);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.pencil;
                label: @tr("Edit {0}", root.item.repo);
                size: Theme.control-sm;
                icon-size: Theme.icon-xs;
                clicked => {
                    InboxUi.action("edit", root.item.id);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.trash-2;
                label: @tr("Remove {0}", root.item.repo);
                size: Theme.control-sm;
                icon-size: Theme.icon-xs;
                clicked => {
                    InboxUi.action("remove", root.item.id);
                }
            }
        }
    }
}

component TicketRow inherits Rectangle {
    in property <InboxTicketRow> item;
    background: hta.has-hover ? Theme.surface-hover : transparent;
    animate background { duration: Theme.dur-hover; }
    hta := TouchArea { }
    HorizontalLayout {
        min-height: 60px;
        padding-left: 16px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.item.title;
                    font-size: Theme.ui-caption;
                    font-weight: Theme.weight-medium;
                    color: Theme.foreground;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                if root.item.shadow: Tag {
                    text: @tr("Shadow");
                    tone: "neutral";
                }
                Tag {
                    text: root.item.status;
                    tone: root.item.tone;
                }
            }
            Caption {
                text: root.item.meta;
            }
            if root.item.pr != "": Caption {
                text: root.item.pr;
                color: Theme.accent-fg;
            }
            if root.item.error != "": Caption {
                text: root.item.error;
                color: Theme.destructive;
            }
        }
        if root.item.has-session: VerticalLayout {
            alignment: center;
            Button {
                text: @tr("Open session");
                size: "sm";
                clicked => {
                    InboxUi.action("open-session", root.item.id);
                }
            }
        }
        if root.item.can-post: VerticalLayout {
            alignment: center;
            Button {
                text: root.item.shadow ? @tr("Promote") : @tr("Post");
                variant: "primary";
                size: "sm";
                clicked => {
                    InboxUi.action("post", root.item.id);
                }
            }
        }
        if root.item.can-stop: VerticalLayout {
            alignment: center;
            Button {
                text: @tr("Stop");
                size: "sm";
                clicked => {
                    InboxUi.action("stop", root.item.id);
                }
            }
        }
        if root.item.can-discard: VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.trash-2;
                label: @tr("Discard {0}", root.item.title);
                size: Theme.control-sm;
                icon-size: Theme.icon-xs;
                clicked => {
                    InboxUi.action("discard", root.item.id);
                }
            }
        }
    }
}

component Empty inherits VerticalLayout {
    in property <string> text;
    in property <image> icon: Icons.inbox;
    padding: 32px;
    spacing: 4px;
    alignment: center;
    HorizontalLayout {
        alignment: center;
        Icon {
            source: root.icon;
            size: 20px;
            tint: Theme.icon-subtlest;
        }
    }
    Text {
        text: root.text;
        font-size: Theme.ui-sm;
        color: Theme.icon-subtlest;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

// Segment of the S4 toolbar: 26 tall, pad [0,6], r6, 12px; active #1C1F24 + #EDEEF0.
component FilterSeg inherits Rectangle {
    in property <string> id;
    in property <string> text;
    width: max(82px, ft.preferred-width + 12px);
    height: 26px;
    border-radius: 6px;
    background: InboxUi.filter == root.id ? Theme.surface-hover : (fta.has-hover ? Theme.surface-hover.with-alpha(0.5) : transparent);
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: InboxUi.filter == root.id;
    accessible-action-default => { InboxUi.action("filter", root.id); }
    ft := Text {
        text: root.text;
        font-size: 12px;
        color: InboxUi.filter == root.id ? Theme.foreground : Theme.muted;
        accessible-role: none;
    }
    fta := TouchArea {
        mouse-cursor: pointer;
        clicked => { InboxUi.action("filter", root.id); }
    }
}

component NoticeRow inherits Rectangle {
    in property <InboxNotice> item;
    height: 56px;
    background: nta.has-hover && root.item.can-open ? Theme.surface-hover : (root.item.unread ? Theme.input : transparent);
    nta := TouchArea {
        mouse-cursor: root.item.can-open ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if root.item.can-open {
                InboxUi.action("open-notice", root.item.id);
            }
        }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.item.unread ? Theme.accent-fg : transparent;
            }
        }
        VerticalLayout {
            alignment: center;
            AgentChip {
                initial: root.item.chip;
                tint: root.item.tint;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.item.title;
                font-size: 13px;
                color: Theme.foreground;
                overflow: elide;
            }
            Text {
                text: root.item.meta;
                font-size: 11px;
                color: Theme.icon-subtlest;
                overflow: elide;
            }
        }
        if root.item.pill != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 19px;
                width: pt.preferred-width + 16px;
                border-radius: 999px;
                background: root.item.pill-tint.with-alpha(0.12);
                pt := Text {
                    text: root.item.pill;
                    font-size: 11px;
                    font-weight: Theme.weight-semibold;
                    color: root.item.pill-tint;
                }
            }
        }
        if root.item.trailing != "": Text {
            text: root.item.trailing;
            font-size: 11px;
            color: Theme.icon-subtlest;
            vertical-alignment: center;
        }
    }
}

export component InboxPage inherits VerticalLayout {
    in property <bool> stacked;
    max-width: 880px;
    alignment: start;
    spacing: 20px;
    // Title block (22 #EDEEF0, gap 6, 13 #8A909A).
    VerticalLayout {
        spacing: 6px;
        Text {
            text: @tr("Inbox");
            font-size: 22px;
            font-weight: Theme.weight-semibold;
            color: Theme.foreground;
        }
        Text {
            text: @tr("Notifications from subagents, builds and pull requests.");
            font-size: 13px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    // Toolbar: segmented filter left, "Mark all read" right.
    HorizontalLayout {
        height: 34px;
        Rectangle {
            width: segs.preferred-width + 6px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.card-border;
            background: Theme.input;
            accessible-role: tab-list;
            accessible-label: @tr("Filter");
            segs := HorizontalLayout {
                x: 3px;
                y: 4px;
                height: 26px;
                spacing: 2px;
                FilterSeg { id: "all"; text: @tr("All {0}", InboxUi.count-all); }
                FilterSeg { id: "unread"; text: @tr("Unread {0}", InboxUi.count-unread); }
                FilterSeg { id: "subagents"; text: @tr("Subagents {0}", InboxUi.count-subagents); }
                FilterSeg { id: "builds"; text: @tr("Builds {0}", InboxUi.count-builds); }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 31px;
                width: mt.preferred-width + 24px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.popover-border;
                background: mta.has-hover && InboxUi.count-unread > 0 ? Theme.border : Theme.surface-hover;
                opacity: InboxUi.count-unread > 0 ? 1 : 0.6;
                accessible-role: button;
                accessible-label: mt.text;
                accessible-action-default => { InboxUi.action("mark-read", ""); }
                mt := Text {
                    text: @tr("Mark all read");
                    font-size: 12px;
                    font-weight: Theme.weight-semibold;
                    color: Theme.foreground;
                    accessible-role: none;
                }
                mta := TouchArea {
                    enabled: InboxUi.count-unread > 0;
                    mouse-cursor: pointer;
                    clicked => { InboxUi.action("mark-read", ""); }
                }
            }
        }
    }
    // Card · Inbox list (#111215, #24272D, r12; rows 56, 1px separators, unread rows #16181C).
    Rectangle {
        background: Theme.card;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.card-border;
        clip: true;
        VerticalLayout {
            padding: 1px;
            if InboxUi.notices.length == 0: Empty {
                icon: Icons.inbox;
                text: InboxUi.filter == "all" ? @tr("Nothing here yet. Subagent work, builds and pull requests show up here.") : @tr("No notifications match this filter.");
            }
            for n[i] in InboxUi.notices: VerticalLayout {
                if i > 0: Rectangle {
                    height: 1px;
                    background: Theme.card-border;
                }
                NoticeRow {
                    item: n;
                }
            }
        }
    }
    // GitHub watcher (existing feature, kept below the designed list).
    Group {
        SettingRow {
            first: true;
            stacked: root.stacked;
            title: @tr("Watch GitHub");
            description: InboxUi.gh-text;
            Switch {
                label: @tr("Watch GitHub");
                checked: InboxUi.enabled;
                toggled(on) => {
                    InboxUi.set-enabled(on);
                }
            }
        }
        if InboxUi.gh-state == 1: SettingRow {
            stacked: root.stacked;
            title: @tr("GitHub CLI");
            description: @tr("Downloads the official gh release from GitHub into the Harness folder and checks its checksum. A gh you install yourself is always used first.");
            Button {
                text: InboxUi.gh-installing ? @tr("Installing…") : @tr("Install GitHub CLI");
                variant: "primary";
                size: "lg";
                enabled: !InboxUi.gh-installing;
                clicked => {
                    InboxUi.action("install-gh", "");
                }
            }
        }
        if InboxUi.gh-state == 2: SettingRow {
            stacked: root.stacked;
            title: @tr("Sign in to GitHub");
            description: @tr("Harness never signs in for you. Run the command in a terminal, finish in the browser, then come back here.");
            Button {
                text: @tr("Copy command");
                size: "lg";
                clicked => {
                    InboxUi.action("copy-gh", "");
                }
            }
        }
    }
    if InboxUi.error != "": StatusLine {
        text: InboxUi.error;
        error: true;
    }
    // Toolbar (design S4: segmented filter at the left, secondary action at the right).
    HorizontalLayout {
        spacing: 10px;
        Text {
            text: @tr("{0} repositories · {1} tickets", InboxUi.sources.length, InboxUi.tickets.length);
            font-size: Theme.ui-xs;
            color: Theme.icon-subtlest;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        Button {
            text: @tr("Add repository");
            has-icon: true;
            icon: Icons.plus;
            size: "lg";
            clicked => {
                InboxUi.action("add", "");
            }
        }
    }
    Card {
        clip: true;
        VerticalLayout {
            CardHead {
                title: @tr("Repositories");
                hint: @tr("{0} watched", InboxUi.sources.length);
            }
            Divider { }
            if InboxUi.sources.length == 0: Empty {
                icon: Icons.folders;
                text: @tr("No repository yet. Add one with the local clone Harness should work in.");
            }
            for s[i] in InboxUi.sources: VerticalLayout {
                if i > 0: Divider { }
                SourceRow {
                    item: s;
                }
            }
        }
    }
    Card {
        clip: true;
        VerticalLayout {
            CardHead {
                title: @tr("Tickets");
                hint: @tr("{0} open", InboxUi.tickets.length);
            }
            Divider { }
            if InboxUi.tickets.length == 0: Empty {
                icon: Icons.inbox;
                text: @tr("No ticket yet. Mention the handle in an issue or comment to start one.");
            }
            for t[i] in InboxUi.tickets: VerticalLayout {
                if i > 0: Divider { }
                TicketRow {
                    item: t;
                }
            }
        }
    }
    Card {
        clip: true;
        VerticalLayout {
            CardHead {
                title: @tr("Recent triggers");
                hint: @tr("Last {0}", InboxUi.triggers.length);
            }
            Divider { }
            if InboxUi.triggers.length == 0: Empty {
                icon: Icons.history;
                text: @tr("Nothing received yet.");
            }
            for g[i] in InboxUi.triggers: VerticalLayout {
                if i > 0: Divider { }
                HorizontalLayout {
                    min-height: 42px;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    Text {
                        text: g.title;
                        font-size: Theme.ui-sm;
                        color: Theme.foreground-subtle;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Tag {
                        text: g.verdict;
                        tone: g.accepted ? "success" : "neutral";
                    }
                    Caption {
                        text: g.time;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                }
            }
        }
    }
}

component FormRow inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    spacing: 6px;
    Text {
        text: root.title;
        font-size: Theme.ui-sm;
        font-weight: Theme.weight-medium;
        color: Theme.foreground-subtle;
    }
    @children
    if root.hint != "": Caption {
        text: root.hint;
        wrap: word-wrap;
    }
}

export component SourceDialog inherits Dialog {
    title: InboxUi.form-id == "" ? @tr("Add repository") : @tr("Edit repository");
    close-label: @tr("Close");
    dialog-width: 520px;
    close => {
        InboxUi.form-open = false;
    }
    FormRow {
        title: @tr("Repository");
        hint: @tr("owner/name on GitHub");
        repo := TextField {
            label: @tr("Repository");
            placeholder: "owner/name";
            mono: true;
            text <=> InboxUi.form-repo;
            init => {
                self.focus();
            }
        }
    }
    FormRow {
        title: @tr("Local folder");
        hint: @tr("The clone Harness works in. Each ticket gets its own worktree and branch.");
        TextField {
            label: @tr("Local folder");
            mono: true;
            text <=> InboxUi.form-folder;
        }
    }
    FormRow {
        title: @tr("Allowed users");
        hint: @tr("GitHub logins, comma separated. Requests from anyone else are ignored.");
        TextField {
            label: @tr("Allowed users");
            placeholder: "octocat, hubot";
            text <=> InboxUi.form-users;
        }
    }
    HorizontalLayout {
        spacing: 12px;
        FormRow {
            title: @tr("Mention handle");
            TextField {
                label: @tr("Mention handle");
                placeholder: "@harness";
                text <=> InboxUi.form-handle;
            }
        }
        FormRow {
            title: @tr("Check every (minutes)");
            TextField {
                label: @tr("Check every (minutes)");
                text: InboxUi.form-minutes;
                edited(value) => {
                    InboxUi.form-minutes = value.to-float().round();
                }
            }
        }
    }
    FormRow {
        title: @tr("Worker agent");
        Select {
            label: @tr("Worker agent");
            options: InboxUi.agents;
            current: InboxUi.form-agent;
            current-label: InboxUi.form-agent-label;
            select(id) => {
                InboxUi.form-agent = id;
                InboxUi.action("agent-label", id);
            }
        }
    }
    FormRow {
        title: @tr("Shadow labels");
        hint: @tr("Issues with one of these labels get a private proposal from the worker agent. Nothing is posted until you promote it.");
        TextField {
            label: @tr("Shadow labels");
            placeholder: "harness-shadow";
            text <=> InboxUi.form-shadow;
        }
    }
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Switch {
                label: @tr("Route with Orchestra");
                checked: InboxUi.form-route;
                toggled(on) => {
                    InboxUi.form-route = on;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: @tr("Route with Orchestra: the Orchestrator picks the agent for each new request");
                font-size: Theme.ui-sm;
                color: Theme.foreground-subtle;
                wrap: word-wrap;
            }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Switch {
                label: @tr("Draft first");
                checked: InboxUi.form-draft;
                toggled(on) => {
                    InboxUi.form-draft = on;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: @tr("Draft first: wait for Post before pushing and replying");
                font-size: Theme.ui-sm;
                color: Theme.foreground-subtle;
                wrap: word-wrap;
            }
        }
    }
    if InboxUi.form-error != "": StatusLine {
        text: InboxUi.form-error;
        error: true;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button {
            text: @tr("Cancel");
            size: "lg";
            clicked => {
                InboxUi.form-open = false;
            }
        }
        Button {
            text: @tr("Save");
            variant: "primary";
            size: "lg";
            enabled: InboxUi.form-repo != "" && InboxUi.form-folder != "";
            clicked => {
                InboxUi.save-form();
            }
        }
    }
}

