// Data pages (spec §6.2): Projects (PRJ-006..010) and Archive management (ARC-001..004).
// Design frames "S14 · Projects" / "S15 · Archive" (FigCraft), 1:1: title block, toolbar, one card with a
// two-line head ("Workspace folders" + "Ordered by last opened"), a caps table header (10 #5D636D) and table
// rows (60px projects / 48px archive, zebra #16181C on even rows, 16px side padding).
import { Theme } from "../theme/tokens.slint";
import { Icon, Icons } from "../components/controls.slint";
import { ProjectsUi, ArchiveUi } from "globals.slint";
import { PageHeader, SearchField, UnsupportedNotice, SetButton, Pill, Dot, CapsLabel } from "parts.slint";

// Card head (design "head": 44px, pad 16, title 13 #EDEEF0 + sub 11 #6B717C, gap 2).
component TableHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> sub;
    height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: Theme.weight-semibold;
            color: Theme.foreground;
        }
        Text {
            text: root.sub;
            font-size: 11px;
            color: Theme.icon-subtlest;
        }
    }
}

component Rule inherits Rectangle {
    height: 1px;
    background: Theme.border;
    accessible-role: none;
}

// Undo bar (surface, radius 10, 16px side padding).
component ActionBar inherits Rectangle {
    in property <string> text;
    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        Text {
            text: root.text;
            font-size: 12px;
            color: Theme.foreground-subtle;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        @children
    }
}

// Small text link (design archive "Restore" accent / "Delete" red, 11px).
component LinkText inherits Text {
    in property <color> tint: Theme.accent-fg;
    callback clicked();
    font-size: 11px;
    color: lta.has-hover ? root.tint.brighter(0.2) : root.tint;
    vertical-alignment: center;
    accessible-role: button;
    accessible-label: self.text;
    accessible-action-default => {
        root.clicked();
    }
    lta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Empty card body.
component EmptyBody inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> hint;
    padding: 32px;
    spacing: 4px;
    alignment: center;
    HorizontalLayout {
        alignment: center;
        Icon {
            source: root.icon;
            size: 20px;
            tint: Theme.icon-subtlest;
        }
    }
    Text {
        text: root.title;
        font-size: 13px;
        color: Theme.foreground-subtle;
        horizontal-alignment: center;
    }
    Text {
        text: root.hint;
        font-size: 12px;
        color: Theme.icon-subtlest;
        horizontal-alignment: center;
    }
}

export component ProjectsPage inherits VerticalLayout {
    in property <bool> stacked;
    callback request-remove(bool);
    callback add-folder();
    // Design project dots: orange, accent, blue, purple, green (cycled).
    property <[color]> dots: [#E88A5C, #7C8CFF, #5BC0FF, #B07CFF, #3DD68C];
    spacing: 20px;
    PageHeader {
        title: @tr("Projects");
        description: @tr("Workspace folders Harness has opened. Each keeps its own sessions, memory and instructions.");
    }
    if !ProjectsUi.available: UnsupportedNotice {
        title: @tr("Project management needs the hub project API");
        reason: @tr("Harness lists the current workspace only until the hub exposes its project list.");
    }
    // Toolbar (design: "4 projects" 12 #8A909A + blue pill "142 sessions", "+ Add folder" primary right).
    HorizontalLayout {
        height: 34px;
        spacing: 8px;
        Text {
            text: @tr("{0} projects", ProjectsUi.rows.length);
            font-size: 12px;
            color: Theme.muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Pill {
                text: @tr("{0} sessions", ProjectsUi.total-sessions);
                tint: #5BC0FF;
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        VerticalLayout {
            alignment: center;
            SetButton {
                text: @tr("+ Add folder");
                variant: "primary";
                clicked => {
                    root.add-folder();
                }
            }
        }
    }
    if ProjectsUi.undo-count > 0: ActionBar {
        text: @tr("{0} project(s) removed. Their sessions stay in Recent and search.", ProjectsUi.undo-count);
        SetButton {
            text: @tr("Undo");
            clicked => {
                ProjectsUi.undo-remove();
            }
        }
    }
    Rectangle {
        background: Theme.card;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.card-border;
        clip: true;
        VerticalLayout {
            padding: 1px;
            TableHead {
                title: @tr("Workspace folders");
                sub: @tr("Ordered by last opened");
            }
            Rule { }
            // Table header (design "thead": 30px after 4px top pad; columns 200 / 250 / 100 / 150 / 40).
            VerticalLayout {
                padding-top: 4px;
                HorizontalLayout {
                    height: 30px;
                    padding-left: 16px;
                    padding-right: 16px;
                    CapsLabel {
                        text: @tr("PROJECT");
                        min-width: root.stacked ? 0px : 200px;
                        max-width: root.stacked ? 100000px : 200px;
                        horizontal-stretch: root.stacked ? 1 : 0;
                    }
                    if !root.stacked: CapsLabel {
                        text: @tr("PATH");
                        width: 250px;
                    }
                    if !root.stacked: CapsLabel {
                        text: @tr("SESSIONS");
                        width: 100px;
                    }
                    CapsLabel {
                        text: @tr("LAST OPENED");
                        width: 150px;
                    }
                    Rectangle {
                        width: 40px;
                    }
                    if !root.stacked: Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                Rule { }
            }
            VerticalLayout {
                padding-bottom: 8px;
                for p[i] in ProjectsUi.rows: Rectangle {
                    height: 60px;
                    background: rta.has-hover ? Theme.hover : (Math.mod(i, 2) == 0 ? Theme.surface : transparent);
                    animate background { duration: Theme.dur-hover; }
                    rta := TouchArea { }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        // Project: dot + name (12 #EDEEF0) + "open" pill, then "parent/name" 11 #6B717C.
                        VerticalLayout {
                            min-width: root.stacked ? 0px : 200px;
                            max-width: root.stacked ? 100000px : 200px;
                            horizontal-stretch: root.stacked ? 1 : 0;
                            alignment: center;
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 7px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Dot {
                                        size: 6px;
                                        tint: root.dots[Math.mod(i, root.dots.length)];
                                    }
                                }
                                Text {
                                    text: p.name;
                                    font-size: 12px;
                                    font-weight: Theme.weight-medium;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if p.current: VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        height: 16px;
                                        text: @tr("open");
                                        tint: #3DD68C;
                                    }
                                }
                                if p.unused: VerticalLayout {
                                    alignment: center;
                                    Pill {
                                        height: 16px;
                                        text: @tr("unused");
                                        tint: Theme.muted;
                                    }
                                }
                            }
                            Text {
                                text: p.short;
                                font-size: 11px;
                                color: Theme.icon-subtlest;
                                overflow: elide;
                            }
                        }
                        if !root.stacked: Text {
                            width: 250px;
                            text: p.path;
                            font-size: 11px;
                            color: Theme.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if !root.stacked: Text {
                            width: 100px;
                            text: p.sessions;
                            font-size: 12px;
                            color: Theme.foreground-subtle;
                            vertical-alignment: center;
                        }
                        Text {
                            width: 150px;
                            text: p.last-used;
                            font-size: 11px;
                            color: Theme.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // Remove (design "✕" 11 #6B717C, right of a 40px cell).
                        Rectangle {
                            width: 40px;
                            Rectangle {
                                x: parent.width - self.width + 4px;
                                width: 20px;
                                height: 20px;
                                border-radius: 5px;
                                background: xta.has-hover ? Theme.hover : transparent;
                                accessible-role: button;
                                accessible-label: @tr("Remove {0}", p.name);
                                accessible-enabled: ProjectsUi.available;
                                accessible-action-default => {
                                    ProjectsUi.select-only(p.id);
                                    root.request-remove(false);
                                }
                                Text {
                                    text: "✕";
                                    font-family: "Segoe UI Symbol";
                                    font-size: 11px;
                                    color: xta.has-hover ? Theme.foreground : Theme.icon-subtlest;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                xta := TouchArea {
                                    enabled: ProjectsUi.available;
                                    mouse-cursor: pointer;
                                    clicked => {
                                        ProjectsUi.select-only(p.id);
                                        root.request-remove(false);
                                    }
                                }
                            }
                        }
                        if !root.stacked: Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
                if ProjectsUi.rows.length == 0: EmptyBody {
                    icon: Icons.folders;
                    title: @tr("No projects");
                    hint: @tr("Open a folder in Harness and it shows up here.");
                }
            }
        }
    }
}

export component ArchivePage inherits VerticalLayout {
    in property <bool> stacked;
    callback request-delete(string);
    spacing: 20px;
    PageHeader {
        title: @tr("Archive");
        description: @tr("Archived sessions are hidden from the sidebar but keep their full transcript and diffs.");
    }
    if !ArchiveUi.available: UnsupportedNotice {
        title: @tr("Archiving needs the hub archive API");
        reason: @tr("Harness sessions cannot be archived yet; this page lists archived sessions once the hub supports it.");
    }
    // Toolbar (design: search 34 tall fills the row).
    SearchField {
        placeholder: @tr("Search archived sessions…");
        text <=> ArchiveUi.query;
        edited(q) => {
            ArchiveUi.search(q);
        }
    }
    Rectangle {
        background: Theme.card;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.card-border;
        clip: true;
        VerticalLayout {
            padding: 1px;
            TableHead {
                title: @tr("Archived sessions");
                sub: @tr("{0} sessions", ArchiveUi.rows.length);
            }
            Rule { }
            // Columns 250 / 150 / 120 / 130 / 140 (actions right-aligned).
            VerticalLayout {
                padding-top: 4px;
                HorizontalLayout {
                    height: 30px;
                    padding-left: 16px;
                    padding-right: 16px;
                    CapsLabel {
                        text: @tr("SESSION");
                        min-width: root.stacked ? 0px : 250px;
                        max-width: root.stacked ? 100000px : 250px;
                        horizontal-stretch: root.stacked ? 1 : 0;
                    }
                    if !root.stacked: CapsLabel {
                        text: @tr("PROJECT");
                        width: 150px;
                    }
                    if !root.stacked: CapsLabel {
                        text: @tr("AGENT");
                        width: 120px;
                    }
                    CapsLabel {
                        text: @tr("ARCHIVED");
                        width: 130px;
                    }
                    CapsLabel {
                        text: @tr("ACTIONS");
                        width: 140px;
                        horizontal-alignment: right;
                    }
                    if !root.stacked: Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                Rule { }
            }
            VerticalLayout {
                padding-bottom: 8px;
                for a[i] in ArchiveUi.rows: Rectangle {
                    height: 48px;
                    background: ata.has-hover ? Theme.hover : (Math.mod(i, 2) == 0 ? Theme.surface : transparent);
                    animate background { duration: Theme.dur-hover; }
                    ata := TouchArea { }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            min-width: root.stacked ? 0px : 250px;
                            max-width: root.stacked ? 100000px : 250px;
                            horizontal-stretch: root.stacked ? 1 : 0;
                            text: a.title;
                            font-size: 12px;
                            color: Theme.foreground-subtle;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if !root.stacked: Text {
                            width: 150px;
                            text: a.project;
                            font-size: 11px;
                            color: Theme.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if !root.stacked: HorizontalLayout {
                            width: 120px;
                            spacing: 6px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Dot {
                                    size: 6px;
                                    tint: a.agent == "Claude Code" ? #E88A5C : a.agent == "Codex" ? #3DD68C : a.agent == "Harness" ? #7C8CFF : #5BC0FF;
                                }
                            }
                            Text {
                                text: a.agent;
                                font-size: 11px;
                                color: Theme.foreground-subtle;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Text {
                            width: 130px;
                            text: a.updated;
                            font-size: 11px;
                            color: Theme.icon-subtlest;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            width: 140px;
                            spacing: 10px;
                            alignment: end;
                            LinkText {
                                text: @tr("Restore");
                                tint: Theme.accent-fg;
                                clicked => {
                                    ArchiveUi.unarchive(a.id);
                                }
                            }
                            LinkText {
                                text: @tr("Delete");
                                tint: Theme.destructive;
                                clicked => {
                                    root.request-delete(a.id);
                                }
                            }
                        }
                        if !root.stacked: Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
                if ArchiveUi.rows.length == 0: EmptyBody {
                    icon: Icons.archive;
                    title: @tr("No archived sessions");
                    hint: @tr("Archiving a session from the sidebar moves it here.");
                }
            }
        }
    }
    if ArchiveUi.has-more: HorizontalLayout {
        alignment: center;
        SetButton {
            text: @tr("Show more");
            clicked => {
                ArchiveUi.more();
            }
        }
    }
}
