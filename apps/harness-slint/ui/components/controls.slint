import { Theme } from "../theme/tokens.slint";
import { Icons, IconsFill, Tiles } from "icons.slint";
import { GlyphAnim, AsciiArt } from "ascii.slint";
import { Look } from "../theme/look.slint";
import { Frost } from "../theme/backdrop.slint";

export { Icons, IconsFill, Tiles }

export component Icon inherits Rectangle {
    in property <image> source;
    in property <color> tint: Theme.icon;
    in property <length> size: Theme.icon-size;
    width: root.size;
    min-height: root.size;
    preferred-height: root.size;
    accessible-role: none;
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        source: root.source;
        colorize: root.tint;
        image-fit: contain;
        accessible-role: none;
        animate colorize { duration: Theme.dur-hover; }
    }
}

// Busy indicator: a quadrant glyph turning in place (unicode frames, no rotation transform).
export component Spinner inherits Rectangle {
    in property <color> tint: Theme.foreground;
    in property <length> size: Theme.icon-sm;
    // true: steps with ArtClock's busy clock (only for spinners shown while a turn runs, which is when that
    // clock runs); false: its own timer.
    in property <bool> clocked: false;
    width: root.size;
    height: root.size;
    accessible-role: none;
    GlyphAnim {
        frames: AsciiArt.spinner;
        interval: 95ms;
        divider: root.clocked ? 1 : 0;
        busy: true;
        font-size: root.size * 1.05;
        color: root.tint;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Glass pane: translucent tint, a rim that is brightest along the top edge, an inner glow (Skia only) and a
// soft drop shadow. `strong` is the near-opaque cut for anything that floats over text.
export component Glass inherits Rectangle {
    in property <string> level: "panel";
    in property <length> radius: Theme.radius-xl;
    in property <bool> shadow: true;
    in property <bool> highlight: true;
    background: root.level == "strong" ? Theme.glass-strong : root.level == "deep" ? Theme.glass-deep : root.level == "card" ? Theme.card : Theme.glass;
    border-radius: root.radius;
    border-width: 1px;
    border-color: root.level == "card" ? Theme.card-border : Theme.glass-rim;
    drop-shadow-blur: root.shadow ? Theme.glass-shadow-blur : 0px;
    drop-shadow-offset-y: root.shadow ? Theme.glass-shadow-y : 0px;
    drop-shadow-color: root.shadow ? Theme.glass-shadow : transparent;
    // Over a wallpaper the pane shows a frosted copy of it instead of its flat fill.
    if Look.has-wallpaper && root.level != "card": Frost {
        radius: root.radius;
        veil: root.level == "strong" ? 0.3 : 0.18;
    }
    if root.highlight: Rectangle {
        border-radius: root.radius;
        inner-shadow-blur: Theme.glass-inner-blur;
        inner-shadow-offset-y: 1px;
        inner-shadow-color: Theme.glass-inner;
        accessible-role: none;
    }
    @children
}

// Buttons: rounded rectangles with 13px semibold labels. primary = white on black (ink on paper),
// secondary = raised + strong border, outline = surface, ghost = transparent, accent = flat accent fill,
// destructive / warning = tinted fill + coloured border.
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> label: self.text;
    in property <string> variant: "outline";
    in property <string> size: "default";
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> trailing-chevron: false;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <color> text-color: root.variant == "primary" ? Theme.primary-foreground : root.variant == "accent" ? Theme.on-accent : root.variant == "destructive" ? Theme.destructive : root.variant == "warning" ? Theme.warning : root.variant == "ghost" ? Theme.foreground-subtle : Theme.foreground;
    callback clicked;
    out property <bool> hovered: ta.has-hover;
    property <bool> hot: ta.has-hover && root.enabled;
    property <length> h: root.size == "xs" ? Theme.control-xs : root.size == "sm" ? Theme.control-sm : root.size == "lg" ? Theme.control-lg : Theme.control;
    property <length> pad: root.size == "lg" ? 14px : root.size == "xs" ? 8px : 12px;
    property <length> icon-px: root.size == "xs" ? 12px : root.size == "sm" ? 14px : root.size == "lg" ? 18px : 15px;
    height: self.h;
    min-width: self.h;
    preferred-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: root.size == "xs" || root.size == "sm" ? Theme.radius-sm : Theme.radius-md;
    property <bool> glassy: root.variant == "outline" || root.variant == "secondary" || root.variant == "destructive" || root.variant == "warning" || root.variant == "ghost";
    border-width: root.glassy ? 1px : 0px;
    border-color: root.variant == "destructive" ? Theme.destructive.with-alpha(root.hot ? 0.7 : 0.35) : root.variant == "warning" ? Theme.warning.with-alpha(root.hot ? 0.7 : 0.35) : root.variant == "ghost" ? transparent : root.variant == "secondary" ? Theme.border-hover : root.hot ? Theme.border-hover : Theme.glass-border;
    background: root.variant == "primary" ? (root.hot ? Theme.primary-hover : Theme.primary) : root.variant == "accent" ? Theme.brand-gradient : root.variant == "secondary" ? (root.active || root.hot ? Theme.surface-hover : Theme.raised) : root.variant == "destructive" ? (root.hot ? Theme.destructive.with-alpha(0.16) : Theme.destructive.with-alpha(0.08)) : root.variant == "warning" ? (root.hot ? Theme.warning.with-alpha(0.16) : Theme.warning.with-alpha(0.08)) : root.variant == "outline" ? (root.active ? Theme.raised : root.hot ? Theme.raised : Theme.surface) : (root.active ? Theme.raised : root.hot ? Theme.hover : transparent);
    drop-shadow-blur: root.variant == "primary" || root.variant == "accent" ? 8px : 0px;
    drop-shadow-offset-y: root.variant == "primary" || root.variant == "accent" ? 2px : 0px;
    drop-shadow-color: (root.variant == "primary" || root.variant == "accent") && root.enabled ? Theme.primary-shadow : transparent;
    opacity: root.enabled ? 1 : 0.45;
    transform-scale: ta.pressed && root.enabled ? 0.97 : 1;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    animate background, border-color, drop-shadow-blur { duration: Theme.dur-hover; easing: ease-out-quint; }
    animate transform-scale { duration: Theme.dur-press; easing: ease-out-quint; }
    if root.glassy && Theme.dark && root.variant == "outline": Rectangle {
        x: root.border-radius;
        y: 1px;
        width: max(0px, root.width - root.border-radius * 2);
        height: 1px;
        background: @linear-gradient(90deg, Theme.glass-highlight.with-alpha(0) 0%, Theme.glass-highlight 50%, Theme.glass-highlight.with-alpha(0) 100%);
        accessible-role: none;
    }
    row := HorizontalLayout {
        padding-left: root.has-icon && root.text == "" ? 0px : root.pad;
        padding-right: root.has-icon && root.text == "" ? 0px : (root.trailing-chevron ? root.pad - 2px : root.pad);
        spacing: 6px;
        alignment: center;
        if root.has-icon: Icon {
            source: root.icon;
            size: root.icon-px;
            tint: root.text-color;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.text-color;
            font-size: Theme.ui-base;
            // 13 semibold — the design's single button label weight.
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.trailing-chevron: Icon {
            source: Icons.chevron-down;
            size: 14px;
            tint: Theme.icon-subtle;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <length> size: Theme.control;
    in property <length> icon-size: Theme.icon-size;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <color> tint: Theme.icon-subtle;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: root.size >= Theme.control-lg ? Theme.radius-md : Theme.radius-sm;
    background: root.active ? Theme.raised : (ta.has-hover && root.enabled ? Theme.hover : Theme.hover.with-alpha(0));
    opacity: root.enabled ? 1 : 0.45;
    transform-scale: ta.pressed && root.enabled ? 0.92 : 1;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
    animate transform-scale { duration: Theme.dur-press; easing: ease-out-quint; }
    Icon {
        source: root.icon;
        size: root.icon-size;
        tint: root.active ? Theme.foreground : ta.has-hover ? Theme.icon : root.tint;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Pill / chip (design: text in the colour, bg = colour + 1F, radius 999, 11 semibold).
export component Tag inherits Rectangle {
    in property <string> text;
    in property <string> tone: "neutral";
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <length> font-size: Theme.ui-xs;
    property <color> fg: root.tone == "confirm" ? Theme.confirm-foreground : root.tone == "warning" ? Theme.warning-surface-foreground : root.tone == "destructive" ? Theme.destructive-surface-foreground : root.tone == "success" ? Theme.success-surface-foreground : root.tone == "progress" ? Theme.progress-surface-foreground : root.tone == "info" ? Theme.info : root.tone == "idle" ? Theme.idle-task : root.tone == "accent" ? Theme.accent-fg : Theme.foreground-subtle;
    height: root.font-size <= Theme.ui-xs ? 20px : 22px;
    preferred-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    background: root.tone == "neutral" ? Theme.tag : root.fg.with-alpha(0.12);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    row := HorizontalLayout {
        padding-left: root.has-icon ? 7px : 9px;
        padding-right: 9px;
        spacing: 4px;
        alignment: center;
        if root.has-icon: Icon {
            source: root.icon;
            size: 12px;
            tint: root.fg;
        }
        Text {
            text: root.text;
            font-size: root.font-size;
            font-weight: Theme.weight-semibold;
            color: root.fg;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

export component Divider inherits Rectangle {
    in property <bool> vertical: false;
    min-height: root.vertical ? 0px : 1px;
    max-height: root.vertical ? 100000px : 1px;
    min-width: root.vertical ? 1px : 0px;
    max-width: root.vertical ? 1px : 100000px;
    background: Theme.border;
    accessible-role: none;
}

export component Card inherits Rectangle {
    in property <length> radius: Theme.radius-lg;
    background: Theme.card;
    border-radius: root.radius;
    border-width: 1px;
    border-color: Theme.card-border;
}

export component MenuShell inherits Rectangle {
    property <bool> shown: false;
    background: Theme.menu;
    border-radius: Theme.radius-xl;
    border-width: 1px;
    border-color: Theme.glass-rim;
    inner-shadow-blur: Theme.glass-inner-blur;
    inner-shadow-offset-y: 1px;
    inner-shadow-color: Theme.glass-inner.with-alpha(0.06);
    drop-shadow-blur: Theme.shadow-md-blur;
    drop-shadow-offset-y: Theme.shadow-md-y;
    drop-shadow-color: Theme.shadow-md-color;
    opacity: root.shown ? 1 : 0;
    transform-scale: root.shown ? 1 : 0.96;
    animate opacity, transform-scale { duration: Theme.dur-menu; easing: ease-out-quint; }
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => {
            root.shown = true;
        }
    }
    Rectangle {
        x: root.border-radius;
        y: 0px;
        width: max(0px, root.width - root.border-radius * 2);
        height: 1px;
        background: @linear-gradient(90deg, Theme.glass-highlight.with-alpha(0) 0%, Theme.glass-highlight 50%, Theme.glass-highlight.with-alpha(0) 100%);
        accessible-role: none;
    }
    VerticalLayout {
        padding: 6px;
        spacing: 2px;
        @children
    }
}

export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <color> detail-color: Theme.foreground-subtle;
    in property <string> label: self.text;
    in property <string> description;
    in property <bool> enabled: true;
    in property <bool> checked: false;
    in property <bool> show-check: true;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked;
    height: 34px;
    border-radius: Theme.radius-md;
    background: ta.has-hover && root.enabled ? Theme.menu-hover : Theme.menu-hover.with-alpha(0);
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-enabled: root.enabled;
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        if root.has-icon: Icon {
            source: root.icon;
            size: Theme.icon-sm;
            tint: !root.enabled ? Theme.icon-subtlest : root.checked ? Theme.foreground : Theme.icon-subtle;
        }
        Text {
            text: root.text;
            font-size: Theme.ui-base;
            color: root.enabled ? Theme.foreground : Theme.foreground-subtlest;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        if root.detail != "": Text {
            text: root.detail;
            font-size: Theme.ui-sm;
            color: root.detail-color;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.show-check: Rectangle {
            width: 16px;
            if root.checked: Icon {
                source: IconsFill.check;
                size: 14px;
                tint: Theme.accent-fg;
            }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Dialog inherits Rectangle {
    in property <length> dialog-width: 440px;
    in property <string> title;
    in property <string> close-label;
    callback close();
    property <bool> shown: false;
    background: root.shown ? Theme.scrim : Theme.scrim.with-alpha(0);
    animate background { duration: Theme.dur-dialog; easing: ease-out-quint; }
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => {
            root.shown = true;
        }
    }
    TouchArea { }
    Glass {
        level: "strong";
        radius: Theme.radius-2xl;
        width: min(root.dialog-width, root.width - 32px);
        height: min(body.preferred-height, root.height - 32px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (root.shown ? 0px : 10px);
        drop-shadow-blur: Theme.shadow-lg-blur;
        drop-shadow-offset-y: Theme.shadow-lg-y;
        drop-shadow-color: Theme.shadow-lg-color;
        opacity: root.shown ? 1 : 0;
        transform-scale: root.shown ? 1 : 0.96;
        clip: true;
        animate opacity, transform-scale, y { duration: Theme.dur-dialog; easing: ease-out-quint; }
        body := VerticalLayout {
            padding: 22px;
            spacing: 14px;
            if root.title != "" || root.close-label != "": HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.title;
                    font-size: Theme.ui-lg;
                    font-weight: Theme.weight-semibold;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                if root.close-label != "": IconButton {
                    icon: Icons.x;
                    label: root.close-label;
                    size: Theme.control;
                    clicked => {
                        root.close();
                    }
                }
            }
            @children
        }
    }
}

export struct TabItem {
    id: string,
    label: string,
}

component TabChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback activate;
    width: tl.preferred-width + 20px;
    border-radius: Theme.radius-md;
    background: root.selected ? Theme.tab-active : (ta.has-hover ? Theme.hover : Theme.hover.with-alpha(0));
    drop-shadow-blur: root.selected ? 8px : 0px;
    drop-shadow-offset-y: root.selected ? 2px : 0px;
    drop-shadow-color: root.selected ? Theme.shadow-md-color : transparent;
    transform-scale: ta.pressed ? 0.96 : 1;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.activate();
    }
    animate background, drop-shadow-blur { duration: Theme.dur-move; easing: ease-out-quint; }
    animate transform-scale { duration: Theme.dur-press; easing: ease-out-quint; }
    tl := Text {
        text: root.text;
        font-size: Theme.ui-base;
        font-weight: root.selected ? Theme.weight-semibold : Theme.weight-medium;
        color: root.selected ? Theme.foreground : Theme.foreground-subtle;
        vertical-alignment: center;
        horizontal-alignment: center;
        accessible-role: none;
        animate color { duration: Theme.dur-hover; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activate();
        }
    }
}

export component TabBar inherits Rectangle {
    in property <[TabItem]> leading;
    in property <[TabItem]> tabs;
    in property <string> current;
    callback select(string);
    height: 40px;
    Rectangle {
        x: 6px;
        y: 4px;
        width: min(root.width - 12px, strip.preferred-width);
        height: root.height - 8px;
        border-radius: Theme.radius-lg;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        strip := HorizontalLayout {
            padding: 3px;
            spacing: 2px;
            alignment: start;
            for t in root.leading: TabChip {
                text: t.label;
                selected: t.id == root.current;
                activate => {
                    root.select(t.id);
                }
            }
            for t in root.tabs: TabChip {
                text: t.label;
                selected: t.id == root.current;
                activate => {
                    root.select(t.id);
                }
            }
        }
    }
}

// Caps section label (design: 10 semibold, caps-label colour, letterSpacing 8%).
export component SectionLabel inherits Text {
    font-size: Theme.ui-xs;
    font-weight: Theme.weight-semibold;
    color: Theme.caps-label;
    letter-spacing: 1.2px;
    vertical-alignment: center;
    overflow: elide;
}

export component StatusDot inherits Rectangle {
    in property <color> tint: Theme.foreground-subtlest;
    in property <length> size: 7px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.tint;
    accessible-role: none;
}

export struct SegmentOption {
    id: string,
    label: string,
}

component SegmentChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <length> pad: 20px;
    callback activate;
    width: ot.preferred-width + root.pad;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.raised : (ta.has-hover ? Theme.hover : transparent);
    drop-shadow-blur: 0px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: transparent;
    transform-scale: ta.pressed ? 0.97 : 1;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => {
        root.activate();
    }
    animate background { duration: Theme.dur-move; easing: ease-out-quint; }
    animate transform-scale { duration: Theme.dur-press; easing: ease-out-quint; }
    ot := Text {
        text: root.text;
        font-size: Theme.ui-base;
        font-weight: Theme.weight-medium;
        color: root.selected ? Theme.foreground : Theme.foreground-subtlest;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
        animate color { duration: Theme.dur-hover; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activate();
        }
    }
}

// Segmented control (design S1: surface track, 1px border, radius 8, 3px padding, active chip = raised).
export component Segmented inherits Rectangle {
    in property <[SegmentOption]> options;
    in property <string> current;
    // Horizontal padding inside each chip (narrow hosts such as the Side Pane use less).
    in property <length> chip-pad: 20px;
    callback select(string);
    height: 31px;
    preferred-width: seg.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    seg := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for o in root.options: SegmentChip {
            pad: root.chip-pad;
            text: o.label;
            selected: o.id == root.current;
            activate => {
                root.select(o.id);
            }
        }
    }
}
