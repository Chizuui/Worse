// Git operations of 9.2B round 3 (spec docs/specs/harness/phase-9-parity.md §7.4 "Git"; inventory GIT-007..GIT-011):
// branch switcher (search, switch, create, blocked switch), commit dialog (include unstaged, commit & push), push
// dialog (upstream, ahead / behind, result, error copy) and the commit graph dialog (lanes, inspect, load more).
// The panels worker owns the repository (`panels::GitCall`); Rust (src/gitui.rs) is the only writer of GitUi and
// mirrors each reply. UI-local state: which dialog is open, the branch filter, the selected graph row.

import { ListView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, Button, IconButton, Tag, Dialog, MenuItem } from "../components/controls.slint";
import { TextField, TextArea, Switch } from "../settings/parts.slint";

export struct BranchRow {
    name: string,
    current: bool,
    upstream: string,
}

// One commit of the graph. `path`: SVG commands of the lane lines in a (lanes * 14) x 28 viewbox; the dot is
// drawn at `lane`.
export struct GraphRow {
    hash: string,
    short: string,
    subject: string,
    author: string,
    date: string,
    refs: string,
    parents: string,
    lane: int,
    lanes: int,
    path: string,
}

export global GitUi {
    // "" | "branches" | "commit" | "push" | "graph"; written by Rust through `open` ("" closes and drops the graph).
    in-out property <string> dialog;
    callback open(string);
    // ---- branches (GIT-009 / GIT-010) ----
    in property <[BranchRow]> branches;
    in property <string> current;
    in-out property <string> filter;
    in property <bool> busy;
    // Files that block the switch (one per line, "" = not blocked) and the branch that was asked for.
    in property <string> blocked;
    in property <string> blocked-branch;
    // branch, create
    callback switch-branch(string, bool);
    // ---- commit (GIT-007) ----
    in-out property <bool> include-unstaged: true;
    // push after a successful commit
    callback commit(bool);
    // ---- push (GIT-008) ----
    in property <string> upstream;
    in property <int> ahead;
    in property <int> behind;
    in property <bool> pushing;
    // Last switch / commit / push outcome: "" | "switched" (a = branch) | "committed" (a = hash, b = summary) |
    // "pushing" / "pushed" / "pushed-upstream" (a = branch, b = remote) | "error" (a = git's message).
    in property <string> result-kind;
    in property <string> result-a;
    in property <string> result-b;
    callback push();
    callback copy-result();
    // ---- graph (GIT-011) ----
    in property <[GraphRow]> graph;
    in property <bool> graph-more;
    in-out property <int> graph-selected: -1;
    callback load-more();
    callback copy-hash(string);
    // The filter field changed; Rust narrows `branches` (case-insensitive substring; Slint strings have no search).
    callback filter-edited(string);

    pure public function result-text() -> string {
        if result-kind == "switched" { return @tr("Switched to {0}", result-a); }
        if result-kind == "committed" { return @tr("Committed {0}: {1}", result-a, result-b); }
        if result-kind == "pushing" { return @tr("Pushing {0} to {1}…", result-a, result-b); }
        if result-kind == "pushed" { return @tr("Pushed {0} to {1}", result-a, result-b); }
        if result-kind == "pushed-upstream" { return @tr("Pushed {0} to {1} and set the upstream", result-a, result-b); }
        result-a
    }
}

// Outcome of the last git operation (panel and dialogs); an error can be copied.
export component ResultLine inherits HorizontalLayout {
    // 修复：空布局默认 vertical-stretch 为 1，会和下方变更列表平分高度，把列表挤到面板底部（phase8-panels git 失败）。
    vertical-stretch: 0;
    spacing: Theme.space-1;
    if GitUi.result-kind != "": Text {
        text: GitUi.result-text();
        wrap: word-wrap;
        font-size: Theme.ui-sm;
        color: GitUi.result-kind == "error" ? Theme.destructive : GitUi.result-kind == "pushing" ? Theme.foreground-subtle : Theme.success;
        horizontal-stretch: 1;
        accessible-role: AccessibleRole.text;
        accessible-label: "git " + GitUi.result-kind + " " + self.text;
    }
    if GitUi.result-kind == "error": VerticalLayout {
        alignment: start;
        horizontal-stretch: 0;
        IconButton {
            icon: Icons.copy;
            label: @tr("Copy error");
            size: Theme.control-sm;
            icon-size: Theme.icon-sm;
            clicked => {
                GitUi.copy-result();
            }
        }
    }
}

// Branch switcher: filter, branch list (current checked), "Create branch <filter>", blocked-switch notice.
component BranchDialog inherits Dialog {
    title: @tr("Switch branch");
    close-label: @tr("Close");
    dialog-width: 420px;
    close => {
        GitUi.open("");
    }
    TextField {
        text <=> GitUi.filter;
        label: @tr("Find or create a branch");
        placeholder: @tr("Find or create a branch");
        edited(text) => {
            GitUi.filter-edited(text);
        }
        accepted => {
            if GitUi.filter != "" {
                GitUi.switch-branch(GitUi.filter, true);
            }
        }
    }
    if GitUi.blocked != "": Rectangle {
        background: Theme.destructive-surface;
        border-radius: Theme.radius-lg;
        VerticalLayout {
            padding: Theme.space-2;
            spacing: Theme.space-1;
            Text {
                text: @tr("Can't switch to {0}: local changes to these files would be overwritten. Commit or stash them first.", GitUi.blocked-branch);
                wrap: word-wrap;
                font-size: Theme.ui-sm;
                color: Theme.destructive;
                accessible-role: AccessibleRole.text;
                accessible-label: "blocked " + GitUi.blocked-branch;
            }
            Text {
                text: GitUi.blocked;
                wrap: word-wrap;
                font-family: Theme.mono-font;
                font-size: Theme.ui-xs;
                color: Theme.foreground;
                accessible-role: AccessibleRole.text;
                accessible-label: "blocked files " + self.text;
            }
        }
    }
    Rectangle {
        height: min(max(GitUi.branches.length, 1) * 32px + 8px, 280px);
        ListView {
            for b in GitUi.branches: MenuItem {
                height: 32px;
                text: b.name;
                detail: b.upstream;
                label: "branch " + b.name;
                checked: b.current;
                enabled: !GitUi.busy;
                clicked => {
                    if !b.current {
                        GitUi.switch-branch(b.name, false);
                    }
                }
            }
        }
    }
    if GitUi.filter != "": MenuItem {
        text: @tr("Create branch {0}", GitUi.filter);
        label: @tr("Create branch {0}", GitUi.filter);
        has-icon: true;
        icon: Icons.plus;
        show-check: false;
        enabled: !GitUi.busy;
        clicked => {
            GitUi.switch-branch(GitUi.filter, true);
        }
    }
    ResultLine { }
}

// Commit dialog: the panel's commit message, "Include unstaged changes", Commit and Commit & push.
component CommitDialog inherits Dialog {
    in-out property <string> message;
    title: @tr("Commit changes");
    close-label: @tr("Close");
    dialog-width: 460px;
    close => {
        GitUi.open("");
    }
    TextArea {
        height: 120px;
        mono: false;
        text <=> root.message;
        label: @tr("Commit message");
    }
    HorizontalLayout {
        spacing: 8px;
        Switch {
            checked: GitUi.include-unstaged;
            label: @tr("Include unstaged changes");
            toggled(on) => {
                GitUi.include-unstaged = on;
            }
        }
        Text {
            text: @tr("Include unstaged changes");
            font-size: Theme.ui-sm;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
        }
    }
    ResultLine { }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button {
            text: @tr("Cancel");
            size: "lg";
            clicked => {
                GitUi.open("");
            }
        }
        Button {
            text: @tr("Commit & push");
            size: "lg";
            enabled: root.message != "" && !GitUi.busy && !GitUi.pushing;
            clicked => {
                GitUi.commit(true);
            }
        }
        Button {
            text: @tr("Commit");
            variant: "primary";
            size: "lg";
            enabled: root.message != "" && !GitUi.busy && !GitUi.pushing;
            clicked => {
                GitUi.commit(false);
            }
        }
    }
}

// Push dialog: branch, upstream (or "sets the upstream"), ahead / behind, Push, result or copyable error.
component PushDialog inherits Dialog {
    title: @tr("Push");
    close-label: @tr("Close");
    dialog-width: 420px;
    close => {
        GitUi.open("");
    }
    Text {
        text: GitUi.upstream == "" ? @tr("{0} has no upstream yet; the push sets it.", GitUi.current) : @tr("{0} → {1}", GitUi.current, GitUi.upstream);
        wrap: word-wrap;
        font-size: Theme.ui-sm;
        color: Theme.foreground;
        accessible-role: AccessibleRole.text;
        accessible-label: "push target " + self.text;
    }
    Text {
        text: @tr("{0} ahead, {1} behind", GitUi.ahead, GitUi.behind);
        font-size: Theme.ui-sm;
        color: Theme.foreground-subtle;
        accessible-role: AccessibleRole.text;
        accessible-label: "push sync " + self.text;
    }

    ResultLine { }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button {
            text: @tr("Close");
            size: "lg";
            clicked => {
                GitUi.open("");
            }
        }
        Button {
            text: @tr("Push");
            label: @tr("Push now");
            variant: "primary";
            size: "lg";
            has-icon: true;
            icon: Icons.arrow-up;
            enabled: !GitUi.pushing && GitUi.current != "";
            clicked => {
                GitUi.push();
            }
        }
    }
}

component GraphLine inherits Rectangle {
    in property <GraphRow> item;
    in property <bool> selected;
    callback pick();
    height: 28px;
    border-radius: Theme.radius-md;
    background: root.selected ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
    accessible-role: list-item;
    accessible-label: "commit " + item.short + " " + item.subject;
    accessible-description: item.refs;
    accessible-action-default => {
        root.pick();
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.pick();
        }
    }
    HorizontalLayout {
        padding-left: Theme.space-1;
        padding-right: Theme.space-2;
        spacing: Theme.space-2;
        Rectangle {
            width: max(item.lanes, 1) * 14px;
            horizontal-stretch: 0;
            // Lines run from y = -1 to 29 (src/gitui.rs) so consecutive rows overlap by a pixel and stay joined.
            Path {
                y: -1px;
                width: parent.width;
                height: 30px;
                viewbox-y: -1;
                viewbox-width: max(item.lanes, 1) * 14;
                viewbox-height: 30;
                commands: item.path;
                stroke: Theme.icon-subtle;
                stroke-width: 1.5px;
            }
            Rectangle {
                x: (item.lane * 14 + 3) * 1px;
                y: 10px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.primary;
            }
        }
        Text {
            text: item.short;
            font-family: Theme.mono-font;
            font-size: Theme.ui-xs;
            color: Theme.foreground-subtle;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        if item.refs != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Tag {
                text: item.refs;
                tone: "progress";
            }
        }
        Text {
            text: item.subject;
            font-size: Theme.ui-sm;
            color: Theme.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: item.author;
            font-size: Theme.ui-xs;
            color: Theme.foreground-subtle;
            vertical-alignment: center;
            horizontal-stretch: 0;
            overflow: elide;
        }
        Text {
            text: item.date;
            font-size: Theme.ui-xs;
            color: Theme.foreground-subtlest;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
}

// Commit graph: one page of `git log` rows with lanes, click inspects a commit, "Load more" fetches the next page.
component GraphDialog inherits Dialog {
    title: @tr("Commit graph");
    close-label: @tr("Close");
    dialog-width: 760px;
    close => {
        GitUi.open("");
    }
    Rectangle {
        height: min(max(GitUi.graph.length, 1) * 28px + 8px, 360px);
        ListView {
            for r[i] in GitUi.graph: GraphLine {
                item: r;
                selected: i == GitUi.graph-selected;
                pick => {
                    GitUi.graph-selected = GitUi.graph-selected == i ? -1 : i;
                }
            }
        }
        if GitUi.graph.length == 0 && !GitUi.busy: Text {
            text: @tr("No commits yet");
            font-size: Theme.ui-sm;
            color: Theme.foreground-subtle;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if GitUi.graph-selected >= 0 && GitUi.graph-selected < GitUi.graph.length: Rectangle {
        border-radius: Theme.radius-lg;
        background: Theme.secondary;
        VerticalLayout {
            padding: Theme.space-2;
            spacing: Theme.space-1;
            HorizontalLayout {
                spacing: Theme.space-1;
                Text {
                    text: GitUi.graph[GitUi.graph-selected].hash;
                    font-family: Theme.mono-font;
                    font-size: Theme.ui-xs;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    accessible-role: AccessibleRole.text;
                    accessible-label: "commit hash " + self.text;
                }
                IconButton {
                    icon: Icons.copy;
                    label: @tr("Copy commit hash");
                    size: Theme.control-sm;
                    icon-size: Theme.icon-sm;
                    clicked => {
                        GitUi.copy-hash(GitUi.graph[GitUi.graph-selected].hash);
                    }
                }
            }
            Text {
                text: GitUi.graph[GitUi.graph-selected].subject;
                wrap: word-wrap;
                font-size: Theme.ui-sm;
                font-weight: Theme.weight-medium;
                color: Theme.foreground;
            }
            Text {
                text: @tr("{0} · {1} · parents {2}", GitUi.graph[GitUi.graph-selected].author, GitUi.graph[GitUi.graph-selected].date, GitUi.graph[GitUi.graph-selected].parents);
                wrap: word-wrap;
                font-size: Theme.ui-xs;
                color: Theme.foreground-subtle;
                accessible-role: AccessibleRole.text;
                accessible-label: "commit detail " + self.text;
            }
        }
    }
    ResultLine { }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        if GitUi.graph-more: Button {
            text: @tr("Load more");
            size: "lg";
            enabled: !GitUi.busy;
            clicked => {
                GitUi.load-more();
            }
        }
        Button {
            text: @tr("Close");
            size: "lg";
            clicked => {
                GitUi.open("");
            }
        }
    }
}

// Mounted at the window root (covers the whole window like the other dialogs).
export component GitDialogs inherits Rectangle {
    in-out property <string> message;
    if GitUi.dialog == "branches": BranchDialog { }
    if GitUi.dialog == "commit": CommitDialog {
        message <=> root.message;
    }
    if GitUi.dialog == "push": PushDialog { }
    if GitUi.dialog == "graph": GraphDialog { }
}
