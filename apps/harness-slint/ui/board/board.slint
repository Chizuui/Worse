import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, Spinner, Button, IconButton, Tag, Dialog, MenuShell, MenuItem } from "../components/controls.slint";
import { TextField, TextArea } from "../settings/parts.slint";
import { AgentTint, Pill } from "../panels/common.slint";

export struct BoardCard {
    id: string,
    lane: int,
    index: int,
    title: string,
    preview: string,
    state: string,
    agent: string,
    branch: string,
    cost: string,
    has-session: bool,
}

export struct BoardColumn {
    label: string,
    count: int,
}

export global BoardUi {
    in-out property <bool> open;
    in property <string> project;
    in property <string> mode: "Local";
    in property <string> sync-text;
    in property <bool> sync-error;
    in property <bool> linked;
    in property <bool> can-link;
    in property <bool> busy;
    in property <[BoardColumn]> columns;
    in property <[BoardCard]> cards;
    in property <int> max-count;
    in property <string> error;
    in-out property <bool> dialog-open;
    in-out property <string> dialog-id;
    in-out property <string> dialog-title;
    in-out property <string> dialog-body;
    in-out property <int> dialog-lane;
    callback action(string, string);
    callback move(string, int, int);
    callback save();
}

component CardItem inherits Rectangle {
    in property <BoardCard> card;
    in property <bool> dragging;
    border-radius: Theme.radius-lg;
    background: root.dragging ? Theme.raised : Theme.surface;
    border-width: 1px;
    border-color: root.card.state == "needsApproval" ? Theme.warning-surface-foreground.with-alpha(0.6) : root.card.state == "failed" ? Theme.destructive-surface-foreground.with-alpha(0.6) : root.dragging ? Theme.border-hover : Theme.border;
    drop-shadow-blur: root.dragging ? 18px : 0px;
    drop-shadow-offset-y: root.dragging ? 6px : 0px;
    drop-shadow-color: Theme.shadow-md-color;
    accessible-role: button;
    accessible-label: root.card.title;
    property <color> agent-tint: AgentTint.of(root.card.agent);
    VerticalLayout {
        padding: 10px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.card.title;
                font-size: 13px;
                font-weight: Theme.weight-medium;
                color: Theme.foreground;
                wrap: word-wrap;
                overflow: elide;
                max-height: 36px;
                horizontal-stretch: 1;
                accessible-role: none;
            }
            if root.card.agent != "": Pill {
                text: root.card.agent;
                tint: root.agent-tint;
            }
        }
        if root.card.preview != "": Text {
            text: root.card.preview;
            font-size: 12px;
            color: Theme.muted;
            overflow: elide;
            accessible-role: none;
        }
        Rectangle {
            vertical-stretch: 1;
        }
        HorizontalLayout {
            spacing: 6px;
            height: 18px;
            if root.card.state == "running": working := HorizontalLayout {
                property <int> beat;
                spacing: 6px;
                Timer {
                    interval: 100ms;
                    running: !Theme.reduce-motion;
                    triggered => {
                        working.beat = mod(working.beat + 1, 20);
                    }
                }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.agent-tint;
                    opacity: Theme.reduce-motion ? 1 : 0.55 + 0.45 * abs(sin(working.beat * 18deg));
                }
                Text {
                    text: "Agent working…";
                    font-size: 11px;
                    color: root.agent-tint;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
            if root.card.state == "needsApproval": Pill {
                y: 0;
                text: "Needs approval";
                tint: Theme.warning-surface-foreground;
            }
            if root.card.state == "failed": Pill {
                y: 0;
                text: "Failed";
                tint: Theme.destructive-surface-foreground;
            }
            if root.card.branch != "": Rectangle {
                y: 0;
                height: 18px;
                width: min(br.preferred-width + 26px, 180px);
                border-radius: 5px;
                background: Theme.success-surface.with-alpha(0.08);
                border-width: 1px;
                border-color: Theme.success-surface-foreground.with-alpha(0.35);
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        source: Icons.git-fork;
                        size: 11px;
                        tint: Theme.success-surface-foreground;
                    }
                    br := Text {
                        text: root.card.branch;
                        font-size: 10px;
                        color: Theme.success-surface-foreground;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: none;
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if root.card.cost != "": Text {
                text: root.card.cost;
                font-size: 11px;
                color: Theme.foreground-subtlest;
                vertical-alignment: center;
                accessible-role: none;
            }
        }
    }
}

component CardDialog inherits Dialog {
    title: BoardUi.dialog-id == "" ? "New card" : "Edit card";
    close-label: "Close";
    dialog-width: 520px;
    close => {
        BoardUi.dialog-open = false;
    }
    init => {
        title-field.focus();
    }
    title-field := TextField {
        text <=> BoardUi.dialog-title;
        label: "Title";
        placeholder: "Title";
        accepted => {
            BoardUi.save();
        }
    }
    TextArea {
        height: 180px;
        mono: false;
        text <=> BoardUi.dialog-body;
        label: "Description";
    }
    if BoardUi.error != "": Text {
        text: BoardUi.error;
        font-size: Theme.ui-sm;
        color: Theme.destructive;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button {
            text: "Cancel";
            size: "lg";
            clicked => {
                BoardUi.dialog-open = false;
            }
        }
        Button {
            text: BoardUi.dialog-id == "" ? "Create" : "Save";
            variant: "primary";
            size: "lg";
            clicked => {
                BoardUi.save();
            }
        }
    }
}

export component BoardPage inherits Rectangle {
    callback close();
    callback window-action(string);
    property <length> pad: 16px;
    property <length> gap: 12px;
    property <length> head-h: 36px;
    property <length> card-h: 104px;
    property <length> card-gap: 8px;
    property <length> col-w: max(180px, (root.width - root.pad * 2 - root.gap * 4) / 5);
    property <string> drag-id: "";
    property <length> drag-dx: 0px;
    property <length> drag-dy: 0px;
    property <length> drag-dist: 0px;
    property <string> menu-id: "";
    property <bool> menu-session: false;
    property <length> menu-x: 0px;
    property <length> menu-y: 0px;
    property <int> hover-lane: -1;
    pure function lane-x(lane: int) -> length {
        return root.pad + lane * (root.col-w + root.gap);
    }
    pure function card-y(index: int) -> length {
        return root.head-h + 8px + index * (root.card-h + root.card-gap);
    }
    pure function lane-at(x: length) -> int {
        return clamp(floor((x - root.pad + root.gap / 2) / (root.col-w + root.gap)), 0, 4);
    }
    pure function index-at(y: length) -> int {
        return max(0, round((y - root.head-h - 8px) / (root.card-h + root.card-gap)));
    }
    pure function lane-tint(label: string) -> color {
        if label.to-lowercase() == "in progress" || label.to-lowercase() == "doing" || label.to-lowercase() == "running" { return Theme.accent-fg; }
        if label.to-lowercase() == "review" || label.to-lowercase() == "in review" { return Theme.warning-surface-foreground; }
        if label.to-lowercase() == "done" { return Theme.success-surface-foreground; }
        if label.to-lowercase() == "todo" || label.to-lowercase() == "to do" { return Theme.info; }
        return Theme.muted;
    }
    background: Theme.background;
    accessible-role: AccessibleRole.text;
    accessible-label: "Board";
    TouchArea { }
    VerticalLayout {
        HorizontalLayout {
            height: 52px;
            padding-left: 12px;
            padding-right: 16px;
            spacing: 10px;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.chevron-left;
                label: "Back to chat";
                clicked => {
                    root.close();
                }
            }
            Icon {
                y: (parent.height - self.height) / 2;
                source: Icons.square-kanban;
                size: 16px;
                tint: Theme.icon-subtle;
            }
            Text {
                text: BoardUi.project == "" ? "Board" : BoardUi.project;
                font-family: Theme.display-font;
                font-size: 17px;
                font-weight: 700;
                color: Theme.foreground;
                vertical-alignment: center;
                overflow: elide;
            }
            Tag {
                y: (parent.height - self.height) / 2;
                text: BoardUi.mode;
            }
            if BoardUi.sync-text != "": Rectangle {
                y: (parent.height - self.height) / 2;
                height: 20px;
                width: min(sync-t.preferred-width + 16px, 360px);
                border-radius: 10px;
                background: BoardUi.sync-error ? Theme.destructive-surface : BoardUi.linked ? Theme.success-surface : Theme.tag;
                sync-t := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    text: BoardUi.sync-text;
                    font-size: 11px;
                    font-weight: Theme.weight-medium;
                    color: BoardUi.sync-error ? Theme.destructive-surface-foreground : BoardUi.linked ? Theme.success-surface-foreground : Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                TouchArea {
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                            root.window-action("drag");
                        }
                    }
                }
            }
            if BoardUi.can-link && !BoardUi.linked: Button {
                y: (parent.height - self.height) / 2;
                text: BoardUi.busy ? "Linking..." : "Link GitHub project";
                enabled: !BoardUi.busy;
                clicked => {
                    BoardUi.action("link", "");
                }
            }
            if BoardUi.linked: Button {
                y: (parent.height - self.height) / 2;
                text: BoardUi.busy ? "Syncing..." : "Sync now";
                enabled: !BoardUi.busy;
                clicked => {
                    BoardUi.action("sync", "");
                }
            }
            if BoardUi.linked: Button {
                y: (parent.height - self.height) / 2;
                text: "Unlink";
                variant: "ghost";
                enabled: !BoardUi.busy;
                clicked => {
                    BoardUi.action("unlink", "");
                }
            }
            Button {
                y: (parent.height - self.height) / 2;
                text: "New card";
                variant: "primary";
                icon: Icons.plus;
                has-icon: true;
                clicked => {
                    BoardUi.action("new", "");
                }
            }
            Rectangle {
                width: 4px;
            }
            for w in [
                { id: "minimize", icon: Icons.minus, label: "Minimize" },
                { id: "maximize", icon: Icons.square, label: "Maximize" },
                { id: "close", icon: Icons.x, label: "Close" },
            ]: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 30px;
                border-radius: Theme.radius-lg;
                background: wta.has-hover ? (w.id == "close" ? #e5484d : Theme.surface-hover) : transparent;
                accessible-role: button;
                accessible-label: w.label;
                accessible-action-default => {
                    root.window-action(w.id);
                }
                Icon {
                    source: w.icon;
                    size: w.id == "maximize" ? Theme.icon-xs : Theme.icon-sm;
                    tint: wta.has-hover && w.id == "close" ? #ffffff : Theme.icon;
                }
                wta := TouchArea {
                    clicked => {
                        root.window-action(w.id);
                    }
                }
            }
        }
        if BoardUi.error != "" && !BoardUi.dialog-open: Rectangle {
            height: 30px;
            Text {
                x: 16px;
                text: BoardUi.error;
                font-size: 12px;
                color: Theme.destructive-surface-foreground;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        Rectangle {
            height: 12px;
        }
        flick := Flickable {
            vertical-stretch: 1;
            interactive: false;
            content-width: max(self.width, root.pad * 2 + root.col-w * 5 + root.gap * 4);
            content-height: max(self.height, root.card-y(BoardUi.max-count + 1) + 16px);
            for col[li] in BoardUi.columns: Rectangle {
                x: root.lane-x(li);
                y: 0px;
                width: root.col-w;
                height: max(flick.height, flick.content-height) - 8px;
                border-radius: 12px;
                background: root.drag-id != "" && root.hover-lane == li ? Theme.raised : Theme.card;
                border-width: 1px;
                border-color: root.drag-id != "" && root.hover-lane == li ? Theme.accent-line : Theme.border;
                HorizontalLayout {
                    y: 0px;
                    height: root.head-h;
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text {
                        text: col.label.to-uppercase();
                        font-size: 10px;
                        font-weight: Theme.weight-semibold;
                        letter-spacing: 0.8px;
                        color: root.lane-tint(col.label);
                        vertical-alignment: center;
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 16px;
                        width: max(18px, cnt.preferred-width + 10px);
                        border-radius: 8px;
                        background: Theme.raised;
                        cnt := Text {
                            text: col.count;
                            font-size: 10px;
                            font-weight: Theme.weight-semibold;
                            color: Theme.muted;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    if li == 0: IconButton {
                        y: (parent.height - self.height) / 2;
                        size: Theme.control-sm;
                        icon-size: Theme.icon-xs;
                        icon: Icons.plus;
                        label: "Add card";
                        clicked => {
                            BoardUi.action("new", "");
                        }
                    }
                }
            }
            for c in BoardUi.cards: CardItem {
                card: c;
                dragging: root.drag-id == c.id;
                x: root.lane-x(c.lane) + 8px + (root.drag-id == c.id ? root.drag-dx : 0px);
                y: root.card-y(c.index) + (root.drag-id == c.id ? root.drag-dy : 0px);
                z: root.drag-id == c.id ? 10 : 1;
                width: root.col-w - 16px;
                height: root.card-h;
                ta := TouchArea {
                    mouse-cursor: root.drag-id == c.id && root.drag-dist > 5px ? MouseCursor.grabbing : MouseCursor.pointer;
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                            root.drag-id = c.id;
                            root.drag-dx = 0px;
                            root.drag-dy = 0px;
                            root.drag-dist = 0px;
                            root.hover-lane = c.lane;
                        }
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-id == c.id {
                            if root.drag-dist > 5px {
                                BoardUi.move(c.id, root.lane-at(root.lane-x(c.lane) + root.drag-dx + root.col-w / 2), root.index-at(root.card-y(c.index) + root.drag-dy));
                            } else {
                                BoardUi.action("click", c.id);
                            }
                            root.drag-id = "";
                            root.drag-dx = 0px;
                            root.drag-dy = 0px;
                            root.hover-lane = -1;
                        }
                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                            root.menu-id = c.id;
                            root.menu-session = c.has-session;
                            root.menu-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                            root.menu-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                            menu.show();
                        }
                    }
                    moved => {
                        if self.pressed && root.drag-id == c.id {
                            root.drag-dx = root.drag-dx + (self.mouse-x - self.pressed-x);
                            root.drag-dy = root.drag-dy + (self.mouse-y - self.pressed-y);
                            root.drag-dist = max(abs(root.drag-dx), abs(root.drag-dy));
                            root.hover-lane = root.lane-at(root.lane-x(c.lane) + root.drag-dx + root.col-w / 2);
                        }
                    }
                }
            }
            if BoardUi.cards.length == 0: Text {
                x: root.lane-x(0) + 12px;
                y: root.card-y(0) + 4px;
                width: root.col-w - 24px;
                text: "No cards yet. Add one with New card, then drag it to Todo to start an agent on it.";
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
    }
    menu := PopupWindow {
        x: min(root.menu-x, root.width - 200px);
        y: min(root.menu-y, root.height - 170px);
        width: 190px;
        MenuShell {
            MenuItem {
                text: "Start";
                icon: Icons.play;
                has-icon: true;
                show-check: false;
                enabled: !root.menu-session;
                clicked => {
                    BoardUi.action("start", root.menu-id);
                    menu.close();
                }
            }
            MenuItem {
                text: "Open session";
                icon: Icons.message-square;
                has-icon: true;
                show-check: false;
                enabled: root.menu-session;
                clicked => {
                    BoardUi.action("open", root.menu-id);
                    menu.close();
                }
            }
            MenuItem {
                text: "Edit";
                icon: Icons.pencil;
                has-icon: true;
                show-check: false;
                clicked => {
                    BoardUi.action("edit", root.menu-id);
                    menu.close();
                }
            }
            MenuItem {
                text: "Delete";
                icon: Icons.trash-2;
                has-icon: true;
                show-check: false;
                clicked => {
                    BoardUi.action("delete", root.menu-id);
                    menu.close();
                }
            }
        }
    }
    if BoardUi.dialog-open: CardDialog { }
}
