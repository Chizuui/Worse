// Title bar drag handle: a plain press starts the move (Rust drags the window and still detects
// double-clicks there). While the window is maximized the press only arms the drag — the native
// Windows behaviour restores the window under the cursor once the pointer moved more than 4px, so a
// plain click keeps it maximized. `bar-width` is the whole title bar width; `action` carries the
// window_action strings up to Rust. Disabled when the OS frame is used (the Windows title bar does
// drag, snap, Aero resize and drag-to-restore itself).
component TitleDrag inherits TouchArea {
    in property <bool> maximized;
    in property <length> bar-width: 1px;
    callback action(string);
    property <bool> dragging;
    // 修复：旧实现只看 pointer-event 并用 event.button 过滤，而 Slint 只在按下时把 button 设成 left，
    // 移动/拖动事件的 button 是 other，于是“拖动已最大化窗口”永远到不了 drag-restore。位移判断改为
    // 复用 TouchArea 的 moved 回调（按住期间持续触发）+ pointer-event 的非按下分支双保险。
    function check-drag() {
        if (self.pressed && root.maximized && !root.dragging) {
            if (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                root.dragging = true;
                // x as per-mille of the title bar width, y (physical px) from the window top.
                root.action("drag-restore:" + round((self.absolute-position.x + self.mouse-x) * 1000 / root.bar-width) + ":" + round((self.absolute-position.y + self.mouse-y) / 1px));
            }
        }
    }
    moved => {
        root.check-drag();
    }
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            if (event.button == PointerEventButton.left) {
                root.dragging = false;
                root.action("drag");
            }
        } else if (event.kind != PointerEventKind.up && event.kind != PointerEventKind.cancel) {
            root.check-drag();
        }
    }
}

export struct MdRow {
    cells: [styled-text],
    cells-dark: [styled-text],
    plain: string,
    links: [MdLink],
}

// kind: 0 text (StyledText), 1 heading (level 1..6), 2 code block, 3 table (rows[0] = header, level = columns),
// 4 list (lang "ul" / "ol", level = first number, one row per item with the item text in cells[0]).
// Code blocks: `highlighted` → `code-light` / `code-dark` (syntax colors per theme), else plain `code`.
export struct MdBlock {
    kind: int,
    level: int,
    text: styled-text,
    text-dark: styled-text,
    code: string,
    plain: string,
    lang: string,
    lang-icon: int,
    highlighted: bool,
    code-light: styled-text,
    code-dark: styled-text,
    rows: [MdRow],
    // Table only: CSV of the table (copy as CSV); `code` holds its Markdown source (copy as Markdown).
    csv: string,
    links: [MdLink],
}

// kind: 0 user, 1 assistant, 2 tool, 3 failover notice, 4 paused notice, 5 thinking (live only).
// expanded: tool card / thinking row open (kept in the model so virtualised rows keep it).
// parts / tool-kind: tool card content (R8). changes / change-dir / change-note: the turn's changed files (R14,
// on its last assistant row; change-dir 1 = undo available, 2 = reapply available).
// status (assistant): 0 streaming, 1 done, 2 stopped, 3 interrupted, 4 failed.
// status (tool): 0 running, 1 awaiting permission, 2 done, 3 denied, 4 failed.
export struct ChatItem {
    id: int,
    kind: int,
    agent: string,
    text: string,
    blocks: [MdBlock],
    status: int,
    title: string,
    from: string,
    to: string,
    reset: string,
    expanded: bool,
    parts: [ToolPart],
    tool-kind: string,
    changes: [ChangeRow],
    change-dir: int,
    change-note: string,
    images: [ChatImage],
    images-more: int,
}

// header: on the first row of a section: "pinned", a timeline group id ("today", "yesterday", "week", "month",
// "older") or "group" (a user group: header-label / header-color / header-id), else "".
// id == "": header-only row of a collapsed group. ago-unit / ago-n: relative update time (ChatUi.ago).
export struct SessionRow {
    id: string,
    title: string,
    agents: string,
    active: bool,
    header: string,
    ago-unit: string,
    ago-n: int,
    pinned: bool,
    unread: bool,
    header-id: string,
    header-label: string,
    // Group colour id; for a "project" header the workspace folder (tooltip / accessible description).
    header-color: string,
    // Sessions under a "project" header.
    header-count: int,
    collapsed: bool,
    worktree: bool,
}

// state: 0 available, 1 not installed, 2 limit reached.
export struct AgentRow {
    id: string,
    name: string,
    state: int,
    reset: string,
    claude: bool,
}

// icon: index into FileIcons.all (src/files.rs `icon_index`).
export struct FileRow {
    name: string,
    depth: int,
    is-dir: bool,
    expanded: bool,
    icon: int,
}

// A queued (not yet running) message; `id` is the core's queue key for cancel-queued.
// One answer of a permission request, exactly as the agent offered it (core Event::PermissionChoices).
// kind: 0 allow once, 1 allow always, 2 reject once, 3 reject always.
export struct PermOption {
    id: string,
    label: string,
    kind: int,
}

export struct QueueRow {
    id: string,
    text: string,
}

// Material file-type icon, centered in its layout cell (fixed-size items are top-aligned in Slint layouts).
// Agent identity colour (design tokens) from an agent display name or id; mixed / unknown → accent.
global AgentTint {
    pure public function of(name: string) -> color {
        AgentLogo.tint(AgentLogo.key(name))
    }
}

// Small rounded agent tile with the agent's initial (assistant author row, design frame 01).
component AgentTile inherits Rectangle {
    in property <string> name;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: AgentLogo.key(root.name) != "" ? transparent : AgentTint.of(root.name);
    property <string> lower: root.name.to-lowercase();
    if AgentLogo.key(root.name) != "": AgentMark {
        name: root.name;
        size: root.width;
    }
    property <string> known: AgentLogo.key(root.name) != "" ? "" : self.lower == "claude code" || self.lower == "claude" ? "C" : self.lower == "codex" ? "X" : self.lower == "deepseek" ? "D" : self.lower == "antigravity" || self.lower == "agy" ? "A" : self.lower == "gemini" ? "G" : "";
    if (root.known != "" || root.name == "") && AgentLogo.key(root.name) == "": Text {
        text: root.known != "" ? root.known : "H";
        font-size: 11px;
        font-weight: 700;
        color: #ffffff;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    // Unknown agent: first letter only (Slint has no substring; clip the upper-cased name).
    if root.known == "" && root.name != "" && AgentLogo.key(root.name) == "": Rectangle {
        x: 6px;
        width: 9px;
        clip: true;
        Text {
            x: 0;
            text: root.name.to-uppercase();
            font-size: 11px;
            font-weight: 700;
            color: #ffffff;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

component FileIcon inherits Rectangle {
    in property <int> index;
    in property <length> size: 16px;
    width: root.size;
    min-height: root.size;
    accessible-role: none;
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        source: FileIcons.all[root.index];
        image-fit: contain;
        accessible-role: none;
    }
}

// ---- markdown --------------------------------------------------------------------------------------------

component RichSelect inherits Rectangle {
    in property <styled-text> text;
    in property <string> plain;
    in property <[MdLink]> links;
    in property <length> font-size: Theme.ui-base;
    in property <string> font-family;
    in property <int> font-weight: 400;
    in property <brush> ink: Theme.foreground;
    callback link(string);
    height: st.preferred-height;
    st := StyledText {
        x: 0;
        y: 0;
        width: root.width;
        text: root.text;
        default-color: root.ink;
        link-color: Theme.link;
        default-font-size: root.font-size;
        default-font-family: root.font-family;
    }
    TextInput {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        text: root.plain;
        read-only: true;
        single-line: false;
        wrap: word-wrap;
        font-size: root.font-size;
        font-family: root.font-family;
        font-weight: root.font-weight;
        color: #00000001;
        selection-foreground-color: #00000001;
        selection-background-color: Theme.text-selection;
        accessible-role: none;
        cursor-position-changed(p) => {
            if self.has-focus && root.links.length > 0 && self.anchor-position-byte-offset == self.cursor-position-byte-offset {
                if ChatUi.link-at(root.links, self.cursor-position-byte-offset) != "" {
                    root.link(ChatUi.link-at(root.links, self.cursor-position-byte-offset));
                }
            }
        }
    }
}

component MarkdownView inherits VerticalLayout {
    in property <[MdBlock]> blocks;
    callback link(string);
    spacing: 12px;
    min-width: 0px;
    max-width: 100000px;
    // 修复：表格单元格若用 preferred-width: 0 求等宽列，StyledText 会按 0 宽度换行计算首选高度，行高暴涨、后续行被裁掉。
    // 改为按实际宽度给出固定列宽；宽度经 changed 回调写入普通属性，避免 width -> 子项 -> width 的绑定环。
    property <length> content-width: 400px;
    changed width => {
        root.content-width = root.width;
    }
    init => {
        root.content-width = root.width;
    }
    for b in root.blocks: VerticalLayout {
        // 修复（8.2 遗留：长回复与下一条消息重叠）：段落 StyledText 位于 for/if 重复项内，布局的宽度约束传不到它的
        // 高度测量，首选高度按未换行的单行宽度计算（实测行高 60px，实际需 114px）；ListView 按该高度摆放下一行，
        // 于是下一条消息压在换行后的文字上。显式给出内容宽度，高度即按实际换行宽度计算（gate 断言相邻行不重叠）。
        if b.kind == 0 || b.kind == 1: RichSelect {
            width: root.content-width;
            text: Theme.dark ? b.text-dark : b.text;
            plain: b.plain;
            links: b.links;
            font-weight: b.kind == 1 ? 700 : 400;
            font-size: b.kind == 1 ? (b.level == 1 ? Theme.ui-xl : (b.level == 2 ? Theme.ui-lg : Theme.ui-base)) : Theme.ui-base;
            link(url) => {
                root.link(url);
            }
        }
        if b.kind == 5: Rectangle {
            height: 9px;
            accessible-role: none;
            Rectangle {
                y: 4px;
                height: 1px;
                background: Theme.border;
            }
        }
        // Code block: ZCode card with a language header (file-type icon + language) above the code.
        if b.kind == 2: cb := Rectangle {
            // Wrap toggle per block (ZCode code block "Wrap"); unwrapped code scrolls horizontally.
            property <bool> wrap: true;
            background: Theme.card;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            // Gate/screen-reader hook: language and whether Rust produced syntax colors.
            accessible-role: AccessibleRole.text;
            accessible-label: "code " + b.lang;
            accessible-description: b.highlighted ? "highlighted" : "plain";
            VerticalLayout {
                Rectangle {
                    height: 32px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 6px;
                        spacing: 6px;
                        if b.lang != "": FileIcon {
                            index: b.lang-icon;
                            size: 14px;
                        }
                        Text {
                            text: b.lang != "" ? b.lang : @tr("Code");
                            font-size: Theme.ui-sm;
                            color: Theme.foreground-subtle;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.arrow-left-right;
                            label: cb.wrap ? @tr("Disable wrap") : @tr("Enable wrap");
                            size: Theme.control-sm;
                            icon-size: Theme.icon-xs;
                            active: !cb.wrap;
                            clicked => {
                                cb.wrap = !cb.wrap;
                            }
                        }
                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.copy;
                            label: @tr("Copy code");
                            size: Theme.control-sm;
                            icon-size: Theme.icon-xs;
                            clicked => {
                                ChatUi.copy(b.code);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding: 12px;
                    padding-top: 0px;
                    // 同上：代码块文字也显式给宽度，换行后的高度才会计入行高。
                    if b.highlighted && cb.wrap: RichSelect {
                        width: root.content-width - 24px;
                        text: Theme.dark ? b.code-dark : b.code-light;
                        plain: b.plain;
                        font-family: Theme.mono-font;
                        font-size: Theme.code-size;
                    }
                    if !b.highlighted && cb.wrap: TextInput {
                        width: root.content-width - 24px;
                        text: b.plain;
                        read-only: true;
                        single-line: false;
                        font-family: Theme.mono-font;
                        font-size: Theme.code-size;
                        color: Theme.foreground;
                        selection-background-color: Theme.text-selection;
                        wrap: word-wrap;
                    }
                    // 不换行：长行在块内横向滚动，块高按行数计算。
                    if !cb.wrap: Flickable {
                        width: root.content-width - 24px;
                        height: nw.preferred-height;
                        content-width: max(self.width, nw.preferred-width);
                        nw := Text {
                            text: b.plain;
                            font-family: Theme.mono-font;
                            font-size: Theme.code-size;
                            color: Theme.foreground;
                            wrap: no-wrap;
                        }
                    }
                }
            }
        }
        // Table: bordered rounded-lg frame, subtle header row, hairlines between rows.
        // List (ZCode markdown-list: items space-y-1.5, subtle markers, pl-5): one row per top-level item.
        if b.kind == 4: VerticalLayout {
            spacing: 6px;
            accessible-role: AccessibleRole.list;
            accessible-label: "list " + b.rows.length;
            for r[ri] in b.rows: HorizontalLayout {
                if b.lang == "ol": Text {
                    width: 24px;
                    text: (b.level + ri) + ".";
                    color: Theme.accent-fg;
                    font-size: Theme.ui-base;
                    font-weight: Theme.weight-medium;
                    accessible-role: none;
                }
                if b.lang != "ol": Rectangle {
                    width: 20px;
                    Rectangle {
                        x: 6px;
                        y: 8px;
                        width: 5px;
                        height: 5px;
                        border-radius: 2.5px;
                        background: Theme.accent-fg.with-alpha(0.7);
                    }
                }
                RichSelect {
                    width: root.content-width - (b.lang == "ol" ? 24px : 20px);
                    text: Theme.dark ? r.cells-dark[0] : r.cells[0];
                    plain: r.plain;
                    links: r.links;
                    link(url) => {
                        root.link(url);
                    }
                }
            }
        }
        // Table copy (ZCode table toolbar): Markdown source or CSV.
        if b.kind == 3: HorizontalLayout {
            alignment: end;
            spacing: 2px;
            height: Theme.control-sm;
            Button {
                text: @tr("Copy as Markdown");
                size: "xs";
                variant: "ghost";
                has-icon: true;
                icon: Icons.copy;
                text-color: Theme.foreground-subtle;
                clicked => {
                    ChatUi.copy(b.code);
                }
            }
            Button {
                text: @tr("Copy as CSV");
                size: "xs";
                variant: "ghost";
                has-icon: true;
                icon: Icons.table;
                text-color: Theme.foreground-subtle;
                clicked => {
                    ChatUi.copy(b.csv);
                }
            }
        }
        if b.kind == 3: Rectangle {
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            accessible-role: table;
            accessible-label: "table " + b.rows.length + "x" + b.level;
            VerticalLayout {
                for r[ri] in b.rows: VerticalLayout {
                    if ri > 0: Divider { }
                    Rectangle {
                        background: ri == 0 ? Theme.surface : transparent;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 12px;
                            // 等宽列：各行独立布局，按内容分配宽度会导致列无法对齐，因此使用统一的固定列宽。
                            for c[ci] in r.cells: StyledText {
                                width: max(24px, (root.content-width - 24px - 12px * max(0, b.level - 1)) / max(1, b.level));
                                text: Theme.dark ? r.cells-dark[ci] : c;
                                default-color: ri == 0 ? Theme.foreground-subtle : Theme.foreground;
                                link-color: Theme.link;
                                default-font-size: Theme.ui-base;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---- chat rows -------------------------------------------------------------------------------------------

// Hover action under a message (ZCode MessageActions: ghost icon buttons, shown on hover, always reachable).
component MessageAction inherits IconButton {
    size: Theme.control-sm;
    icon-size: Theme.icon-xs;
    animate opacity { duration: Theme.dur-hover; easing: ease-out-quint; }
}

component ChatRow inherits VerticalLayout {
    in property <ChatItem> item;
    in property <length> bubble-max: 600px;
    // Current find match (ring around the row).
    in property <bool> hit;
    // The session runs (turn actions that rewrite history are disabled; the hub would answer Busy).
    in property <bool> busy;
    callback link(string);
    // Tool and thinking rows are flat one-liners: they stack tight; messages keep their breathing room.
    padding-top: root.item.kind == 2 || root.item.kind == 5 ? 1px : 8px;
    padding-bottom: root.item.kind == 2 || root.item.kind == 5 ? 1px : 8px;
    // User message: right-aligned bubble (`bg-user-bubble rounded-xl`), at most 80% of the column.
    if root.item.kind == 0: Rectangle {
        min-width: ul.min-width;
        min-height: ul.min-height;
        preferred-height: ul.preferred-height;
        max-height: ul.max-height;
        uta := TouchArea {
            ul := VerticalLayout {
                spacing: 2px;
                if root.item.images.length > 0: ImageStrip {
                    images: root.item.images;
                    more: root.item.images-more;
                    at-end: true;
                    padding-bottom: 4px;
                }
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        // Soft filled bubble, no outline; the bottom-right corner is tighter, like a tail.
                        max-width: min(root.bubble-max, 560px);
                        background: Theme.user-bubble;
                        border-radius: 18px;
                        border-bottom-right-radius: 6px;
                        border-width: root.hit ? 1px : 0px;
                        border-color: root.hit ? Theme.find-highlight-active : transparent;
                        accessible-role: AccessibleRole.text;
                        accessible-label: root.item.text;
                        accessible-item-selected: root.hit;
                        HorizontalLayout {
                            padding-top: 10px;
                            padding-bottom: 10px;
                            padding-left: 15px;
                            padding-right: 15px;
                            TextInput {
                                text: root.item.text;
                                read-only: true;
                                single-line: false;
                                wrap: word-wrap;
                                color: Theme.foreground;
                                font-size: Theme.ui-caption;
                                selection-background-color: Theme.text-selection;
                                accessible-role: none;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    height: Theme.control-sm;
                    // R10: edit + resend, rewind to here (text and context back into the composer), fork from here.
                    MessageAction {
                        icon: Icons.pencil;
                        label: @tr("Edit message");
                        opacity: uta.has-hover ? 1 : 0.0;
                        enabled: !root.busy;
                        clicked => {
                            ChatUi.turn-action("edit", root.item.id);
                        }
                    }
                    MessageAction {
                        icon: Icons.rotate-ccw;
                        label: @tr("Rewind to here");
                        opacity: uta.has-hover ? 1 : 0.0;
                        enabled: !root.busy;
                        clicked => {
                            ChatUi.turn-action("rewind", root.item.id);
                        }
                    }
                    MessageAction {
                        icon: Icons.git-fork;
                        label: @tr("Fork from here");
                        opacity: uta.has-hover ? 1 : 0.0;
                        clicked => {
                            ChatUi.turn-action("fork", root.item.id);
                        }
                    }
                    MessageAction {
                        icon: Icons.copy;
                        label: @tr("Copy message");
                        opacity: uta.has-hover ? 1 : 0.0;
                        clicked => {
                            ChatUi.copy(root.item.text);
                        }
                    }
                }
            }
        }
    }
    // Assistant message: plain markdown on the panel (no bubble). A small agent line names who answered,
    // since one Harness session mixes agents.
    if root.item.kind == 1: Rectangle {
        // Screen readers (and the gate) read "<agent>: <raw text>".
        accessible-role: AccessibleRole.text;
        accessible-label: root.item.agent + ": " + root.item.text;
        accessible-item-selected: root.hit;
        border-width: root.hit ? 2px : 0px;
        border-color: Theme.find-highlight-active;
        border-radius: Theme.radius-lg;
        min-width: al.min-width;
        min-height: al.min-height;
        preferred-height: al.preferred-height;
        max-height: al.max-height;
        ata := TouchArea {
            al := VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    height: 24px;
                    AgentTile {
                        y: (parent.height - self.height) / 2;
                        name: root.item.agent;
                    }
                    Text {
                        text: root.item.agent;
                        font-size: Theme.ui-caption;
                        font-weight: Theme.weight-semibold;
                        color: Theme.foreground;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    if root.item.status == 0: Spinner {
                        y: (parent.height - self.height) / 2;
                        size: 13px;
                    }
                    if root.item.status == 0: Text {
                        text: @tr("Streaming…");
                        font-size: Theme.ui-sm;
                        color: Theme.foreground-subtle;
                        vertical-alignment: center;
                    }
                    if root.item.status == 2: Text {
                        text: @tr("Stopped");
                        font-size: Theme.ui-sm;
                        color: Theme.warning-surface-foreground;
                        vertical-alignment: center;
                    }
                    if root.item.status == 3: Text {
                        text: @tr("Interrupted");
                        font-size: Theme.ui-sm;
                        color: Theme.warning-surface-foreground;
                        vertical-alignment: center;
                    }
                    if root.item.status == 4: Text {
                        text: @tr("Failed");
                        font-size: Theme.ui-sm;
                        color: Theme.destructive;
                        vertical-alignment: center;
                    }
                }
                MarkdownView {
                    blocks: root.item.blocks;
                    link(url) => {
                        root.link(url);
                    }
                }
                if root.item.changes.length > 0: ChangesCard {
                    id: root.item.id;
                    files: root.item.changes;
                    dir: root.item.change-dir;
                    note: root.item.change-note;
                }
                if root.item.status != 0: HorizontalLayout {
                    alignment: start;
                    height: Theme.control-sm;
                    MessageAction {
                        icon: Icons.copy;
                        label: @tr("Copy response");
                        opacity: ata.has-hover ? 1 : 0.0;
                        clicked => {
                            ChatUi.copy(root.item.text);
                        }
                    }
                    if root.item.id == ChatUi.last-assistant: MessageAction {
                        icon: Icons.refresh-cw;
                        label: @tr("Retry");
                        opacity: ata.has-hover ? 1 : 0.0;
                        enabled: !root.busy;
                        clicked => {
                            ChatUi.turn-action("retry", root.item.id);
                        }
                    }
                    MessageAction {
                        icon: Icons.git-fork;
                        label: @tr("Fork from here");
                        opacity: ata.has-hover ? 1 : 0.0;
                        clicked => {
                            ChatUi.turn-action("fork", root.item.id);
                        }
                    }
                }
            }
        }
    }
    // Tool call: ZCode's inline tool row (icon + title + status) that expands into its content (R8).
    if root.item.kind == 2: ToolCard {
        id: root.item.id;
        title: root.item.title;
        status: root.item.status;
        tool-kind: root.item.tool-kind;
        parts: root.item.parts;
        expanded: root.item.expanded;
        hit: root.hit;
        images: root.item.images;
        images-more: root.item.images-more;
    }
    // Thinking (live agent thought): collapsed line, expands to the text.
    if root.item.kind == 5: ThinkingRow {
        id: root.item.id;
        text: root.item.text;
        preview: root.item.title;
        active: root.item.status == 0;
        expanded: root.item.expanded;
    }
    // Autonomous turn when a background task ended (§9.17): one muted line with a refresh icon.
    if root.item.kind == 6: Rectangle {
        height: line.preferred-height + 8px;
        accessible-role: AccessibleRole.text;
        accessible-label: root.item.text;
        HorizontalLayout {
            padding: 4px;
            spacing: 6px;
            Icon {
                y: (parent.height - self.height) / 2;
                source: Icons.refresh-cw;
                size: Theme.icon-xs;
                tint: Theme.foreground-subtlest;
            }
            line := Text {
                text: root.item.text;
                font-size: Theme.ui-sm;
                color: Theme.foreground-subtle;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
                accessible-role: none;
            }
        }
    }
    // Failover / paused notices: warning surface with an icon.
    if root.item.kind == 3 || root.item.kind == 4: Rectangle {
        property <string> message: root.item.kind == 3 ? (root.item.reset != "" ? @tr("Switched from {0} to {1}: limit reached (resets {2})", root.item.from, root.item.to, root.item.reset) : @tr("Switched from {0} to {1}: limit reached", root.item.from, root.item.to)) : (root.item.reset != "" ? @tr("All agents reached their limits. Paused (resets {0})", root.item.reset) : @tr("All agents reached their limits. Paused"));
        background: Theme.warning-surface;
        border-radius: Theme.radius-lg;
        accessible-role: AccessibleRole.text;
        accessible-label: self.message;
        HorizontalLayout {
            padding: 8px;
            padding-left: 12px;
            spacing: 8px;
            Icon {
                source: root.item.kind == 3 ? Icons.arrow-left-right : Icons.pause;
                size: Theme.icon-sm;
                tint: Theme.warning-surface-foreground;
            }
            Text {
                text: message;
                wrap: word-wrap;
                font-size: Theme.ui-sm;
                color: Theme.warning-surface-foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
                accessible-role: none;
            }
        }
    }
}

// ---- sidebar ---------------------------------------------------------------------------------------------

component Sidebar inherits Rectangle {
    in property <[SessionRow]> sessions;
    in property <string> initial;
    in property <string> workspace;
    // Narrow drawer: no brand row above the sidebar, so show the New session button inside it.
    in property <bool> show-new: false;
    callback new-session();
    callback new-menu(length, length);
    callback new-worktree-session();
    callback open-session(string);
    callback archive-session(string);
    callback open-settings();
    // Opens a settings page from the sidebar ("projects", "archive").
    callback open-page(string);
    // Session context menu at a window position (right click or the row's "More" button).
    callback menu(string, length, length);
    // Group menu (header right click or its "More" button).
    callback group-menu(string, length, length);
    // Session drag (R11): the dragged session id, the pointer y in the sidebar and the drop list geometry.
    property <string> drag-id;
    property <bool> dragged;
    property <length> drag-y;
    property <length> drop-row: 28px;
    property <length> drop-top: root.height - 48px - (ChatUi.groups.length + 1) * root.drop-row;
    // Nothing here yet: the ASCII bunny naps where the list would be.
    if root.sessions.length == 0: VerticalLayout {
        x: 0;
        y: root.height * 0.32;
        width: root.width;
        height: 96px;
        alignment: center;
        spacing: 10px;
        HorizontalLayout {
            alignment: center;
            GlyphAnim {
                frames: AsciiArt.bunny-sleep;
                interval: 380ms;
                font-size: 13px;
                color: Theme.foreground-subtlest;
            }
        }
        Text {
            text: @tr("No sessions yet");
            font-size: Theme.ui-sm;
            color: Theme.foreground-subtlest;
            horizontal-alignment: center;
            accessible-role: none;
        }
    }
    VerticalLayout {
        padding: 12px;
        padding-top: 4px;
        spacing: 2px;
        if root.show-new: HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 6px;
            Button {
                horizontal-stretch: 1;
                text: @tr("New session");
                variant: "primary";
                has-icon: true;
                icon: Icons.plus;
                clicked => {
                    root.new-session();
                }
            }
            Button {
                label: "New session in worktree";
                variant: "secondary";
                has-icon: true;
                icon: Icons.git-fork;
                clicked => {
                    root.new-worktree-session();
                }
            }
        }
        // Search sessions (design 01): surface field with a Ctrl K chip; opens the command palette.
        Rectangle {
            height: 34px;
            border-radius: Theme.radius-md;
            background: srch-ta.has-hover ? Theme.surface-hover : Theme.surface;
            border-width: 1px;
            border-color: srch-ta.has-hover ? Theme.border-hover : Theme.border;
            animate background, border-color { duration: Theme.dur-hover; easing: ease-out-quint; }
            accessible-role: button;
            accessible-label: @tr("Search");
            accessible-action-default => {
                ChatUi.palette-open = true;
            }
            HorizontalLayout {
                padding-left: 11px;
                padding-right: 6px;
                spacing: 8px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    source: Icons.search;
                    size: Theme.icon-xs;
                    tint: Theme.icon-subtlest;
                }
                Text {
                    text: @tr("Search sessions");
                    font-size: Theme.ui-caption;
                    color: Theme.foreground-subtlest;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                    accessible-role: none;
                }
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 20px;
                    width: kbd-t.preferred-width + 12px;
                    border-radius: Theme.radius-sm;
                    background: Theme.raised;
                    border-width: 1px;
                    border-color: Theme.border-hover;
                    kbd-t := Text {
                        text: "Ctrl K";
                        font-size: Theme.ui-xs + 1px;
                        color: Theme.muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
            srch-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    ChatUi.palette-open = true;
                }
            }
        }
        Rectangle {
            height: 8px;
        }
        HorizontalLayout {
            height: 28px;
            padding-left: 10px;
            SectionLabel {
                text: @tr("Sessions");
                horizontal-stretch: 1;
            }
            IconButton {
                icon: Icons.plus;
                label: @tr("New group");
                size: Theme.control-sm;
                icon-size: Theme.icon-xs;
                clicked => {
                    ChatUi.group-action("new", "");
                }
            }
        }
        ListView {
            vertical-stretch: 1;
            for s in root.sessions: Rectangle {
                // Section header above the first row: Pinned, a user group (color dot, collapse, menu) or a timeline
                // group (ZCode task list: Today / Yesterday / Previous 7 days …). id == "": collapsed group header only.
                height: (s.header != "" ? (s.header == "group" || s.header == "project" ? 36px : 30px) : 0px) + (s.id != "" ? 49px : 0px);
                VerticalLayout {
                    padding-bottom: s.id != "" ? 2px : 0px;
                    if s.header == "project": Rectangle {
                        height: 36px;
                        border-radius: Theme.radius-md;
                        background: pha.has-hover ? Theme.hover : transparent;
                        accessible-role: AccessibleRole.button;
                        accessible-label: "project " + s.header-label;
                        accessible-description: (s.collapsed ? "collapsed " : "expanded ") + s.header-color;
                        accessible-action-default => {
                            ChatUi.group-action("toggle", s.header-id);
                        }
                        pha := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                ChatUi.group-action("toggle", s.header-id);
                            }
                        }
                        HorizontalLayout {
                            padding-top: 12px;
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            // Caps folder header (design 01: "ZCODE / WORSE   5").
                            Text {
                                text: s.header-label.to-uppercase();
                                font-size: 10px;
                                font-weight: Theme.weight-semibold;
                                letter-spacing: 0.8px;
                                color: Theme.caps-label;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                            Icon {
                                y: (parent.height - self.height) / 2;
                                source: s.collapsed ? Icons.chevron-right : Icons.chevron-down;
                                size: Theme.icon-xs;
                                tint: Theme.icon-subtle;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: s.header-count;
                                font-size: 10px;
                                color: Theme.caps-label;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.plus;
                                label: "New session in " + s.header-label;
                                size: Theme.control-sm;
                                icon-size: Theme.icon-xs;
                                opacity: pha.has-hover ? 1 : 0.55;
                                clicked => {
                                    ChatUi.group-action("new-session", s.header-color);
                                }
                            }
                        }
                    }
                    if s.header != "" && s.header != "group" && s.header != "project": HorizontalLayout {
                        height: 30px;
                        padding-top: 8px;
                        padding-left: 0px;
                        SectionLabel {
                            text: ChatUi.group-label(s.header);
                        }
                    }
                    if s.header == "group": Rectangle {
                        height: 36px;
                        border-radius: Theme.radius-md;
                        background: gha.has-hover ? Theme.hover : transparent;
                        accessible-role: AccessibleRole.button;
                        accessible-label: "group " + s.header-label;
                        accessible-description: s.collapsed ? "collapsed" : "expanded";
                        accessible-action-default => {
                            ChatUi.group-action("toggle", s.header-id);
                        }
                        gha := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                ChatUi.group-action("toggle", s.header-id);
                            }
                            pointer-event(event) => {
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                    root.group-menu(s.header-id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-top: 12px;
                            padding-left: 10px;
                            padding-right: 2px;
                            spacing: 6px;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: ChatUi.group-color(s.header-color);
                            }
                            Text {
                                text: s.header-label.to-uppercase();
                                font-size: 10px;
                                font-weight: Theme.weight-semibold;
                                letter-spacing: 0.8px;
                                color: Theme.caps-label;
                                vertical-alignment: center;
                                overflow: elide;
                                accessible-role: none;
                            }
                            Icon {
                                y: (parent.height - self.height) / 2;
                                source: s.collapsed ? Icons.chevron-right : Icons.chevron-down;
                                size: Theme.icon-xs;
                                tint: Theme.icon-subtle;
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            IconButton {
                                y: (parent.height - self.height) / 2;
                                icon: Icons.ellipsis;
                                label: @tr("Group actions for {0}", s.header-label);
                                size: Theme.control-sm;
                                icon-size: Theme.icon-xs;
                                opacity: gha.has-hover ? 1 : 0;
                                clicked => {
                                    root.group-menu(s.header-id, self.absolute-position.x, self.absolute-position.y + self.height);
                                }
                            }
                        }
                    }
                    if s.id != "": Rectangle {
                        // Design 01: 47px row, agent-colour dot, title 13 + meta 11, active = raised bg.
                        border-radius: Theme.radius-md;
                        background: s.active ? Theme.raised : (sta.has-hover ? Theme.hover : Theme.hover.with-alpha(0));
                        border-width: 0px;
                        transform-scale: sta.pressed ? 0.985 : 1;
                        animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
                        animate transform-scale { duration: Theme.dur-press; easing: ease-out-quint; }
                        accessible-role: list-item;
                        accessible-label: s.title != "" ? s.title : @tr("Untitled session");
                        accessible-item-selected: s.active;
                        accessible-action-default => {
                            root.open-session(s.id);
                        }
                        Rectangle {
                            x: 10px;
                            y: 14px;
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: AgentTint.of(s.agents);
                        }
                        VerticalLayout {
                            padding-left: 28px;
                            padding-right: sta.has-hover || more-btn.hovered || archive-btn.hovered || s.active ? 64px : 10px;
                            alignment: center;
                            spacing: 1px;
                            HorizontalLayout {
                                spacing: 4px;
                                if s.pinned: Icon {
                                    source: Icons.pin;
                                    size: 12px;
                                    tint: Theme.icon-subtlest;
                                }
                                if s.worktree: Icon {
                                    source: Icons.git-fork;
                                    size: 12px;
                                    tint: Theme.icon-subtlest;
                                }
                                Text {
                                    text: s.title != "" ? s.title : @tr("Untitled session");
                                    font-size: Theme.ui-caption;
                                    font-weight: s.unread ? Theme.weight-semibold : 400;
                                    color: s.active || sta.has-hover || s.unread ? Theme.foreground : Theme.foreground-subtle;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                    accessible-role: none;
                                }
                                if s.unread: StatusDot {
                                    y: (parent.height - self.height) / 2;
                                    tint: Theme.accent-fg;
                                    accessible-role: AccessibleRole.text;
                                    accessible-label: "unread";
                                }
                            }
                            Text {
                                text: s.agents != "" ? s.agents + " · " + ChatUi.ago(s.ago-unit, s.ago-n) : ChatUi.ago(s.ago-unit, s.ago-n);
                                font-size: Theme.ui-sm - 1px;
                                color: Theme.muted;
                                overflow: elide;
                                accessible-role: none;
                            }
                        }
                        sta := TouchArea {
                            mouse-cursor: root.drag-id != "" ? grabbing : pointer;
                            clicked => {
                                if !root.dragged {
                                    root.open-session(s.id);
                                }
                            }
                            moved => {
                                // Drag to a group (ZCode task list): starts after 8px; the drop list shows the targets.
                                if self.pressed && ChatUi.groups.length > 0 && (root.drag-id != "" || abs(self.mouse-y - self.pressed-y) > 8px) {
                                    root.drag-id = s.id;
                                    root.dragged = true;
                                    root.drag-y = self.absolute-position.y + self.mouse-y - root.absolute-position.y;
                                }
                            }
                            pointer-event(event) => {
                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                    root.dragged = false;
                                }
                                if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-id != "" {
                                    if root.drag-y >= root.drop-top {
                                        if floor((root.drag-y - root.drop-top) / root.drop-row) < ChatUi.groups.length {
                                            ChatUi.drop-session(root.drag-id, ChatUi.groups[floor((root.drag-y - root.drop-top) / root.drop-row)].id);
                                        } else {
                                            ChatUi.drop-session(root.drag-id, "");
                                        }
                                    }
                                    root.drag-id = "";
                                }
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                    root.menu(s.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                        more-btn := IconButton {
                            x: parent.width - self.width * 2 - 6px;
                            y: (parent.height - self.height) / 2;
                            icon: Icons.ellipsis;
                            label: @tr("More actions for {0}", s.title != "" ? s.title : @tr("Untitled session"));
                            size: Theme.control-sm;
                            icon-size: Theme.icon-sm;
                            opacity: sta.has-hover || self.hovered || archive-btn.hovered || s.active ? 1 : 0;
                            animate opacity { duration: Theme.dur-hover; }
                            clicked => {
                                root.menu(s.id, self.absolute-position.x, self.absolute-position.y + self.height);
                            }
                        }
                        // Archive (ZCode: hover action on the session row). Always in the tree so keyboard and
                        // accessibility users reach it; only drawn on hover or for the open session.
                        archive-btn := IconButton {
                            x: parent.width - self.width - 4px;
                            y: (parent.height - self.height) / 2;
                            icon: Icons.archive;
                            label: @tr("Archive {0}", s.title != "" ? s.title : @tr("Untitled session"));
                            size: Theme.control-sm;
                            icon-size: Theme.icon-sm;
                            opacity: sta.has-hover || self.hovered || more-btn.hovered || s.active ? 1 : 0;
                            animate opacity { duration: Theme.dur-hover; }
                            clicked => {
                                root.archive-session(s.id);
                            }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 6px;
        }
        // Account card (design 01): avatar, workspace name, plan usage track, settings gear.
        Rectangle {
        height: 52px;
        border-radius: Theme.radius-lg;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        HorizontalLayout {
            padding: 4px;
            padding-right: 6px;
            spacing: 4px;
            acct := Rectangle {
                horizontal-stretch: 1;
                border-radius: Theme.radius-md;
                background: acct-ta.has-hover ? Theme.hover : Theme.hover.with-alpha(0);
                transform-scale: acct-ta.pressed ? 0.97 : 1;
                animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
                animate transform-scale { duration: Theme.dur-press; easing: ease-out-quint; }
                accessible-role: button;
                accessible-label: @tr("Account menu");
                accessible-action-default => {
                    acct-menu.show();
                }
                acct-row := HorizontalLayout {
                    x: 8px;
                    width: parent.width - 16px;
                    spacing: 8px;
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 26px;
                        height: 26px;
                        border-radius: 13px;
                        background: Theme.surface-hover;
                        border-width: 1px;
                        border-color: Theme.glass-border;
                        Text {
                            text: root.initial;
                            font-size: Theme.ui-sm;
                            font-weight: Theme.weight-semibold;
                            color: Theme.foreground;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                // 没有打开文件夹时只显示产品名。
                                text: root.workspace != "" ? root.workspace : "Worse Harness";
                                font-size: Theme.ui-sm;
                                font-weight: Theme.weight-medium;
                                color: Theme.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: root.workspace != "" ? "· Harness" : "";
                                font-size: Theme.ui-sm;
                                color: Theme.foreground-subtle;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        // Plan usage track (only when the agent reports usage).
                        if ChatUi.usage-known: Rectangle {
                            height: 3px;
                            border-radius: 1.5px;
                            background: Theme.border-hover;
                            Rectangle {
                                x: 0;
                                width: parent.width * clamp(ChatUi.usage-ratio, 0, 1);
                                height: parent.height;
                                border-radius: 1.5px;
                                background: ChatUi.usage-ratio > 0.9 ? Theme.destructive : ChatUi.usage-ratio > 0.7 ? Theme.warning-surface-foreground : Theme.accent-fg;
                            }
                        }
                    }
                }
                acct-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        acct-menu.show();
                    }
                }
                acct-menu := PopupWindow {
                    x: 0;
                    y: -self.height - 8px;
                    width: 260px;
                    MenuShell {
                        HorizontalLayout {
                            height: 26px;
                            padding-left: 10px;
                            Text {
                                text: root.workspace != "" ? root.workspace + " · " + @tr("Local") : @tr("Local");
                                font-size: Theme.ui-sm;
                                font-weight: Theme.weight-medium;
                                color: Theme.foreground-subtle;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        MenuItem {
                            text: @tr("Settings");
                            detail: "Ctrl+,";
                            show-check: false;
                            has-icon: true;
                            icon: Icons.settings;
                            clicked => {
                                acct-menu.close();
                                root.open-settings();
                            }
                        }
                        MenuItem {
                            text: @tr("Agents & usage");
                            show-check: false;
                            has-icon: true;
                            icon: Icons.bot;
                            clicked => {
                                acct-menu.close();
                                root.open-page("agents");
                            }
                        }
                        MenuItem {
                            text: @tr("Appearance");
                            show-check: false;
                            has-icon: true;
                            icon: Icons.palette;
                            clicked => {
                                acct-menu.close();
                                root.open-page("appearance");
                            }
                        }
                        MenuItem {
                            text: @tr("Keyboard shortcuts");
                            show-check: false;
                            has-icon: true;
                            icon: Icons.keyboard;
                            clicked => {
                                acct-menu.close();
                                root.open-page("shortcuts");
                            }
                        }
                        Rectangle {
                            height: 9px;
                            Rectangle {
                                y: 4px;
                                height: 1px;
                                background: Theme.popover-border;
                            }
                        }
                        MenuItem {
                            text: @tr("Scheduled prompts");
                            show-check: false;
                            has-icon: true;
                            icon: Icons.calendar-clock;
                            clicked => {
                                acct-menu.close();
                                ChatUi.schedule-action("open", "");
                            }
                        }
                        MenuItem {
                            text: @tr("Board");
                            show-check: false;
                            has-icon: true;
                            icon: Icons.square-kanban;
                            clicked => {
                                acct-menu.close();
                                BoardUi.action("open", "");
                            }
                        }
                        MenuItem {
                            text: @tr("Projects");
                            show-check: false;
                            has-icon: true;
                            icon: Icons.folders;
                            clicked => {
                                acct-menu.close();
                                root.open-page("projects");
                            }
                        }
                        MenuItem {
                            text: @tr("Archived sessions");
                            show-check: false;
                            has-icon: true;
                            icon: Icons.archive;
                            clicked => {
                                acct-menu.close();
                                root.open-page("archive");
                            }
                        }
                    }
                }
            }
        }
        }
    }
    // Drop targets while a session is dragged: one row per group, then "No group".
    if root.drag-id != "": Rectangle {
        x: 8px;
        y: root.drop-top;
        width: root.width - 16px;
        height: (ChatUi.groups.length + 1) * root.drop-row;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.popover;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000022;
        for g[gi] in ChatUi.groups: Rectangle {
            y: gi * root.drop-row;
            height: root.drop-row;
            border-radius: Theme.radius-md;
            background: root.drag-y >= root.drop-top + gi * root.drop-row && root.drag-y < root.drop-top + (gi + 1) * root.drop-row ? Theme.hover : transparent;
            HorizontalLayout {
                padding-left: 10px;
                spacing: 6px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: ChatUi.group-color(g.color);
                }
                Text {
                    text: @tr("Move to {0}", g.name);
                    font-size: Theme.ui-sm;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
        Rectangle {
            y: ChatUi.groups.length * root.drop-row;
            height: root.drop-row;
            border-radius: Theme.radius-md;
            background: root.drag-y >= root.drop-top + ChatUi.groups.length * root.drop-row ? Theme.hover : transparent;
            Text {
                x: 24px;
                text: @tr("Remove from group");
                font-size: Theme.ui-sm;
                color: Theme.foreground-subtle;
                vertical-alignment: center;
            }
        }
    }
}

// ---- composer dock ---------------------------------------------------------------------------------------

component AgentPicker inherits HorizontalLayout {
    in property <[AgentRow]> agents;
    in property <string> sticky;
    // 全部 agent 都耗尽（暂停）时允许手动选择已耗尽的 agent 重试：hub 会清除其耗尽标记并恢复暂停的回合。
    in property <bool> paused;
    callback choose(string);
    alignment: end;
    padding-right: 36px;
    function report() {
        DockUi.menu-x = self.absolute-position.x;
        DockUi.menu-y = self.absolute-position.y;
        DockUi.menu-w = self.width;
    }
    init => {
        root.report();
    }
    changed absolute-position => {
        root.report();
    }
    changed width => {
        root.report();
    }
    MenuShell {
        width: 260px;
        for a[i] in root.agents: MenuItem {
            property <bool> selectable: a.state == 0 || (a.state == 2 && root.paused);
            text: a.name;
            label: "agent-option " + a.name;
            detail: a.id == root.sticky ? @tr("Active") : a.state == 0 ? @tr("Fallback #{0}", i + 1) : (a.state == 1 ? @tr("Not installed") : (a.reset != "" ? @tr("Limit reached · resets {0}", a.reset) : @tr("Limit reached")));
            detail-color: a.state == 2 ? Theme.warning-surface-foreground : Theme.foreground-subtle;
            description: a.id == root.sticky ? @tr("Active agent; on a usage limit Harness switches automatically down the fallback order") : a.state == 0 ? @tr("Fallback #{0}: used automatically when the agents above hit their limit", i + 1) : self.detail;
            enabled: self.selectable;
            checked: a.id == root.sticky;
            clicked => {
                root.choose(a.id);
            }
        }
    }
}

// Round send / stop button (ZCode composer: 28px circle, arrow-up; primary when enabled).
component RoundButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> filled: true;
    in property <bool> pulse: false;
    callback clicked;
    property <bool> live: root.enabled && root.filled;
    height: self.width;
    border-radius: Theme.radius-md;
    width: 30px;
    background: root.live ? (rta.has-hover ? Theme.primary-brush-hover : Theme.primary-brush) : !root.enabled ? Theme.border-hover : (rta.has-hover ? Theme.raised : Theme.surface);
    border-width: root.live || !root.enabled ? 0px : 1px;
    border-color: Theme.border-hover;
    drop-shadow-blur: root.live ? 3px : 0px;
    drop-shadow-offset-y: root.live ? 1px : 0px;
    drop-shadow-color: root.live ? Theme.primary-shadow : transparent;
    transform-scale: rta.pressed && root.enabled ? 0.9 : 1;
    animate background, drop-shadow-blur { duration: Theme.dur-hover; easing: ease-out-quint; }
    animate transform-scale { duration: Theme.dur-press; easing: ease-out-quint; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }
    if root.pulse: Rectangle {
        property <float> t: mod(animation-tick() / 1400ms, 1);
        width: parent.width * (1 + 0.55 * self.t);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: Theme.foreground-subtle;
        opacity: (1 - self.t) * 0.7;
    }
    Icon {
        source: root.icon;
        size: Theme.icon-sm;
        tint: root.live ? Theme.primary-foreground : (root.enabled ? Theme.icon : Theme.icon-subtlest);
    }
    rta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Starter card: hairline card with a mono index, the title and a muted hint; an arrow slides in on hover.
component StarterRow inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <string> index: "01";
    in property <color> tint: Theme.accent-fg;
    in property <bool> last;
    callback clicked;
    height: 70px;
    border-radius: Theme.radius-xl;
    background: sra.has-hover ? Theme.surface-hover : Theme.card;
    border-width: 1px;
    border-color: sra.has-hover ? Theme.border-hover : Theme.border;
    animate background, border-color { duration: Theme.dur-hover; easing: ease-out-quint; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        Text {
            text: root.index;
            font-family: Theme.art-font;
            font-size: 11px;
            color: sra.has-hover ? Theme.accent-fg : Theme.caps-label;
            vertical-alignment: center;
            accessible-role: none;
            animate color { duration: Theme.dur-hover; easing: ease-out-quint; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 5px;
            Text {
                text: root.text;
                font-size: Theme.ui-caption;
                font-weight: Theme.weight-semibold;
                color: Theme.foreground;
                overflow: elide;
                accessible-role: none;
            }
            if root.hint != "": Text {
                text: root.hint;
                font-size: Theme.ui-sm;
                color: Theme.muted;
                overflow: elide;
                accessible-role: none;
            }
        }
        Icon {
            y: (parent.height - self.height) / 2;
            source: Icons.arrow-right;
            size: Theme.icon-xs;
            tint: Theme.foreground;
            opacity: sra.has-hover ? 1 : 0;
            animate opacity { duration: Theme.dur-hover; easing: ease-out-quint; }
        }
    }
    sra := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component EmptyState inherits VerticalLayout {
    in property <string> place;
    callback pick(string);
    property <bool> shown: false;
    property <length> list-w: 600px;
    alignment: center;
    padding: 24px;
    min-width: 0px;
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: Theme.dur-enter; easing: ease-out-quint; }
    init => {
        self.list-w = min(600px, self.width - 48px);
    }
    changed width => {
        self.list-w = min(600px, self.width - 48px);
    }
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => {
            root.shown = true;
        }
    }
    // Hero: the unicode wordmark (one letter at a time lights up) with the ASCII bunny sitting on it.
    // Needs room, so short or narrow windows skip straight to the heading.
    if root.height >= 500px && root.width >= 520px: HorizontalLayout {
        alignment: center;
        Rectangle {
            width: wm.preferred-width;
            height: wm.preferred-height;
            accessible-role: none;
            wm := GlyphAnim {
                x: 0;
                y: 0;
                frames: AsciiArt.wordmark;
                interval: 130ms;
                font-size: 8px;
                color: Theme.foreground;
            }
            // In the gap right of "WORSE", feet on the top edge of "HARNESS".
            GlyphAnim {
                x: parent.width - self.width + 2px;
                y: parent.height * 0.5 - self.height + 4px;
                frames: AsciiArt.bunny;
                interval: 170ms;
                font-size: 14px;
                color: Theme.foreground;
            }
        }
    }
    if root.height >= 500px && root.width >= 520px: Rectangle {
        height: 30px;
    }
    Text {
        text: @tr("What should we build?");
        font-family: Theme.display-font;
        font-size: 30px;
        font-weight: 700;
        color: Theme.foreground;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Rectangle {
        height: 10px;
    }
    HorizontalLayout {
        alignment: center;
        Text {
            width: min(root.list-w, 460px);
            text: root.place != "" ? @tr("Working in {0}. Pick a starter or describe a task.", root.place) : @tr("Pick a starter or describe a task.");
            font-family: Theme.serif-font;
            font-italic: Theme.serif-font == "Instrument Serif";
            font-size: Theme.serif-font == "Instrument Serif" ? 19px : Theme.ui-caption;
            wrap: word-wrap;
            horizontal-alignment: center;
            color: Theme.foreground-subtle;
        }
    }
    Rectangle {
        height: 26px;
    }
    // 2×2 starter cards.
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            width: root.list-w;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                StarterRow {
                    width: (root.list-w - 10px) / 2;
                    index: "01";
                    text: @tr("Explain this repo");
                    hint: @tr("map modules & entry points");
                    tint: Theme.info;
                    clicked => {
                        root.pick("Explain how this codebase is organized: the main modules, how they connect, and where to start reading.");
                    }
                }
                StarterRow {
                    width: (root.list-w - 10px) / 2;
                    index: "02";
                    text: @tr("Review my changes");
                    hint: @tr("uncommitted diff, bugs & risky edits");
                    tint: Theme.agent-codex;
                    clicked => {
                        root.pick("Review the uncommitted changes in this repository and point out bugs or risky edits.");
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                StarterRow {
                    width: (root.list-w - 10px) / 2;
                    index: "03";
                    text: @tr("Find and fix a bug");
                    hint: @tr("describe the symptom");
                    tint: Theme.warning-surface-foreground;
                    clicked => {
                        root.pick("Find and fix this bug: ");
                    }
                }
                StarterRow {
                    width: (root.list-w - 10px) / 2;
                    last: true;
                    index: "04";
                    text: @tr("Plan a feature");
                    hint: @tr("step by step before writing code");
                    tint: Theme.agent-agy;
                    clicked => {
                        root.pick("Plan this feature step by step before writing code: ");
                    }
                }
            }
        }
    }
}

component WorkingLine inherits Rectangle {
    property <int> tick;
    property <int> secs;
    property <float> glow: 0.55 + 0.45 * sin(root.tick * 18deg);
    height: 26px;
    accessible-role: text;
    accessible-label: "Thinking, " + root.secs + " seconds";
    Timer {
        interval: 120ms;
        running: true;
        triggered => {
            root.tick = mod(root.tick + 1, 1000);
        }
    }
    Timer {
        interval: 1s;
        running: true;
        triggered => {
            root.secs += 1;
        }
    }
    HorizontalLayout {
        padding-left: 6px;
        spacing: 10px;
        // Unicode scan: a shade ramp (░▒▓█▓▒░) sweeping through eight cells.
        GlyphAnim {
            y: (parent.height - self.height) / 2;
            frames: AsciiArt.scan;
            interval: 90ms;
            font-size: 11px;
            color: Theme.foreground-subtle;
            vertical-alignment: center;
        }
        Text {
            text: "Thinking…";
            font-size: Theme.ui-caption;
            color: Theme.foreground-subtle;
            opacity: root.glow;
            vertical-alignment: center;
        }
        Text {
            text: root.secs < 60 ? root.secs + "s" : floor(root.secs / 60) + "m " + mod(root.secs, 60) + "s";
            font-size: Theme.ui-sm;
            color: Theme.muted;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
    }
}
component LimitBar inherits VerticalLayout {
    in property <string> label;
    in property <string> reset;
    in property <float> value;
    spacing: 6px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            font-size: Theme.ui-sm;
            font-weight: Theme.weight-medium;
            color: Theme.foreground;
            horizontal-stretch: 1;
        }
        Text {
            text: root.reset;
            font-size: Theme.ui-sm;
            color: Theme.foreground-subtle;
            vertical-alignment: center;
        }
        Text {
            text: round(root.value * 100) + "%";
            font-size: Theme.ui-sm;
            color: Theme.foreground-subtle;
            min-width: 32px;
            horizontal-alignment: right;
        }
    }
    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.border-hover;
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.value, 0, 1);
            height: parent.height;
            border-radius: 2px;
            background: root.value > 0.9 ? Theme.destructive : root.value > 0.7 ? Theme.warning-surface-foreground : Theme.link;
        }
    }
}
component UsageRing inherits Rectangle {
    in property <[AgentRow]> agents;
    property <float> ratio: ChatUi.usage-known ? clamp(ChatUi.usage-ratio, 0, 1) : 0;
    property <angle> sweep: clamp(root.ratio, 0.001, 0.999) * 360deg;
    property <color> tone: root.ratio > 0.9 ? Theme.destructive : root.ratio > 0.7 ? Theme.warning-surface-foreground : Theme.primary;
    width: 28px;
    height: 28px;
    border-radius: Theme.radius-md;
    background: ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: ChatUi.usage-known ? "Usage: context " + round(root.ratio * 100) + "% used" : "Usage";
    accessible-action-default => {
        pop.show();
    }
    Path {
        x: 5px;
        y: 5px;
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: "M 9 2 A 7 7 0 1 1 8.99 2";
        stroke: Theme.border;
        stroke-width: 2.5px;
        accessible-role: none;
    }
    if root.ratio > 0: Path {
        x: 5px;
        y: 5px;
        width: 18px;
        height: 18px;
        viewbox-width: 18;
        viewbox-height: 18;
        commands: "M 9 2 A 7 7 0 \{root.ratio > 0.5 ? 1 : 0} 1 \{9 + 7 * sin(root.sweep)} \{9 - 7 * cos(root.sweep)}";
        stroke: root.tone;
        stroke-width: 2.5px;
        stroke-line-cap: round;
        accessible-role: none;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            ChatUi.usage-action("refreshPlan");
            pop.show();
        }
    }
    pop := PopupWindow {
        close-policy: close-on-click-outside;
        width: 360px;
        height: card.preferred-height;
        x: root.width - self.width;
        y: -self.height - 8px;
        card := Rectangle {
            background: Theme.menu;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.popover-border;
            drop-shadow-blur: Theme.shadow-md-blur;
            drop-shadow-offset-y: Theme.shadow-md-y;
            drop-shadow-color: Theme.shadow-md-color;
            VerticalLayout {
                padding: 16px;
                spacing: 14px;
                Text {
                    text: "Plan usage limits";
                    font-size: Theme.ui-sm;
                    color: Theme.foreground-subtle;
                }
                if ChatUi.plan-limits.length == 0: Text {
                    text: "Checking plan usage…";
                    font-size: Theme.ui-sm;
                    color: Theme.foreground-subtle;
                }
                for p in ChatUi.plan-limits: VerticalLayout {
                    property <bool> open: ChatUi.plan-limits.length == 1 ? ChatUi.limit-open != p.id : ChatUi.limit-open == p.id;
                    spacing: 8px;
                    Rectangle {
                        height: 24px;
                        accessible-role: button;
                        accessible-label: p.label;
                        accessible-description: open ? "expanded" : "collapsed";
                        accessible-action-default => {
                            ChatUi.limit-open = open ? "" : p.id;
                        }
                        pta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                ChatUi.limit-open = open ? "" : p.id;
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                source: open ? Icons.chevron-down : Icons.chevron-right;
                                size: Theme.icon-xs;
                                tint: pta.has-hover ? Theme.foreground : Theme.icon-subtle;
                            }
                            Text {
                                text: p.label + (p.plan != "" ? " · " + p.plan : "");
                                font-size: Theme.ui-sm;
                                color: Theme.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: p.error != "" ? p.error : (open ? "" : p.summary != "" ? p.summary : "5h " + round(p.five * 100) + "% · week " + round(p.week * 100) + "%");
                                font-size: Theme.ui-xs;
                                color: p.error != "" ? Theme.warning-surface-foreground : Theme.foreground-subtle;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 180px;
                            }
                        }
                    }
                    if open && p.known: LimitBar {
                        label: p.five-label != "" ? p.five-label : "5-hour limit";
                        reset: p.five-reset;
                        value: p.five;
                    }
                    if open && p.known: LimitBar {
                        label: p.week-label != "" ? p.week-label : "Weekly · all models";
                        reset: p.week-reset;
                        value: p.week;
                    }
                    if open && p.known && p.has-opus: LimitBar {
                        label: p.opus-label != "" ? p.opus-label : "Weekly · Opus";
                        reset: p.opus-reset;
                        value: p.opus;
                    }
                    for b in (open ? p.bars : []): LimitBar {
                        label: b.label;
                        reset: b.reset;
                        value: b.value;
                    }
                }
                for a in root.agents: HorizontalLayout {
                    property <bool> hidden: a.claude || (a.id == "agy" && ChatUi.agy-plan);
                    visible: !self.hidden;
                    height: self.hidden ? 0px : 22px;
                    spacing: 8px;
                    Rectangle {
                        width: Theme.icon-xs;
                    }
                    Text {
                        text: a.name;
                        font-size: Theme.ui-sm;
                        color: a.state == 1 ? Theme.foreground-subtlest : Theme.foreground;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: a.state == 0 ? "Available" : a.state == 1 ? "Not installed" : (a.reset != "" ? "Limit reached · resets " + a.reset : "Limit reached");
                        font-size: Theme.ui-xs;
                        vertical-alignment: center;
                        color: a.state == 0 ? Theme.foreground-subtle : a.state == 1 ? Theme.foreground-subtlest : Theme.warning-surface-foreground;
                    }
                }
                Divider { }
                HorizontalLayout {
                    Text {
                        text: "Context window";
                        font-size: Theme.ui-sm;
                        color: Theme.foreground-subtle;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    compact-link := Rectangle {
                        width: compact-row.preferred-width;
                        accessible-role: button;
                        accessible-label: "Compact now";
                        accessible-action-default => {
                            if ChatUi.usage-known {
                                ChatUi.usage-action("compactSession");
                                pop.close();
                            }
                        }
                        compact-ta := TouchArea {
                            enabled: ChatUi.usage-known;
                            mouse-cursor: pointer;
                            clicked => {
                                ChatUi.usage-action("compactSession");
                                pop.close();
                            }
                        }
                        compact-row := HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Compact now";
                                font-size: Theme.ui-sm;
                                font-weight: Theme.weight-medium;
                                color: !ChatUi.usage-known ? Theme.foreground-subtlest : compact-ta.has-hover ? Theme.link : Theme.foreground;
                                vertical-alignment: center;
                            }
                            Icon {
                                y: (parent.height - self.height) / 2;
                                source: Icons.chevron-right;
                                size: Theme.icon-xs;
                                tint: !ChatUi.usage-known ? Theme.foreground-subtlest : compact-ta.has-hover ? Theme.link : Theme.foreground;
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Current session";
                            font-size: Theme.ui-sm;
                            color: Theme.foreground;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: ChatUi.usage-known ? ChatUi.usage-text : "Not reported yet";
                            font-size: Theme.ui-sm;
                            color: Theme.foreground-subtle;
                        }
                        if ChatUi.usage-known: Text {
                            text: round(root.ratio * 100) + "%";
                            font-size: Theme.ui-sm;
                            color: Theme.foreground;
                        }
                    }
                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.secondary;
                        Rectangle {
                            x: 0;
                            width: parent.width * root.ratio;
                            height: parent.height;
                            border-radius: 2px;
                            background: root.ratio > 0.9 ? Theme.destructive : root.ratio > 0.7 ? Theme.warning-surface-foreground : Theme.link;
                        }
                    }
                }
                Rectangle {
                    height: 22px;
                    accessible-role: checkbox;
                    accessible-label: "Auto-compact";
                    accessible-checked: ChatUi.auto-compact;
                    accessible-action-default => {
                        ChatUi.usage-action("toggleAutoCompact");
                    }
                    auto-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            ChatUi.usage-action("toggleAutoCompact");
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Auto-compact";
                            font-size: Theme.ui-sm;
                            color: Theme.foreground;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "at 85%";
                            font-size: Theme.ui-sm;
                            color: Theme.foreground-subtle;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 30px;
                            height: 18px;
                            border-radius: 9px;
                            background: ChatUi.auto-compact ? Theme.switch-on : Theme.secondary;
                            border-width: ChatUi.auto-compact ? 0px : 1px;
                            border-color: Theme.border-hover;
                            Rectangle {
                                x: ChatUi.auto-compact ? parent.width - self.width - 3px : 3px;
                                y: 3px;
                                width: 12px;
                                height: 12px;
                                border-radius: 6px;
                                background: ChatUi.auto-compact ? Theme.on-accent : Theme.foreground-subtle;
                                animate x { duration: 120ms; }
                            }
                        }
                    }
                }
            }
        }
    }
}

component Composer inherits VerticalLayout {
    in property <[AgentRow]> agents;
    in-out property <string> draft;
    in property <bool> running;
    in property <int> queued;
    in property <string> sticky-name;
    callback send();
    callback stop();
    callback toggle-picker();
    callback stick-bottom-request();
    spacing: 6px;
    public function focus-input() {
        input.focus();
    }
    // Composer: floating glass slab. Near-opaque so the transcript does not show through; light rim, inner
    // glow, and a brighter rim while the input has focus.
    pill := Rectangle {
        border-radius: Theme.radius-2xl;
        background: Theme.composer;
        border-width: 1px;
        border-color: Theme.glass-rim;
        drop-shadow-blur: Theme.shadow-composer-blur;
        drop-shadow-offset-y: 14px;
        drop-shadow-color: Theme.shadow-composer-color;
        Rectangle {
            border-radius: parent.border-radius;
            inner-shadow-blur: Theme.glass-inner-blur;
            inner-shadow-offset-y: 1px;
            inner-shadow-color: Theme.glass-inner.with-alpha(input.has-focus ? 0.16 : 0.08);
            border-width: 1px;
            border-color: input.has-focus ? Theme.input-border-focused : transparent;
            animate border-color, inner-shadow-color { duration: Theme.dur-move; easing: ease-out-quint; }
            accessible-role: none;
        }
        VerticalLayout {
            padding: 10px;
            padding-left: 10px;
            padding-top: 10px;
            spacing: 6px;
            if ChatUi.chips.length > 0: Rectangle {
                height: 28px;
                min-width: 0px;
                horizontal-stretch: 1;
                clip: true;
                Flickable {
                    width: parent.width;
                    height: parent.height;
                    content-width: max(self.width, chips-row.preferred-width);
                    content-height: self.height;
                    chips-row := HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        padding-left: 4px;
                        for c[ci] in ChatUi.chips: Rectangle {
                            height: 28px;
                            width: chip-row.preferred-width;
                            border-radius: Theme.radius-full;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.glass-border;
                            accessible-role: AccessibleRole.text;
                            accessible-label: c.kind + " " + c.label;
                            accessible-description: c.detail;
                            chip-row := HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 4px;
                                spacing: 6px;
                                Icon {
                                    source: c.kind == "paste" ? Icons.file-text : c.kind == "image" ? Icons.image : c.kind == "skill" ? Icons.wand-sparkles : Icons.paperclip;
                                    size: Theme.icon-sm;
                                    tint: Theme.icon-subtle;
                                }
                                Text {
                                    text: c.label;
                                    font-size: Theme.ui-sm;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    max-width: 200px;
                                    accessible-role: none;
                                }
                                if c.detail != "": Text {
                                    text: c.detail;
                                    font-size: Theme.ui-xs;
                                    color: Theme.foreground-subtle;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                                if c.kind == "image": IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.pencil;
                                    label: @tr("Annotate {0}", c.label);
                                    size: 20px;
                                    icon-size: 12px;
                                    clicked => {
                                        ChatUi.annotate-chip(ci);
                                    }
                                }
                                IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.x;
                                    label: @tr("Remove attachment {0}", c.label);
                                    size: 20px;
                                    icon-size: 12px;
                                    clicked => {
                                        ChatUi.remove-chip(ci);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: clamp(input.preferred-height, 22px, 180px) + 12px;
                    clip: true;
                    FocusScope {
                        y: 6px;
                        height: parent.height - 12px;
                        capture-key-pressed(event) => {
                            if event.modifiers.control && !event.modifiers.alt && (event.text == "u" || event.text == "U") {
                                ChatUi.attach-files();
                                return accept;
                            }
                            // @ / 弹出列表打开时，方向键、Enter/Tab 与 Esc 由弹出列表处理。
                            if ChatUi.mention-open {
                                if event.text == Key.DownArrow {
                                    ChatUi.mention-index = Math.mod(ChatUi.mention-index + 1, max(1, ChatUi.mention-rows.length));
                                    return accept;
                                }
                                if event.text == Key.UpArrow {
                                    ChatUi.mention-index = Math.mod(ChatUi.mention-index - 1 + max(1, ChatUi.mention-rows.length), max(1, ChatUi.mention-rows.length));
                                    return accept;
                                }
                                if (event.text == Key.Return || event.text == Key.Tab) && ChatUi.mention-rows.length > 0 {
                                    ChatUi.mention-pick(ChatUi.mention-index);
                                    return accept;
                                }
                                if event.text == Key.Escape {
                                    ChatUi.mention-open = false;
                                    return accept;
                                }
                            }
                            // 粘贴：剪贴板里是图片时由 Rust 存成 PNG 并作为图片附件；否则交给 TextInput 粘贴文本。
                            if (event.text == "v" || event.text == "V") && (event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt {
                                if ChatUi.paste-image() {
                                    return accept;
                                }
                            }
                            // 提示词历史：输入框为空（或正在浏览历史）时 ↑/↓ 切换已发送的提示词。
                            if event.text == Key.UpArrow && !event.modifiers.shift {
                                if ChatUi.history(-1) {
                                    return accept;
                                }
                            }
                            if event.text == Key.DownArrow && !event.modifiers.shift {
                                if ChatUi.history(1) {
                                    return accept;
                                }
                            }
                            // Enter 发送，Shift+Enter 交给 TextInput 换行。
                            // KEY-024：发送键由设置决定（Enter 或 Ctrl/Cmd+Enter）；后者时普通 Enter 交给 TextInput 换行。
                            if event.text == Key.Return && !event.modifiers.shift {
                                if SettingsUi.get-string("general.composerSend", SettingsUi.rev) == "modEnter" && !event.modifiers.control && !event.modifiers.meta {
                                    return reject;
                                }
                                root.send();
                                return accept;
                            }
                            reject
                        }
                        input-flick := Flickable {
                            interactive: false;
                            content-width: self.width;
                            content-height: max(self.height, input.preferred-height);
                            input := TextInput {
                                width: input-flick.width;
                                height: max(input-flick.height, self.preferred-height);
                                text <=> root.draft;
                                single-line: false;
                                wrap: word-wrap;
                                font-size: Theme.ui-caption;
                                color: Theme.foreground;
                                selection-background-color: Theme.selected;
                                accessible-label: @tr("Message");
                                cursor-position-changed(p) => {
                                    if p.y + input-flick.content-y < 0 {
                                        input-flick.content-y = -p.y;
                                    } else if p.y + self.font-size * 1.5 + input-flick.content-y > input-flick.height {
                                        input-flick.content-y = min(0px, input-flick.height - p.y - self.font-size * 1.5);
                                    }
                                }
                            }
                        }
                    }
                    if root.draft == "": Text {
                        x: 0;
                        y: 6px;
                        text: root.running ? @tr("Queue a follow-up, or Steer to run it next") : @tr("Ask anything. @ to mention, / for commands");
                        color: Theme.icon-subtlest;
                        font-size: Theme.ui-caption;
                        accessible-role: none;
                    }
                }
            }
            HorizontalLayout {
                height: 34px;
                spacing: 2px;
                plus-btn := Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 28px;
                    border-radius: Theme.radius-md;
                    background: pta.has-hover ? Theme.border-hover : Theme.raised;
                    border-width: 1px;
                    border-color: pta.has-hover ? Theme.accent-line : Theme.border;
                    transform-scale: pta.pressed ? 0.9 : 1;
                    animate background, border-color { duration: Theme.dur-hover; easing: ease-out-quint; }
                    animate transform-scale { duration: Theme.dur-press; easing: ease-out-quint; }
                    accessible-role: button;
                    accessible-label: @tr("Add");
                    accessible-action-default => {
                        plus-menu.show();
                    }
                    Icon {
                        source: Icons.plus;
                        size: Theme.icon-sm;
                        tint: pta.has-hover ? Theme.accent-fg : Theme.icon;
                    }
                    pta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            plus-menu.show();
                        }
                    }
                }
                Rectangle {
                    width: 4px;
                }
                // Agent picker chip: agent-colour dot + name + chevron (design 01).
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 28px;
                    width: agent-chip.preferred-width;
                    border-radius: Theme.radius-md;
                    background: agta.has-hover ? Theme.border-hover : Theme.raised;
                    animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
                    accessible-role: button;
                    accessible-label: @tr("Agent: {0}", root.sticky-name);
                    accessible-action-default => {
                        root.toggle-picker();
                    }
                    agent-chip := HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 7px;
                        if AgentLogo.key(root.sticky-name) != "": AgentMark {
                            y: (parent.height - self.height) / 2;
                            name: root.sticky-name;
                            size: 16px;
                        }
                        if AgentLogo.key(root.sticky-name) == "": Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: AgentTint.of(root.sticky-name);
                        }
                        Text {
                            text: root.sticky-name;
                            font-size: Theme.ui-caption;
                            font-weight: Theme.weight-medium;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        Icon {
                            y: (parent.height - self.height) / 2;
                            source: Icons.chevron-down;
                            size: 12px;
                            tint: Theme.icon-subtle;
                        }
                    }
                    agta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-picker();
                        }
                    }
                }
                Rectangle {
                    width: 4px;
                }
                PickerBar {
                    horizontal-stretch: 1;
                }
                if root.queued > 0 && DockUi.editing-id == "": Tag {
                    y: (parent.height - self.height) / 2;
                    text: @tr("{0} queued", root.queued);
                    tone: "progress";
                }
                if DockUi.editing-id != "": HorizontalLayout {
                    spacing: 2px;
                    Tag {
                        y: (parent.height - self.height) / 2;
                        text: @tr("Editing queued message");
                        tone: "progress";
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.x;
                        label: @tr("Cancel editing");
                        size: 20px;
                        icon-size: 12px;
                        clicked => {
                            DockUi.queue-action("cancel-edit", DockUi.editing-id);
                        }
                    }
                }
                UsageRing {
                    y: (parent.height - self.height) / 2;
                    agents: root.agents;
                }
                Rectangle {
                    width: 4px;
                }
                if root.running && DockUi.editing-id == "" && (root.draft != "" || ChatUi.chips.length > 0): Button {
                    y: (parent.height - self.height) / 2;
                    variant: "secondary";
                    size: "sm";
                    text: @tr("Steer");
                    has-icon: true;
                    icon: Icons.corner-down-left;
                    label: @tr("Steer: run right after the current turn");
                    clicked => {
                        root.stick-bottom-request();
                        DockUi.steer();
                    }
                }
                if root.running: RoundButton {
                    y: (parent.height - self.height) / 2;
                    icon: IconsFill.stop;
                    label: @tr("Stop");
                    filled: false;
                    pulse: true;
                    clicked => {
                        root.stop();
                    }
                }
                if !root.running || root.draft != "" || ChatUi.chips.length > 0: RoundButton {
                    y: (parent.height - self.height) / 2;
                    icon: IconsFill.send;
                    label: @tr("Send");
                    enabled: root.draft != "" || ChatUi.chips.length > 0;
                    clicked => {
                        root.send();
                    }
                }
            }
        }
    }
    plus-menu := PopupWindow {
        x: 0;
        y: -self.height - 6px;
        width: 300px;
        MenuShell {
            MenuItem {
                text: @tr("Add files or photos");
                detail: "Ctrl+U";
                show-check: false;
                has-icon: true;
                icon: Icons.paperclip;
                clicked => {
                    plus-menu.close();
                    ChatUi.attach-files();
                }
            }
            MenuItem {
                text: @tr("Slash commands");
                show-check: false;
                has-icon: true;
                icon: Icons.square-terminal;
                clicked => {
                    plus-menu.close();
                    root.draft = root.draft == "" ? "/" : root.draft + " /";
                    root.focus-input();
                }
            }
            MenuItem {
                text: @tr("Mention a file, session or agent");
                show-check: false;
                has-icon: true;
                icon: Icons.at-sign;
                clicked => {
                    plus-menu.close();
                    root.draft = root.draft == "" ? "@" : root.draft + " @";
                    root.focus-input();
                }
            }
            MenuItem {
                text: @tr("Whiteboard");
                show-check: false;
                has-icon: true;
                icon: Icons.brush;
                clicked => {
                    plus-menu.close();
                    ChatUi.annotate-chip(-1);
                }
            }
        }
    }
}
// Queued messages above the composer (ZCode ConversationQueuePanel): grip (drag to reorder), text, Steer, Edit,
// Remove. The drag only previews locally; the order shown is always the hub's next Event::Queue.
component QueueList inherits Rectangle {
    in property <[QueueRow]> items;
    callback cancel(string);
    property <length> row-h: 34px;
    property <int> drag-index: -1;
    property <length> drag-dy;
    // Design 01 card grammar: surface, radius 12, border; caps header.
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 4px;
        spacing: 0px;
        Text {
            height: 26px;
            x: 10px;
            text: @tr("Queued messages ({0})", root.items.length).to-uppercase();
            font-size: 10px;
            font-weight: Theme.weight-semibold;
            letter-spacing: 0.8px;
            color: Theme.caps-label;
            vertical-alignment: center;
        }
        for q[qi] in root.items: Rectangle {
            height: root.row-h;
            z: root.drag-index == qi ? 1 : 0;
            Rectangle {
                y: root.drag-index == qi ? root.drag-dy : 0;
                height: parent.height;
                border-radius: Theme.radius-md;
                background: root.drag-index == qi ? Theme.raised : qta.has-hover ? Theme.hover : transparent;
                opacity: DockUi.editing-id == q.id ? 0.6 : 1;
                qta := TouchArea { }
                HorizontalLayout {
                    padding-top: 2px;
                    padding-bottom: 2px;
                    padding-left: 2px;
                    padding-right: 2px;
                    spacing: 6px;
                    Rectangle {
                        width: Theme.control;
                        accessible-role: AccessibleRole.slider;
                        accessible-label: @tr("Drag to reorder: {0}", q.text);
                        accessible-value: qi + 1;
                        accessible-value-minimum: 1;
                        accessible-value-maximum: root.items.length;
                        accessible-value-step: 1;
                        accessible-action-increment => {
                            DockUi.queue-move(q.id, 1);
                        }
                        accessible-action-decrement => {
                            DockUi.queue-move(q.id, -1);
                        }
                        Icon {
                            source: Icons.grip-vertical;
                            size: Theme.icon-sm;
                            tint: Theme.icon-subtlest;
                        }
                        TouchArea {
                            mouse-cursor: grab;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    root.drag-index = qi;
                                    root.drag-dy = 0;
                                }
                                if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                                    if root.drag-index == qi {
                                        // 释放时按位移换算目标行，只发一次整体重排；显示以 hub 的下一次 Queue 事件为准。
                                        if e.kind == PointerEventKind.up && round(root.drag-dy / root.row-h) != 0 {
                                            DockUi.queue-move(q.id, round(root.drag-dy / root.row-h));
                                        }
                                        root.drag-index = -1;
                                        root.drag-dy = 0;
                                    }
                                }
                            }
                            moved => {
                                if self.pressed && root.drag-index == qi {
                                    // 修复：TouchArea 随拖动行一起偏移了 drag-dy，mouse-y 是相对已偏移位置的坐标；
                                    // 不加回 drag-dy 时位移只收敛到指针实际位移的一半（拖两行只移动一行）。
                                    root.drag-dy = clamp(self.mouse-y - self.pressed-y + root.drag-dy, -qi * root.row-h, (root.items.length - 1 - qi) * root.row-h);
                                }
                            }
                        }
                    }
                    Text {
                        text: q.text;
                        font-size: Theme.ui-caption;
                        color: Theme.foreground;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        accessible-role: AccessibleRole.text;
                        accessible-label: @tr("Queued: {0}", q.text);
                    }
                    Button {
                        variant: "secondary";
                        size: "sm";
                        y: (parent.height - self.height) / 2;
                        text: @tr("Steer");
                        label: @tr("Steer queued message: {0}", q.text);
                        enabled: DockUi.editing-id != q.id;
                        clicked => {
                            DockUi.queue-action("steer", q.id);
                        }
                    }
                    IconButton {
                        icon: Icons.pencil;
                        icon-size: Theme.icon-sm;
                        size: Theme.control;
                        label: @tr("Edit queued message: {0}", q.text);
                        enabled: DockUi.editing-id == "";
                        clicked => {
                            DockUi.queue-action("edit", q.id);
                        }
                    }
                    IconButton {
                        icon: Icons.trash-2;
                        icon-size: Theme.icon-sm;
                        size: Theme.control;
                        label: @tr("Cancel queued message: {0}", q.text);
                        clicked => {
                            root.cancel(q.id);
                        }
                    }
                }
            }
        }
    }
}
// Permission prompt in the composer dock (ZCode: card "Permission required" above the input).
component PermissionCard inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <[PermOption]> options;
    callback answer(bool);
    callback choose(string);
    callback feedback();
    // Design 01 card grammar: surface, radius 12, strong border; tinted icon tile.
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-hover;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.glass-shadow;
    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 6px;
                background: Theme.ask-foreground.with-alpha(0.12);
                Icon {
                    source: Icons.shield-check;
                    size: Theme.icon-xs;
                    tint: Theme.ask-foreground;
                }
            }
            Text {
                text: @tr("Permission required");
                font-size: Theme.ui-caption;
                font-weight: Theme.weight-semibold;
                color: Theme.foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        Rectangle {
            background: Theme.background;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 8px;
                padding-left: 10px;
                Text {
                    text: root.title;
                    font-family: Theme.mono-font;
                    font-size: Theme.code-size;
                    color: Theme.foreground;
                    overflow: elide;
                }
            }
        }
        if root.detail != "": Text {
            text: root.detail;
            font-size: Theme.ui-sm;
            color: Theme.foreground-subtle;
            wrap: word-wrap;
        }
        // Every option the agent offered, numbered like ZCode (1, 2, 3 … choose by key).
        for o[i] in root.options: MenuItem {
            text: o.label;
            detail: i < 9 ? "" + (i + 1) : "";
            show-check: false;
            has-icon: true;
            icon: o.kind < 2 ? Icons.check : Icons.x;
            clicked => {
                root.choose(o.id);
            }
        }
        // R9: deny once and tell the agent why (ChoosePermission reject + a follow-up message).
        if root.options.length > 0: MenuItem {
            text: @tr("Deny with feedback…");
            show-check: false;
            has-icon: true;
            icon: Icons.message-square;
            clicked => {
                root.feedback();
            }
        }
        if root.options.length > 0: Text {
            text: @tr("Press a number to choose, Esc to deny once");
            font-size: Theme.ui-xs;
            color: Theme.foreground-subtlest;
            horizontal-alignment: right;
        }
        // 选项随 PermissionChoices 紧随请求到达；到达前不提供按钮（旧的 RespondPermission 回退已移除）。
        if root.options.length == 0: Text {
            text: @tr("Loading options…");
            font-size: Theme.ui-xs;
            color: Theme.foreground-subtlest;
            horizontal-alignment: right;
        }
    }
}

// ---- side pane -------------------------------------------------------------------------------------------

component FileTree inherits Rectangle {
    in property <[FileRow]> files;
    callback toggle(int);
    ListView {
        for f[i] in root.files: Rectangle {
            height: 28px;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                Rectangle {
                    border-radius: Theme.radius-md;
                    background: fta.has-hover ? Theme.surface-hover : transparent;
                    animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
                    accessible-role: list-item;
                    accessible-label: f.name;
                    accessible-expandable: f.is-dir;
                    accessible-expanded: f.expanded;
                    accessible-action-default => {
                        if f.is-dir {
                            root.toggle(i);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 6px + f.depth * 14px;
                        padding-right: 6px;
                        spacing: 4px;
                        Rectangle {
                            width: 14px;
                            if f.is-dir: Icon {
                                source: f.expanded ? Icons.chevron-down : Icons.chevron-right;
                                size: Theme.icon-xs;
                                tint: Theme.icon-subtle;
                            }
                        }
                        FileIcon {
                            index: f.icon;
                        }
                        Text {
                            text: f.name;
                            font-size: Theme.ui-base;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                            accessible-role: none;
                        }
                    }
                    fta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if f.is-dir {
                                root.toggle(i);
                            }
                        }
                    }
                }
            }
        }
    }
}

// Side Pane: framed like the main panel; tab bar = "Files" + agent A's panel tabs (PanelTabs.tabs).
component SidePane inherits Rectangle {
    in property <[FileRow]> files;
    in property <string> workspace;
    in-out property <string> tab: "files";
    in-out property <bool> wide;
    callback toggle(int);
    callback close();
    // Floating glass pane beside the transcript.
    background: Theme.panel;
    border-radius: Theme.radius-2xl;
    border-width: 1px;
    border-color: Theme.glass-rim;
    drop-shadow-blur: Theme.glass-shadow-blur;
    drop-shadow-offset-y: Theme.glass-shadow-y;
    drop-shadow-color: Theme.glass-shadow;
    clip: true;
    Rectangle {
        border-radius: parent.border-radius;
        inner-shadow-blur: Theme.glass-inner-blur;
        inner-shadow-offset-y: 1px;
        inner-shadow-color: Theme.glass-inner;
        accessible-role: none;
    }
    property <bool> shown: false;
    opacity: self.shown ? 1 : 0;
    animate opacity { duration: Theme.dur-panel; easing: ease-out-quint; }
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => {
            root.shown = true;
        }
    }
    VerticalLayout {
        padding-left: 1px;
        // Tabs as segmented pills (design 01: Overview / Git / Terminal / Files); Diff and Search keep a title.
        HorizontalLayout {
            height: 48px;
            padding-left: 12px;
            padding-right: 8px;
            spacing: 4px;
            Segmented {
                y: (parent.height - self.height) / 2;
                options: [
                    { id: "overview", label: "Overview" },
                    { id: "git", label: "Git" },
                    { id: "terminal", label: "Terminal" },
                    { id: "files", label: "Files" },
                ];
                current: root.tab;
                select(id) => {
                    root.tab = id;
                }
            }
            if root.tab == "diff" || root.tab == "search": Text {
                text: root.tab == "diff" ? "Diff" : "Search";
                font-size: Theme.ui-caption;
                font-weight: Theme.weight-semibold;
                color: Theme.foreground;
                vertical-alignment: center;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: root.wide ? Icons.minimize-2 : Icons.maximize-2;
                label: root.wide ? @tr("Collapse panel") : @tr("Expand panel");
                clicked => {
                    root.wide = !root.wide;
                }
            }
        }
        if root.tab == "files": VerticalLayout {
            vertical-stretch: 1;
            padding-top: 2px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-bottom: 8px;
                Rectangle {
                    height: 34px;
                    border-radius: Theme.radius-md;
                    background: fsta.has-hover ? Theme.surface-hover : Theme.surface;
                    border-width: 1px;
                    border-color: fsta.has-hover ? Theme.border-hover : Theme.border;
                    animate background, border-color { duration: Theme.dur-hover; easing: ease-out-quint; }
                    accessible-role: button;
                    accessible-label: @tr("Search files");
                    accessible-action-default => {
                        ChatUi.palette-scope = "files";
                        ChatUi.palette-open = true;
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        spacing: 8px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            source: Icons.search;
                            size: Theme.icon-sm;
                            tint: fsta.has-hover ? Theme.accent-fg : Theme.icon-subtle;
                        }
                        Text {
                            text: @tr("Search files…");
                            font-size: Theme.ui-sm;
                            color: Theme.foreground-subtle;
                            vertical-alignment: center;
                        }
                    }
                    fsta := TouchArea {
                        mouse-cursor: text;
                        clicked => {
                            ChatUi.palette-scope = "files";
                            ChatUi.palette-open = true;
                        }
                    }
                }
            }
            HorizontalLayout {
                height: 24px;
                padding-left: 12px;
                padding-right: 12px;
                SectionLabel {
                    text: root.workspace;
                }
            }
            FileTree {
                vertical-stretch: 1;
                files: root.files;
                toggle(i) => {
                    root.toggle(i);
                }
            }
        }
        if root.tab == "overview": OverviewPanel {
            vertical-stretch: 1;
            workspace: root.workspace;
        }
        if root.tab != "files" && root.tab != "overview": PanelHost {
            vertical-stretch: 1;
            tab: root.tab;
        }
    }
}

// ---- settings: ui/settings/shell.slint (spec phase-9-parity.md §6) ----------------------------------------

// ---- window ----------------------------------------------------------------------------------------------

component ResizeEdge inherits TouchArea {
    callback start();
    pointer-event(event) => {
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
            root.start();
        }
    }
}

export component AppWindow inherits Window {
    title: "Harness";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 360px;
    min-height: 480px;
    no-frame: !root.native-frame;
    // Use the OS window frame (Windows title bar): the custom title bar then only renders the
    // Harness header row, and drag/resize/maximize stay native. Applied at startup.
    in property <bool> native-frame: true;
    background: Theme.canvas;
    default-font-size: Theme.ui-base;
    callback window-action(string);
    in property <bool> win-maximized;
    // Live update (phase 1): Rust sets this when the build output changed under the running shadow copy.
    in-out property <bool> update-ready;
    callback restart-for-update();
    in property <string> workspace-initial;
    in-out property <bool> sidebar-hidden;
    property <bool> show-sidebar: !root.narrow && !root.sidebar-hidden;
    // 修复：Windows 上默认字体回退会为汉字选到日文字体，简体专用字（会话、设置、语言…）显示为方框；
    // 由 Rust 按平台传入含简体中文字形的 UI 字体（空字符串 = Slint 默认）。
    in property <string> ui-font-family;
    default-font-family: root.ui-font-family;
    icon: @image-url("brand/app-icon.png");
    // Syne / Instrument Serif are Latin only: when the UI font is a system CJK face, headings use it too.
    property <bool> latin-ui: root.ui-font-family == "Plus Jakarta Sans" || root.ui-font-family == "Inter" || root.ui-font-family == "Segoe UI" || root.ui-font-family == "";
    changed latin-ui => {
        Theme.display-font = self.latin-ui ? "Syne" : root.ui-font-family;
        Theme.serif-font = self.latin-ui ? "Instrument Serif" : root.ui-font-family;
    }

    in property <[SessionRow]> sessions;
    in property <[AgentRow]> agents;
    in property <[FallbackRow]> fallback;
    in property <[ChatItem]> chat;
    in property <[FileRow]> files;
    in property <[QueueRow]> queue;
    in property <string> workspace;
    in property <string> active-title;
    in property <string> sticky-agent;
    in property <string> sticky-name;
    in property <bool> running;
    in property <int> queued;
    in property <bool> paused;
    in property <bool> perm-visible;
    in property <int> perm-request;
    in property <string> perm-title;
    in property <string> perm-detail;
    in property <[PermOption]> perm-options;
    in property <string> error-text;
    in-out property <string> draft;
    in-out property <bool> settings-open;
    // 修复：通过按钮（或无障碍动作）开始录制快捷键时，焦点可能落在已被销毁的元素上（页面切换后），
    // 此时按键不会进入任何 FocusScope，录制永远收不到组合键。录制/按键搜索开始时把焦点交回根 FocusScope。
    property <bool> capturing-keys: ShortcutsUi.recording != "" || ShortcutsUi.key-search;
    changed capturing-keys => {
        if self.capturing-keys {
            key-scope.focus();
        }
    }
    in-out property <bool> picker-open;
    in-out property <bool> drawer-open;
    in-out property <bool> files-open: true;
    in-out property <length> sidebar-w: Theme.sidebar-width;

    callback new-session();
    callback new-worktree-session();
    callback open-folder();
    callback open-session(string);
    callback archive-session(string);
    callback send-draft(string);
    callback stop();
    callback cancel-queued(string);
    callback choose-agent(string);
    callback permission(int, bool);
    callback choose-permission(int, string);
    // "1".."9" → 0..8, anything else → -1 (permission option keys).
    pure function digit(text: string) -> int {
        if text == "1" { return 0; }
        if text == "2" { return 1; }
        if text == "3" { return 2; }
        if text == "4" { return 3; }
        if text == "5" { return 4; }
        if text == "6" { return 5; }
        if text == "7" { return 6; }
        if text == "8" { return 7; }
        if text == "9" { return 8; }
        -1
    }
    callback move-fallback(int, int);
    // Global shortcut command (ShortcutsUi.match) that Rust runs (zoom, theme, …).
    callback run-command(string);
    callback toggle-file(int);
    callback open-link(string);

    // 用 changed 回调而非绑定：narrow 影响布局的最小宽度，直接绑定 width 会形成布局绑定环。
    property <bool> narrow: false;
    property <length> win-w: 1100px;
    property <bool> title-editing;
    changed width => {
        self.narrow = self.width < 720px;
        self.win-w = self.width;
        self.window-action("sync");
    }
    property <bool> stick-bottom: true;
    property <length> chat-pad: 16px;
    // Last path component of the workspace (sidebar footer), set by Rust.
    in property <string> workspace-name;
    // User bubble max width (80% of the chat column), written from the panel's changed-width callback.
    property <length> bubble-max: 600px;

    function do-send() {
        if root.draft != "" || ChatUi.chips.length > 0 {
            root.send-draft(root.draft);
            root.draft = "";
            root.picker-open = false;
        }
    }

    // Composer text goes to src/chat on every change (@ / popups, long-paste chips, history browsing).
    changed draft => {
        ChatUi.draft-edited(self.draft);
    }
    // Clipboard: Slint has no clipboard API in Rust, so text is copied through a hidden TextInput (ChatUi.copy).
    public function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.text = "";
    }
    // Session context menu (sidebar right click / "More") and header menu.
    property <bool> ctx-open;
    property <string> ctx-id;
    property <length> ctx-x;
    property <length> ctx-y;
    property <bool> header-menu-open;
    property <bool> nmenu-open;
    property <length> nmenu-x;
    property <length> nmenu-y;
    property <bool> folder-confirm;
    function open-new-menu(x: length, y: length) {
        root.ctx-open = false;
        root.gctx-open = false;
        root.nmenu-x = x;
        root.nmenu-y = y;
        root.nmenu-open = true;
    }
    function pick-folder() {
        root.nmenu-open = false;
        if root.running {
            root.folder-confirm = true;
        } else {
            root.open-folder();
        }
    }
    // Group menu (sidebar group header).
    property <bool> gctx-open;
    property <string> gctx-id;
    property <length> gctx-x;
    property <length> gctx-y;
    function open-group-menu(id: string, x: length, y: length) {
        root.ctx-open = false;
        root.gctx-id = id;
        root.gctx-x = x;
        root.gctx-y = y;
        root.gctx-open = true;
    }
    // Pinned state of the session the menu is for (Pin / Unpin label); asked from Rust when the menu opens.
    property <bool> ctx-pinned;
    pure callback session-pinned(string) -> bool;
    function open-menu(id: string, x: length, y: length) {
        root.gctx-open = false;
        root.ctx-pinned = root.session-pinned(id);
        root.ctx-id = id;
        root.ctx-x = x;
        root.ctx-y = y;
        root.ctx-open = true;
    }
    property <bool> overlay-open: ChatUi.palette-open || ChatUi.find-open;
    changed overlay-open => {
        if !self.overlay-open {
            key-scope.focus();
        }
    }
    // Find: estimate the scroll position of the matching row first (unrealized rows have estimated heights), then
    // the row itself corrects it from its real y once it is instantiated (see the chat list delegate).
    property <int> find-seq: ChatUi.find-seq;
    changed find-seq => {
        if ChatUi.find-row >= 0 && root.chat.length > 0 {
            root.stick-bottom = false;
            chat-list.content-y = max(chat-list.visible-height - chat-list.content-height, min(0px, -(chat-list.content-height * ChatUi.find-row / root.chat.length) + 48px));
        }
    }
    function reveal-row(y: length) {
        root.stick-bottom = false;
        chat-list.content-y = max(chat-list.visible-height - chat-list.content-height, min(0px, -y + 48px));
    }

    // 修复：窗口启动时没有焦点项，键盘事件不会进入 FocusScope，未点过输入框时 Esc 无法关闭设置页；
    // 把初始焦点交给根 FocusScope。
    forward-focus: key-scope;
    // Side pane tab shared by the wide and the narrow (overlay) side pane. bridge.rs wires PanelNav.open-tab to it
    // (a git row opens Diff).
    in-out property <string> side-tab: "overview";
    // 修复：权限提示出现时输入框（持有焦点）被移除，焦点随之丢失，Esc 等快捷键不再到达 key-scope；
    // 此时把焦点交回根 FocusScope。
    changed perm-visible => {
        if root.perm-visible {
            key-scope.focus();
        }
    }

    key-scope := FocusScope {
        capture-key-pressed(event) => {
            // Shortcut recorder / key search (settings): the root sees keys before the focused child, so it hands
            // them to Rust first; Esc there cancels the recording instead of closing settings.
            if root.settings-open && (ShortcutsUi.recording != "" || ShortcutsUi.key-search) {
                if ShortcutsUi.key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                    return accept;
                }
            }
            // Permission options (ZCode PermissionDialog): number keys pick the option, Esc denies once. Checked before
            // the generic Esc handling, which would otherwise stop the run that waits for this answer.
            if root.perm-visible && !root.settings-open && !ChatUi.palette-open && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && root.perm-options.length > 0 {
                let index = root.digit(event.text);
                if index >= 0 && index < root.perm-options.length {
                    root.choose-permission(root.perm-request, root.perm-options[index].id);
                    return accept;
                }
                if event.text == Key.Escape {
                    root.permission(root.perm-request, false);
                    return accept;
                }
            }
            if event.text == Key.Escape {
                if ChatUi.palette-open {
                    ChatUi.palette-open = false;
                    return accept;
                }
                if ChatUi.dialog-open {
                    ChatUi.dialog-open = false;
                    root.title-editing = false;
                    return accept;
                }
                if ChatUi.schedules-open {
                    ChatUi.schedules-open = false;
                    return accept;
                }
                if BoardUi.dialog-open {
                    BoardUi.dialog-open = false;
                    return accept;
                }
                if BoardUi.open && !root.settings-open {
                    BoardUi.open = false;
                    return accept;
                }
                if WhiteboardUi.open {
                    WhiteboardUi.open = false;
                    return accept;
                }
                if root.ctx-open || root.header-menu-open || root.gctx-open {
                    root.ctx-open = false;
                    root.header-menu-open = false;
                    root.gctx-open = false;
                    return accept;
                }
                if ChatUi.find-open {
                    ChatUi.find-close();
                    return accept;
                }
                if DiffUi.open {
                    DiffUi.cancel();
                    return accept;
                }
                if DockUi.picker-open != "" {
                    DockUi.picker-open = "";
                    return accept;
                }
                if root.picker-open {
                    root.picker-open = false;
                    return accept;
                }
                if root.settings-open {
                    root.settings-open = false;
                    return accept;
                }
                if root.running {
                    root.stop();
                    return accept;
                }
            }
            // Global shortcuts (user keymap in settings.json, defaults from ZCode's shortcutCommands).
            if event.modifiers.control || event.modifiers.alt || event.modifiers.meta {
                let command = ShortcutsUi.match(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                if command != "" {
                    root.run-command(command);
                    return accept;
                }
            }
            reject
        }

        MidnightBackdrop {
            width: parent.width;
            height: parent.height;
        }
        HorizontalLayout {
            // Liquid-glass redesign: sidebar, chat and side pane float as rounded glass cards over the backdrop.
            padding: Theme.frame-gap;
            spacing: Theme.frame-gap;
            if root.show-sidebar: VerticalLayout {
                width: root.sidebar-w;
                Glass {
                    radius: Theme.radius-2xl;
                    clip: true;
                    VerticalLayout {
                // Brand row: the bunny mark and the short name, then history / hide controls.
                HorizontalLayout {
                    height: Theme.topbar-height - 4px;
                    padding-left: 14px;
                    padding-right: 10px;
                    spacing: 2px;
                    Image {
                        y: (parent.height - self.height) / 2;
                        width: 26px;
                        height: 26px;
                        source: @image-url("brand/mascot-small.svg");
                        accessible-role: none;
                    }
                    Rectangle {
                        width: 6px;
                    }
                    Text {
                        text: "Harness";
                        font-family: Theme.display-font;
                        font-weight: 700;
                        font-size: Theme.ui-lg;
                        color: Theme.foreground;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        TitleDrag {
                            enabled: !root.native-frame;
                            bar-width: root.width;
                            maximized: root.win-maximized;
                            action(a) => {
                                root.window-action(a);
                            }
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        size: Theme.control-sm;
                        icon-size: Theme.icon-sm;
                        icon: Icons.chevron-left;
                        label: @tr("Navigate Back");
                        enabled: ChatUi.can-back;
                        clicked => {
                            ChatUi.nav("back");
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        size: Theme.control-sm;
                        icon-size: Theme.icon-sm;
                        icon: Icons.chevron-right;
                        label: @tr("Navigate Forward");
                        enabled: ChatUi.can-forward;
                        clicked => {
                            ChatUi.nav("forward");
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        size: Theme.control-sm;
                        icon-size: Theme.icon-sm;
                        icon: Icons.panel-left;
                        label: @tr("Hide sidebar");
                        clicked => {
                            root.sidebar-hidden = true;
                        }
                    }
                }
                // New session: white primary row; right click or the chevron opens the options menu.
                HorizontalLayout {
                    height: 36px;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-bottom: 4px;
                    spacing: 6px;
                    new-btn := Rectangle {
                        horizontal-stretch: 1;
                        border-radius: Theme.radius-md;
                        background: nbta.has-hover ? Theme.primary-hover : Theme.primary;
                        drop-shadow-blur: 10px;
                        drop-shadow-offset-y: 3px;
                        drop-shadow-color: Theme.primary-shadow;
                        animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
                        accessible-role: button;
                        accessible-label: @tr("New session");
                        accessible-action-default => {
                            root.new-session();
                        }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Icon {
                                source: Icons.plus;
                                size: Theme.icon-xs;
                                tint: Theme.primary-foreground;
                            }
                            Text {
                                text: @tr("New session");
                                font-size: Theme.ui-caption;
                                font-weight: Theme.weight-semibold;
                                color: Theme.primary-foreground;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                        nbta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.new-session();
                            }
                            pointer-event(event) => {
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                    root.open-new-menu(self.absolute-position.x, self.absolute-position.y + self.height + 4px);
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: 32px;
                        border-radius: Theme.radius-md;
                        background: nmta.has-hover ? Theme.surface-hover : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
                        accessible-role: button;
                        accessible-label: "New session options";
                        accessible-action-default => {
                            root.open-new-menu(new-btn.absolute-position.x, new-btn.absolute-position.y + new-btn.height + 4px);
                        }
                        Icon {
                            source: Icons.chevron-down;
                            size: Theme.icon-xs;
                            tint: Theme.icon-subtle;
                        }
                        nmta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-new-menu(new-btn.absolute-position.x, new-btn.absolute-position.y + new-btn.height + 4px);
                            }
                        }
                    }
                }
                Sidebar {
                    vertical-stretch: 1;
                    sessions: root.sessions;
                initial: root.workspace-initial;
                workspace: root.workspace-name;
                new-session => {
                    root.new-session();
                }
                new-worktree-session => {
                    root.new-worktree-session();
                }
                open-session(id) => {
                    root.open-session(id);
                }
                archive-session(id) => {
                    root.archive-session(id);
                }
                menu(id, x, y) => {
                    root.open-menu(id, x, y);
                }
                new-menu(x, y) => {
                    root.open-new-menu(x, y);
                }
                group-menu(id, x, y) => {
                    root.open-group-menu(id, x, y);
                }
                open-page(id) => {
                    root.settings-open = true;
                    SettingsUi.open-page(id);
                }
                open-settings => {
                    root.settings-open = true;
                }
                }
                    }
                }
            }
            VerticalLayout {
            horizontal-stretch: 1;
            // Topbar: floats directly on the backdrop (no fill, no rule) above the chat card.
            Rectangle {
                height: Theme.topbar-height;
                background: transparent;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 4px;
                    spacing: 4px;
                    if root.narrow || root.sidebar-hidden: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.panel-left;
                        label: @tr("Show sidebar");
                        clicked => {
                            if root.narrow {
                                root.drawer-open = !root.drawer-open;
                            } else {
                                root.sidebar-hidden = false;
                            }
                        }
                    }
                    if root.title-editing && ChatUi.dialog-open && ChatUi.dialog-kind == "rename": Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 28px;
                        width: min(max(200px, title-input.preferred-width + 20px), 420px);
                        border-radius: Theme.radius-md;
                        background: Theme.input;
                        border-width: 1px;
                        border-color: Theme.switch-on;
                        title-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            text <=> ChatUi.dialog-text;
                            single-line: true;
                            vertical-alignment: center;
                            font-size: Theme.ui-base;
                            color: Theme.foreground;
                            selection-background-color: Theme.switch-on;
                            accessible-label: @tr("Session title");
                            init => {
                                self.focus();
                                self.select-all();
                            }
                            accepted => {
                                root.title-editing = false;
                                ChatUi.dialog-submit();
                            }
                            key-pressed(event) => {
                                if event.text == Key.Escape {
                                    root.title-editing = false;
                                    ChatUi.dialog-open = false;
                                    return accept;
                                }
                                reject
                            }
                        }
                    }
                    if !(root.title-editing && ChatUi.dialog-open && ChatUi.dialog-kind == "rename"): title-btn := Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 28px;
                        // `win-w` (not `root.width`): a plain property written from `changed width`, so no layout binding loop.
                        width: min(title-text.preferred-width + 16px, root.narrow ? max(80px, root.win-w - 190px) : 420px);
                        border-radius: Theme.radius-md;
                        background: tta.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Rename session");
                        accessible-action-default => {
                            if root.active-title != "" {
                                root.title-editing = true;
                                ChatUi.session-action("rename", "");
                            }
                        }
                        title-text := Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: root.active-title != "" ? root.active-title : @tr("New session");
                            font-size: Theme.ui-base;
                            font-weight: Theme.weight-semibold;
                            color: Theme.foreground;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                        tta := TouchArea {
                            mouse-cursor: root.active-title != "" ? text : default;
                            clicked => {
                                if root.active-title != "" {
                                    root.ctx-open = false;
                                    root.header-menu-open = false;
                                    root.title-editing = true;
                                    ChatUi.session-action("rename", "");
                                }
                            }
                        }
                    }
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 22px;
                        height: 24px;
                        border-radius: Theme.radius-md;
                        background: cta.has-hover || root.header-menu-open ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Session actions");
                        accessible-action-default => {
                            root.ctx-open = false;
                            root.header-menu-open = !root.header-menu-open;
                        }
                        Icon {
                            source: Icons.chevron-down;
                            size: Theme.icon-sm;
                            tint: Theme.icon-subtle;
                        }
                        cta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.ctx-open = false;
                                root.header-menu-open = !root.header-menu-open;
                            }
                        }
                    }
                    // Workspace chip (design 01: "ZCode/Worse").
                    if root.workspace-name != "" && !root.narrow: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 22px;
                        width: min(ws-chip.preferred-width + 16px, 220px);
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: Theme.border-hover;
                        ws-chip := Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: root.workspace-name;
                            font-family: Theme.art-font;
                            font-size: Theme.ui-sm - 1px;
                            color: Theme.muted;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        TitleDrag {
                            enabled: !root.native-frame;
                            bar-width: root.width;
                            maximized: root.win-maximized;
                            action(a) => {
                                root.window-action(a);
                            }
                        }
                    }
                    // Board: ghost text button (dropped on phone-size windows, where the title needs the room).
                    if !root.narrow: Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 28px;
                        width: board-t.preferred-width + 20px;
                        border-radius: Theme.radius-md;
                        background: bdta.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Board");
                        accessible-action-default => {
                            BoardUi.action("open", "");
                        }
                        board-t := Text {
                            text: @tr("Board");
                            font-size: Theme.ui-caption;
                            color: bdta.has-hover ? Theme.foreground : Theme.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        bdta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                BoardUi.action("open", "");
                            }
                        }
                    }
                    // Orchestra · N (design 01: accent pill with a dot; N = running subagents + tasks). Opens Settings > Orchestra.
                    orch-btn := Rectangle {
                        property <int> live: ChatUi.subagents-running + ChatUi.background-tasks-running;
                        y: (parent.height - self.height) / 2;
                        height: 28px;
                        width: orch-row.preferred-width;
                        border-radius: Theme.radius-md;
                        background: orta.has-hover ? Theme.surface-hover : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
                        accessible-role: button;
                        accessible-label: @tr("Orchestra");
                        accessible-description: self.live + " running";
                        accessible-action-default => {
                            BoardUi.open = false;
                            OrchLiveUi.open = true;
                        }
                        orch-row := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 7px;
                            // Idle: a quiet dot. While subagents / tasks run: unicode level bars, in the accent.
                            if orch-btn.live == 0: Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.icon-subtlest;
                            }
                            if orch-btn.live > 0: GlyphAnim {
                                y: (parent.height - self.height) / 2;
                                frames: AsciiArt.bars;
                                interval: 110ms;
                                font-size: 9px;
                                color: Theme.accent-fg;
                                vertical-alignment: center;
                            }
                            if !root.narrow: Text {
                                text: orch-btn.live > 0 ? @tr("Orchestra · {0}", orch-btn.live) : @tr("Orchestra");
                                font-size: Theme.ui-caption;
                                font-weight: Theme.weight-medium;
                                color: orta.has-hover || orch-btn.live > 0 ? Theme.foreground : Theme.foreground-subtle;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                        }
                        orta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                BoardUi.open = false;
                                OrchLiveUi.open = true;
                            }
                        }
                    }
                    // Side panel toggle (design 01: bordered square).
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        height: 28px;
                        border-radius: Theme.radius-md;
                        background: root.files-open ? Theme.raised : (ptta.has-hover ? Theme.hover : transparent);
                        border-width: 1px;
                        border-color: Theme.border-hover;
                        accessible-role: button;
                        accessible-label: root.files-open ? @tr("Close panel") : @tr("Open panel");
                        accessible-action-default => {
                            root.files-open = !root.files-open;
                        }
                        Icon {
                            source: Icons.panel-right;
                            size: Theme.icon-xs;
                            tint: root.files-open ? Theme.foreground : Theme.icon-subtle;
                        }
                        ptta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.files-open = !root.files-open;
                            }
                        }
                    }
                    more-panels := IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.ellipsis;
                        label: @tr("More panels");
                        active: root.files-open && (root.side-tab == "diff" || root.side-tab == "search");
                        clicked => {
                            panels-menu.show();
                        }
                    }
                    Rectangle {
                        width: 8px;
                    }
                    if !root.native-frame: HorizontalLayout {
                        spacing: 2px;
                        for w in [
                            { id: "minimize", icon: Icons.minus, label: "Minimize" },
                            { id: "maximize", icon: Icons.square, label: "Maximize" },
                            { id: "close", icon: Icons.x, label: "Close" },
                        ]: Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 40px;
                            height: 30px;
                            border-radius: Theme.radius-lg;
                            background: wta.has-hover ? (w.id == "close" ? #e5484d : Theme.surface-hover) : transparent;
                            animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
                            accessible-role: button;
                            accessible-label: w.label;
                            accessible-action-default => {
                                root.window-action(w.id);
                            }
                            Icon {
                                source: w.icon;
                                size: w.id == "maximize" ? Theme.icon-xs : Theme.icon-sm;
                                tint: wta.has-hover && w.id == "close" ? #ffffff : Theme.icon;
                            }
                            wta := TouchArea {
                                clicked => {
                                    root.window-action(w.id);
                                }
                            }
                        }
                    }
                }
                panels-menu := PopupWindow {
                    x: more-panels.x - 180px;
                    y: parent.height;
                    width: 220px;
                    MenuShell {
                        MenuItem {
                            text: "Background tasks";
                            has-icon: true;
                            icon: Icons.list-todo;
                            show-check: false;
                            detail: ChatUi.subagents-running + ChatUi.background-tasks-running > 0 ? ChatUi.subagents-running + ChatUi.background-tasks-running + "" : ChatUi.subagents.length + ChatUi.background-tasks.length > 0 ? ChatUi.subagents.length + ChatUi.background-tasks.length + "" : "";
                            clicked => {
                                root.side-tab = "overview";
                                root.files-open = true;
                                panels-menu.close();
                            }
                        }
                        MenuItem {
                            text: "Diff";
                            has-icon: true;
                            icon: Icons.file-diff;
                            checked: root.side-tab == "diff";
                            clicked => {
                                root.side-tab = "diff";
                                root.files-open = true;
                                panels-menu.close();
                            }
                        }
                        MenuItem {
                            text: "Terminal";
                            has-icon: true;
                            icon: Icons.terminal;
                            checked: root.side-tab == "terminal";
                            clicked => {
                                root.side-tab = "terminal";
                                root.files-open = true;
                                panels-menu.close();
                            }
                        }
                        MenuItem {
                            text: "Git";
                            has-icon: true;
                            icon: Icons.git-branch;
                            checked: root.side-tab == "git";
                            clicked => {
                                root.side-tab = "git";
                                root.files-open = true;
                                panels-menu.close();
                            }
                        }
                        MenuItem {
                            text: "Search";
                            has-icon: true;
                            icon: Icons.search;
                            checked: root.side-tab == "search";
                            clicked => {
                                root.side-tab = "search";
                                root.files-open = true;
                                panels-menu.close();
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                padding-right: 0px;
                padding-bottom: 0px;
                spacing: Theme.frame-gap;
                // Main column: flat on the backdrop (no card). The dither field hugs its edges and stays clear of
                // the transcript column; on the empty chat it comes further in and shimmers.
                main-panel := Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    DitherField {
                        lively: root.chat.length == 0 && !root.settings-open;
                        reach: root.chat.length == 0 ? clamp((parent.width - 600px) / 2, 0px, 420px) : clamp((parent.width - Theme.chat-max-width) / 2 - 12px, 0px, 300px);
                    }
                    // 与 narrow 相同：内容列宽度用 changed 回调写入普通属性，避免宽度→内边距→布局的绑定环。
                    changed width => {
                        root.chat-pad = max(16px, (self.width - Theme.chat-max-width) / 2);
                        root.bubble-max = (self.width - 2 * root.chat-pad) * 0.8;
                    }
                    VerticalLayout {
                        Rectangle {
                            vertical-stretch: 1;
                            if root.chat.length == 0: EmptyState {
                                width: parent.width;
                                height: parent.height;
                                place: root.workspace-name;
                                pick(text) => {
                                    root.draft = text;
                                }
                            }
                            chat-list := ListView {
                                width: parent.width;
                                height: parent.height;
                                property <length> bottom-y: min(0px, self.visible-height - self.content-height);
                                function follow() {
                                    if root.stick-bottom {
                                        if self.content-y != self.bottom-y {
                                            self.content-y = self.bottom-y;
                                        }
                                    } else if self.content-y < self.bottom-y {
                                        self.content-y = self.bottom-y;
                                    }
                                }
                                changed content-height => {
                                    self.follow();
                                }
                                changed visible-height => {
                                    self.follow();
                                }
                                changed visible-width => {
                                    self.follow();
                                }
                                property <length> last-y;
                                changed content-y => {
                                    if !root.stick-bottom && self.content-y < self.last-y && self.content-y <= self.bottom-y + 2px {
                                        root.stick-bottom = true;
                                    }
                                    self.last-y = self.content-y;
                                }
                                scrolled => {
                                    root.stick-bottom = false;
                                }
                                // 内容列最宽 chat-max-width 并居中：用左右内边距实现，alignment: center 会让子项退回首选宽度。
                                for item in root.chat: HorizontalLayout {
                                    padding-left: root.chat-pad;
                                    padding-right: root.chat-pad;
                                    // 查找定位第二步：匹配行实例化（或匹配切换到已存在的行）时按真实 y 精确滚动。
                                    property <bool> hit: ChatUi.find-open && item.id == ChatUi.find-id;
                                    property <int> seq: ChatUi.find-seq;
                                    init => {
                                        if self.hit {
                                            root.reveal-row(self.y);
                                        }
                                    }
                                    changed seq => {
                                        if self.hit {
                                            root.reveal-row(self.y);
                                        }
                                    }
                                    ChatRow {
                                        horizontal-stretch: 1;
                                        item: item;
                                        hit: parent.hit;
                                        busy: root.running;
                                        bubble-max: root.bubble-max;
                                        link(url) => {
                                            root.open-link(url);
                                        }
                                    }
                                }
                            }
                            if ChatUi.find-open: FindBar {
                                x: parent.width - self.width - 12px;
                                y: 8px;
                                width: min(380px, parent.width - 24px);
                                close => {
                                    ChatUi.find-close();
                                }
                            }
                            // Scroll to bottom (ZCode: round button above the composer when scrolled up).
                            if !root.stick-bottom && root.chat.length > 0: Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: parent.height - self.height - 8px;
                                width: Theme.control;
                                height: Theme.control;
                                border-radius: self.width / 2;
                                background: Theme.popover;
                                border-width: 1px;
                                border-color: Theme.popover-border;
                                drop-shadow-blur: Theme.shadow-md-blur;
                                drop-shadow-offset-y: Theme.shadow-md-y;
                                drop-shadow-color: Theme.shadow-md-color;
                                accessible-role: button;
                                accessible-label: @tr("Scroll to bottom");
                                accessible-action-default => {
                                    root.stick-bottom = true;
                                    chat-list.content-y = min(0px, chat-list.visible-height - chat-list.content-height);
                                }
                                Icon {
                                    source: Icons.arrow-down;
                                    size: Theme.icon-sm;
                                    tint: Theme.icon;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.stick-bottom = true;
                                        chat-list.content-y = min(0px, chat-list.visible-height - chat-list.content-height);
                                    }
                                }
                            }
                        }
                        // 修复：底部区域（横幅、选择器、输入框）与聊天列表平分多余高度，暂停横幅被拉伸占满聊天区；
                        // 底部区域不参与纵向拉伸，多余高度全部给聊天列表。
                        HorizontalLayout {
                            vertical-stretch: 0;
                            padding-left: root.chat-pad;
                            padding-right: root.chat-pad;
                            padding-bottom: 12px;
                            padding-top: 4px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                vertical-stretch: 0;
                                spacing: 8px;
                                if root.paused: Rectangle {
                                    vertical-stretch: 0;
                                    background: Theme.warning-surface;
                                    border-radius: Theme.radius-lg;
                                    accessible-role: AccessibleRole.text;
                                    accessible-label: pt.text;
                                    HorizontalLayout {
                                        padding: 8px;
                                        padding-left: 12px;
                                        spacing: 8px;
                                        Icon {
                                            source: Icons.triangle-alert;
                                            size: Theme.icon-sm;
                                            tint: Theme.warning-surface-foreground;
                                        }
                                        pt := Text {
                                            text: @tr("All agents reached their limits. New messages are queued until one is available.");
                                            wrap: word-wrap;
                                            font-size: Theme.ui-sm;
                                            color: Theme.warning-surface-foreground;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            accessible-role: none;
                                        }
                                    }
                                }
                                // Error banner (replaces the header error text): destructive surface, dismissible.
                                if root.error-text != "": Rectangle {
                                    vertical-stretch: 0;
                                    background: Theme.destructive-surface;
                                    border-radius: Theme.radius-lg;
                                    accessible-role: AccessibleRole.text;
                                    accessible-label: "error " + root.error-text;
                                    HorizontalLayout {
                                        padding: 6px;
                                        padding-left: 12px;
                                        spacing: 8px;
                                        Icon {
                                            source: Icons.circle-alert;
                                            size: Theme.icon-sm;
                                            tint: Theme.destructive-surface-foreground;
                                        }
                                        Text {
                                            text: root.error-text;
                                            wrap: word-wrap;
                                            font-size: Theme.ui-sm;
                                            color: Theme.destructive-surface-foreground;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            accessible-role: none;
                                        }
                                        IconButton {
                                            icon: Icons.x;
                                            label: @tr("Dismiss error");
                                            size: Theme.control-sm;
                                            icon-size: Theme.icon-sm;
                                            clicked => {
                                                ChatUi.dismiss-error();
                                            }
                                        }
                                    }
                                }
                                if DockUi.failure-shown: FailureBanner { }
                                if root.perm-visible: PermissionCard {
                                    title: root.perm-title;
                                    detail: root.perm-detail;
                                    options: root.perm-options;
                                    answer(allow) => {
                                        root.permission(root.perm-request, allow);
                                    }
                                    choose(id) => {
                                        root.choose-permission(root.perm-request, id);
                                    }
                                    feedback => {
                                        ChatUi.deny-feedback(root.perm-request);
                                    }
                                }
                                if ChatUi.parent-id != "": SubagentBar { }
                                if ChatUi.plan.length > 0: StatusPanel { }
                                if root.queue.length > 0: QueueList {
                                    items: root.queue;
                                    cancel(id) => {
                                        root.cancel-queued(id);
                                    }
                                }
                                if DockUi.picker-open != "" && !root.perm-visible: Rectangle {
                                    height: 0px;
                                    pm := PickerMenu {
                                        x: 0;
                                        y: -self.preferred-height - 4px;
                                        width: parent.width;
                                        height: self.preferred-height;
                                    }
                                }
                                if root.picker-open: AgentPicker {
                                    agents: root.agents;
                                    sticky: root.sticky-agent;
                                    paused: root.paused;
                                    choose(id) => {
                                        root.choose-agent(id);
                                        root.picker-open = false;
                                    }
                                }
                                // @ / slash popup above the composer (rows from src/chat).
                                if ChatUi.mention-open && !root.perm-visible: MenuShell {
                                    vertical-stretch: 0;
                                    if ChatUi.mention-rows.length == 0: Text {
                                        height: 36px;
                                        text: ChatUi.mention-trigger == "/" ? @tr("No commands") : @tr("No matches");
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        color: Theme.foreground-subtle;
                                    }
                                    if ChatUi.mention-rows.length > 0: ResultList {
                                        height: min(ChatUi.mention-rows.length * 36px, 288px);
                                        rows: ChatUi.mention-rows;
                                        current: ChatUi.mention-index;
                                        list-label: ChatUi.mention-trigger == "/" ? @tr("Commands") : @tr("Mentions");
                                        run(i) => {
                                            ChatUi.mention-pick(i);
                                        }
                                    }
                                }
                                if root.running && !root.perm-visible: WorkingLine { }
                                // Live update (phase 1): pill above the composer when a new build replaced the source exe.
                                if root.update-ready: HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 26px;
                                        width: upd-row.preferred-width;
                                        border-radius: Theme.radius-full;
                                        background: upd-hit.has-hover ? Theme.accent-line : Theme.accent-soft;
                                        border-width: 1px;
                                        border-color: Theme.accent-line;
                                        animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
                                        accessible-role: button;
                                        accessible-label: @tr("New build ready · Restart");
                                        accessible-action-default => {
                                            root.restart-for-update();
                                        }
                                        upd-row := HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            spacing: 7px;
                                            Rectangle {
                                                y: (parent.height - self.height) / 2;
                                                width: 7px;
                                                height: 7px;
                                                border-radius: 3.5px;
                                                background: Theme.accent-fg;
                                            }
                                            Text {
                                                text: @tr("New build ready");
                                                font-size: Theme.ui-sm;
                                                color: Theme.accent-fg;
                                                vertical-alignment: center;
                                                accessible-role: none;
                                            }
                                            Text {
                                                text: @tr("Restart");
                                                font-size: Theme.ui-sm;
                                                font-weight: Theme.weight-semibold;
                                                color: Theme.foreground;
                                                vertical-alignment: center;
                                                accessible-role: none;
                                            }
                                        }
                                        upd-hit := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.restart-for-update();
                                            }
                                        }
                                    }
                                }
                                if !root.perm-visible: Composer {
                                    agents: root.agents;
                                    draft <=> root.draft;
                                    running: root.running;
                                    queued: root.queued;
                                    sticky-name: root.sticky-name;
                                    send => {
                                        root.stick-bottom = true;
                                        root.do-send();
                                    }
                                    stop => {
                                        root.stop();
                                    }
                                    toggle-picker => {
                                        root.picker-open = !root.picker-open;
                                        DockUi.picker-open = "";
                                    }
                                    stick-bottom-request => {
                                        root.stick-bottom = true;
                                    }
                                }
                            }
                        }
                    }
                }
                if root.files-open && !root.narrow: SidePane {
                    property <length> main-w: root.win-w - (root.show-sidebar ? root.sidebar-w + Theme.frame-gap : 0px) - Theme.frame-gap * 2;
                    width: self.wide ? max(Theme.side-pane-width, self.main-w * 0.7) : root.side-tab == "diff" ? max(Theme.side-pane-width, self.main-w * 0.5) : Theme.side-pane-width;
                    tab <=> root.side-tab;
                    files: root.files;
                    workspace: root.workspace;
                    toggle(i) => {
                        root.toggle-file(i);
                    }
                    close => {
                        root.files-open = false;
                    }
                }
            }
            }
        }

        // Sidebar resize handle (ZCode: drag the sidebar edge; 200–420px). Width is UI-local.
        if root.show-sidebar: Rectangle {
            // Sits in the gap between the sidebar card and the chat card.
            x: Theme.frame-gap + root.sidebar-w + Theme.frame-gap / 2 - 3px;
            y: Theme.topbar-height;
            width: 6px;
            height: parent.height - Theme.topbar-height * 2;
            border-radius: 3px;
            accessible-role: AccessibleRole.slider;
            accessible-label: @tr("Resize sidebar");
            accessible-value: round(root.sidebar-w / 1px);
            accessible-value-minimum: 200;
            accessible-value-maximum: 420;
            accessible-value-step: 20;
            accessible-action-increment => {
                root.sidebar-w = min(420px, root.sidebar-w + 20px);
            }
            accessible-action-decrement => {
                root.sidebar-w = max(200px, root.sidebar-w - 20px);
            }
            background: sra.has-hover || sra.pressed ? Theme.border : transparent;
            sra := TouchArea {
                mouse-cursor: ew-resize;
                moved => {
                    if self.pressed {
                        root.sidebar-w = clamp(root.sidebar-w + self.mouse-x - self.pressed-x, 200px, 420px);
                    }
                }
            }
        }

        if !root.win-maximized && !root.native-frame: ResizeEdge {
            x: 0;
            y: 0;
            width: parent.width;
            height: 4px;
            mouse-cursor: ns-resize;
            start => {
                root.window-action("resize-n");
            }
        }
        if !root.win-maximized && !root.native-frame: ResizeEdge {
            x: 0;
            y: parent.height - 4px;
            width: parent.width;
            height: 4px;
            mouse-cursor: ns-resize;
            start => {
                root.window-action("resize-s");
            }
        }
        if !root.win-maximized && !root.native-frame: ResizeEdge {
            x: 0;
            y: 0;
            width: 4px;
            height: parent.height;
            mouse-cursor: ew-resize;
            start => {
                root.window-action("resize-w");
            }
        }
        if !root.win-maximized && !root.native-frame: ResizeEdge {
            x: parent.width - 4px;
            y: 0;
            width: 4px;
            height: parent.height;
            mouse-cursor: ew-resize;
            start => {
                root.window-action("resize-e");
            }
        }
        if !root.win-maximized && !root.native-frame: ResizeEdge {
            x: 0;
            y: 0;
            width: 8px;
            height: 8px;
            mouse-cursor: nwse-resize;
            start => {
                root.window-action("resize-nw");
            }
        }
        if !root.win-maximized && !root.native-frame: ResizeEdge {
            x: parent.width - 8px;
            y: parent.height - 8px;
            width: 8px;
            height: 8px;
            mouse-cursor: nwse-resize;
            start => {
                root.window-action("resize-se");
            }
        }
        if !root.win-maximized && !root.native-frame: ResizeEdge {
            x: parent.width - 8px;
            y: 0;
            width: 8px;
            height: 8px;
            mouse-cursor: nesw-resize;
            start => {
                root.window-action("resize-ne");
            }
        }
        if !root.win-maximized && !root.native-frame: ResizeEdge {
            x: 0;
            y: parent.height - 8px;
            width: 8px;
            height: 8px;
            mouse-cursor: nesw-resize;
            start => {
                root.window-action("resize-sw");
            }
        }

        // Narrow (phone-size) layout: sessions drawer and files sheet as overlays.
        if root.narrow && root.drawer-open: Rectangle {
            background: Theme.scrim;
            TouchArea {
                clicked => {
                    root.drawer-open = false;
                }
            }
            Rectangle {
                x: Theme.frame-gap;
                y: Theme.frame-gap;
                width: min(300px, parent.width - 48px);
                height: parent.height - Theme.frame-gap * 2;
                background: Theme.glass-strong;
                border-radius: Theme.radius-2xl;
                border-width: 1px;
                border-color: Theme.glass-rim;
                drop-shadow-blur: Theme.shadow-lg-blur;
                drop-shadow-offset-y: Theme.shadow-lg-y;
                drop-shadow-color: Theme.shadow-lg-color;
                clip: true;
                Sidebar {
                    show-new: true;
                    sessions: root.sessions;
                    initial: root.workspace-initial;
                    workspace: root.workspace-name;
                    new-session => {
                        root.drawer-open = false;
                        root.new-session();
                    }
                    new-worktree-session => {
                        root.drawer-open = false;
                        root.new-worktree-session();
                    }
                    open-session(id) => {
                        root.drawer-open = false;
                        root.open-session(id);
                    }
                    archive-session(id) => {
                        root.archive-session(id);
                    }
                    menu(id, x, y) => {
                        root.open-menu(id, x, y);
                    }
                    new-menu(x, y) => {
                        root.drawer-open = false;
                        root.open-new-menu(x, y);
                    }
                    group-menu(id, x, y) => {
                        root.open-group-menu(id, x, y);
                    }
                    open-page(id) => {
                        root.drawer-open = false;
                        root.settings-open = true;
                        SettingsUi.open-page(id);
                    }
                    open-settings => {
                        root.drawer-open = false;
                        root.settings-open = true;
                    }
                }
            }
        }
        if root.narrow && root.files-open && !root.drawer-open && root.chat.length == 0: Rectangle {
            // On phones the file tree is a sheet that only shows on an empty chat; the header toggle hides it.
            x: 12px;
            y: 52px;
            width: parent.width - 24px;
            height: min(260px, parent.height / 3);
            SidePane {
                tab <=> root.side-tab;
                files: root.files;
                workspace: root.workspace;
                toggle(i) => {
                    root.toggle-file(i);
                }
            }
        }

        // Session menu (sidebar row) and header menu: click outside closes them.
        if root.ctx-open || root.header-menu-open || root.gctx-open || root.nmenu-open: TouchArea {
            clicked => {
                root.ctx-open = false;
                root.header-menu-open = false;
                root.gctx-open = false;
                root.nmenu-open = false;
            }
        }
        if root.nmenu-open: MenuShell {
            x: min(root.nmenu-x, root.width - self.width - 8px);
            y: min(root.nmenu-y, root.height - self.preferred-height - 8px);
            width: 220px;
            height: self.preferred-height;
            accessible-role: AccessibleRole.groupbox;
            accessible-label: @tr("New session menu");
            MenuItem {
                text: @tr("New session");
                show-check: false;
                has-icon: true;
                icon: Icons.plus;
                clicked => {
                    root.nmenu-open = false;
                    root.new-session();
                }
            }
            MenuItem {
                text: @tr("New session in worktree");
                show-check: false;
                has-icon: true;
                icon: Icons.git-fork;
                clicked => {
                    root.nmenu-open = false;
                    root.new-worktree-session();
                }
            }
            MenuItem {
                text: @tr("Open folder…");
                show-check: false;
                has-icon: true;
                icon: Icons.folder-open;
                clicked => {
                    root.pick-folder();
                }
            }
        }
        if root.folder-confirm: ConfirmDialog {
            title: @tr("A turn is running. Restart Harness in another folder?");
            message: @tr("Harness restarts in the folder you pick. Running and queued turns are interrupted.");
            confirm-text: @tr("Open folder");
            destructive: false;
            close => {
                root.folder-confirm = false;
            }
            confirm => {
                root.folder-confirm = false;
                root.open-folder();
            }
        }
        if root.gctx-open: MenuShell {
            x: min(root.gctx-x, root.width - self.width - 8px);
            y: min(root.gctx-y, root.height - self.preferred-height - 8px);
            width: 220px;
            height: self.preferred-height;
            accessible-role: AccessibleRole.groupbox;
            accessible-label: @tr("Group menu");
            MenuItem {
                text: @tr("Rename group");
                show-check: false;
                has-icon: true;
                icon: Icons.pencil;
                clicked => {
                    root.gctx-open = false;
                    ChatUi.group-action("rename", root.gctx-id);
                }
            }
            HorizontalLayout {
                padding: 6px;
                padding-left: 10px;
                spacing: 6px;
                for c in ["gray", "red", "orange", "yellow", "green", "blue", "purple"]: Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: ChatUi.group-color(c);
                    accessible-role: AccessibleRole.button;
                    accessible-label: "color " + c;
                    accessible-action-default => {
                        root.gctx-open = false;
                        ChatUi.group-action("color:" + c, root.gctx-id);
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.gctx-open = false;
                            ChatUi.group-action("color:" + c, root.gctx-id);
                        }
                    }
                }
            }
            MenuItem {
                text: @tr("Move group up");
                show-check: false;
                has-icon: true;
                icon: Icons.chevron-up;
                clicked => {
                    root.gctx-open = false;
                    ChatUi.group-action("up", root.gctx-id);
                }
            }
            MenuItem {
                text: @tr("Move group down");
                show-check: false;
                has-icon: true;
                icon: Icons.chevron-down;
                clicked => {
                    root.gctx-open = false;
                    ChatUi.group-action("down", root.gctx-id);
                }
            }
            MenuItem {
                text: @tr("Delete group");
                show-check: false;
                has-icon: true;
                icon: Icons.trash-2;
                clicked => {
                    root.gctx-open = false;
                    ChatUi.group-action("delete", root.gctx-id);
                }
            }
        }
        if root.ctx-open: MenuShell {
            x: min(root.ctx-x, root.width - self.width - 8px);
            y: min(root.ctx-y, root.height - self.preferred-height - 8px);
            width: 220px;
            height: self.preferred-height;
            accessible-role: AccessibleRole.groupbox;
            accessible-label: @tr("Session menu");
            MenuItem {
                text: @tr("Open");
                show-check: false;
                clicked => {
                    root.ctx-open = false;
                    root.open-session(root.ctx-id);
                }
            }
            MenuItem {
                text: @tr("Copy session ID");
                show-check: false;
                has-icon: true;
                icon: Icons.copy;
                clicked => {
                    root.ctx-open = false;
                    ChatUi.copy-session-id(root.ctx-id);
                }
            }
            MenuItem {
                text: @tr("Rename");
                show-check: false;
                has-icon: true;
                icon: Icons.pencil;
                clicked => {
                    root.ctx-open = false;
                    ChatUi.session-action("rename", root.ctx-id);
                }
            }
            MenuItem {
                text: @tr("Export as Markdown");
                show-check: false;
                has-icon: true;
                icon: Icons.download;
                clicked => {
                    root.ctx-open = false;
                    ChatUi.session-action("export", root.ctx-id);
                }
            }
            MenuItem {
                text: root.ctx-pinned ? @tr("Unpin") : @tr("Pin");
                show-check: false;
                has-icon: true;
                icon: Icons.pin;
                clicked => {
                    root.ctx-open = false;
                    ChatUi.session-action(root.ctx-pinned ? "unpin" : "pin", root.ctx-id);
                }
            }
            MenuItem {
                text: @tr("Mark as unread");
                show-check: false;
                has-icon: true;
                icon: Icons.mail;
                clicked => {
                    root.ctx-open = false;
                    ChatUi.session-action("unread", root.ctx-id);
                }
            }
            MenuItem {
                text: @tr("Fork");
                show-check: false;
                has-icon: true;
                icon: Icons.git-fork;
                clicked => {
                    root.ctx-open = false;
                    ChatUi.session-action("fork", root.ctx-id);
                }
            }
            for g in ChatUi.groups: MenuItem {
                text: @tr("Move to {0}", g.name);
                show-check: false;
                has-icon: true;
                icon: Icons.folder;
                clicked => {
                    root.ctx-open = false;
                    ChatUi.session-action("group:" + g.id, root.ctx-id);
                }
            }
            MenuItem {
                text: @tr("Remove from group");
                show-check: false;
                has-icon: true;
                icon: Icons.minus;
                clicked => {
                    root.ctx-open = false;
                    ChatUi.session-action("ungroup", root.ctx-id);
                }
            }
            MenuItem {
                text: @tr("Archive");
                show-check: false;
                has-icon: true;
                icon: Icons.archive;
                clicked => {
                    root.ctx-open = false;
                    root.archive-session(root.ctx-id);
                }
            }
            MenuItem {
                text: @tr("Delete");
                show-check: false;
                has-icon: true;
                icon: Icons.trash-2;
                clicked => {
                    root.ctx-open = false;
                    ChatUi.session-action("delete", root.ctx-id);
                }
            }
        }
        if root.header-menu-open: MenuShell {
            x: (root.show-sidebar ? root.sidebar-w + Theme.frame-gap * 2 : 40px) + 8px;
            y: Theme.topbar-height + Theme.frame-gap;
            width: 280px;
            height: self.preferred-height;
            accessible-role: AccessibleRole.groupbox;
            accessible-label: @tr("Session actions");
            MenuItem {
                text: @tr("Find in Task");
                show-check: false;
                has-icon: true;
                icon: Icons.search;
                enabled: root.chat.length > 0;
                clicked => {
                    root.header-menu-open = false;
                    ChatUi.find-open = true;
                }
            }
            MenuItem {
                text: @tr("Previous Task");
                show-check: false;
                has-icon: true;
                icon: Icons.chevron-up;
                enabled: ChatUi.can-prev;
                clicked => {
                    root.header-menu-open = false;
                    ChatUi.nav("prev");
                }
            }
            MenuItem {
                text: @tr("Next Task");
                show-check: false;
                has-icon: true;
                icon: Icons.chevron-down;
                enabled: ChatUi.can-next;
                clicked => {
                    root.header-menu-open = false;
                    ChatUi.nav("next");
                }
            }
            MenuItem {
                text: ChatUi.action-label("exportMarkdown");
                show-check: false;
                has-icon: true;
                icon: Icons.file-text;
                enabled: root.chat.length > 0;
                clicked => {
                    root.header-menu-open = false;
                    ChatUi.export("markdown");
                }
            }
            MenuItem {
                text: ChatUi.action-label("exportHtml");
                show-check: false;
                has-icon: true;
                icon: Icons.code;
                enabled: root.chat.length > 0;
                clicked => {
                    root.header-menu-open = false;
                    ChatUi.export("html");
                }
            }
            MenuItem {
                text: ChatUi.action-label("renameSession");
                show-check: false;
                has-icon: true;
                icon: Icons.pencil;
                enabled: ChatUi.has-session;
                clicked => {
                    root.header-menu-open = false;
                    ChatUi.session-action("rename", "");
                }
            }
            MenuItem {
                text: ChatUi.action-label("forkSession");
                show-check: false;
                has-icon: true;
                icon: Icons.git-fork;
                enabled: ChatUi.has-session;
                clicked => {
                    root.header-menu-open = false;
                    ChatUi.session-action("fork", "");
                }
            }
            MenuItem {
                text: ChatUi.action-label("copySessionId");
                show-check: false;
                has-icon: true;
                icon: Icons.copy;
                enabled: ChatUi.has-session;
                clicked => {
                    root.header-menu-open = false;
                    ChatUi.copy-session-id("");
                }
            }
            MenuItem {
                text: ChatUi.action-label("revealWorkspace");
                show-check: false;
                has-icon: true;
                icon: Icons.folder-open;
                clicked => {
                    root.header-menu-open = false;
                    ChatUi.reveal();
                }
            }
        }

        if ChatUi.palette-open: CommandCenter {
            close => {
                ChatUi.palette-open = false;
            }
        }

        // OS file drag over the window: drop target hint (files become composer chips).
        if ChatUi.drop-hover: Rectangle {
            background: Theme.scrim;
            Rectangle {
                width: min(360px, parent.width - 48px);
                height: 120px;
                border-radius: Theme.radius-2xl;
                border-width: 2px;
                border-color: Theme.input-border-focused;
                background: Theme.popover;
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    HorizontalLayout {
                        alignment: center;
                        Icon {
                            source: Icons.paperclip;
                            tint: Theme.icon;
                        }
                    }
                    Text {
                        text: @tr("Drop files to attach");
                        horizontal-alignment: center;
                        color: Theme.foreground;
                    }
                }
            }
        }

        if ChatUi.toast != "": Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 96px;
            width: tt.preferred-width + 24px;
            height: 32px;
            border-radius: Theme.radius-lg;
            background: Theme.toast;
            border-width: 1px;
            border-color: Theme.popover-border;
            drop-shadow-blur: Theme.shadow-md-blur;
            drop-shadow-offset-y: Theme.shadow-md-y;
            drop-shadow-color: Theme.shadow-md-color;
            accessible-role: AccessibleRole.text;
            accessible-label: "toast " + ChatUi.toast;
            tt := Text {
                text: ChatUi.toast;
                color: Theme.foreground;
                font-size: Theme.ui-sm;
                accessible-role: none;
            }
        }

        // Hidden clipboard helper (copy-text).
        Rectangle {
            width: 0px;
            height: 0px;
            clip: true;
            opacity: 0;
            // 多行文本（代码块、整条回复）也要原样复制，single-line 会把换行吞掉。
            clipboard := TextInput {
                single-line: false;
                accessible-role: none;
            }
        }

        if ChatUi.schedules-open: SchedulesDialog { }
        if WhiteboardUi.open: WhiteboardDialog { }
        if DockUi.picker-open != "" || root.picker-open: Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            TouchArea {
                x: 0;
                y: 0;
                width: parent.width;
                height: max(0px, DockUi.menu-y);
                clicked => {
                    DockUi.picker-open = "";
                    root.picker-open = false;
                }
            }
            TouchArea {
                x: 0;
                y: DockUi.menu-y;
                width: max(0px, DockUi.menu-x);
                height: max(0px, parent.height - DockUi.menu-y);
                clicked => {
                    DockUi.picker-open = "";
                    root.picker-open = false;
                }
            }
            TouchArea {
                x: DockUi.menu-x + DockUi.menu-w;
                y: DockUi.menu-y;
                width: max(0px, parent.width - DockUi.menu-x - DockUi.menu-w);
                height: max(0px, parent.height - DockUi.menu-y);
                clicked => {
                    DockUi.picker-open = "";
                    root.picker-open = false;
                }
            }
        }
        if ChatUi.dialog-open && !(root.title-editing && ChatUi.dialog-kind == "rename"): TextDialog { }
        if GitUi.dialog != "": GitDialogs {
            message <=> PanelGit.message;
        }

        if BoardUi.open: BoardPage {
            close => {
                BoardUi.open = false;
            }
            window-action(action) => {
                root.window-action(action);
            }
        }
        if OrchLiveUi.open: OrchestraLive {
            session-title: root.active-title;
            agent-id: root.sticky-agent;
            agent-name: root.sticky-name;
            model-name: DockUi.model-name;
            session-running: root.running;
            close => {
                OrchLiveUi.open = false;
            }
            open-settings => {
                OrchLiveUi.open = false;
                root.settings-open = true;
                SettingsUi.open-page("orchestra");
            }
            delegate => {
                OrchLiveUi.open = false;
                root.draft = @tr("Delegate to subagents: ");
            }
        }
        // Settings is a centred modal over a dimmed backdrop (click outside or Esc closes); full window only when
        // the window is too small for a dialog.
        if root.settings-open: settings-overlay := Rectangle {
            property <bool> modal: !root.narrow && root.width >= 760px && root.height >= 520px;
            background: self.modal ? Theme.scrim : transparent;
            TouchArea {
                clicked => {
                    root.settings-open = false;
                }
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.modal ? min(1120px, parent.width - 96px) : parent.width;
                height: parent.modal ? min(780px, parent.height - 96px) : parent.height;
                border-radius: parent.modal ? Theme.radius-3xl : 0px;
                drop-shadow-blur: parent.modal ? 60px : 0px;
                drop-shadow-offset-y: parent.modal ? 20px : 0px;
                drop-shadow-color: Theme.shadow-lg-color;
                background: Theme.canvas;
                Rectangle {
                    border-radius: parent.border-radius;
                    clip: true;
                    MidnightBackdrop { }
                    SettingsShell {
            init => {
                SettingsUi.open-page(SettingsUi.page);
            }
            fallback: root.fallback;
            narrow: root.narrow;
            version: SettingsUi.get-string("app.version", SettingsUi.rev);
            update-ready: root.update-ready;
            restart-for-update => {
                root.restart-for-update();
            }
            add-folder => {
                root.open-folder();
            }
            close => {
                root.settings-open = false;
            }
            move-fallback(index, delta) => {
                root.move-fallback(index, delta);
            }
                    }
                }
                Rectangle {
                    border-radius: parent.border-radius;
                    border-width: settings-overlay.modal ? 1px : 0px;
                    border-color: Theme.glass-rim;
                }
            }
        }
        // 设置页里也能打开（Settings › Agents › Set up agents…），所以放在 SettingsShell 之后，叠在其上。
        if SetupUi.open: SetupDialog { }
        if AgentsUi.provider-open: ProviderDialog { }
    }
}

