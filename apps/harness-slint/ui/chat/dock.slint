// Composer dock of 9.2B round 3 (spec docs/specs/harness/phase-9-parity.md §7.4 "UI contract for 9.2B round 3"):
// queue operations, mode / model / effort pickers and the typed error banner. The hub owns the queue, the
// per-session choices and the failure; Rust (src/bridge/dock.rs) mirrors its events here. UI-local state is
// only which menu is open, the drag preview and whether the failure details are expanded.

import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, Button, IconButton, MenuShell, MenuItem, SectionLabel } from "../components/controls.slint";
import { ProgressTrack } from "../panels/common.slint";

// One choice of a picker: (id, display name) from Event::SessionOptions.
export struct OptionRow {
    id: string,
    name: string,
}

export global DockUi {
    // ---- queue (R12) ----
    // Queued message being edited in the composer ("" = none); Send then sends EditQueued.
    in property <string> editing-id;
    // "steer" | "edit" | "remove" | "cancel-edit" on a queued id.
    callback queue-action(string, string);
    // Moves a queued message by delta rows (grip drag release, accessible increment / decrement).
    callback queue-move(string, int);
    // Composer Steer while a turn runs (Command::Steer).
    callback steer();

    // ---- pickers (R13) ----
    in property <[OptionRow]> modes;
    in property <[OptionRow]> models;
    in property <[OptionRow]> efforts;
    in property <string> mode;
    in property <string> model;
    in property <string> effort;
    in property <string> mode-name;
    in property <string> model-name;
    in property <string> effort-name;
    // A turn runs (choices apply from the next prompt; the pickers are disabled meanwhile).
    in property <bool> options-locked;
    // A Set* call is in flight.
    in property <bool> options-pending;
    // Open picker menu: "" | "mode" | "model" | "effort" | "options" (UI-local).
    in-out property <string> picker-open;
    in property <bool> machine;
    in property <bool> research;
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in-out property <length> menu-w;
    // Window x of the button that opened a picker menu: the menu opens above that button, not at the far end
    // of the composer.
    in-out property <length> anchor-x;
    // Models the menu shows: `models` narrowed by `model-query` (kept by Rust; Slint cannot search text).
    in property <[OptionRow]> models-shown;
    in-out property <string> model-query;
    callback filter-models(string);
    // Footer width level (UI-local, computed by PickerBar from measured widths): "full" = three buttons,
    // "medium" = Model + options button (Mode, Effort in the popup), "compact" = options button only.
    in-out property <string> picker-layout: "full";
    // "mode" | "model" | "effort", option id.
    callback pick-option(string, string);

    // ---- typed failure (R20) ----
    in property <bool> failure-shown;
    // "auth" | "processExited" | "initFailed" | "transient" | "other"
    in property <string> failure-kind;
    in property <string> failure-message;
    // details and trace joined (empty = no Details toggle).
    in property <string> failure-details;
    // "retry" | "after" | "login" | "no"
    in property <string> failure-retry;
    // Seconds left of an After hint (0 = retry allowed now).
    in property <int> failure-wait;
    in-out property <bool> failure-expanded;
    // "retry" | "copy" | "dismiss"
    callback failure-action(string);

    pure public function failure-title(kind: string) -> string {
        if kind == "auth" { return @tr("Sign-in required"); }
        if kind == "processExited" { return @tr("The agent process exited"); }
        if kind == "initFailed" { return @tr("The agent failed to start"); }
        if kind == "transient" { return @tr("Rate limit or network error"); }
        @tr("The turn failed")
    }
    pure public function mode-description(id: string) -> string {
        if id == "default" { return "Ask before edits and commands"; }
        if id == "acceptEdits" { return "Automatically accept all file edits"; }
        if id == "plan" { return "Create a plan before making changes"; }
        if id == "bypassPermissions" { return "Run everything without asking"; }
        if id == "dontAsk" { return "Deny anything not already allowed"; }
        if id == "auto" { return "Work in the project, ask outside it"; }
        if id == "read-only" { return "Read files only, ask before changes"; }
        if id == "full-access" { return "Edit files and run commands without asking"; }
        ""
    }
    pure public function picker-label(which: string) -> string {
        if which == "mode" { return @tr("Mode"); }
        if which == "model" { return @tr("Model"); }
        @tr("Effort")
    }
}

// One picker button in the composer footer (ghost button + chevron); the menu opens above the composer.
// Wraps a Button (centred in the footer row) rather than inheriting it, so the footer spacing matches the icons.
export component PickerButton inherits HorizontalLayout {
    in property <string> which;
    in property <string> value;
    horizontal-stretch: 0;
    alignment: center;
    Button {
        y: (parent.height - self.height) / 2;
        variant: "ghost";
        size: "sm";
        text: root.value;
        trailing-chevron: true;
        label: DockUi.picker-label(root.which) + ": " + root.value;
        text-color: root.which == "mode" && DockUi.machine ? Theme.destructive : root.which == "mode" && DockUi.research ? Theme.brand : Theme.foreground-subtle;
        enabled: !DockUi.options-locked && !DockUi.options-pending;
        clicked => {
            DockUi.anchor-x = root.absolute-position.x;
            if root.which == "model" && DockUi.model-query != "" {
                DockUi.model-query = "";
                DockUi.filter-models("");
            }
            DockUi.picker-open = DockUi.picker-open == root.which ? "" : root.which;
        }
    }
}

// "Options" icon button of the collapsed footer (sliders icon, hover tooltip "Mode & effort").
component OptionsButton inherits Rectangle {
    // Same square as the other footer icon buttons (IconButton default size).
    width: Theme.control;
    height: Theme.control;
    property <bool> enabled: !DockUi.options-locked && !DockUi.options-pending;
    btn := IconButton {
        icon: Icons.sliders-horizontal;
        label: @tr("Mode & effort");
        icon-size: Theme.icon-sm;
        enabled: root.enabled;
        // tip-ta (on top) takes the pointer, so its hover drives the button's highlight.
        active: DockUi.picker-open == "options" || (tip-ta.has-hover && root.enabled);
        clicked => {
            DockUi.anchor-x = root.absolute-position.x;
            DockUi.picker-open = DockUi.picker-open == "options" ? "" : "options";
        }
    }
    // Tooltip above the button (no shared tooltip component exists; tokens Theme.tooltip*).
    if tip-ta.has-hover && DockUi.picker-open != "options": Rectangle {
        x: (root.width - self.width) / 2;
        y: -self.height - 4px;
        width: tip.preferred-width + 12px;
        height: tip.preferred-height + 6px;
        border-radius: Theme.radius-md;
        background: Theme.tooltip;
        accessible-role: none;
        tip := Text {
            text: @tr("Mode & effort");
            font-size: Theme.ui-sm;
            color: Theme.tooltip-foreground;
            accessible-role: none;
        }
    }
    tip-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if root.enabled {
                DockUi.picker-open = DockUi.picker-open == "options" ? "" : "options";
            }
        }
    }
}

// Picker row of the composer footer. Takes the width the footer leaves after its other items and picks a level
// (spec phase-9-parity.md "Width"): three buttons, Model + options button, or options button only. Nothing is clipped.
export component PickerBar inherits Rectangle {
    horizontal-stretch: 1;
    // The bar asks for no width of its own, so every other footer item keeps its preferred width and the bar
    // gets the rest (footer width minus agent button, icons, tags, context meter, Steer and Stop / Send).
    // At least the options button, so even the compact level never draws over its neighbours.
    min-width: root.count > 0 ? Theme.control : 0px;
    preferred-width: root.full-w;
    // Gap between picker buttons (matches the round-3 footer).
    property <length> gap: 2px;
    // Width of a PickerButton beyond its text, from Button size "sm" with a trailing chevron (controls.slint):
    // left pad 8px + text + row spacing 4px + chevron 12px + right pad (8px - 2px) = text + 30px.
    property <length> chrome: 8px + 4px + 12px + 6px;
    property <length> mode-w: DockUi.modes.length > 0 ? mode-t.preferred-width + root.chrome : 0px;
    property <length> model-w: DockUi.models.length > 0 ? model-t.preferred-width + root.chrome : 0px;
    property <length> effort-w: DockUi.efforts.length > 0 && DockUi.models.length == 0 ? effort-t.preferred-width + root.chrome : 0px;
    property <int> count: (DockUi.modes.length > 0 ? 1 : 0) + (DockUi.models.length > 0 ? 1 : 0) + (DockUi.efforts.length > 0 ? 1 : 0);
    property <length> full-w: root.mode-w + root.model-w + root.effort-w + max(0, root.count - 1) * root.gap;
    property <bool> collapsible: DockUi.modes.length > 0 || DockUi.efforts.length > 0;
    property <length> medium-w: root.model-w + (DockUi.models.length > 0 ? root.gap : 0px) + Theme.control;
    property <string> level: root.full-w <= root.width || !root.collapsible ? "full" : root.medium-w <= root.width ? "medium" : "compact";
    init => {
        DockUi.picker-layout = root.level;
    }
    changed level => {
        DockUi.picker-layout = root.level;
        // A menu that moved into (or out of) the popup is closed rather than shown at the wrong anchor.
        DockUi.picker-open = "";
    }
    // Text measurers (same font as Button text); not drawn, not in the accessibility tree.
    mode-t := Text {
        visible: false;
        width: 0px;
        height: 0px;
        text: DockUi.mode-name;
        font-size: Theme.ui-base;
        accessible-role: none;
    }
    model-t := Text {
        visible: false;
        width: 0px;
        height: 0px;
        text: DockUi.efforts.length > 0 ? DockUi.model-name + "  " + DockUi.effort-name : DockUi.model-name;
        font-size: Theme.ui-base;
        accessible-role: none;
    }
    effort-t := Text {
        visible: false;
        width: 0px;
        height: 0px;
        text: DockUi.effort-name;
        font-size: Theme.ui-base;
        accessible-role: none;
    }
    HorizontalLayout {
        x: 0px;
        width: self.preferred-width;
        height: root.height;
        spacing: root.gap;
        if root.level != "compact" && DockUi.models.length > 0: PickerButton {
            which: "model";
            value: DockUi.efforts.length > 0 && root.level == "full" ? DockUi.model-name + "  " + DockUi.effort-name : DockUi.model-name;
        }
        if root.level == "full" && DockUi.efforts.length > 0 && DockUi.models.length == 0: PickerButton {
            which: "effort";
            value: DockUi.effort-name;
        }
        if root.level == "full" && DockUi.modes.length > 0: PickerButton {
            which: "mode";
            value: DockUi.mode-name;
        }
        if root.level != "full": VerticalLayout {
            alignment: center;
            OptionsButton { }
        }
    }
}

// One section of the options popup: header + the choices of one picker.
component OptionSection inherits VerticalLayout {
    in property <string> which;
    spacing: 2px;
    HorizontalLayout {
        padding-left: 8px;
        SectionLabel {
            height: 24px;
            text: DockUi.picker-label(root.which);
            accessible-role: AccessibleRole.text;
            accessible-label: "section " + self.text;
        }
    }
    for o in (root.which == "mode" ? DockUi.modes : root.which == "model" ? DockUi.models : DockUi.efforts): MenuItem {
        text: o.name;
        label: root.which + "-option " + o.name;
        checked: o.id == (root.which == "mode" ? DockUi.mode : root.which == "model" ? DockUi.model : DockUi.effort);
        clicked => {
            DockUi.pick-option(root.which, o.id);
            DockUi.picker-open = "";
        }
    }
    if root.which == "mode": MenuItem {
        text: "Deep research";
        label: "mode-option Deep research";
        checked: DockUi.research;
        clicked => {
            DockUi.pick-option("mode", "harness:research");
            DockUi.picker-open = "";
        }
    }
}

component OptionItem inherits Rectangle {
    in property <string> text;
    in property <string> description;
    in property <string> hint;
    in property <bool> checked;
    in property <bool> submenu;
    in property <string> label: self.text;
    callback clicked;
    height: root.description != "" ? 46px : 32px;
    border-radius: Theme.radius-md;
    background: ta.has-hover ? Theme.raised : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.text;
                font-size: 13px;
                font-weight: root.description != "" ? Theme.weight-medium : 400;
                color: Theme.foreground;
                overflow: elide;
                accessible-role: none;
            }
            if root.description != "": Text {
                text: root.description;
                font-size: 11px;
                color: Theme.muted;
                overflow: elide;
                accessible-role: none;
            }
        }
        if root.checked: Icon {
            y: (parent.height - self.height) / 2;
            source: Icons.check;
            size: 14px;
            tint: Theme.accent-fg;
        }
        if !root.checked && root.hint != "": Text {
            text: root.hint;
            font-size: Theme.ui-sm;
            color: Theme.foreground-subtle;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.submenu: Icon {
            y: (parent.height - self.height) / 2;
            source: Icons.chevron-right;
            size: Theme.icon-sm;
            tint: Theme.icon-subtle;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component MenuRule inherits Rectangle {
    height: 9px;
    Rectangle {
        x: 6px;
        y: 4px;
        width: parent.width - 12px;
        height: 1px;
        background: Theme.popover-border;
    }
}

component MenuHeading inherits HorizontalLayout {
    in property <string> text;
    height: 26px;
    padding-left: 10px;
    Text {
        text: root.text.to-uppercase();
        font-size: 10px;
        font-weight: Theme.weight-semibold;
        letter-spacing: 0.8px;
        color: Theme.caps-label;
        vertical-alignment: center;
        accessible-role: AccessibleRole.text;
        accessible-label: "section " + self.text;
    }
}

export component PickerMenu inherits HorizontalLayout {
    // Above the button that opened it, kept inside the composer.
    alignment: start;
    // Set from `report` (a plain property: binding it to the position would be a layout loop).
    property <length> pad;
    property <length> anchor: DockUi.anchor-x;
    padding-left: root.pad;
    changed anchor => {
        root.report();
    }
    function report() {
        DockUi.menu-x = self.absolute-position.x;
        DockUi.menu-y = self.absolute-position.y;
        DockUi.menu-w = self.width;
        root.pad = clamp(DockUi.anchor-x - self.absolute-position.x, 0px, max(0px, self.width - 312px));
    }
    init => {
        root.report();
    }
    changed absolute-position => {
        root.report();
    }
    changed width => {
        root.report();
    }
    if DockUi.picker-open == "mode": MenuShell {
        width: 304px;
        MenuHeading {
            text: @tr("Mode");
        }
        for o[i] in DockUi.modes: OptionItem {
            text: o.name;
            description: DockUi.mode-description(o.id);
            hint: (i + 1) + "";
            label: "mode-option " + o.name;
            checked: !DockUi.machine && o.id == DockUi.mode;
            clicked => {
                DockUi.pick-option("mode", o.id);
                DockUi.picker-open = "";
            }
        }
        MenuRule { }
        OptionItem {
            text: @tr("Machine");
            description: @tr("Full access: no prompts, controls this computer");
            label: "mode-option Machine";
            checked: DockUi.machine;
            clicked => {
                DockUi.pick-option("mode", "harness:machine");
                DockUi.picker-open = "";
            }
        }
        OptionItem {
            text: "Deep research";
            description: "Search the web and write a sourced report";
            label: "mode-option Deep research";
            checked: DockUi.research;
            clicked => {
                DockUi.pick-option("mode", "harness:research");
                DockUi.picker-open = "";
            }
        }
    }
    if DockUi.picker-open == "model": MenuShell {
        // A long list (OpenRouter, Command Code: dozens of models) gets a search box that takes the keyboard
        // as the menu opens: type to narrow, Enter picks the first match.
        property <bool> searchable: DockUi.models.length > 8;
        width: self.searchable ? 304px : 260px;
        if self.searchable: Rectangle {
            height: 30px;
            border-radius: 8px;
            background: Theme.surface;
            border-width: 1px;
            border-color: model-search.has-focus ? Theme.border-hover : Theme.border;
            Icon {
                x: 9px;
                y: (parent.height - self.height) / 2;
                source: Icons.search;
                size: Theme.icon-xs;
                tint: Theme.icon-subtlest;
            }
            if model-search.text == "": Text {
                x: 30px;
                width: parent.width - 40px;
                text: "Search " + DockUi.models.length + " models";
                font-size: Theme.ui-sm;
                color: Theme.foreground-subtlest;
                vertical-alignment: center;
                accessible-role: none;
            }
            model-search := TextInput {
                x: 30px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 40px;
                height: 18px;
                text <=> DockUi.model-query;
                single-line: true;
                font-size: Theme.ui-sm;
                color: Theme.foreground;
                accessible-label: "Search models";
                init => {
                    self.focus();
                }
                edited => {
                    DockUi.filter-models(self.text);
                }
                accepted => {
                    if DockUi.models-shown.length > 0 {
                        DockUi.pick-option("model", DockUi.models-shown[0].id);
                        DockUi.picker-open = "";
                    }
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        DockUi.picker-open = "";
                        return accept;
                    }
                    reject
                }
            }
        }
        if DockUi.models-shown.length == 0: Text {
            height: 34px;
            text: "No model matches";
            font-size: Theme.ui-sm;
            color: Theme.foreground-subtlest;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Flickable {
            height: min(DockUi.models-shown.length * 34px, 340px);
            content-height: DockUi.models-shown.length * 34px;
            VerticalLayout {
                width: parent.width;
                spacing: 2px;
                for o[i] in DockUi.models-shown: OptionItem {
                    text: o.name;
                    // Number keys pick from a short list; a long one is searched instead.
                    hint: DockUi.models.length > 8 ? "" : (i + 1) + "";
                    label: "model-option " + o.name;
                    checked: o.id == DockUi.model;
                    clicked => {
                        DockUi.pick-option("model", o.id);
                        DockUi.picker-open = "";
                    }
                }
            }
        }
        if DockUi.efforts.length > 0: MenuRule { }
        if DockUi.efforts.length > 0: OptionItem {
            text: @tr("Effort");
            hint: DockUi.effort-name;
            submenu: true;
            label: @tr("Effort") + ": " + DockUi.effort-name;
            clicked => {
                DockUi.picker-open = "effort";
            }
        }
    }
    if DockUi.picker-open == "effort": MenuShell {
        width: 260px;
        HorizontalLayout {
            height: 30px;
            spacing: 4px;
            Rectangle {
                width: 28px;
                border-radius: 8px;
                background: back-ta.has-hover ? Theme.menu-hover : transparent;
                accessible-role: button;
                accessible-label: @tr("Back");
                accessible-action-default => {
                    DockUi.picker-open = DockUi.models.length > 0 ? "model" : "";
                }
                Icon {
                    source: Icons.chevron-left;
                    size: Theme.icon-sm;
                    tint: Theme.icon-subtle;
                }
                back-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        DockUi.picker-open = DockUi.models.length > 0 ? "model" : "";
                    }
                }
            }
            Text {
                text: @tr("Effort");
                font-size: Theme.ui-sm;
                font-weight: Theme.weight-medium;
                color: Theme.foreground-subtle;
                vertical-alignment: center;
            }
        }
        for o[i] in DockUi.efforts: OptionItem {
            text: o.name;
            hint: (i + 1) + "";
            label: "effort-option " + o.name;
            checked: o.id == DockUi.effort;
            clicked => {
                DockUi.pick-option("effort", o.id);
                DockUi.picker-open = "";
            }
        }
    }
    if DockUi.picker-open == "options": MenuShell {
        width: 280px;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: @tr("Mode & effort");
        if DockUi.modes.length > 0: OptionSection {
            which: "mode";
        }
        if DockUi.picker-layout == "compact" && DockUi.models.length > 0: OptionSection {
            which: "model";
        }
        if DockUi.efforts.length > 0: OptionSection {
            which: "effort";
        }
    }
}
// Typed error banner (frame 13): tinted card with a round "!" badge, title 13 semibold + message 12 muted,
// Retry (secondary) / Details / Copy / Dismiss on the right. Rate-limit / network errors use the warning tint.
export component FailureBanner inherits Rectangle {
    property <bool> soft: DockUi.failure-kind == "transient";
    property <color> tone: self.soft ? Theme.warning-surface-foreground : Theme.destructive-surface-foreground;
    vertical-stretch: 0;
    background: Theme.dark ? root.tone.with-alpha(0.07) : root.tone.with-alpha(0.08);
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: root.tone.with-alpha(0.35);
    accessible-role: AccessibleRole.groupbox;
    accessible-label: "failure " + DockUi.failure-kind + " " + DockUi.failure-message;
    VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                y: 1px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: root.tone;
                Text {
                    text: "!";
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.dark ? Theme.canvas : #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                Text {
                    text: DockUi.failure-title(DockUi.failure-kind);
                    font-size: 13px;
                    font-weight: Theme.weight-semibold;
                    color: Theme.foreground;
                    accessible-role: none;
                }
                Text {
                    text: DockUi.failure-message;
                    wrap: word-wrap;
                    font-size: 12px;
                    color: Theme.muted;
                    accessible-role: none;
                }
                if DockUi.failure-retry == "login": Text {
                    text: @tr("Sign in to the agent's CLI in a terminal, then retry.");
                    wrap: word-wrap;
                    font-size: 11px;
                    color: root.tone;
                    accessible-role: AccessibleRole.text;
                }
            }
            if DockUi.failure-retry != "no": Button {
                y: 0;
                variant: "outline";
                size: "sm";
                text: DockUi.failure-wait > 0 ? @tr("Retry in {0} s", DockUi.failure-wait) : @tr("Retry");
                label: @tr("Retry");
                enabled: DockUi.failure-wait <= 0;
                clicked => {
                    DockUi.failure-action("retry");
                }
            }
            IconButton {
                icon: Icons.x;
                label: @tr("Dismiss error");
                size: Theme.control-sm;
                icon-size: Theme.icon-sm;
                clicked => {
                    DockUi.failure-action("dismiss");
                }
            }
        }
        if soft && DockUi.failure-wait > 0: ProgressTrack {
            ratio: -1;
            tint: root.tone;
        }
        HorizontalLayout {
            padding-left: 34px;
            spacing: 6px;
            alignment: start;
            if DockUi.failure-details != "": Button {
                variant: "ghost";
                size: "sm";
                text: DockUi.failure-expanded ? @tr("Hide details") : @tr("Details");
                trailing-chevron: true;
                clicked => {
                    DockUi.failure-expanded = !DockUi.failure-expanded;
                }
            }
            Button {
                variant: "ghost";
                size: "sm";
                text: @tr("Copy");
                has-icon: true;
                icon: Icons.copy;
                label: @tr("Copy error");
                clicked => {
                    DockUi.failure-action("copy");
                }
            }
        }
        if DockUi.failure-expanded && DockUi.failure-details != "": Rectangle {
            background: Theme.card;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            details := TextInput {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                text: DockUi.failure-details;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                font-family: Theme.mono-font;
                font-size: 11px;
                color: Theme.foreground-subtle;
                accessible-label: @tr("Error details");
            }
            height: min(180px, details.preferred-height + 16px);
        }
    }
}
