// Turn-level chat parts of Phase 9.2 (spec docs/specs/harness/phase-9-parity.md §7): expandable tool cards and
// thinking rows (R8), the changed-files summary (R14), the status panel / context meter, the shared text dialog
// (rename, edit + resend, deny with feedback, groups) and the scheduled prompts dialog (R18).
// Rust (src/bridge.rs, src/chat/turns.rs) owns every list; these components render it and report input.

import { Theme } from "../theme/tokens.slint";
import { Icon, Icons, IconsFill, Spinner, Button, IconButton, Tag, Divider, Dialog } from "../components/controls.slint";
import { TextField, TextArea, Switch } from "../settings/parts.slint";
import { AgentTint, Pill, ProgressTrack, CapsHeader } from "../panels/common.slint";
import { ChatUi, ChatImage, ToolPart, ChangeRow, PlanRow, ScheduleRow, SubagentRow } from "globals.slint";
import { LiveUi } from "../panels/live.slint";
import { ArtClock } from "../components/ascii.slint";

// Row of small image previews; a click opens the file in the OS viewer.
export component ImageStrip inherits HorizontalLayout {
    in property <[ChatImage]> images;
    in property <int> more;
    in property <bool> at-end;
    alignment: root.at-end ? end : start;
    spacing: 6px;
    for img in root.images: Rectangle {
        height: 72px;
        width: max(48px, min(112px, 72px * img.image.width / max(1, img.image.height)));
        border-radius: 8px;
        border-width: 1px;
        border-color: ita.has-hover ? Theme.border-hover : Theme.border;
        background: Theme.surface;
        clip: true;
        accessible-role: AccessibleRole.button;
        accessible-label: img.path;
        Image {
            width: parent.width;
            height: parent.height;
            source: img.image;
            image-fit: cover;
            accessible-role: none;
        }
        ita := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                ChatUi.open-path(img.path);
            }
        }
    }
    if root.more > 0: Text {
        text: "+" + root.more;
        font-size: Theme.ui-sm;
        color: Theme.foreground-subtle;
        vertical-alignment: center;
    }
}

// Tool call row (ZCode inline tool row) that expands into its content: diffs, text, locations, raw input/output.
export component ToolCard inherits VerticalLayout {
    in property <int> id;
    in property <string> title;
    in property <int> status;
    in property <string> tool-kind;
    in property <[ToolPart]> parts;
    in property <bool> expanded;
    in property <bool> hit;
    in property <[ChatImage]> images;
    in property <int> images-more;
    // First changed lines of an edit (shown while collapsed), and the file / line range the tool touched.
    in property <[ToolPart]> peek;
    in property <string> file;
    in property <int> file-line;
    in property <string> range;
    in property <int> added;
    in property <int> removed;
    in property <bool> member;
    property <string> status-text: root.status == 0 ? @tr("Running") : root.status == 1 ? @tr("Awaiting permission") : root.status == 2 ? @tr("Done") : root.status == 3 ? @tr("Denied") : @tr("Failed");
    property <string> tone: root.status == 2 ? "success" : root.status == 1 ? "progress" : root.status == 0 ? "neutral" : root.status == 3 ? "warning" : "destructive";
    property <length> content-width: 400px;
    changed width => {
        root.content-width = root.width;
    }
    init => {
        root.content-width = root.width;
    }
    // Output of commands and file tools is terminal text (tables, listings, code): fixed-width, so columns
    // line up. Other tools (web pages, thoughts, MCP answers) return prose and keep the interface font.
    property <bool> raw-output: root.tool-kind == "execute" || root.tool-kind == "read" || root.tool-kind == "search" || root.tool-kind == "edit" || root.tool-kind == "delete" || root.tool-kind == "move";
    property <image> kind-icon: root.tool-kind == "read" ? Icons.file-text : root.tool-kind == "fetch" ? Icons.globe : root.tool-kind == "edit" || root.tool-kind == "move" ? Icons.square-pen : root.tool-kind == "delete" ? Icons.trash-2 : root.tool-kind == "search" ? Icons.search : root.tool-kind == "think" ? Icons.brain : root.tool-kind == "execute" ? Icons.square-terminal : Icons.wrench;
    spacing: 4px;
    // Flat row (no box): a fill appears only on hover or while its detail is open.
    Rectangle {
        height: 30px;
        clip: true;
        border-radius: Theme.radius-md;
        background: root.expanded ? Theme.surface : tta.has-hover && root.parts.length > 0 ? Theme.hover : Theme.hover.with-alpha(0);
        border-width: root.hit ? 2px : 0px;
        border-color: root.hit ? Theme.find-highlight-active : transparent;
        animate background, border-color { duration: Theme.dur-hover; easing: ease-out-quint; }
        accessible-item-selected: root.hit;
        accessible-role: AccessibleRole.button;
        accessible-label: root.title + " · " + root.status-text;
        accessible-description: root.parts.length > 0 ? (root.expanded ? "expanded" : "collapsed") : "";
        accessible-action-default => {
            if root.parts.length > 0 {
                ChatUi.toggle-detail(root.id);
            }
        }
        tta := TouchArea {
            mouse-cursor: root.parts.length > 0 ? pointer : default;
            clicked => {
                if root.parts.length > 0 {
                    ChatUi.toggle-detail(root.id);
                }
            }
        }
        HorizontalLayout {
            padding-left: root.member ? 20px : 8px;
            padding-right: 8px;
            spacing: 8px;
            Text {
                text: root.title;
                font-family: Theme.art-font;
                font-size: 12px;
                color: tta.has-hover ? Theme.foreground : Theme.foreground-subtle;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 0;
                accessible-role: none;
                animate color { duration: Theme.dur-hover; easing: ease-out-quint; }
            }
            if root.added > 0: Text {
                text: "+" + root.added;
                font-size: 12px;
                color: Theme.success-surface-foreground;
                vertical-alignment: center;
            }
            if root.removed > 0: Text {
                text: "−" + root.removed;
                font-size: 12px;
                color: Theme.destructive-surface-foreground;
                vertical-alignment: center;
            }
            if root.parts.length > 0: Image {
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                source: Icons.chevron-right;
                colorize: Theme.icon-subtle;
                transform-rotation: root.expanded ? 90deg : 0deg;
                animate transform-rotation { duration: Theme.dur-move; easing: ease-out-quint; }
                accessible-role: none;
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            if root.images-more > 0: Text {
                text: "+" + root.images-more;
                font-size: Theme.ui-sm;
                color: Theme.foreground-subtle;
                vertical-alignment: center;
            }
            for img in root.images: Rectangle {
                y: (parent.height - self.height) / 2;
                height: 18px;
                width: max(12px, min(32px, 18px * img.image.width / max(1, img.image.height)));
                border-radius: 3px;
                border-width: 1px;
                border-color: ita.has-hover ? Theme.border-hover : Theme.border;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: img.image;
                    image-fit: cover;
                    accessible-role: none;
                }
                ita := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ChatUi.open-path(img.path);
                    }
                }
            }
            // Line range chip: opens the file in the Live view at that line.
            if root.file != "" && root.range != "": Rectangle {
                y: (parent.height - self.height) / 2;
                height: 20px;
                width: range-t.preferred-width + 12px;
                border-radius: Theme.radius-sm;
                background: rta.has-hover ? Theme.surface-hover : Theme.tag;
                accessible-role: button;
                accessible-label: @tr("Show {0} in Live", root.range);
                accessible-action-default => {
                    LiveUi.open(root.file, root.file-line);
                }
                range-t := Text {
                    text: root.range;
                    font-family: Theme.art-font;
                    font-size: 10px;
                    color: rta.has-hover ? Theme.foreground : Theme.foreground-subtle;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                rta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        LiveUi.open(root.file, root.file-line);
                    }
                }
            }
            if root.status == 1 || root.status == 3: Tag {
                y: (parent.height - self.height) / 2;
                text: root.status-text;
                tone: root.tone;
                accessible-role: none;
            }
            if root.status == 0: Spinner {
                y: (parent.height - self.height) / 2;
                size: 14px;
                tint: Theme.accent-fg;
                clocked: true;
            }
            if root.status == 4: Icon {
                y: (parent.height - self.height) / 2;
                source: Icons.circle-x;
                size: 14px;
                tint: Theme.destructive-surface-foreground;
            }
        }
    }
    // Collapsed edit: the first changed lines, so a change can be seen without opening the row. Click opens it in
    // the Live view.
    if false && !root.expanded && root.peek.length > 0: Rectangle {
        property <length> line-h: Theme.code-size * 1.5;
        height: root.peek.length * self.line-h + 12px;
        border-radius: Theme.radius-md;
        background: pka.has-hover ? Theme.surface-hover : Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        accessible-role: AccessibleRole.button;
        accessible-label: @tr("Show the change in Live");
        accessible-action-default => {
            LiveUi.open(root.file, root.file-line);
        }
        animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
        for p[i] in root.peek: Rectangle {
            x: 0;
            y: 6px + i * parent.line-h;
            height: parent.line-h;
            background: p.kind == 2 ? Theme.diff-added-surface : p.kind == 3 ? Theme.diff-removed-surface : transparent;
            Text {
                x: 10px;
                width: 12px;
                text: p.kind == 2 ? "+" : p.kind == 3 ? "−" : "…";
                font-family: Theme.mono-font;
                font-size: Theme.code-size;
                color: p.kind == 2 ? Theme.diff-added : p.kind == 3 ? Theme.diff-removed : Theme.foreground-subtlest;
                vertical-alignment: center;
            }
            Text {
                x: 26px;
                width: parent.width - 34px;
                text: p.text;
                font-family: Theme.mono-font;
                font-size: Theme.code-size;
                color: p.kind == 6 ? Theme.foreground-subtlest : Theme.foreground;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        pka := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                LiveUi.open(root.file, root.file-line);
            }
        }
    }
    if root.expanded && root.parts.length > 0: Rectangle {
        property <bool> shown: false;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.card;
        clip: true;
        opacity: self.shown ? 1 : 0;
        animate opacity { duration: Theme.dur-enter; easing: ease-out-quint; }
        Timer {
            interval: 16ms;
            running: !parent.shown;
            triggered => {
                parent.shown = true;
            }
        }
        accessible-role: AccessibleRole.groupbox;
        accessible-label: "tool detail " + root.title;
        VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            for p in root.parts: row := Rectangle {
                background: p.kind == 2 ? Theme.diff-added-surface : p.kind == 3 ? Theme.diff-removed-surface : transparent;
                // Diff header and location: open the file in the editor (OS default app).
                accessible-role: AccessibleRole.text;
                accessible-label: (p.kind == 2 ? "+ " : p.kind == 3 ? "- " : "") + p.text;
                if p.kind == 1 || p.kind == 4: TouchArea {
                    mouse-cursor: pointer;
                    accessible-role: AccessibleRole.button;
                    accessible-label: "open " + p.text;
                    accessible-action-default => {
                        ChatUi.open-path(p.text);
                    }
                    clicked => {
                        ChatUi.open-path(p.text);
                    }
                }
                property <bool> has-icon: p.kind == 1 || p.kind == 4;
                property <length> pad-top: p.kind == 1 || p.kind == 5 ? 6px : 1px;
                property <length> text-x: 12px + (self.has-icon ? Theme.icon-xs + 6px : 0px);
                height: self.pad-top + txt.preferred-height + 1px;
                if row.has-icon: Icon {
                    x: 12px;
                    y: row.pad-top + 2px;
                    source: p.kind == 1 ? Icons.file-diff : Icons.file;
                    size: Theme.icon-xs;
                    tint: Theme.icon-subtle;
                }
                txt := Text {
                    x: row.text-x;
                    y: row.pad-top;
                    width: max(40px, root.content-width - row.text-x - 12px);
                    text: p.kind == 5 ? (p.text == "input" ? @tr("Input") : @tr("Output")) : p.kind == 2 ? "+ " + p.text : p.kind == 3 ? "- " + p.text : p.text;
                    wrap: word-wrap;
                    font-family: (p.kind == 0 && !root.raw-output) || p.kind == 5 ? "" : Theme.mono-font;
                    font-size: (p.kind == 0 && !root.raw-output) || p.kind == 5 ? Theme.ui-sm : Theme.code-size;
                    font-weight: p.kind == 1 || p.kind == 5 ? Theme.weight-medium : 400;
                    color: p.kind == 5 ? Theme.foreground-subtle : p.kind == 2 ? Theme.diff-added : p.kind == 3 ? Theme.diff-removed : Theme.foreground;
                    accessible-role: none;
                }
            }
        }
    }
}

// Thinking block (live agent_thought_chunk): collapsed to one line, expands to the full text.
export component ThinkingRow inherits VerticalLayout {
    in property <int> id;
    in property <string> text;
    in property <string> preview;
    in property <bool> active;
    in property <bool> expanded;
    // The expanded text sits in a conditional element of a list row: the layout's width does not reach its
    // height measurement there, so the row was measured as if the text were one line and the next rows were
    // drawn over it. An explicit width (kept in a plain property to avoid a width binding loop) fixes the
    // height, as in the message and tool rows.
    property <length> content-width: 400px;
    changed width => {
        root.content-width = root.width;
    }
    init => {
        root.content-width = root.width;
    }
    spacing: 4px;
    Rectangle {
        height: 30px;
        border-radius: Theme.radius-md;
        background: tha.has-hover ? Theme.hover : Theme.hover.with-alpha(0);
        animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
        accessible-role: AccessibleRole.button;
        accessible-label: root.active ? @tr("Thinking…") : @tr("Thought");
        accessible-description: root.expanded ? "expanded" : "collapsed";
        accessible-action-default => {
            ChatUi.toggle-detail(root.id);
        }
        tha := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                ChatUi.toggle-detail(root.id);
            }
        }
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 9px;
            Icon {
                y: (parent.height - self.height) / 2;
                source: Icons.brain;
                size: Theme.icon-xs;
                tint: Theme.icon-subtlest;
            }
            Text {
                text: root.active ? @tr("Thinking…") : @tr("Thought");
                font-size: Theme.ui-base;
                font-weight: Theme.weight-medium;
                color: Theme.foreground-subtle;
                // Same 2 s breathing as before, stepped by the shared busy clock (90 ms) instead of every frame.
                opacity: root.active && !Theme.reduce-motion ? 0.6 + 0.4 * abs(sin(ArtClock.busy-tick * 16.2deg)) : 1;
                vertical-alignment: center;
                accessible-role: none;
            }
            Text {
                text: root.expanded ? "" : root.preview;
                font-size: Theme.ui-sm;
                color: Theme.foreground-subtlest;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: none;
            }
            Image {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source: Icons.chevron-right;
                colorize: Theme.icon-subtle;
                transform-rotation: root.expanded ? 90deg : 0deg;
                animate transform-rotation { duration: Theme.dur-move; easing: ease-out-quint; }
                accessible-role: none;
            }
        }
    }
    if root.expanded: HorizontalLayout {
        padding-left: 17px;
        spacing: 14px;
        Rectangle {
            width: 2px;
            border-radius: 1px;
            background: Theme.border-hover;
        }
        Text {
            // 17 padding + 2 rule + 14 spacing sit to its left.
            width: max(40px, root.content-width - 33px);
            text: root.text;
            wrap: word-wrap;
            font-size: Theme.ui-sm;
            color: Theme.foreground-subtle;
            accessible-role: AccessibleRole.text;
            accessible-label: "thought " + root.text;
        }
    }
}

// Changed-files summary under a turn's last reply (R14): undo restores the files the turn changed, reapply
// writes them back. dir: 1 = undo available, 2 = reapply available.
export component ChangesCard inherits Rectangle {
    in property <int> id;
    in property <[ChangeRow]> files;
    in property <int> dir;
    in property <string> note;
    property <bool> open;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    clip: true;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: @tr("{n} file changed" | "{n} files changed" % root.files.length);
    VerticalLayout {
        HorizontalLayout {
            height: 36px;
            padding-left: 12px;
            padding-right: 6px;
            spacing: 8px;
            Icon {
                y: (parent.height - self.height) / 2;
                source: root.dir == 2 ? Icons.rotate-ccw : Icons.check;
                size: 14px;
                tint: root.dir == 2 ? Theme.icon-subtle : Theme.success-surface-foreground;
            }
            Rectangle {
                horizontal-stretch: 1;
                accessible-role: AccessibleRole.button;
                accessible-label: root.dir == 2 ? @tr("{n} file changed (undone)" | "{n} files changed (undone)" % root.files.length) : @tr("{n} file changed" | "{n} files changed" % root.files.length);
                accessible-action-default => {
                    root.open = !root.open;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.open = !root.open;
                    }
                }
                Text {
                    x: 0;
                    width: parent.width;
                    text: root.dir == 2 ? @tr("{n} file changed (undone)" | "{n} files changed (undone)" % root.files.length) : @tr("{n} file changed" | "{n} files changed" % root.files.length);
                    font-size: 13px;
                    font-weight: Theme.weight-medium;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }
            }
            Image {
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                source: Icons.chevron-down;
                colorize: Theme.icon-subtle;
                transform-rotation: root.open ? 180deg : 0deg;
                animate transform-rotation { duration: Theme.dur-move; easing: ease-out-quint; }
                accessible-role: none;
            }
            if root.dir == 1: Button {
                y: (parent.height - self.height) / 2;
                text: @tr("Undo changes");
                size: "sm";
                variant: "ghost";
                has-icon: true;
                icon: Icons.rotate-ccw;
                clicked => {
                    ChatUi.turn-action("undo", root.id);
                }
            }
            if root.dir == 2: Button {
                y: (parent.height - self.height) / 2;
                text: @tr("Reapply changes");
                size: "sm";
                variant: "ghost";
                has-icon: true;
                icon: Icons.rotate-cw;
                clicked => {
                    ChatUi.turn-action("reapply", root.id);
                }
            }
        }
        if root.open: Rectangle {
            height: 1px;
            background: Theme.border;
        }
        if root.open: Rectangle {
          background: Theme.card;
          VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 6px;
            padding-bottom: 8px;
            for f in root.files: HorizontalLayout {
                height: 22px;
                spacing: 8px;
                accessible-role: AccessibleRole.text;
                accessible-label: "changed " + f.path + (f.safe ? "" : " (modified since)");
                Text {
                    text: f.action == 1 ? "D" : "M";
                    width: 12px;
                    font-family: Theme.mono-font;
                    font-size: Theme.code-size;
                    font-weight: Theme.weight-semibold;
                    color: f.action == 1 ? Theme.destructive-surface-foreground : Theme.success-surface-foreground;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                Text {
                    text: f.path;
                    font-size: 12px;
                    color: Theme.foreground-subtle;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    accessible-role: none;
                }
                if !f.safe: Tag {
                    text: @tr("Modified since");
                    tone: "warning";
                    accessible-role: none;
                }
            }
            if root.note != "": Text {
                text: root.note;
                wrap: word-wrap;
                font-size: 12px;
                color: Theme.muted;
            }
          }
        }
    }
}

// Status panel above the composer: the agent's plan / todo list (collapsible) and the context meter.
export component StatusPanel inherits Rectangle {
    property <int> done: 0;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: @tr("Plan");
    VerticalLayout {
        HorizontalLayout {
            height: 32px;
            padding-left: 10px;
            padding-right: 4px;
            spacing: 8px;
            Icon {
                source: Icons.list-todo;
                size: Theme.icon-sm;
                tint: Theme.icon-subtle;
            }
            Text {
                text: @tr("Plan");
                font-size: 13px;
                font-weight: Theme.weight-medium;
                color: Theme.foreground;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: ChatUi.plan-open ? Icons.chevron-down : Icons.chevron-up;
                label: ChatUi.plan-open ? @tr("Collapse plan") : @tr("Expand plan");
                size: Theme.control-sm;
                icon-size: Theme.icon-xs;
                clicked => {
                    ChatUi.plan-open = !ChatUi.plan-open;
                }
            }
        }
        if ChatUi.plan-open: VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-bottom: 6px;
            for e in ChatUi.plan: HorizontalLayout {
                spacing: 8px;
                padding-top: 2px;
                padding-bottom: 2px;
                accessible-role: AccessibleRole.text;
                accessible-label: (e.status == 2 ? "done " : e.status == 1 ? "doing " : "todo ") + e.text;
                Icon {
                    source: e.status == 2 ? Icons.circle-check : e.status == 1 ? Icons.loader-circle : Icons.square;
                    size: Theme.icon-sm;
                    tint: e.status == 2 ? Theme.success-surface-foreground : e.status == 1 ? Theme.accent-fg : Theme.icon-subtle;
                }
                Text {
                    text: e.text;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    font-size: Theme.ui-sm;
                    color: e.status == 2 ? Theme.foreground-subtlest : Theme.foreground;
                    accessible-role: none;
                }
            }
        }
    }
}

// Subagent cards (frame 01 right panel, 05/14): agent dot + title + status pill, 4px progress track while running,
// meta line "agent · activity · elapsed" in muted. Expanded card shows the detail and "Open session".
export component SubagentList inherits VerticalLayout {
    property <length> content-width: 260px;
    changed width => {
        root.content-width = root.width;
    }
    init => {
        root.content-width = root.width;
    }
    spacing: 8px;
    Timer {
        interval: 1s;
        running: ChatUi.subagents-running > 0;
        triggered => {
            ChatUi.subagent-action("tick", "");
        }
    }
    for s in ChatUi.subagents-show-all ? ChatUi.subagents : ChatUi.subagents-active: Rectangle {
        property <bool> open: ChatUi.subagent-expanded == s.id;
        property <string> detail: s.status == 1 ? @tr("Needs approval — open to answer") : s.status == 0 ? (s.activity != "" ? s.activity : @tr("Thinking…")) : s.preview != "" ? s.preview : s.status == 2 ? @tr("Done") : s.status == 3 ? @tr("Failed") : s.status == 4 ? @tr("Cancelled") : @tr("Interrupted");
        property <string> pill: s.status == 0 ? @tr("Running") : s.status == 1 ? @tr("Needs approval") : s.status == 2 ? @tr("Done") : s.status == 3 ? @tr("Failed") : s.status == 4 ? @tr("Cancelled") : @tr("Interrupted");
        property <color> pill-tint: s.status == 0 ? Theme.info : s.status == 1 ? Theme.warning-surface-foreground : s.status == 2 ? Theme.success-surface-foreground : s.status == 3 ? Theme.destructive-surface-foreground : Theme.muted;
        border-radius: Theme.radius-lg;
        background: sa.has-hover || self.open ? Theme.raised : Theme.surface;
        border-width: 1px;
        border-color: self.open ? Theme.border-hover : Theme.border;
        animate background, border-color { duration: Theme.dur-hover; easing: ease-out-quint; }
        accessible-role: AccessibleRole.button;
        accessible-label: s.title;
        accessible-description: (s.status == 0 ? "running" : s.status == 1 ? "needs approval" : s.status == 2 ? "done" : s.status == 3 ? "failed" : s.status == 4 ? "cancelled" : "interrupted") + " · " + s.agent;
        accessible-action-default => {
            ChatUi.subagent-expanded = self.open ? "" : s.id;
        }
        VerticalLayout {
            Rectangle {
                height: head.preferred-height;
                sa := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        ChatUi.subagent-expanded = ChatUi.subagent-expanded == s.id ? "" : s.id;
                    }
                }
                head := VerticalLayout {
                    padding-left: 12px;
                    padding-right: 10px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: AgentTint.of(s.agent);
                        }
                        Text {
                            text: s.title != "" ? s.title : @tr("Subagent");
                            font-size: 13px;
                            font-weight: Theme.weight-medium;
                            color: Theme.foreground;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        Pill {
                            y: (parent.height - self.height) / 2;
                            text: pill;
                            tint: pill-tint;
                        }
                    }
                    if s.status == 0: ProgressTrack {
                        on-busy-clock: true;
                        tint: Theme.accent-fg;
                    }
                    if s.status == 3: ProgressTrack {
                        ratio: 1;
                        tint: Theme.destructive-surface-foreground.with-alpha(0.5);
                    }
                    if s.scope != "": Text {
                        text: @tr("Scope: ") + s.scope;
                        font-size: 10px;
                        color: Theme.muted;
                        overflow: elide;
                        accessible-role: none;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: s.agent + (open ? "" : " · " + detail);
                            font-size: 11px;
                            color: s.status == 1 ? Theme.warning-surface-foreground : Theme.muted;
                            overflow: elide;
                            horizontal-stretch: 1;
                            accessible-role: none;
                        }
                        Text {
                            text: ChatUi.elapsed(s.started-s, s.finished-s);
                            font-size: 11px;
                            color: Theme.foreground-subtlest;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                    }
                }
            }
            if open: Rectangle {
                height: 1px;
                background: Theme.border;
            }
            if open: Rectangle {
                height: body.preferred-height + 10px + bar.preferred-height + 10px + 10px;
                body := Text {
                    x: 12px;
                    y: 10px;
                    width: max(40px, root.content-width - 24px);
                    text: detail;
                    font-size: 12px;
                    color: s.status == 1 ? Theme.warning-surface-foreground : Theme.foreground-subtle;
                    wrap: word-wrap;
                }
                bar := HorizontalLayout {
                    x: 12px;
                    y: 10px + body.preferred-height + 10px;
                    width: max(40px, root.content-width - 24px);
                    alignment: end;
                    Button {
                        text: @tr("Open session");
                        size: "sm";
                        clicked => {
                            ChatUi.subagent-action("open", s.id);
                        }
                    }
                }
            }
        }
    }
}

// Background tasks of the open session (§9.17): one compact row per task (frame 01/05), Stop while running.
export component BackgroundTaskList inherits VerticalLayout {
    spacing: 2px;
    Timer {
        interval: 1s;
        running: ChatUi.background-tasks-running > 0;
        triggered => {
            ChatUi.subagent-action("tick", "");
        }
    }
    for t in ChatUi.background-tasks: Rectangle {
        property <bool> failed: !t.running && t.state != "completed";
        height: row.preferred-height + 12px;
        border-radius: Theme.radius-md;
        background: ta.has-hover ? Theme.hover : self.failed ? Theme.destructive-surface.with-alpha(0.06) : transparent;
        accessible-role: AccessibleRole.text;
        accessible-label: t.name + " · " + (t.running ? "running" : t.state) + (t.description != "" ? " · " + t.description : "");
        ta := TouchArea { }
        row := HorizontalLayout {
            x: 6px;
            y: 6px;
            width: max(40px, root.width - 12px);
            spacing: 10px;
            if t.running: Spinner {
                y: 2px;
                size: 12px;
                tint: Theme.accent-fg;
                clocked: true;
            }
            if !t.running: Icon {
                y: 2px;
                source: t.state == "completed" ? Icons.check : Icons.circle-x;
                size: 12px;
                tint: t.state == "completed" ? Theme.success-surface-foreground : Theme.destructive-surface-foreground;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: t.name;
                        font-family: Theme.mono-font;
                        font-size: 12px;
                        color: Theme.foreground-subtle;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    if failed: Pill {
                        y: (parent.height - self.height) / 2;
                        text: @tr("Failed");
                        tint: Theme.destructive-surface-foreground;
                    }
                    Text {
                        text: ChatUi.elapsed(t.started-s, t.finished-s);
                        font-size: 11px;
                        color: Theme.foreground-subtlest;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                if (t.description != "" ? t.description : t.summary) != "": Text {
                    text: t.description != "" ? t.description : t.summary;
                    font-size: 11px;
                    color: failed ? Theme.destructive-surface-foreground : Theme.muted;
                    overflow: elide;
                    accessible-role: none;
                }
            }
            if t.running && t.can-stop: Button {
                y: (parent.height - self.height) / 2;
                text: @tr("Stop");
                size: "sm";
                clicked => {
                    ChatUi.stop-background-task(t.id);
                }
            }
        }
    }
}

// Team strip above the composer of a session that delegated work: one lane per subagent that is still
// working, with what it is doing right now and the steps just before. A click opens the subagent's session.
component TeamLane inherits Rectangle {
    in property <SubagentRow> s;
    property <color> tint: AgentTint.of(root.s.agent);
    property <bool> waiting: root.s.status == 1;
    height: root.s.trail.length > 0 ? 44px : 30px;
    border-radius: Theme.radius-md;
    background: la.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.dur-hover; easing: ease-out-quint; }
    accessible-role: AccessibleRole.button;
    accessible-label: (root.s.agent-name != "" ? root.s.agent-name : root.s.agent) + ": " + root.s.title;
    accessible-description: root.waiting ? "needs approval" : root.s.activity;
    accessible-action-default => {
        ChatUi.subagent-action("open", root.s.id);
    }
    la := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            ChatUi.subagent-action("open", root.s.id);
        }
    }
    // Who.
    Rectangle {
        x: 8px;
        y: 11px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.tint;
    }
    Text {
        x: 24px;
        y: 0;
        height: 30px;
        width: min(self.preferred-width, 120px);
        text: root.s.agent-name != "" ? root.s.agent-name : root.s.agent;
        font-size: Theme.ui-sm;
        font-weight: Theme.weight-semibold;
        color: Theme.foreground;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    // Now: the step in progress, in the mono face, with the working glyphs in front.
    now := Rectangle {
        x: 152px;
        y: 0;
        height: 30px;
        width: max(0px, root.width - self.x - 96px);
        if !root.waiting: Spinner {
            x: 0;
            y: (parent.height - self.height) / 2;
            size: 12px;
            tint: root.tint;
            clocked: true;
        }
        Text {
            x: 20px;
            width: parent.width - 20px;
            height: parent.height;
            text: root.waiting ? @tr("Needs approval — open to answer") : root.s.activity != "" ? root.s.activity : root.s.title != "" ? root.s.title : @tr("Thinking…");
            font-family: root.waiting || root.s.activity == "" ? "" : Theme.art-font;
            font-size: root.waiting || root.s.activity == "" ? Theme.ui-sm : 11px;
            color: root.waiting ? Theme.warning-surface-foreground : Theme.foreground-subtle;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
    }
    // Before: the last steps, newest first.
    if root.s.trail.length > 0: Text {
        x: 172px;
        y: 25px;
        width: max(0px, root.width - self.x - 12px);
        text: "↳ " + root.s.trail[0] + (root.s.trail.length > 1 ? "  ·  " + root.s.trail[1] : "") + (root.s.trail.length > 2 ? "  ·  " + root.s.trail[2] : "");
        font-family: Theme.art-font;
        font-size: 10px;
        color: Theme.foreground-subtlest;
        overflow: elide;
        accessible-role: none;
    }
    // Steps so far and the time it has been at it; Stop appears on hover.
    Text {
        x: parent.width - self.width - (la.has-hover || sta.has-hover ? 34px : 10px);
        y: 0;
        height: 30px;
        text: (root.s.steps > 0 ? @tr("{n} step" | "{n} steps" % root.s.steps) + " · " : "") + ChatUi.elapsed(root.s.started-s, root.s.finished-s);
        font-size: Theme.ui-xs + 1px;
        color: Theme.foreground-subtlest;
        vertical-alignment: center;
        horizontal-alignment: right;
        accessible-role: none;
    }
    if la.has-hover || sta.has-hover: Rectangle {
        x: parent.width - 28px;
        y: 4px;
        width: 22px;
        height: 22px;
        border-radius: Theme.radius-sm;
        background: sta.has-hover ? Theme.destructive.with-alpha(0.18) : transparent;
        accessible-role: button;
        accessible-label: @tr("Stop this subagent");
        accessible-action-default => {
            ChatUi.subagent-action("stop", root.s.id);
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 8px;
            height: 8px;
            border-radius: 2px;
            background: sta.has-hover ? Theme.destructive : Theme.icon-subtle;
        }
    }
    sta := TouchArea {
        x: parent.width - 28px;
        y: 4px;
        width: 22px;
        height: 22px;
        mouse-cursor: pointer;
        clicked => {
            ChatUi.subagent-action("stop", root.s.id);
        }
    }
}

export component TeamStrip inherits Rectangle {
    in-out property <bool> open: true;
    callback orchestra();
    property <int> shown: min(ChatUi.subagents-active.length, 4);
    property <int> done: ChatUi.subagents.length - ChatUi.subagents-active.length;
    border-radius: Theme.radius-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: @tr("Team");
    // Elapsed times tick once a second while anyone is working.
    Timer {
        interval: 1s;
        running: ChatUi.subagents-running > 0;
        triggered => {
            ChatUi.subagent-action("tick", "");
        }
    }
    VerticalLayout {
        padding: 4px;
        Rectangle {
            height: 26px;
            hta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open = !root.open;
                }
            }
            Text {
                x: 8px;
                height: parent.height;
                text: "▚";
                font-family: Theme.art-font;
                font-size: 11px;
                color: Theme.accent-fg;
                vertical-alignment: center;
                accessible-role: none;
            }
            Text {
                x: 24px;
                height: parent.height;
                text: @tr("Team") + "  ·  " + @tr("{0} working", ChatUi.subagents-active.length) + (ChatUi.subagents-waiting > 0 ? "  ·  " + @tr("{0} waiting for you", ChatUi.subagents-waiting) : "") + (root.done > 0 ? "  ·  " + @tr("{0} finished", root.done) : "");
                font-size: Theme.ui-sm;
                font-weight: Theme.weight-medium;
                color: ChatUi.subagents-waiting > 0 ? Theme.warning-surface-foreground : Theme.foreground-subtle;
                vertical-alignment: center;
                accessible-role: none;
            }
            Rectangle {
                x: parent.width - self.width - 28px;
                y: (parent.height - self.height) / 2;
                width: orch-t.preferred-width + 14px;
                height: 20px;
                border-radius: Theme.radius-sm;
                background: ota.has-hover ? Theme.surface-hover : transparent;
                accessible-role: button;
                accessible-label: @tr("Open Orchestra");
                accessible-action-default => {
                    root.orchestra();
                }
                orch-t := Text {
                    text: @tr("Orchestra") + " ↗";
                    font-size: Theme.ui-xs + 1px;
                    color: ota.has-hover ? Theme.foreground : Theme.foreground-subtlest;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                ota := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.orchestra();
                    }
                }
            }
            Image {
                x: parent.width - 22px;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source: Icons.chevron-right;
                colorize: Theme.icon-subtle;
                transform-rotation: root.open ? 90deg : 0deg;
                animate transform-rotation { duration: Theme.dur-move; easing: ease-out-quint; }
                accessible-role: none;
            }
        }
        if root.open: VerticalLayout {
            for s[i] in ChatUi.subagents-active: TeamLane {
                visible: i < 4;
                height: i < 4 ? (s.trail.length > 0 ? 44px : 30px) : 0px;
                s: s;
            }
            if ChatUi.subagents-active.length > 4: Text {
                height: 22px;
                text: "   " + @tr("+{0} more in Orchestra", ChatUi.subagents-active.length - 4);
                font-size: Theme.ui-xs + 1px;
                color: Theme.foreground-subtlest;
                vertical-alignment: center;
            }
        }
    }
}

// Bar on top of a subagent session (§9.8): who delegated it and the way back.
export component SubagentBar inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: @tr("Subagent of {0}", ChatUi.parent-title);
    HorizontalLayout {
        padding: 6px;
        padding-left: 12px;
        spacing: 8px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            border-radius: 6px;
            background: Theme.accent-soft;
            Icon {
                source: Icons.bot;
                size: 12px;
                tint: Theme.accent-fg;
            }
        }
        Text {
            text: @tr("Subagent of {0}", ChatUi.parent-title);
            font-size: 13px;
            color: Theme.foreground-subtle;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        Button {
            text: @tr("Back to main session");
            size: "sm";
            has-icon: true;
            icon: Icons.arrow-left;
            clicked => {
                ChatUi.subagent-action("back", ChatUi.parent-id);
            }
        }
    }
}

// Context meter (ACP usage_update): a small ring-like bar + percentage; hover text has the token counts.
export component ContextMeter inherits HorizontalLayout {
    spacing: 4px;
    accessible-role: AccessibleRole.text;
    accessible-label: "context " + ChatUi.usage-text + (ChatUi.usage-cost != "" ? " · " + ChatUi.usage-cost : "");
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 28px;
        height: 4px;
        border-radius: 2px;
        background: Theme.border;
        Rectangle {
            x: 0;
            width: parent.width * clamp(ChatUi.usage-ratio, 0, 1);
            height: parent.height;
            border-radius: 2px;
            background: ChatUi.usage-ratio > 0.9 ? Theme.destructive : ChatUi.usage-ratio > 0.7 ? Theme.warning-surface-foreground : Theme.accent-fg;
        }
    }
    Text {
        text: round(ChatUi.usage-ratio * 100) + "%";
        font-size: 12px;
        color: Theme.muted;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// Shared text dialog: one or two fields, an optional check box, confirm / cancel. Rust reads the fields on submit.
export component TextDialog inherits Dialog {
    title: ChatUi.dialog-text-of(ChatUi.dialog-kind, "title");
    close-label: @tr("Close");
    dialog-width: 480px;
    close => {
        ChatUi.dialog-open = false;
    }
    if ChatUi.dialog-text-of(ChatUi.dialog-kind, "label") != "": Text {
        text: ChatUi.dialog-text-of(ChatUi.dialog-kind, "label");
        font-size: Theme.ui-sm;
        color: Theme.foreground-subtle;
        wrap: word-wrap;
    }
    if !ChatUi.dialog-confirm-only && !ChatUi.dialog-multiline: TextField {
        text <=> ChatUi.dialog-text;
        label: ChatUi.dialog-text-of(ChatUi.dialog-kind, "title");
        accepted => {
            ChatUi.dialog-submit();
        }
    }
    if !ChatUi.dialog-confirm-only && ChatUi.dialog-multiline: TextArea {
        height: 140px;
        mono: false;
        text <=> ChatUi.dialog-text;
        label: ChatUi.dialog-text-of(ChatUi.dialog-kind, "title");
    }
    if ChatUi.dialog-text-of(ChatUi.dialog-kind, "label2") != "": TextField {
        text <=> ChatUi.dialog-text2;
        label: ChatUi.dialog-text-of(ChatUi.dialog-kind, "label2");
        placeholder: ChatUi.dialog-text-of(ChatUi.dialog-kind, "label2");
    }
    if ChatUi.dialog-text-of(ChatUi.dialog-kind, "check") != "": HorizontalLayout {
        spacing: 8px;
        Switch {
            checked: ChatUi.dialog-check;
            label: ChatUi.dialog-text-of(ChatUi.dialog-kind, "check");
            toggled(on) => {
                ChatUi.dialog-check = on;
            }
        }
        Text {
            text: ChatUi.dialog-text-of(ChatUi.dialog-kind, "check");
            font-size: Theme.ui-sm;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
        }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        Button {
            text: @tr("Cancel");
            size: "lg";
            clicked => {
                ChatUi.dialog-open = false;
            }
        }
        Button {
            text: ChatUi.dialog-text-of(ChatUi.dialog-kind, "confirm");
            variant: ChatUi.dialog-destructive ? "destructive" : "primary";
            size: "lg";
            clicked => {
                ChatUi.dialog-submit();
            }
        }
    }
}

// Scheduled prompts (R18): global switch (off by default), list with enable / run now / delete, and "New".
export component SchedulesDialog inherits Dialog {
    title: @tr("Scheduled prompts");
    close-label: @tr("Close");
    dialog-width: 560px;
    close => {
        ChatUi.schedules-open = false;
    }
    HorizontalLayout {
        spacing: 8px;
        Switch {
            checked: ChatUi.schedules-enabled;
            label: @tr("Run scheduled prompts");
            toggled(on) => {
                ChatUi.schedule-action(on ? "enable" : "disable", "");
            }
        }
        Text {
            text: @tr("Run scheduled prompts");
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: Theme.foreground;
            accessible-role: none;
        }
        Button {
            text: @tr("New schedule");
            has-icon: true;
            icon: Icons.plus;
            clicked => {
                ChatUi.schedule-action("new", "");
            }
        }
    }
    if ChatUi.schedules.length == 0: Text {
        text: @tr("No scheduled prompts yet.");
        color: Theme.foreground-subtle;
        horizontal-alignment: center;
    }
    for s in ChatUi.schedules: Rectangle {
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        accessible-role: AccessibleRole.list-item;
        accessible-label: "schedule " + s.title;
        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            Switch {
                y: (parent.height - self.height) / 2;
                checked: s.enabled;
                label: @tr("Enable {0}", s.title);
                toggled(on) => {
                    ChatUi.schedule-action("toggle", s.id);
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: s.title;
                    font-weight: Theme.weight-medium;
                    color: Theme.foreground;
                    overflow: elide;
                }
                Text {
                    text: (s.kind == "daily" ? @tr("Daily at {0}", s.at) : @tr("Every {0} min", s.every-min))
                        + (s.next-in >= 0 ? " · " + @tr("next in {0} min", s.next-in) : "")
                        + (s.last != "" ? " · " + s.last : "");
                    font-size: Theme.ui-sm;
                    color: Theme.foreground-subtle;
                    overflow: elide;
                }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.play;
                label: @tr("Run {0} now", s.title);
                clicked => {
                    ChatUi.schedule-action("run", s.id);
                }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.trash-2;
                label: @tr("Delete {0}", s.title);
                clicked => {
                    ChatUi.schedule-action("delete", s.id);
                }
            }
        }
    }
}
