<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Harness" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/harness_bg</item>
        <item name="android:navigationBarColor">@color/harness_bg</item>
        <item name="android:windowBackground">@color/harness_bg</item>
        <item name="colorAccent">@color/harness_accent</item>
        <item name="colorPrimary">@color/harness_accent</item>
        <item name="colorPrimaryDark">@color/harness_bg</item>
    </style>

    <style name="Harness.Text" parent="android:TextAppearance">
        <item name="android:textColor">@color/harness_fg</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Harness.Title" parent="Harness.Text">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Harness.Muted" parent="Harness.Text">
        <item name="android:textColor">@color/harness_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
